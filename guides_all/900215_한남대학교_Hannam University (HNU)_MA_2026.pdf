<script></script><style type="text/css" data-type="vc_custom-css">/*메인 배너 텍스트*/
.heading-text.el-text .font-weight-400 span{
    padding-left:0px;
}
.heading-text.el-text .font-weight-400:before {
    content: "";
    display: none;
}


/*s1_남색 퀵메뉴*/
.quick_menu .icon-box-content{
   vertical-align: middle;
}
.quick_menu .single-block-padding{
    border-radius:20px;
    width:230px;
}
.quick_menu h5 a{
    color:#ffffff !important;
}
.quick_menu h5 a:hover{
    color:#ffffff !important;
}
.quick_menu .qicon-06{
    padding-top: 8px !important;
}
@media (max-width: 960px){
.quick_menu .qicon-06{
    padding-top: 0px !important;
}
}
.quick_menu .icon-box-left .icon-box-content {
    padding-left: 20px;
}


/*s1_전체보기 아이콘*/
.view_more{
    padding-top:6px;
}
@media (max-width: 400px){
.view_more{
    width:110px !important;
    padding-top:10px;
}
}

/*s1_공지사항 게시판*/
.notice_table{
    margin-top:-18px !important;
}
.s1 #kboard-default-latest table .kboard-latest-title{
    padding:22px 0px;
}

/*s2_교육대학원 소개*/
.s2 .uncell{
    border-radius:20px;
}

/*s4_갤러리*/
#kboard-thumb-latest .item_box{
    border-top : 0px;
    border-bottom : 0px;
}

 #kboard-thumb-latest .item_box .item{
    width : 25%;
    background-color: #fff;
    border : 1px solid #E5E5E5;
    padding: 0px !important;
}

#kboard-thumb-latest .item_box .item .title {
    font-size: 16px;
    margin-bottom: 10px;
    padding-left:10px;
    padding-right:10px;
    text-align: left;
    font-weight: 500;
}
#kboard-thumb-latest .item_box .item .title a{
overflow: hidden;
    display: block;
    white-space: nowrap;
    text-overflow: ellipsis;
}

#kboard-thumb-latest .item_box .item .title + div {
    font-size: 13px !important ;
    color:#666;
    text-align:left;
    padding-left:10px;
    margin-bottom:12px;
}
@media (max-width: 960px){
 #kboard-thumb-latest .item_box .item{
    width : 50%;
}
}</style><noscript><style> .wpb_animate_when_almost_visible { opacity: 1; }</style></noscript></head>
