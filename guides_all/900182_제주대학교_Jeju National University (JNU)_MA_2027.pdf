						<h1>							모집요강
						</h1>
						<!-- <p class="text">제주대학교 국제교류처에 오신 것을 환영합니다.</p> -->
						<div class="contents-util">
							<a href="#"  onclick="window.open('/intl/admission/graduateschool/graduate.htm?_layout=playout&amp;_view=print' + window.location.hash, 'winPrint','width=770,height=600,scrollbars=yes');return false;"><i class="fa-regular fa-print"></i></a>
