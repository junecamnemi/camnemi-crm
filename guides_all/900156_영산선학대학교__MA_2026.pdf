<style>
#preloader {
  position: fixed;
  left: 0;
  top: 0;
  z-index: 999;
  width: 100%;
  height: 100%;
  overflow: visible;
  background:url('http://youngsan.ac.kr/theme/henalhome/design/img/preloader.gif') no-repeat center center;
}
</style>
<script>
jQuery(document).ready(function($) {
    $(window).load(function(){
	   $('#preloader').fadeOut('slow',function(){$(this).remove();});
    });
});
</script>
