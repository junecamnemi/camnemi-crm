<!-- 팝업레이어 시작 { -->
<div id="hd_pop">


</div>

<script>
$(function() {

    // ✅ 오버레이가 없으면 생성
    if (!$('#hd_pop_overlay').length) {
        $('body').append('<div id="hd_pop_overlay" aria-hidden="true"></div>');
    }

    function lockScroll() {
        var scrollBarWidth = window.innerWidth - document.documentElement.clientWidth;
        $('html, body').addClass('is-popup-open');
        if (scrollBarWidth > 0) $('body').css('padding-right', scrollBarWidth + 'px');
    }

    function unlockScroll() {
        $('html, body').removeClass('is-popup-open');
        $('body').css('padding-right', '');
    }

    function refreshPopupState() {
        var hasVisiblePopup = $('#hd_pop .hd_pops:visible').length > 0;

        if (hasVisiblePopup) {
            $('#hd_pop_overlay').stop(true, true).fadeIn(180);
            lockScroll();
        } else {
            $('#hd_pop_overlay').stop(true, true).fadeOut(180);
            unlockScroll();
        }
    }

function closePopup($pop) {
  if (!$pop || !$pop.length) return;

  // 중복 클릭 방지
  if ($pop.hasClass('is-closing')) return;

  $pop.addClass('is-closing');

  // transition 시간(0.18s) + 여유 약간
  setTimeout(function () {
    $pop.hide().removeClass('is-closing');
    refreshPopupState();
  }, 220);
}

    // ✅ 최초 상태 반영
    refreshPopupState();

    // 다시열람 안함
    $(".hd_pops_reject").click(function() {
        var id = $(this).attr('class').split(' ');
        var ck_name = id[1];
        var exp_time = parseInt(id[2], 10);

        closePopup($("#" + id[1]));
        set_cookie(ck_name, 1, exp_time, g5_cookie_domain);
    });

    // 닫기
    $('.hd_pops_close').click(function() {
        var idb = $(this).attr('class').split(' ');
        closePopup($('#' + idb[1]));
    });

    $("#hd").css("z-index", 1000);
});
</script>
<!-- } 팝업레이어 끝 -->

