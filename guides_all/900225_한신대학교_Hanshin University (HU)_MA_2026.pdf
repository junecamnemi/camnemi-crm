function ajaxLogout(){
	
	var access_token = $("#access_token").val();
	
	var params = "grant_type=logout"
		           + "&client_id=" + client_id
		           + "&access_token=" + access_token
		           + "&scope=" + scope
		           + "&redirect_uri=" + document.location.href;
		
	$.ajax({
		type : 'POST',
		url : 'https://sso2.hs.ac.kr/oauth2/removeSession.do',
		data:params,
		dataType : "json",
		async : false,
		success : function(data) {
			console.log(data);
		},
		error : function(request,status,error) {
			console.log(error);
		} 
	});
	
	$.ajax({
		type:"post",
		url:"/totalLogin/eCampusLogout.do",
		async:false,
		cache:false,
		success:function(r){
			
			$("#request_uri").val(document.location.href);
			
			document.getElementById("logoutForm").submit();
		}
	});
	
}
</script>
	
