<script>
	$(window).scroll(function(){
		let yOffset = window.pageYOffset;
		let calc = yOffset / ($('body').outerHeight() - $(window).outerHeight());

		$('.onTicket .back').css({
			'transform' : `rotate(${calc*360}deg)`
		});

	});
</script>

