<script>
	function toPage(num,sID) {
		var form=document.boardFrm;
		form.M_NUM.value=num;
		form.sID.value=sID;
		form.no.value=num;
		form.action="/board.jsp";
		form.target="_self";
		form.submit();
	}
	
