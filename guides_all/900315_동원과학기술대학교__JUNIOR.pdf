	 <!-- 메인팝업존 사이즈 크기 -->

<script>
	var dateNow = new Date();
	var dateClose = new Date ("01/29/2026 14:59:59");; //팝업 내리는 time  (월/일/년도  시/분/초)
	var dateStart = new Date ("09/07/2026 09:00:00"); //팝업 게재 time (월/일/년도  시/분/초)
	if(dateNow < dateClose) {
		//위에 설정한 시간에 팝업을 내릴 경우
		//open_windowPopup3(500,480,0,0,2,"/resources/_Etc/Popup/ipsi/pop_260120.html");
		// 창 가로 사이즈, 창 세로사이즈, left, top, 이미지캐시
	}
	if(dateNow > dateStart) {
		//위에 설정한 시간에 팝업 게재를 할경우
		open_windowPopup4(500,420,0,0,3,"/resources/_Etc/Popup/ipsi/pop_260907.html");
	}
	//열림유지  
	//open_windowPopup2(500,480,450,0,2,"/resources/_Etc/Popup/ipsi/pop_251208.html");
	//open_windowPopup4(500,480,500,0,2,"/resources/_Etc/Popup/ipsi/pop_260119.html");
	//open_windowPopup2(500,480,0,0,2,"/resources/_Etc/Popup/ipsi/pop_260115.html");
	//open_windowPopup3(500,480,0,0,2,"/resources/_Etc/Popup/ipsi/pop_260113.html");
	//open_windowPopup3(500,480,0,0,2,"/resources/_Etc/Popup/ipsi/pop_260120.html");
	//open_windowPopup3(500,480,0,0,2,"/resources/_Etc/Popup/ipsi/pop_260126.html");
	//open_windowPopup3(600,997,0,0,2,"/resources/_Etc/Popup/ipsi/pop_260211.html");
	// 창 가로 사이즈, 창 세로사이즈, left, top, 이미지캐시


	// 마크업 들어간 윈도우 새창팝업
	function open_windowPopup2(w,h,l,t,pop_seq,pop_url){
		var hh = parseInt(h,10) +50;

		var open_windowPopup2_option ={
				url : pop_url,
				name : "open_windowPop2_" + pop_seq,
				width : w,
				height : hh,
				left : l,
				top : t,
				scrollbars : "no",
				resizable : "no"
			};
		if( getCookie('open_windowPop2_'+pop_seq) != "done" ){
			popupOpen( open_windowPopup2_option );
		}
	}

	//열림유지
	// open_windowPopup3(500,480,0,0,3,"/resources/_Etc/Popup/ipsi/pop_250701.html");
	// 창 가로 사이즈, 창 세로사이즈, left, top, 이미지캐시

	// 마크업 들어간 윈도우 새창팝업
	function open_windowPopup3(w,h,l,t,pop_seq,pop_url){
		var hh = parseInt(h,10) +50;

		var open_windowPopup3_option ={
				url : pop_url,
				name : "open_windowPop3_" + pop_seq,
				width : w,
				height : hh,
				left : l,
				top : t,
				scrollbars : "no",
				resizable : "no"
			};
		if( getCookie('open_windowPop3_'+pop_seq) != "done" ){
			popupOpen( open_windowPopup3_option );
		}
	}
	// 마크업 들어간 윈도우 새창팝업
	function open_windowPopup4(w,h,l,t,pop_seq,pop_url){
		var hh = parseInt(h,10) +50;

		var open_windowPopup4_option ={
				url : pop_url,
				name : "open_windowPop4_" + pop_seq,
				width : w,
				height : hh,
				left : l,
				top : t,
				scrollbars : "no",
				resizable : "no"
			};
		if( getCookie('open_windowPop4_'+pop_seq) != "done" ){
			popupOpen( open_windowPopup4_option );
		}
	}

</script>
