<script>
    $(document).ready(function() {
        var eventCookie = getCookie("imgpop");
        if (eventCookie == "done") {
            $('.popup_area').removeClass('show');
        }else{
            
            $('.popup_area').addClass('show');
            popupSwiper();
            

        }

    });
</script>
