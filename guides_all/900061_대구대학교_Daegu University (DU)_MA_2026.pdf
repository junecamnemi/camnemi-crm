<script type="text/javascript">
    var popup_swiper;

    // sns 공유할 현재 URL
    var share_url = window.location.href;

    $(document).ready(function(){

        

        var call_popup = false;

        //팝업
        $("a.popup_open").on("click", function(e){
            $("html").addClass("fixed");
            $(".popup_area").addClass("show");
            
            popupSwiper();
            

            


        });

        $(".pop-close").on("click", function(){
            $("html").removeClass("fixed");
            $(".popup_area").removeClass("show");
            if(popup_swiper){
                popup_swiper.destroy(true, true);
            }
        });

        if($("#kakaoBtn").length > 0){

        }
    });

    //SNS 공유
    function shareSNS(sns_type){
        switch (sns_type){
            case "facebook":
                window.open("https://www.facebook.com/sharer/sharer.php?u="+encodeURIComponent(share_url));
                break;

            case "twitter":
                window.open("https://twitter.com/intent/tweet"
                    +"?"
                    +"text="+encodeURIComponent("대구대학교 학과 CMS - ") // Title in this html document
                    +"&url="+encodeURIComponent(share_url)
                );
                break;

            case "kakao":
                // 위에 있음.
                break;
        }
    }

    //상단 팝업존
    function setCookie( name, value, expiredays ) {
        var todayDate = new Date();
        todayDate.setDate( todayDate.getDate() + expiredays );
        document.cookie = name + "=" + escape( value ) + "; path=/; expires=" + todayDate.toGMTString() + ";"
    }

    function closePop() {
        setCookie( "imgpop", "done" , 1 );
        $('.popup_area').removeClass('show');
        if(popup_swiper){
            popup_swiper.destroy(true, true);
        }

    }

    function getCookie(name) {
        var Found = false;
        var start, end;
        var i = 0;

        while(i <= document.cookie.length) {
            start = i;
            end = start + name.length;
            if(document.cookie.substring(start, end) == name) {
                Found = true;
                break;
            }
            i++;
        }
        if(Found == true) {
            start = end + 1;
            end = start+name.length-2;
            return document.cookie.substring(start, end);
        }
        return;
    }


    function popupSwiper(){
        popup_swiper = new Swiper(".popup_list", {
            slidesPerView: 1,
            spaceBetween: 20,
            fadeEffect: {
                crossFade: false,
            },
                breakpoints: {
                991: {
                    slidesPerView: 3,
                    allowTouchMove: false,
                    touchRatio: 0,
                },
                767: {
                    slidesPerView: 2,
                    allowTouchMove: false,
                    touchRatio: 0,
                }
            },
            mousewheel: false,
            pagination: {
                el: ".popup_pagination",
                type: "fraction"
            },
            navigation: {
                nextEl: ".popup_next",
                prevEl: ".popup_prev"
            }
        });
    }
</script>

