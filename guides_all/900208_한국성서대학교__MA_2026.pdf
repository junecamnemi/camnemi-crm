	(function(){
		var A_OPEN_SLIDE = "bible_templets_grad_header_open_slide";

		document.addEventListener("click", function(ev){
			var el = ev.target && ev.target.closest("[data-action]");
			if (!el) return;
			var act = el.getAttribute("data-action");

			if (act === A_OPEN_SLIDE) {
				OpenSlideMenu();
			}
		});
	})();
</script>

