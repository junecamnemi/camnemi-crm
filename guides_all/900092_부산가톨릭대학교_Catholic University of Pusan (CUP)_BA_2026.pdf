    <link rel="stylesheet" href="/plug-in/zTree_v3-master/css/zTreeStyle/zTreeStyle.css;CUPSESSIONID=53AAAD250E1BEA58E8F79E1C1CE0821F" type="text/css">
    <script src="/common/admmgr/js/calendar.js;CUPSESSIONID=53AAAD250E1BEA58E8F79E1C1CE0821F"></script>
    <script type="text/javascript" src="/common/admmgr/js/file/CtitFile-custom.js;CUPSESSIONID=53AAAD250E1BEA58E8F79E1C1CE0821F"></script>
    <script type="text/javascript" src="/plug-in/zTree_v3-master//js/jquery.ztree.core.js;CUPSESSIONID=53AAAD250E1BEA58E8F79E1C1CE0821F"></script>
    <script type="text/javascript">
    $(document).ready(function(){
        fn_Change();
    });
    function getFontCss(treeId,treeNode){
        return (!!treeNode.highlight) ? {color:"#A60000", "font-weight":"bold"} : {color:"#333", "font-weight":"normal"};
    }
    //[트리 Fn] 사이트 변경시 트리 갱신
    function fn_Change(){
        $("div.loader_wrap").show();
        var setting = {
            data: {
                simpleData: {
                    enable: true
                }
            },
            view: {
                fontCss: getFontCss,
                showLine: true,
                selectedMulti: false,
                dblClickExpand: false
            },
            callback: {
                onNodeCreated: this.onNodeCreated,
                beforeClick: this.beforeClick,
                onClick: this.onClick
            }
        };
        $.ajax({
            type : "POST",
            url  : "/cup/ipsi/front/contsMenuAjax075000000000000.do;CUPSESSIONID=53AAAD250E1BEA58E8F79E1C1CE0821F",
            data : {"ipsiSiteCd":"075000000000000"},
            dataType : "text",
            success : function(data){
                onebtnchk=0;
                //console.log(data);
                var rJson = $.parseJSON(data);
                var arrJson = new Array();
                $.each(rJson,function(idx){
                    var rData = $(this)[0];
                    var objJson = new Object();
                    var strIcon = "";
                    var bNoLink = false;
                    //메뉴코드 맨 앞자리가 0인것은 관리자메뉴이므로 컨텐츠관리 메뉴에 표시되면 안됨
                    //현재 메뉴 체계에서 M앞에 하나 더 추가가 되어야함
                    //
                    if(rData.MENU_CD.substring(0, 3) != "000"  ){
                        //console.log(rData.CHILD_CNT);
                        //하위 노드가 없을 때
                        if( Number(rData.CHILD_CNT) == 0 ){
                            //메뉴타입이 콘텐츠일시
                            if( rData.MENU_TP == "001001002000" ){
                                bNoLink = false;
                                //콘텐츠가 매핑되어 있을시
                                if( Number(rData.CONTS_CNT) > 0 ){
                                    //console.log("메뉴매핑됨["+rData+"]");
                                    strIcon = "/plug-in/zTree_v3-master/css/zTreeStyle/img/diy/diy_conts_map_y.png;CUPSESSIONID=53AAAD250E1BEA58E8F79E1C1CE0821F";
                                //콘텐츠가 매핑안되어 있을시
                                }else{
                                    strIcon = "/plug-in/zTree_v3-master/css/zTreeStyle/img/diy/diy_conts_map_n.png;CUPSESSIONID=53AAAD250E1BEA58E8F79E1C1CE0821F";
                                }
                            //메뉴 타입이 게시판 일시
                            }else if(rData.MENU_TP == "001001001000"){
                                bNoLink = false;
                                //URL 매핑되어 있을시
                                if( rData.URL !="" ){
                                    //console.log("메뉴매핑됨["+rData+"]");
                                    strIcon = "/plug-in/zTree_v3-master/css/zTreeStyle/img/diy/2.png;CUPSESSIONID=53AAAD250E1BEA58E8F79E1C1CE0821F";
                                //URL 매핑 안되어 있을시
                                }else{
                                    strIcon = "/plug-in/zTree_v3-master/css/zTreeStyle/img/diy/2.png;CUPSESSIONID=53AAAD250E1BEA58E8F79E1C1CE0821F";
                                }
                            //메뉴타입이 게시판or콘텐츠가 아닐시
                            }else{
                                bNoLink = true;
                                strIcon = "/plug-in/zTree_v3-master/css/zTreeStyle/img/diy/2.png;CUPSESSIONID=53AAAD250E1BEA58E8F79E1C1CE0821F";
                            }
                        //하위노드가 있을 때
                        }else{
                            //메뉴타입이 콘텐츠일시
                            if( rData.MENU_TP == "001001002000" ){
                                bNoLink = false;
                                //콘텐츠가 매핑되어 있을시
                                if( Number(rData.CONTS_CNT) > 0 ){
                                    strIcon = "/plug-in/zTree_v3-master/css/zTreeStyle/img/diy/diy_conts_map_y.png;CUPSESSIONID=53AAAD250E1BEA58E8F79E1C1CE0821F";
                                //콘텐츠가 매핑안되어 있을시
                                }else{
                                    strIcon = "/plug-in/zTree_v3-master/css/zTreeStyle/img/diy/diy_conts_map_n.png;CUPSESSIONID=53AAAD250E1BEA58E8F79E1C1CE0821F";
                                }
                            //메뉴 타입이 게시판 일시
                            }else if(rData.MENU_TP == "001001001000"){
                                bNoLink = false;
                                //URL 매핑되어 있을시
                                if( rData.URL !="" ){
                                    //console.log("메뉴매핑됨["+rData+"]");
                                    strIcon = "/plug-in/zTree_v3-master/css/zTreeStyle/img/diy/2.png;CUPSESSIONID=53AAAD250E1BEA58E8F79E1C1CE0821F";
                                //URL 매핑 안되어 있을시
                                }else{
                                    strIcon = "/plug-in/zTree_v3-master/css/zTreeStyle/img/diy/2.png;CUPSESSIONID=53AAAD250E1BEA58E8F79E1C1CE0821F";
                                }
                            //메뉴타입이 게시판or콘텐츠가 아닐시
                            }else{
                                bNoLink = true;
                            }
                        }
                        objJson.id   = rData.MENU_CD;
                        objJson.pId  = rData.P_MENU_CD;
                        objJson.name = rData.MENU_NM;
                        objJson.menuType = rData.MENU_TP;//메뉴타입도 매핑함.
                        objJson.boardMngNo = rData.BOARD_MNG_NO; // 목록을 가져오기 위해 게시판 유형 같이 넘겨주기.
                        objJson.page = rData.PAGE;
                        objJson.icon = strIcon;
                        objJson.noLink = bNoLink;
                        arrJson.push(objJson);
                    }
                });
                        console.log(arrJson);
                //return false;
                $.fn.zTree.init($("#zTree"),setting,arrJson);
                console.log(arrJson);
                  var treeObj = $.fn.zTree.getZTreeObj("zTree");
                  treeObj.expandAll(true);
                $("div.loader_wrap").hide();
            },
            error : function(request,status,error){
                onebtnchk=0;
                alert("처리 중 오류가 발생되었습니다.\nerror:"+error+"request:"+request+"status:"+status);
                $("div.bh_on_rev_loader").hide();
            }
        });
    }
    //[트리 Fn] 트리 클릭
    function onClick(e,treeId,node){
        var pageKey = node.page;
        document.getElementById('canvasContainer').querySelector('iframe').src = document.getElementById('canvasContainer').querySelector('iframe').src.replace(/#page=\d+/, '')+'#page='+pageKey;
    }
    </script>
    

