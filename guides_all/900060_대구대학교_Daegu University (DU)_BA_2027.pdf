<script>
    
	// 구글 번역 초기화
	function googleTranslateElementInit() {
		new google.translate.TranslateElement(
			{
				pageLanguage: 'ko',
				includedLanguages: 'ko,en,zh-CN,ja,vi,mn,uz,fr,es',
				autoDisplay: false
			},
			'google_translate_element'
		);
	}

	function resetLanguage() {
		var host = location.hostname;
		var parts = host.split('.');
		var rootDomain = parts.length > 1 ? parts.slice(-2).join('.') : host;

		document.cookie = 'googtrans=;expires=Thu, 01 Jan 1970 00:00:00 GMT;path=/';
		document.cookie = 'googtrans=;expires=Thu, 01 Jan 1970 00:00:00 GMT;path=/;domain=' + host;
		document.cookie = 'googtrans=;expires=Thu, 01 Jan 1970 00:00:00 GMT;path=/;domain=.' + host;
		document.cookie = 'googtrans=;expires=Thu, 01 Jan 1970 00:00:00 GMT;path=/;domain=' + rootDomain;
		document.cookie = 'googtrans=;expires=Thu, 01 Jan 1970 00:00:00 GMT;path=/;domain=.' + rootDomain;

		location.href = location.pathname + location.search + location.hash;
	}

	function waitForTranslateCombo(callback) {
		var count = 0;
		var timer = setInterval(function () {
			var combo = document.querySelector('.goog-te-combo');

			if (combo) {
				clearInterval(timer);
				callback(combo);
				return;
			}

			count++;

			if (count > 40) {
				clearInterval(timer);
				alert('번역 엔진이 아직 준비되지 않았습니다.');
			}
		}, 250);
	}

	var CustomTranslator = {
		init: function () {
			this.bindEvents();
		},

		openList: function () {
			$('.translator_list').stop().slideToggle(200);
			$('.translator_btn').toggleClass('active');
		},

		closeList: function () {
			$('.translator_list').stop().slideUp(200);
			$('.translator_btn').removeClass('active');
		},

		changeLanguage: function (langCode) {
			waitForTranslateCombo(function (combo) {
				$('.skiptranslate').hide();
				$('body').css('top', '0');

				combo.value = langCode;
				combo.dispatchEvent(new Event('change', { bubbles: true }));
			});
		},

		bindEvents: function () {
			var _this = this;

			$(document).on('click', '.translator_btn', function (e) {
				e.preventDefault();
				e.stopPropagation();
				_this.openList();
			});

			$(document).on('click', '.translator_list button[data-lang]', function (e) {
				e.preventDefault();
				e.stopPropagation();

				var langCode = $(this).data('lang');

				_this.closeList();

				if (langCode === 'ko') {
					resetLanguage();
					return;
				}

				_this.changeLanguage(langCode);
			});

			$(document).on('click', function (e) {
				if (!$(e.target).closest('.translator').length) {
					_this.closeList();
				}
			});
		}
	};

	$(function () {
