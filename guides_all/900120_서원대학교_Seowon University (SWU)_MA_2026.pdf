	<div class="artclViewTitleWrap">
		<div class="artclViewHeader">
			<h2 class="artclViewTitle">
				
				
				&nbsp; [대학원] 2026학년도 전기 대학원(일반·교육·산업) 신입생 모집 안내
			</h2>
			<div class="artclViewSide">
				
				<dl>
					<!--<dt>작성자</dt>-->
					<dd>				
						
								대학원
							
					</dd>
				</dl>
				<dl>
					<!--<dt>작성일</dt>-->
