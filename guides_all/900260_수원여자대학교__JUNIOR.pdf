			<script type="text/javascript">
			function family_site(){
				var obj = $(".family_site");
					obj.btn = obj.find(">a");
					obj.se = obj.find(">select");
				
				obj.btn.click(function(){
					var urls = obj.se.find(">option:selected").attr("value");

					if(!urls) return false;

					if(urls.indexOf("http://") != -1 || urls.indexOf("https://") != -1){
						window.open(urls,"");
					} else {
						location.href = urls;
					}
					return false;
				});
			}
				family_site();
			</script>
