						<li><a href="#none" id="print"><img src="/images/swc/layout/icon_print.png" alt="프린트" /></a></li>
					</ul>
					<script type="text/javascript">
						function gong_ac_AC(){
							var btn = $(".gong_ac");
								btn.ul = btn.siblings("ul");

							btn.click(function(){								
								var img = btn.find(">img")[0];

								if(btn.ul.is(":hidden")){
									img.src = img.src.replace(".png","_on.png");
									btn.ul.show();
								} else {
									img.src = img.src.replace("_on.png",".png");
									btn.ul.hide();
								}
								return false;
							});
						}
						gong_ac_AC();
					</script>
</div>
	<script type="text/javascript">
	
		
					
		$(document).ready(function(){
// 			var common = "/css/common/common.css";
			var kor_common = "/css/swc/common.css";
			var layout = "/css/swc/layout.css";
			var board = "/css/egovframework/com/cop/bbs/board_basic.css";
			
			var content = "/css/swc/content.css";
// 			var component = "/css/common/component.css";
		
			// 프린트 기능
			$("#print").bind("click",function(event){
				$("#content").printElement({
					printMode:'popup', //팝업설정 popup = 팝업창 , iframe = iframe
					//overrideElementCSS:[common, kor_common, layout, layout_rwd, board, content, content2, content3, component], //css경로
					overrideElementCSS:[kor_common, board, layout, content], //css경로
					pageTitle:'수원여자대학교입학', //인쇄 타이틀
					printBodyOptions:{
						styleToAdd: 'width:1024px; overflow-x:hidden;' //style attributes to add to the body of print document
					},
					leaveOpen:false //false = 인쇄후 창닫기
				});
				event.preventDefault();
			});
		});
	</script>	

			
		
