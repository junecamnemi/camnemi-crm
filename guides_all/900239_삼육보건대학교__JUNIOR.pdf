			<article>
				<!--컨텐츠 영역-->

				

				<!--컨텐츠 위치-->
				

<script src="/type/common/js/pdfobject.min.js"></script>
<!-- <style>
#divPdf {min-height: 1125px !important;}
</style> -->
<script>

	var myPDF;

	var options = {
		pdfOpenParams: {
			navpanes: 0,
			toolbar: 0,
			statusbar: 0,
			view: "FitV",
			pagemode: "none",
			page: 1
		},
		forcePDFJS: true,
		PDFJS_URL: "/pdfJS/web/viewer.html"
	};


	$(function(){

		myPDF = PDFObject.embed("/ajaxfile/CmnFileCpnt/fileView.do?gbn=p01&SITE_NO=4&MENU_NO=120&CONTENTS_NO=1&TYPE_CODE=C0601", '#pdf', options);
		//myPDF = PDFObject.embed("/pdfJS/001_1.pdf", '#pdf', options);



		//$("#divPdf").attr("src","/pdfJS/web/viewer.html?file="+encodeURIComponent("http://exam.shu.ac.kr/ajaxfile/CmnSvc/FileView.do?GBN=X12&SITE_NO=4&MENU_NO=120&CONTENTS_NO=1&TYPE_CODE=C0601"));

		fn_comm_ajax({
			url : "/ajaxf/FrSvc/getContentsFileIndexList.do",
			data : $("#sendForm").serialize(),
			dataType : "json",
			success : function(data) {
				console.log(data);
				if (data.length > 0) {
					//$(".btn_mSelect").append(data[0].INDEX_NM);
					for(var i=0 ; i<data.length ; i++){
						var innerHTML = '';
						innerHTML += '<li '+(i==0?'class="on"':'')+'><button type="button" class="step_menu" onclick="javascript:return false;" data-page="'+data[i].PAGE_NO+'" value="'+(i+1)+'"><span class="base">'+data[i].INDEX_NM+'</span></button></li>';
						//innerHTML += '<li><a href="#none" class="btnD Arrow step_menu" onclick="javascript:return false;" data-page="'+data[i].PAGE_NO+'">'+data[i].INDEX_NM+'</a></li>';
						$(".pdf_infoList #optionVal").append(innerHTML);

						//최초진입
						$("#optionVal li").each(function(index){
							if($(this).hasClass("on")){
								var selectVal = $(this).find("button").val();
								var selectTxt = $(this).find(".base").text();
								$("#mPDF_Index .toggleBtn").val(selectVal).find(".base").html(selectTxt);
							}
						});
					}
				}else{
					$(".pdf_infoList").remove();
				}
			}
		});

		$("#divPdf").attr("title","순수외국인 PDF 문서정보");

		$(document).on('click', '.step_menu', function(){

			var pageNo = $(this).data('page');
			$('#divPdf').contents().find("#thumbnailView a").eq(pageNo-1).trigger('click');
			if($(this).next().children().length == 0){
				$(this).next().remove();
			}
			$(this).parent().addClass('on').siblings().removeClass('on');

			var selectVal = $(this).val();
			var selectTxt = $(this).find(".base").text();

			$("#optionVal>li>button").removeAttr("title");
			$("#optionVal>li").removeClass("on");
			$(this).attr("title","선택됨").parents("li").addClass("on");

			$("#mPDF_Index .toggleBtn").val(selectVal).find(".base").html(selectTxt);

			$("#mPDF_Index").removeClass("on").find(".toggleBtn").attr("title", "메뉴 축소됨");

			//모바일일때만 축소
			if(window.innerWidth <= 768){
				$("#optionVal").slideUp(300);
			}

			return false;
		});


		$(document).on('click', '.pdf_infoList li button', function(){
			var offset = $("#pdf").offset();
			//console.log(offset.top);
			$('html, body').animate({scrollTop : offset.top-150}, 400);
		});



		$(document).on('click', '.pdf_page_btn', function(){
			var pageNo = jQuery(this).data('page');
			$('#divPdf').contents().find("#thumbnailView a").eq(pageNo-1).trigger('click');
			return false;
		});

		$(document).on("click","a#pdfBtn",function(){
			location.href="/ajaxfile/CmnFileCpnt/fileDownload.do?FILE_ORG_NM="+encodeURI(encodeURIComponent('2027학년도 순수외국인 모집요강.pdf'))+"&FILE_NM=202606/1781663087234_0.pdf";
		});
		$(document).on("click","a#pdfFullBtn",function(){
			window.open("/ajaxfile/CmnFileCpnt/fileView.do?gbn=p01&SITE_NO=4&MENU_NO=120&CONTENTS_NO=1&TYPE_CODE=C0601","_pdf","");
		});
		$(document).on("click","a#hwpBtn",function(){
			location.href="/ajaxfile/CmnFileCpnt/fileDownload.do?FILE_ORG_NM="+encodeURI(encodeURIComponent(''))+"&FILE_NM=";
		});

		var infoList_txt = $(".pdf_infoList .list>li.on a").text();
		$(".pdf_infoList .btn_mSelect").text(infoList_txt);

		$(document).on("click",".pdf_infoList .btn_mSelect",function(){
			$(".pdf_infoList").addClass('on');
		});

		$(document).on("click",".pdf_infoList .list li a",function(){
			$(".pdf_infoList .btn_mSelect").text($(this).text());
			$(".pdf_infoList").removeClass('on');
		});

	});
</script>
<div class="board_area">
	<div class="lineList_v pdfView typePdfview">
