						<span class="base"></span>
					</button>
				</div>
				<!-- //모바일용 -->

				<ul id="optionVal">
				</ul>

				<script>
					$(function(){
						//모바일일때 버튼으로 메뉴 확장
						$("#mPDF_Index .toggleBtn").on("click", function(e){
							$(this).attr("title","메뉴 확장됨").parent(".selectBase").addClass("on");
							$("#optionVal").slideDown(300);
						})

						$(window).bind('load resize', function(){
							if(window.innerWidth >= 768){
								$(".pdf_infoList>ul").removeAttr("style");
							}
						});
					});
				</script>
			</div>
		</div>
		<div class="pdf_view pdf_View" id="pdf">

		</div>
	</div>
