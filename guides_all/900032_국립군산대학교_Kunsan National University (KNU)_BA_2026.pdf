                            leftM_li.attr("class","");
                            leftM_li.eq(index).attr("class","on");
                            leftM_li.find("> ul").attr("class","hide");
                            leftM_li.eq(index).find("> ul").attr("class","");
                            return false;
                        }
                    });
                */
                leftM_a.on("click", function() {
                    var index = leftM_a.index(this);
                    var targetLi = leftM_li.eq(index);

                    if (targetLi.find("> ul").length > 0) {
                        leftM_li.not(".fix").removeClass("on");

                        if (!targetLi.hasClass("fix")) {
                            targetLi.addClass("on");
                        }
                        leftM_li.not(".fix").find("> ul").addClass("hide");
                        targetLi.find("> ul").removeClass("hide");

                        return false;
                    }
                });
            </script>
        </div>
    </div>
