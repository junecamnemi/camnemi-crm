                        <h3>전문학사과정 외국인특별전형</h3>
                         

<script type="text/javascript">

var favoUrl = "";
$( document ).ready(function() {
	favoUrl = "/web/"+$(location).attr('href').split('/web/')[1] ;
	//ajax로 메뉴에 등록된 url 체크
	check_menu();
	
});

/* 체크된 메인배너  목록 삭제 */
function add_favourl(){
	
		alert("즐겨찾기는 로그인이 필요합니다.");
		return;
	
	
	if (!confirm("즐겨찾기를 추가하시겠습니까?")){
	 	return false;	
	}	
	
	$.ajax({
		 type: "POST",
	     url: "/web/member/favoInsertAjax.do",
	     async:false,
	     data: {"favoUrl" : favoUrl},
	     dataType:'json',
	     //processData: false,
	     //contentType: false,
	     //cache: false,
	     //timeout: 600000,
	     success: function (returnData, status) {
	     	if(status == 'success'){
		    	if(returnData.result == 'success'){
		    		alert("즐겨찾기에  추가되었습니다.");
		    		if('web/member/favoList.do'==favoUrl){
		    			location.reload();	
		    		}
		        }else if(returnData.result == 'dupl'){
		        	alert("즐겨찾기에 이미 추가되었습니다.");
	           	}else{
	           		alert("즐겨찾기에 추가 되지 않았습니다.");
	           	}
           }else{
        	   alert("즐겨찾기에 추가 되지 않았습니다.");
           }
       },
       error: function (e) {
    	   alert("즐겨찾기에 추가 되지 않았습니다.");
       }
	});
}

/* 체크된 메인배너  목록 삭제 */
function check_menu(){
	$.ajax({
		 type: "POST",
	     url: "/web/checkMenuAjax.do",
	     async:false,
	     data: {"favoUrl" : favoUrl},
	     dataType:'json',
	     success: function (returnData, status) {
	     	if(status == 'success'){
		    	if(returnData.result == 'notExist'){
		    		$('.favorite').remove()	; //즐겨찾기 버튼 삭제
		        }
           }else{
           }
       },
       error: function (e) {
       }
	});
	
}


</script>

