function googleSearch(){
	if($('#googleSearchTxt').val().trim()==''){
		alert('검색어를 입력해 주세요');
		return false;
	}
	var frm = document.googleForm ;
	frm.target="_blank"
	frm.q.value = "site:seoularts.ac.kr "+$('#googleSearchTxt').val();
	frm.action = "https://www.google.co.kr/search";
	frm.submit();
}
</script>



