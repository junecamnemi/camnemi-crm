<head>
<title>전문학사과정 외국인특별전형 &lt; 모집요강 &lt; 입학안내 &lt; 서울예술대학교</title>
<script>
$(document).ready(function (){
	//3뎁스 ul 하단 li 없으면 삭제
	$('.threeDepUl').each(function (index, item){
		if($(this).children().length == 0){
			$(this).remove();
		}
	});

	$('.threeDepUl').each(function (index, item){ //3뎁스를 2뎁스로
		var threeLink = $(this).find('a').attr('href') ;
		$(this).closest('li').children('a').attr("href",threeLink); //2뎁스
	});

	$('.gnb_inner').each(function (index, item){ //2뎁스를 1뎁스로
		$(this).find('.twoDepHr').each(function (index, item){
			if(index == 0){
				var twoLink = $(this).attr('href') ;
				$(this).closest('.oneDepli').children('a').attr("href",twoLink);
			}
		});	
	});

	var mnOneDp = 1 ;
	var mnTwoDp = 0 ;
		
	
		mnTwoDp = 2 ;
	
	
	//lnb 타이틀 이름 재 정의 
	var $t1 = $("#aside>ul>li").eq(mnOneDp - 1).find(">a").text();
	var $t2 = $("#aside>ul>li").eq(mnOneDp - 1).find(">ul>li").eq(mnTwoDp - 1).find(">a").text();
	var $tt = '<li class="home"><span class="blind">home</span></li>' ;
		$tt+= '<li>'+$('.lnb_tit').text()+'</li>';
		$tt+= '<li>'+$t1+'</li>';
		
	if(0 != mnTwoDp){
		$tt+= '<li>'+$t2+'</li>';	 
	}
	
	$('.location').html($tt);
	
	//좌측 타이틀 변경
	$('.sub_visual_txt').find('h2').text($('.lnb_tit').text());
	
	//상단 대표 이미지 변경
	var topVisual = 3 ;
	if($('.sub_visual').attr('class') !=null){
		$(".sub_visual").removeClass (function (index, className) {
			return (className.match (/(^|\s)visual\S+/g) || []).join(' ');
		});
		
		$(".sub_visual").addClass('visual0'+topVisual); 
        	 
		/* 
		if($('.sub_visual').attr('class').indexOf('visual00')!=-1){ //게시판 등의 상위 이미지 공통으로 쓸경우
			if(topVisual == 10){
				topVisual = 9; 
			}
			$('.sub_visual').addClass('visual0'+topVisual); 
		}
		*/
	}
	
	// 3depth가  없을경우 has_dep3 삭제
	$(".gnb_inner .r > ul > li > a").each(function () {
		if ($(this).next("ul").length == 0) {
			$(this).removeClass("has_dep3");
		}
	});
	
	if (window.location.protocol != "https:"){
		$('#loginbtn').attr('href' , '/web/user/login.do') ;
		$('#loginbtnMbl').attr('href' , '/web/user/login.do') ;
		$('#loginOutbtn').attr('href' , '/web/uat/uia/actionLogout.do') ;
		$('#loginOutbtnMbl').attr('href' , '/web/uat/uia/actionLogout.do') ;
	}
});
</script>



