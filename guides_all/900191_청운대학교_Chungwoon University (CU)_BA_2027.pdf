<input type="hidden" id="loginId" value=""/>
<script nonce="NEOCMSSCRIPT">
    function fn_deleteBbsNtt(url) {
	if(confirm("게시물을 삭제 하시겠습니까?")){
	    location.href = url;
	}
    }
    function fn_deleteBbsNttComment(url) {
	location.href = url;
    }

    function fn_addComment(e, frm) {
	if (e) {
	    e.preventDefault();
	    e.stopPropagation();
	}
	
	var loginId = $('#loginId').val().trim();
	if(!loginId){
		if(confirm("로그인이 필요한 서비스입니다. 로그인 하시겠습니까?")){
			var url = new URL(location.href);
			var domain = url.hostname.split('.');
			
			if(domain[0] != 'job'){
				domain[0] = "job";
				url.hostname = domain.join('.');
			}
			
			location.href = "https://job.chungwoon.ac.kr/loginView.do?rurl=" + encodeURIComponent(url.toString());
			return false;
		}
		
		return false;
	}
	
	var form = document.getElementById('bbsNttComment');
	form.submit();

	return true;
    }

    function fn_validateBbsNttComment( frm ) {
	if( !frm.commentCn.value ) {
		alert("댓글 내용을 입력해주세요.");
		return false;
	}
	return true;
    }
</script>
						
						








    
        
    
    









