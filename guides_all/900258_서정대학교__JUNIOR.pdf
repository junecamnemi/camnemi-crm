<script>
	function setCookie(name, value, exp) {
		var date = new Date();
		date.setTime(date.getTime() + exp*24*60*60*1000);
		document.cookie = name + '=' + value + ';expires=' + date.toUTCString() + ';path=/';
	};
	$(document).ready(function() {
		// 새 창 링크 접근성 보정: target="_blank"에 '새 창 열림' 안내 추가
		$('a[target="_blank"]').each(function() {
			var $a = $(this);
			// 1) 이미 sr-only 안내가 있으면 스킵
			if ($a.find('.sr-only').length > 0) {
				return;
			}

			// 2) 링크의 이름이 될 수 있는 것을 모은다.
			//    보이는 텍스트 > 링크 안 이미지의 alt > title 순
			var visibleText = $.trim($a.clone().children().remove().end().text());
			var imgAlt      = $.trim($a.find('img[alt]').first().attr('alt') || '');
			var titleAttr   = $.trim($a.attr('title') || '');

			var baseLabel = visibleText || imgAlt || titleAttr || '';

			// 이름이 될 만한 것이 하나도 없으면 건너뛴다.
			if (!baseLabel) {
				return;
			}

			// 3) 이미 '새 창' 안내가 이름에 들어 있으면 중복 안내하지 않는다.
			if (baseLabel.indexOf('새 창') !== -1 || baseLabel.indexOf('새창') !== -1) {
				return;
			}

			// 4) aria-label 은 설정하지 않는다.
			//    aria-label 을 주면 링크 안 이미지의 alt 를 덮어써서
			//    배너 내용이 전혀 전달되지 않는다(팝업존 배너에서 발생했던 문제).
			//    아래 sr-only 문구만 덧붙이면 링크 이름은
			//    "이미지 alt + (새 창 열림)" 으로 정상 조합된다.
			$a.append('<span class="sr-only">(새 창 열림)</span>');
		}
									);
	}
					 );
</script>
