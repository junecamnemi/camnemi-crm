    <script>

        function notice_more () {

            var id = $(".notice-cate-slider li.swiper-slide-thumb-active").attr("id");
            if(id == 'notice1') location.href = '/board/board005';
            if(id == 'notice2') location.href = '/board/board005';
            if(id == 'notice3') location.href = '/board/board006';
            if(id == 'notice4') location.href = '/board/board007';
            if(id == 'notice5') location.href = '/board/board008';
            if(id == 'notice6') location.href = '/board/board009';
            if(id == 'notice7') location.href = '/board/board010';
            if(id == 'notice8') location.href = '/board/board011`';
            if(id == 'notice9') location.href = '/board/board012';
        }

        $(".cal-prev").click(function() {
            findCalendar('sub');
        })
        $(".cal-next").click(function() {
            findCalendar('add');
        })

        function findCalendar (status) {

            var $cont = $(".cal-cont");

            var searchMonth = $("#span_month").html();
            var searchYear = $(".year").html();
            var param = { searchMonth: searchMonth, searchYear: searchYear, status: status }
            ktcRequest("/calendar", 'GET', param, true, null, null).then(function (res) {

                $("#span_month").html(res.body.month)
                $(".year").html(res.body.year)
                $cont.children().remove();
                var list = res.body.list
                if(list.length <= 0){
                    $cont.addClass("no-sche")
                }else{
                    $cont.removeClass("no-sche")
                }
                for( var i=0; i<list.length; i++) {

                    var item = list[i]
                    var el = "";
                    el += '<li>'
                    el +=    '<a href="" class="h6">'+item.bcTitle+'</a>'
                    el +=    '<p>'+item.bcStartDate+' - '+item.bcEndDate+'</p>'
                    el += '</li>'

                    $cont.append(el)

                }

                $cont.mCustomScrollbar({
                    theme:"light",
                    setTop: 0 ,
                });
            })



        }
    </script>

    <script>

        var $w = $(window),
            $body = $('body');

        $("#datepicker").datepicker({
            //dateFormat: 'yy-mm'
        });
        // 스크롤바
        $(window).on("load",function(){
            var liheight = $('.cal-cont li').height();
            $(".cal-cont").mCustomScrollbar({
                theme:"light",
                setTop: 0 ,
            });
        });
        var visualSwiperNum = $('.visual-swiper .swiper-slide').length,
            visualSwiper = new Swiper(".visual-swiper", {
                effect:'fade',
                loop: true,
                autoplay: {
                    delay: 8000,
                    disableOnInteraction: false
                },
                navigation: {
                    prevEl: '.main-visual .swiper-button-prev',
                    nextEl: '.main-visual .swiper-button-next',
                },
                on:{
                    init:function(){
                        $('.main-visual .index-swiper-pn-num').html('<b class="text-primary">01</b> '+ '<b>0' + visualSwiperNum +'</b>');
                        $('.main-visual .index-swiper-pn>i').css('width',1/visualSwiperNum*100+'%');
                    },
                    slideChange: function(){
                        // $('.main-visual .index-swiper-pn-num b:first-child').html('0'+(this.realIndex+1));
                        if(visualSwiperNum == this.realIndex+1)
                        { $('.index-swiper-pn-num b:last-child').addClass('text-primary') ; }
                        else
                        { $('.index-swiper-pn-num b:last-child').removeClass('text-primary') ; }
                        //  0923 수정
                        $('.main-visual .index-swiper-pn-num b:first-child').html('0'+(this.realIndex+1));
                        $('.main-visual .index-swiper-pn>i').css('width',(this.realIndex+1)/visualSwiperNum*100+'%');
                    },
                }
            }); //visualSwiper

        var noticeSwiper = new Swiper(".notice-cate-swiper", {
            slidesPerView:'auto',
            freeMode:true ,
            spaceBetween:15 ,
            slidesPerGroup:2,
            watchSlidesVisibility: true,
            watchSlidesProgress: true,
            // navigation: {
            //     nextEl: '.notice-cont-slider .swiper-button-next',
            //     prevEl: '.notice-cont-slider .swiper-button-prev',
            // },
            breakpoints: {
                991: {
                    spaceBetween: 0,
                    slidesPerGroup:'auto',
                },
            },


        });

        var noticeContSwiper = new Swiper(".notice-cont-swiper", {
            allowTouchMove:false,
            thumbs: {
                swiper: noticeSwiper,
            },
            navigation: {
                nextEl: '.notice-cont-slider .swiper-button-next',
                prevEl: '.notice-cont-slider .swiper-button-prev',
            },
            on:{
                slideChangeTransitionEnd: function(){
                    // var tI = noticeSwiper.activeIndex;
                    if($('.notice-cate-swiper .swiper-slide').slice(0, 6).hasClass('swiper-slide-thumb-active')){
                        $('.notice-cate-slider').addClass('hasnext');
                        $('.notice-cate-swiper .swiper-wrapper').css(
                            'transform','translate3d(0px, 0px, 0px)'
                        )
                    } else {
                        $('.notice-cate-slider').removeClass('hasnext');
                        $('.notice-cate-swiper .swiper-wrapper').css(
                            'transform','translate3d(-130px, 0px, 0px)'
                        )
                    }
                }
            }
        });

        var cultureSwiperNum = $('.culture-swiper .swiper-slide').length,
            cultureSwiper = new Swiper(".culture-swiper", {
                loop: true,
                slidesPerView: "auto",
                centeredSlides: true,
                spaceBetween: 40 ,
                navigation: {
                    nextEl: '.culture-swiper-btn-next',
                    prevEl: '.culture-swiper-btn-prev',
                },
                on:{
                    init:function(){
                        $('.culture-slider .culture-swiper-pn-num').html('<b class="text-white">01</b> '+ '<b>0' + cultureSwiperNum +'</b>');
                        $('.culture-slider .culture-swiper-pn>i').css('width',1/cultureSwiperNum*100+'%');
                    },
                    slideChange: function(){

                        if(cultureSwiperNum == this.realIndex+1)
                        { $('.culture-swiper-pn-num b:last-child').addClass('text-white') ; }
                        else
                        { $('.culture-swiper-pn-num b:last-child').removeClass('text-white') ; }
                        //  0923 수정
                        $('.culture-slider .culture-swiper-pn-num b:first-child').html('0'+(this.realIndex+1));
                        $('.culture-slider .culture-swiper-pn>i').css('width',(this.realIndex+1)/cultureSwiperNum*100+'%');
                    },
                }
            }); //cultureSwiper

        var visionSwiper = new Swiper(".vision-swiper", {
            effect:'fade',
            loop: true,
            autoplay: {
                delay: 8000,
                disableOnInteraction: false
            },
            navigation: {
                nextEl: '.vision-slider .swiper-button-next',
                prevEl: '.vision-slider .swiper-button-prev',
            },
        });

    </script>
