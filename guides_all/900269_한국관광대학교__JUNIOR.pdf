<script>
    let popupList = [{"popupSeq":"202608210327","popupTitle":"\uAD00\uAD11\uD638\uC2A4\uD53C\uD0C8\uB9AC\uD130 \uCEE4\uB9AC\uC5B4 \uBAA8\uB4C8","popupLink":"https:\/\/www.ktc.ac.kr\/","popupContent":null,"popupRoot":null,"isNewWindow":"Y","popupAttach":"202608219038"},{"popupSeq":"202608210328","popupTitle":"\uD56D\uACF5\uC11C\uBE44\uC2A4 \uCEE4\uB9AC\uC5B4 \uBAA8\uB4C8","popupLink":"https:\/\/www.ktc.ac.kr\/","popupContent":null,"popupRoot":null,"isNewWindow":"Y","popupAttach":"202608219039"},{"popupSeq":"202608210329","popupTitle":"\uCEEC\uB9AC\uB108\uB9AC\uB514\uC800\uD2B8 \uCEE4\uB9AC\uC5B4 \uBAA8\uB4C8","popupLink":"https:\/\/www.ktc.ac.kr\/","popupContent":null,"popupRoot":null,"isNewWindow":"Y","popupAttach":"202608219040"},{"popupSeq":"202608250330","popupTitle":"2\uD559\uAE30 \uD53C\uD2B8\uB2C8\uC2A4\uC13C\uD130 \uC6B4\uC601 \uC548\uB0B4","popupLink":"http:\/\/www.ktc.ac.kr\/main","popupContent":null,"popupRoot":null,"isNewWindow":"Y","popupAttach":"202608259104"},{"popupSeq":"202608310331","popupTitle":"\uC2A4\uD3EC\uCE20\uD2B8\uB808\uC774\uB108\uACFC","popupLink":"https:\/\/www.kyosu.net\/news\/articleView.html?idxno=209547","popupContent":null,"popupRoot":null,"isNewWindow":"Y","popupAttach":"202608319158"},{"popupSeq":"202609090340","popupTitle":"2026\uD559\uB144\uB3C4 2\uD559\uAE30 \uBC29\uACFC \uD6C4 \uD504\uB85C\uADF8\uB7A8 \uBAA8\uC9D1 \uACF5\uACE0","popupLink":"https:\/\/www.ktc.ac.kr\/board\/view\/202108170005\/202609095006","popupContent":null,"popupRoot":null,"isNewWindow":"Y","popupAttach":"202609099272"},{"popupSeq":"202609110341","popupTitle":"2026\uD559\uB144\uB3C4 \uC575\uCEE4\uC0AC\uC5C5 10~11\uC6D4 \uAC1C\uAC15 \uD504\uB85C\uADF8\uB7A8 \uC548\uB0B4","popupLink":"https:\/\/www.ktc.ac.kr\/board\/view\/202108170005\/202609115017","popupContent":null,"popupRoot":null,"isNewWindow":"Y","popupAttach":"202609119308"}];
    var el = "";

    console.log('size >' +popupList.length)
    popupList.forEach(function(item){
        el = "";

        if(checkPopupCookie(item.popupSeq)) {
            el += '<div id="popup'+ item.popupSeq +'"  class="popup-inner">'
            el +=	'<div class="popup-cnt">'
            if (item.isNewWindow === 'Y') {
                el += '<a href="' + item.popupLink + '" target="_blank"><img src="/files/' + item.popupAttach + '" alt=""></a>';
            } else {
                el += '<a href="' + item.popupLink + '"><img src="/files/' + item.popupAttach + '" alt=""></a>';
            }
            el += '</div>';
            el += '<div class="popup-ft">'
            el += '<label onclick="closePopup(\''+item.popupSeq+'\')">'
            el += '<input type="checkbox">'
            el += '이 창을 하루동안 보지 않습니다.'
            el += '</label>'
            el += '<button type="button" title="닫기" onclick="$(this).closest(\'.popup-inner\').fadeOut();">&times;<span class="sr-only">닫기</span></button>'
            el += '</div>'
            el += '</div>'

            $(".popup").append(el);
        }
    });

    function setCookie (name, value, expiredays) {
        var d = new Date();
        d.setDate(d.getDate() + expiredays);
        document.cookie = name  +"="+ escape(value) + "; path=/; expires="+d.toGMTString()+";";
    }

    function getCookie () {
        return document.cookie;
    }

    function checkPopupCookie(name) {
        var cookie = getCookie();
        if(cookie.indexOf("close_"+name) > -1) {
            return false;
        }

        return true;
    }

    function closePopup (popupSeq) {
        setCookie("close_"+popupSeq, "close", 1 )
        $("#popup"+popupSeq).fadeOut()
    }


</script>

