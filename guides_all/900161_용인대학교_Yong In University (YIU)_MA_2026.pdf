<script type="text/javascript">
jQuery(document).ready(function(){
	if (typeof initPage === "function") {
		initPage();
	}
	setPageDesign();

	setMainType();
});

function setPageDesign() {
	// 디자인 맞추기
	var totalCnt = $(".pagination").find("li").length;

	if (typeof $(".pagination") !== 'undefined' && totalCnt < 5) {
		$(".pagination").find("li").attr("style", "border-left:0")
	}
};

function setMainType() {
	var INO = UT.getCookie("INO");
	if(INO == 'OUT') {
		$("#INOOUT").addClass('active');
		$("#INOIN").removeClass('active');
	} else {
		$("#INOOUT").removeClass('active');
		$("#INOIN").addClass('active');
	}
};
</script>
