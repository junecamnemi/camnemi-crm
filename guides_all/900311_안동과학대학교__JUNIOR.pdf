$(document).ready(function() {
	$(".recentBbsTab").click(function() {
		$(this).parent().parent().find(".recentBbsLi").removeClass("active");
		$(this).parent(".recentBbsLi").addClass("active");
	});
	
	$(".recentBbsInfo").find(" > dl:last").addClass("_last");
});

</script>

	
	
