	<script type="text/javascript">
	$(document).ready(function () {
		//게시글 좋아요 기능
		$('.btn_like a.bbs_like').on('click', function(){
			var login_yn = "";
			var obj = $(this);
			var idx = obj.data("idx");

			if(!login_yn){
				alert("로그인 후 이용가능합니다.");
			} else {
				$.ajax({
					type : "POST",
					url : "/include/bbs_like.htm",
					data : {"mode":"bbs_like", "idx":idx, "bbsid":"paper", "userid" : "", "b_idx" : "", "p_menu0":"1", "p_menu1" : "4"},
					success : function(data){
						switch(data['bool']){
							case 'true':
								obj.toggleClass('on');
								break;
							default :
								alert(data['msg']);
								break;
						}
					},
					error : function(e){
						console.log(e.responseText);
					}
				});
				
			}
			
		});
	});	
	</script>
