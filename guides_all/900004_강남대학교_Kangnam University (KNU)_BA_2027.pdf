<script>
    function hit_up(bltn_seq,link,target){
        $.ajax({
            url:"/include/hit_up_ajax.php",
            type:'GET',
            data: { "bltn_seq" : bltn_seq},
            dataType: "html",
            success:function(data){
                //location.href=link;
                if(target=="_blank"){
                    var win = window.open(link, "PopupWin");
                }else{
                    location.href=link;
                }


            },
            error:function(jqXHR, textStatus, errorThrown){
                //alert("error \n" + textStatus + " : " + errorThrown);
            }
        });
    }
</script>

