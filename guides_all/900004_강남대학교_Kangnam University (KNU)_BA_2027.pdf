    <script>
        $(document).ready(function(){
			
			/* 반응형 이미지맵 */
		$('img[usemap]').rwdImageMaps();

            var slider = $('.popup_slider');
            var timer;
            $(window).on('load resize', function(){
                clearTimeout(timer);
                timer = setTimeout(sliderReponsive(),100);
            });

            function sliderReponsive(){
                if ($(window).width () > 1301){
                    slider.filter('.slick-initialized').slick('unslick');
                }else {
                    slider.not('.slick-initialized').slick({
                        slidesToShow: 2,
                        slidesToScroll: 1,
                        setPosition: 0,
                        autoplay:true,
                        speed:1000,
                        dots: true,
                        dotsClass: 'custom_paging',
                        customPaging: function (slider, i) {
                            return  (i + 1) + '/' + slider.slideCount;},
                    });
                }
            }


            $('.popup_slider').slick({
                responsive: [
                    {
                        breakpoint: 1299,
                        settings: {
                            slidesToShow: 4,
                            slidesToScroll: 1,
                            setPosition: 0,
                            autoplay:true,
                            speed:1000,
                            dots: true,
                            dotsClass: 'custom_paging',
                            customPaging: function (slider, i) {
                                return  (i + 1) + '/' + slider.slideCount;
                            },
                        }
                    },
                    {
                        breakpoint: 1023,
                        settings: {
                            slidesToShow: 2,
                            slidesToScroll: 1,
                            setPosition: 0,
                            autoplay:true,
                            speed:1000,
                            dots: true,
                            dotsClass: 'custom_paging',
                            customPaging: function (slider, i) {
                                return  (i + 1) + '/' + slider.slideCount;
                            },
                        }
                    }
                ]
            });

            if ($(window).width() > 1301)
            {
                slider.slick('unslick');
            }else{
                //slider.not('.slick-initialized');
                slider.slick('setPosition');
                slider.slick('slickGoTo', 0);
                slider.not('.slick-initialized').slick('slickOptions');
            }
        });
    </script>

