	$(document).ready(function() {
		// NEWS PLUS+ //
		var sliderNewsPlus = $('.mainInterviewContent').bxSlider({
			auto: true        // 자동 실행 여부
			, autoControls: true
			, speed: 800        // 이동 속도를 설정 1000 -> 1초
			, pause:	2000	// 각각의 페이지 로딩 속도 1000 -> 1초
			, moveSlides: 1     // 슬라이드 이동시 개수
			, minSlides: 1      // 최소 노출 개수
			, maxSlides: 1      // 최대 노출 개수
			, slideMargin: 0    // 슬라이드간의 간격
//			, slideWidth: 360   // 슬라이드 너비
			, autoHover: true   // 마우스 호버시 정지 여부
			, pager: false      // 현재 위치 페이징 표시 여부 설정
			, controls: false	// 이전, 다음 버튼 기능 사용여부
			, onSlideAfter: function() {
				$('.sliderPagerNewsPlus > li > a').removeClass('on').eq(sliderNewsPlus.getCurrentSlide()).addClass('on');
			}
		});
		$('.sliderPagerNewsPlus > li').on('click', function(event) {			
			sliderNewsPlus.stopAuto();
			sliderNewsPlus.goToSlide($(this).index());
			return false;
		});
		// NEWS PLUS+ //
	});
	</script>

