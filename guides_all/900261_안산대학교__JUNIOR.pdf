            <a id="IContents_hlnkDownLoad" title="새창열림" class="btn btn-block btn-primary mt-1 mb-1" href="/common/pdfjs/web/viewer.html?file=/upload/ansan/iphak/preferences/2027/MOZIP/0916164126635.pdf" target="_blank"><span class="material-icons ml-0 mr-1">file_download</span>모집요강 다운로드</a>
        </div>
    </div>
    <div class="box-info p-3 mb-2" id="js-pdf"><ul class="list-style01 m-0 row"><li class="col-md-3"><a href="#pdf6" title="6 페이지로 이동합니다">01_전형일정</a></li><li class="col-md-3"><a href="#pdf7" title="7 페이지로 이동합니다">02_모집학과 및 모집인원</a></li><li class="col-md-3"><a href="#pdf7" title="7 페이지로 이동합니다">03_지원방법</a></li><li class="col-md-3"><a href="#pdf8" title="8 페이지로 이동합니다">04_지원자격</a></li><li class="col-md-3"><a href="#pdf8" title="8 페이지로 이동합니다">05_전형방법</a></li><li class="col-md-3"><a href="#pdf9" title="9 페이지로 이동합니다">06_제출서류</a></li><li class="col-md-3"><a href="#pdf10" title="10 페이지로 이동합니다">07_등록금</a></li><li class="col-md-3"><a href="#pdf11" title="11 페이지로 이동합니다">08_장학금</a></li><li class="col-md-3"><a href="#pdf11" title="11 페이지로 이동합니다">09_안산대학교 자체 한국어 능력 검증 시험</a></li><li class="col-md-3"><a href="#pdf12" title="12 페이지로 이동합니다">10_유의사항</a></li><li class="col-md-3"><a href="#pdf13" title="13 페이지로 이동합니다">11_기숙사</a></li><li class="col-md-3"><a href="#pdf18" title="18 페이지로 이동합니다">12_학과안내</a></li><li class="col-md-3"><a href="#pdf20" title="20 페이지로 이동합니다">13_한국어교육센터(한국어학당) 모집안내</a></li></ul></div><script src="/common/js/idino.pdf.js"></script>    
    <div id="IContents_divPdfViewer">
        <div class="cont embed-responsive"><iframe class="embed-responsive-item objPdf_10" id="pdf" src="/common/pdfjs/web/viewer.html?file=/upload/ansan/iphak/preferences/2027/MOZIP/0916164126635.pdf" title="0916164126635.pdf" allowfullscreen=""></iframe></div>        
        <script>
            window.onload = function () {
                fn_pdfviewer_init();
            }

            function fn_pdfviewer_init() {
                try {
                    var $outerContainer = $(".objPdf_10").contents().find("#outerContainer");
                    if (window.innerWidth < 992) {
                        if ($outerContainer.hasClass("sidebarOpen")) {
                            fn_set_btn_list_setting("close");
                        }
                        else {
                            fn_set_btn_list_setting("open");
                        }
                    }
                    else {
                        fn_set_btn_list_setting("close");
                        if ($outerContainer.hasClass("sidebarOpen")) { }
                        else {
                            fn_pdfviewer_toggle();
                        }
                    }

                    var $btn_list_toggle = $("#IContents_btnListToggle");
                    $btn_list_toggle.removeClass("d-none");

                    var $pdfviewer_btn_obj = $(".objPdf_10").contents().find("#sidebarToggle");
                    $pdfviewer_btn_obj.attr("onclick", "return parent.fn_set_btn_list_setting_frame();");
                } catch (e) { }
            }

            function fn_pdfviewer_toggle() {
                var $outerContainer = $(".objPdf_10").contents().find("#outerContainer");
                if ($outerContainer.hasClass("sidebarOpen")) {
                    fn_set_btn_list_setting("open");
                }
                else {
                    fn_set_btn_list_setting("close");
                }

                var $pdfviewer_btn_obj = $(".objPdf_10").contents().find("#sidebarToggle");
                $pdfviewer_btn_obj.removeAttr("onclick");
                $pdfviewer_btn_obj.click();
                $pdfviewer_btn_obj.attr("onclick", "return parent.fn_set_btn_list_setting_frame();");
            }

            function fn_set_btn_list_setting_frame() {
                var $outerContainer = $(".objPdf_10").contents().find("#outerContainer");
                if ($outerContainer.hasClass("sidebarOpen")) {
                    fn_set_btn_list_setting("close");
                }
                else {
                    fn_set_btn_list_setting("open");
                }

                return false;
            }
            function fn_set_btn_list_setting(gubun) {
                var $btn_list_toggle = $("#IContents_btnListToggle");
                if (gubun == "open") {
                    $btn_list_toggle.attr("title", "목차열기");
                    $btn_list_toggle.html("<img src='/common/images/pdf-ico01-w.png' alt='' aria-hidden='true' class='mr-2'>목차열기");
                }
                else if (gubun == "close") {
                    $btn_list_toggle.attr("title", "목차닫기");
                    $btn_list_toggle.html("<img src='/common/images/pdf-ico02-w.png' alt='' aria-hidden='true' class='mr-1'>목차닫기");
                }
                else {
                    if ($btn_list_toggle.hasClass("d-none")) { }
                    else {
                        $btn_list_toggle.addClass("d-none");
                    }
                }
            }
        </script>
    </div>
    

                        
                        
                        
