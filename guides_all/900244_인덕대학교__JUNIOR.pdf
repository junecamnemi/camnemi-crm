select {
    display: inline-block;
    box-sizing: border-box;
    width: 160px !important;
    height: 45px;
    line-height: 43px;
    border: 1px solid #fff;
    border-bottom-right-radius: 5px;
    background: url('/resources/template/A/img/searchBox_icon1.png') no-repeat right center;
    padding-left: 14px;
    overflow: hidden;
    cursor: pointer;
    color: #fff;
    font-size: 14px;
    text-align: left;
}

option {
    display: block;
    padding: 4px 15px;
    text-align: left;
    color: #555;
}


select::-ms-expand{
    display: none;
}

