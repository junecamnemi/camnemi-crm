<script type="text/javascript">
    var dataLength=0;
    var flagCheck = "";
    
    $(document).ready(function(){
        $("#SEARCH_TEXT").text("모집요강 통합검색");

        
        $("[name='LIST_GB']").val("Y");
        
        
        fn_init();
        

        
    });

    /*학부, 학과 리스트*/
    function fn_orgList(orgPcd, orgCd){
        fn_comm_ajax({
            url: "/ajax/CM_BB01_SVC/CM_BB01_ORG.do",
            dataType: "json",
            data: {
                FC_ORG_PCD : orgPcd,
                FC_ORG_CD : orgCd
            },
            success: function(data) {
                $("[name='FC_ORG_CD']").html('<option value="">학과</option>');
                if(orgPcd == null || orgPcd == ''){
                    $("[name='FC_ORG_PCD']").html('<option value="">학부</option>');
                    $("[name='FC_ORG_PCD']").fn_comm_makeSelect({
                        data : data,
                        jsonName : "ORG_PCD",
                        jsonValue : "ORG_PNM"
                    })
                }else{
                    $("[name='FC_ORG_CD']").fn_comm_makeSelect({
                        data : data,
                        jsonName : "ORG_CD",
                        jsonValue : "ORG_NM"
                    })
                }
            }
        });
    }

    function fn_init(){
        $("#contents").addClass("board");
        
        $("#schfrm").fn_comm_setFromCookie("CM_BB01_169");
        fn_R00();
    };
    
    function fn_R00(){
        fn_comm_ajax({
            url: "/ajax/CM_BB01_SVC/CM_BB01_R00.do", 
            dataType: "json",
            data: $("#schfrm").serialize() + "&MENU_SN=169",
            success: function(data) {
                dataLength = data.length;
                
                $("#tbody").empty();
                
                if($("[name='pageNo']").val()=="1") {
                    fn_comm_setList("#tbody", data, "#listTemplate", null);
                }
                
                fn_R01();
            }
        });
    };
    
    function fn_R01(){
        fn_comm_ajax({
            url: "/ajax/CM_BB01_SVC/CM_BB01_R01.do", 
            dataType: "json",
            data: $("#schfrm").serialize()+"&paginationJsFunction=linkPage&MENU_SN=169",
            pageId:"CM_BB01_169",
            success: function(data) {
                fn_comm_setList2("#tbody", data, "#listTemplate", null, null, "#ul_pagination");
                
                if(data.list.length==0&&dataLength==0) {
                    $("#noData").show();
                }else{
                    $("#noData").hide();
                }
            }
        });
        
    };
    
    fn_comm_setList2 = function(parentId, data, dataTemplateId, noDataTemplateId, rowCountId, paginationId) {
        var isPaging = !fn_comm_isNull(paginationId);
        var list = null;
        if (isPaging) {
            list = data.list;
        } else {
            list = data;
        }
        
        if($("[name='pageNo']").val()!="1") {
            $(parentId).empty();
        }
        if (list==null || list.length==0) {
            if (rowCountId) {
                $(rowCountId).text(0);
            }
            if (noDataTemplateId) {
                $(noDataTemplateId).tmpl({}).appendTo(parentId);
            }
            if (isPaging) {
                $(paginationId).html("");
            }
            return;
        }

        if (rowCountId) {
            var cnt = 0;
            if (isPaging) {
                var cntVal = String(list[0]["__CNT__"]);
                if(! fn_util_isEmpty(cntVal)) cnt = Number(cntVal);
            } else {
                cnt = list.length;
            }
            cnt = fn_util_makeComma(cnt);
            $(rowCountId).text(cnt);
        }
        for (var idx=0; idx<list.length; idx++) {
            var dataObj = list[idx];
            if (isPaging) {
                dataObj.rownum = dataObj["__RNUM__"];
            } else {
                dataObj.rownum = (idx+1);
            }
        }
        $(dataTemplateId).tmpl(list).appendTo(parentId);
        if (isPaging) {
            var pagination = fn_comm_processScalarAjax({
                url : contextPath + "/CM_CM03_CON/CM_CM03_R01.do",
                data : {
                    currentPageNo : data.currentPageNo,
                    totalRecordCount : data.totalRecordCount,
                    recordCountPerPage : data.recordCountPerPage,
                    templateCd : templateCd,
                    templatePath : templatePath
                }
            });
            $(paginationId).html(pagination);
        }
    };
    
    // 페이지 이동
    function linkPage(pageNo){
        $("#schfrm [name='pageNo']").val(pageNo);
        fn_R00();
    }
    
    
    function fn_allDown(sn) {
        fn_comm_ajax({
            url: "/ajax/CM_BB01_SVC/FILE_ALL_DOWN.do", 
            dataType: "json",
            data: {"BBS_SN":sn},
            success: function(data) {
                for(var idx=0;idx<data.length;idx++) {
                    window.open("/ajax/CM_BB01_SVC/CM_BB01_R97.do?TABLE_ID=AP_BBS&PK_COL="+sn+"&ATCH_SN="+data[idx].ATCH_SN+"&isTemp=false",idx,"");
                }
            }
        });
    }
    
    function fn_zipDown(sn) {
        window.open("/ajax/CM_BB01_SVC/FILE_ZIP.do?MENU_SN=169&BBS_SN=" + sn ,"TEST","");
    }
    
    function fn_rowClick(sn, code, flag) {
        fn_comm_ajax({
            url: "/ajax/CM_BB01_SVC/CM_BB01_R82.do", 
            dataType: "json",
            data: {"BBS_SN":sn,"MENU_SN":"169"},
            success: function(data) {
                
                if(data.READ_GB=="Y") {
                    if(flag=="F") {
                        fn_fileDown(sn, code);
                    }else{
                        if(code=="1") {
                            location.href="CM_BB01_V01.do?MENU_SN=169&BBS_SN=" + sn ;
                        }else{
                            location.href="CM_BB01_V01.do?MENU_SN=169&BBS_SN=" + sn + "&" + $("#schfrm").serialize();
                        }
                    }
                }else{
                    flagCheck = flag;
                    
                    $("#frm_popup [name='BBS_SN']").val(sn);
                    
                    $("#pop_pw").show();
                    
                    $("#BBS_PW").focus();
                }
                
            }
        });
    }
    
    function fn_submitPass() {
        fn_comm_ajax({
            url: "/ajax/CM_BB01_SVC/CM_BB01_R80.do", 
            dataType: "json",
            data: $("#frm_popup").serialize(),
            success: function(data) {
                if(data.PASS=="Y") {
                    if(flagCheck=="F") {
                        fn_fileDown(sn, code);
                    }else{
                        location.href="CM_BB01_V01.do?MENU_SN=169&BBS_SN=" + $("#frm_popup [name='BBS_SN']").val()
                            + "&ATTR_SN=1";
                    }
                }else{
                    alert("비밀번호를 확인하세요.");
                    $("#BBS_PW").val("");
                }
            }
        });
    }
    
    function closePop() {
        $("#frm_popup [name='BBS_PW']").val("");
        $("#frm_popup [name='BBS_SN']").val("");
        $("#pop_pw").hide();
    }
    
    function fn_tabList() {
        // 매개변수로 어떤 탭 볼 건지를 받았으면 해당 탭 선택 처리
        if(! fn_util_isEmpty("")) {
            $("[name='tabs']").removeClass("active").removeClass('on');
            $("[name='tabs'][data-cd='']").addClass("active on");
            
            $("[name='FC_CATEGORY_CD']").val("");
        }
    }
    
    function fn_tabClick(obj, cd) {
        $("[name='tabs']").removeClass("active on");
        $(obj).addClass("active on");
        
        $("[name='FC_CATEGORY_CD']").val(cd);
        
        linkPage(1);
    }
    
    function fn_fileDown(sn, cnt) {
        if(cnt > 1) {
            fn_zipDown(sn);
        }else{
            fn_allDown(sn);
        }
    }
</script>
