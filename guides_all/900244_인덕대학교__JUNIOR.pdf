<script type="text/javascript">
$(document).ready(function(){
    fn_quickmenu_R01();
});
function fn_quickmenu_click(type) { // 원서접수 버튼 클릭함
    alert('원서 접수 기간이 아닙니다.');
    // return false;
}
function fn_quickmenu_R01() {
    fn_comm_ajax({
        url: "/ajax/CM_MN02_SVC/CM_MN02_R12.do",
        dataType: "json",
        data: {
            DOMAIN_SN:'1',
            INFO_DIV_CD:'F1',
            USE_AT:'Y'
        },
        async:true,
        success: function(data, textStatus, jqXHR) {
            // console.log(data);
            if(data == null || $.isEmptyObject(data)) {
                $("#quick").hide();
                return;
            }
            $("#quick").show().empty();
            for(var idx=0; idx<data.length; idx++) {
                data[idx].PATH = data[idx].INFO_CN;
                $("#sidebar_template").tmpl(data[idx]).appendTo("#quick");
            }
        }
    });
}
function fn_quickmenu_applyLink(url) {
    var today = fn_CM_getTime();
	var fromDt = new Date(2017, 0, 3);
    var toDt   = new Date(2017, 0, 13);
    fromDt.setHours(9, 0, 0, 0);
    toDt.setHours(20, 0, 0, 0);
    var result = fn_util_linkFrom(url, true, fromDt, toDt, today);
    if(! result) alert('원서접수 기간이 아닙니다.');
}
</script>
<a href="#quick" id="quick_btn">퀵메뉴</a>
<ul id="quick">
