<script type="text/javascript">
/**
 * 푸터 링크 동작을 처리합니다.
 */
function fn_footer_open(url) {
    if($.isEmptyObject(url)) return;
    if(url == '#') return;
    url = fn_util_replaceAll(url, "__CMS_INDUK_URL__", "http://www.induk.ac.kr");
    url = fn_util_replaceAll(url, "__CMS_INDUK_IPSI_URL__", "http://ipsi.induk.ac.kr");
    if(fn_footer_needOpenPop(url)) {
        window.open(url);
        return;
    }
    location.href = url;
}
/**
 * URL을 받아 이 URL을 팝업으로 띄울지 현재 화면에서 띄울지를 판별해 true / false 로 반환합니다.
 */
function fn_footer_needOpenPop(url) {
    // 파일을 직접 가리키는 경우 무조건 팝업
    if(fn_util_endsWith(url, ".pdf"))  return true;
    if(fn_util_endsWith(url, ".xls"))  return true;
    if(fn_util_endsWith(url, ".xlsx")) return true;
    if(fn_util_endsWith(url, ".doc"))  return true;
    if(fn_util_endsWith(url, ".docx")) return true;
    if(fn_util_endsWith(url, ".ppt"))  return true;
    if(fn_util_endsWith(url, ".pptx")) return true;
    if(fn_util_endsWith(url, ".hwp"))  return true;
    if(fn_util_endsWith(url, ".xps"))  return true;
    if(fn_util_endsWith(url, ".zip"))  return true;
    
    // 도메인 내 화면이면 팝업 아님
    var domainWithContext = "/IPSI";
    if(url.indexOf(domainWithContext) == 0) return false;
    return true;
}
</script>
