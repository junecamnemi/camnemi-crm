<script type="text/javascript">

var menuDivTemplates = {
    CN : {HREF_TEMPLATE : null, ONCLICK_TEMPLATE : null}

,
LN : {HREF_TEMPLATE : "{%=HREF%}", ONCLICK_TEMPLATE : null}

,
PU : {HREF_TEMPLATE : "#", ONCLICK_TEMPLATE : function(metadata){ window.open(metadata.HREF); return false; }}

,
IF : {HREF_TEMPLATE : null, ONCLICK_TEMPLATE : null}

,
BB : {HREF_TEMPLATE : null, ONCLICK_TEMPLATE : null}

,
PG : {HREF_TEMPLATE : null, ONCLICK_TEMPLATE : null}

,
ME : {HREF_TEMPLATE : null, ONCLICK_TEMPLATE : null}


}

// 각 메뉴 검사해서 메뉴구분(MENU_DIV)에 따라 이벤트 변경
function fn_cms_processMenu() {
    var $menu1LvElement = $("#gnb>li>a[target!='_blank']");
    $(".menu_element").each(function(){
        var $this = $(this);
        var is1Lv = $this.is("#gnb>li>a[target!='_blank']") && $this.next('ul').find('li').length >= 1;
        
        $.each(menuDivTemplates, function(key, val){
            if(! $this.is(".menu_" + key)) return;
            
            var replaceData = {};
            replaceData.HREF = $this.attr('href');
            replaceData.MENU_DIV = key;
            replaceData.CONTEXT_PATH = '';
            
            $(this).off('click');
            
            if(! is1Lv) {
                if(val.HREF_TEMPLATE != null) $this.attr('href', fn_cms_replaces(val.HREF_TEMPLATE, replaceData));
                if(val.ONCLICK_TEMPLATE != null) $this.on('click', function(){fn_util_removeAllCookies("PAGE_", "/"); return val.ONCLICK_TEMPLATE(replaceData)});
                $this.on('click', function(){fn_util_removeAllCookies('PAGE_');});
            }
        });
        
        if($this.is("#gnb>li>a[target!='_blank'].menu_LN")) {
            $this.off('click');
        }
    });
}
function fn_cms_replaces(targetStr, data) {
    targetStr = fn_util_replaceAll(targetStr, '{%=HREF%}', data.HREF);
    targetStr = fn_util_replaceAll(targetStr, '{%=CONTEXT_PATH%}', data.CONTEXT_PATH);
    return fn_util_replaceAll(targetStr, '{%=MENU_DIV%}', data.MENU_DIV);
}
$(document).ready(function(){
    fn_cms_processMenu();
});
</script>
