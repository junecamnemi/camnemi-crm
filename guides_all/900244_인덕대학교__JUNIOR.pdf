<form id="schfrm" onsubmit="linkPage(1); return false;">
    <input type="hidden" name="pageNo" value="1"/>
    <input type="hidden" name="recordCountPerPage" value="15"/>
    <input type="hidden" name="FC_CATEGORY_CD" value=""/>
    <input type="hidden" name="LIST_DIV" value="1"/>
    <input type="hidden" name="LIST_GB" value=""/>
    <input type="hidden" name="ATTR_SN"  value=""/>

    <fieldset id="searchBox">
        <legend id="SEARCH_TEXT"></legend>
        
        <span class="w">
            <select title="검색어 분류" name="FC_SEARCH_GB">
                <option value="ALL">전체</option>
                <option value="SJ">제목</option>
                <option value="ID">작성자</option>
            </select>
        </span>
        <select title="검색어 분류" name="FC_SEARCH_GB_M" class="m">
            <option value="ALL">전체</option>
            <option value="SJ">제목</option>
            <option value="ID">작성자</option>
        </select>
        <input type="text" name="FC_SEARCH_CONTENTS" placeholder="검색어를 입력하세요." value="" title="검색어를 입력하세요." />
        <button title="검색">검색</button>
    </fieldset>
</form>
<table class="listTable">
    <caption>제출서류서식 리스트</caption>
    <colgroup>
        <col width="8%"  class="w" />
        
        <col width="*"             />
        
        <col width="7%"  class="w" />
        
        
        <col width="9%"  class="w" />
        <col width="12%" class="w" />
        <col width="8%"  class="w" />
    </colgroup>
    <thead class="w">
        <tr>
            <th scope="col">번호</th>
            
            <th scope="col">제목</th>
            
            <th scope="col">첨부파일</th>
            
            
            <th scope="col">등록자</th>
            <th scope="col">등록일</th>
            <th scope="col">조회수</th>
        </tr>
    </thead>
    <tbody id="tbody"></tbody>
    <script type="text/x-jquery-tmpl" id="listTemplate">
        <tr {%if BBS_DIV=="NT"&&CODE=="1"%}class="notice"{%/if%}>
            <td class="w" style="text-align:center;">{%if BBS_DIV=="NT"&&CODE=="1"%}공지{%else%}{%= rownum %}{%/if%}</td>
            {%if ORG_CD != null %}
            <td class="w" style="text-align:center;">{%= ORG_NM %}</td>
            {%/if%}
            <td class="al" title="{%= SJ_VIEW %}">
                {%if LVL>0%}
                <img src="/resources/template/A/img/bu_view_blue.png" alt="답변" title="답변"/>
                {%/if%}
                {%if SECRET_AT=="Y"%}
                <i title="비밀글" class="icon_secret">비밀글</i>
                {%/if%}
                <a href="javascript:fn_rowClick('{%= BBS_SN %}','{%= CODE %}', 'V');">
                    
                    {%= SJ_VIEW %}
                    
                    {%if NEWRECORD=="Y"%}
                    <i title="새글" class="icon_new" style="margin-top:0px;">새글</i>
                    {%/if%}
                    
                </a>
            </td>
            
            <td class="w">
                {%if FILE_CNT>0%}
                    <img src="/resources/template/A/img/icon_file2.png" alt="첨부파일" title="첨부파일" onclick="fn_rowClick({%= BBS_SN %}, '{%= FILE_CNT %}', 'F');" style="cursor:pointer;"/>
                {%/if%}
            </td>
            
            
            <td class="w">{%= USER_NM %}</td>
            <td class="w">{%= REG_DT %}</td>
            <td class="w">{%= READ_CNT %}</td>
        </tr>
    </script>
    <script type="text/x-jquery-tmpl" id="noListTemplate">
        <tr>
            <td class="no_data" colspan="5">등록된 게시물이 없습니다</td>
        </tr>
    </script>
</table>
<div class="data_none" style="display:none;" id="noData">
    등록된 게시물이 없습니다.
</div>

<div class="paging" id="ul_pagination"></div>


