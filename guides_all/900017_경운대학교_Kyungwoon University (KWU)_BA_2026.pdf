		/* 헤더 스크롤 시 배경 전환 */
		var $h = $('#ip-header');
		function onScroll(){ if(window.pageYOffset > 60){ $h.addClass('is-fixed'); } else { $h.removeClass('is-fixed'); } }
		$(window).on('scroll', onScroll); onScroll();

		/* 드롭다운(언어/셀렉트/관련링크) 토글 */
		$(document).on('click', '.ip-lang-btn, .ip-sel-btn, .ip-rel > .ip-footer-btn', function(e){
			e.preventDefault();
			var $p = $(this).parent();
			$('.ip-lang, .ip-sel, .ip-rel').not($p).removeClass('open');
			$p.toggleClass('open');
		});
		$(document).on('click', function(e){
			if(!$(e.target).closest('.ip-lang, .ip-sel, .ip-rel').length){ $('.ip-lang, .ip-sel, .ip-rel').removeClass('open'); }
		});

		/* 전체메뉴 : PC(>1200) 사이트맵 이동 / 모바일(<=1200) 드로어 */
		var $mnav = $('#ipMnav');
		function openMnav(){ $mnav.addClass('open').attr('aria-hidden','false'); $('body').addClass('mnav-open'); }
		function closeMnav(){ $mnav.removeClass('open').attr('aria-hidden','true'); $('body').removeClass('mnav-open'); }
		$('.ip-ico-menu').on('click', function(e){
			if(window.innerWidth <= 1200){ e.preventDefault(); openMnav(); }
		});
		$mnav.on('click', '.ip-mnav-close, .ip-mnav-dim', function(){ closeMnav(); });
		$mnav.on('click', '.ip-mnav-toggle', function(){
			var $item = $(this).closest('.ip-mnav-item');
			var open = $item.toggleClass('open').hasClass('open');
			$(this).attr('aria-expanded', open);
		});
		$(document).on('keydown', function(e){ if(e.key === 'Escape'){ closeMnav(); } });
		$(window).on('resize', function(){ if(window.innerWidth > 1200){ closeMnav(); } });

		/* 통합검색 레이어 */
		var $ipSearch = $('#ipSearch');
		function openSearch(){
			closeMnav();
			$ipSearch.addClass('open').attr('aria-hidden','false');
			setTimeout(function(){ $ipSearch.find('.ip-search-input').focus(); }, 300);
		}
		function closeSearch(){ $ipSearch.removeClass('open').attr('aria-hidden','true'); }
		$('.ip-ico-search').on('click', function(e){ e.preventDefault(); openSearch(); });
		$ipSearch.on('click', '.ip-search-close, .ip-search-dim', function(){ closeSearch(); });
		$(document).on('keydown', function(e){ if(e.key === 'Escape'){ closeSearch(); } });
		$ipSearch.find('.ip-search-form').on('submit', function(){
			if($.trim($(this).find('.ip-search-input').val()) === ''){
				alert('검색어를 입력해주세요.');
				$(this).find('.ip-search-input').focus();
				return false;
			}
		});

		/* TOP 버튼 */
		$('.ip-top').on('click', function(){ $('html,body').animate({scrollTop:0}, 400); });
	});
</script>

</body>

	<script>
	function setCookie( name, value, expiredays ) {
		var todayDate = new Date();
			todayDate.setDate( todayDate.getDate() + expiredays );
			document.cookie = name + "=" + escape( value ) + "; path=/; expires=" + todayDate.toGMTString() + ";"
	}
    function openWin(div) {
		$('#'+div).addClass('active');
	}

	function closeWin(div, chk, cookname) {
		if ( document.getElementById(chk).checked ){
			setCookie(cookname, "done", 1);
		}
		$('#'+div).removeClass('active');
	}

	// SNS 공유하기
	$('.page_info .btns').snsshare({
        data:{
            domain:document.location.host,
            url:document.location.href,
            desc : '입학 홈페이지 &gt; 외국인 &gt; 모집요강'
        },
        key:{
            kakao:'23ecf8a84ca2ad8e550dc399b3776e81'
        }
    });
	</script>

	<form id="fileUploadForm" method="post" enctype="multipart/form-data" action="" class="none">
		<input type="file" name="uploadFiles" id="uploadFiles" />
		<input type="hidden" name="uploadType" id="uploadType" value="" />
		<input type="hidden" name="fileId" id="fileId" />
		<input type="hidden" name="isDbSave" id="isDbSave" />
		<input type="hidden" name="vodYn" id="vodYn" />
	</form>
</html>