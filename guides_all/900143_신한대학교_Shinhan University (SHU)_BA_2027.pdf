	<script>
	function openipsi(evt, cityName)
	{
		var i, tabcontent, tablinks;
		tabcontent = document.getElementsByClassName("ipsi_list");
		for (i = 0; i < tabcontent.length; i++) {
			tabcontent[i].style.display = "none";
		}
		tablinks = document.getElementsByClassName("ipsi_con");
		for (i = 0; i < tablinks.length; i++) {
			tablinks[i].className = tablinks[i].className.replace(" on", "");
		}
		document.getElementById(cityName).style.display = "block";
		evt.currentTarget.className += " on";
	}
	
	
	
	
	function gomenupage(menuNo)
	{
		
		var gourl = "/gomenucontroll.do;jsessionid=1BB34D199EA5B70C985E1357EDD90A44.server2?menuNO="+menuNo;
		
	
		if(menuNo > 10500000){
			window.open(gourl)
		}else{
			location.href = gourl;
		}
		
		//location.href = gourl;
		///location.replace(gourl);
		///"/gomenucontroll.do?menuNO="+menuNo;
		}
		
		
		
		
	
	$(document).ready(function() {
		var numClick = 1; // 셀렉트 박스 클릭상태 확인
		$('.selected_tit').parent().click(function(e) {
			// 클릭시 링크 이동 방지
			e.preventDefault();
			e.returnValue = false;
	
			// 선택목록 표시
			numClick += 1;
			if (numClick % 2 != '1') { // 홀수, 짝수로 구분
				document.getElementById('selectbox').style.display = 'block';
			} else {
				document.getElementById('selectbox').style.display = 'none';
			}
		});
		$('#selectbox li a').click(function(e) {
			// 클릭시 링크 이동 방지
			e.preventDefault();
			e.returnValue = false;
	
			// 목록 선택시 텍스트 전달
			var selectText = $(this).text();
			$('.selected_tit').text(selectText);
		});
	});
	
	</script>
	
