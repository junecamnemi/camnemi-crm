<script type="text/javascript">
var cookiedata = document.cookie;

for (i = 0; i < 10; i++){
	var el = document.getElementById("layerPopup" + i);
	if(el) {
		if (cookiedata.indexOf("layerPopup" + i + "=done") > -1) {
			el.style.display = "none";
		} else el.style.display =" block";
	}
}
</script>

