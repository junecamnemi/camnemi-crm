<script>
	document.addEventListener('DOMContentLoaded', function () {
	  let triggered = false;
	  let lastScrollTop = window.pageYOffset || document.documentElement.scrollTop;
	  let allowTrigger = false;

	  const topPopupEl = document.querySelector('.topPopup');

	  // 사용자가 스크롤을 시작한 이후에만 이벤트를 활성화
	  window.addEventListener('scroll', function initUserScroll() {
		allowTrigger = true;
		window.removeEventListener('scroll', initUserScroll);
	  });

	  function handleScroll() {
		if (!allowTrigger || triggered) return;

		const currentScroll = window.pageYOffset || document.documentElement.scrollTop;

		// 팝업 실제 높이를 기준값으로 사용 (팝업을 다 지나친 뒤에 사라짐)
		const popupHeight = topPopupEl ? topPopupEl.offsetHeight : 100;
		const threshold = Math.max(popupHeight - 40, 60); // 살짝 여유를 둠

		// 아래로 스크롤한 경우만 동작
		if (currentScroll > lastScrollTop && currentScroll >= threshold) {
		  document.querySelector('.topPopup')?.classList.add('hidden');
		  document.querySelector('.headerTop')?.classList.add('active');
		  
		  const layerPopup = document.getElementById('layerPopup6');
		  if (layerPopup) {
			layerPopup.style.top = '133px';
		  }
		  
		  triggered = true;
		}

		lastScrollTop = currentScroll <= 0 ? 0 : currentScroll;
	  }

	  window.addEventListener('scroll', handleScroll);

	  // 팝업 보기 버튼 클릭 시 다시 보이기
	  const popupToggleBtn = document.querySelector('.topPopupShow');
	  if (popupToggleBtn) {
		popupToggleBtn.addEventListener('click', function () {
		  document.querySelector('.topPopup')?.classList.remove('hidden');
		  document.querySelector('.headerTop')?.classList.remove('active');
		  
		  const layerPopup = document.getElementById('layerPopup6');
		  if (layerPopup) {
			layerPopup.style.top = '645px';
		  }
		  
		  triggered = false;
		  lastScrollTop = window.pageYOffset || document.documentElement.scrollTop;
		});
	  }
	});
</script>
