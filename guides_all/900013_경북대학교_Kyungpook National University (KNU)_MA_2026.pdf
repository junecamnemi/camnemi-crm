							<script type="text/javascript">
function formSubmit()
   {     

	  // 폼 전송 함수

	  formSubmit = function () {

		 fncEnCode( document .getElementById("UserName_client").value);



		 /** 모바일 기기에 대해서 전송 변경 처리 시작 **/

		 if ( navigator.userAgent.match(/Android|Mobile|iP(hone|od|ad)|BlackBerry|IEMobile|Kindle|NetFront|Silk-Accelerated|(hpw|web)OS|Fennec|Minimo|Opera M(obi|ini)|Blazer|Dolfin|Dolphin|Skyfire|Zune/)

		   ){

			document.getElementById("SubmitForm").action = "https://knu.eduwill.net/m/member/loginSSOCheck.will";

			}

		 /** 모바일 기기에 대해서 전송 변경 처리 끝 **/

		 document.getElementById("SubmitForm").submit();

	  }          

	  // 회원명 인코딩 처리

	  fncEnCode = function(param) {

		 var encode = '';

		 for (i = 0; i< param.length; i++){

			var len   = '' + param.charCodeAt(i);

			var token = '' + len.length;

			encode += token + param.charCodeAt(i);

		 }

		 document.getElementById("UserName").value = encode;

	  }

	  // 폼 전송 실행

	  formSubmit();

	  

   }
   function login_go_layer(url){
		if(confirm("로그인 후 이동 가능합니다. 로그인 하시겠습니까?")){	
			//window.open("https://my.knu.ac.kr/stpo/comm/support/loginPortal/loginForm.action?redirUrl="+url);
			location.href = "https://home.knu.ac.kr/sso/business.php";
		}else{
			return;
		}
		
	}
</script>

