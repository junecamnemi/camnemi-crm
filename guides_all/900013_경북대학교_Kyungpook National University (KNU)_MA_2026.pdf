			<script>
			function onDeptShow(str,n) {
				for(i=1;i<=10;i++) {
					if(document.getElementById('mdept-'+str+'-'+i) != null) {
						if(n == i) {
							$('#mdept-m'+str+'-'+i).attr('class','on');
							document.getElementById('mdept-'+str+'-'+i).style.display = '';
						}else{
							$('#mdept-m'+str+'-'+i).attr('class','');
							document.getElementById('mdept-'+str+'-'+i).style.display = 'none';
						}
					}
				}

			}
			</script>
