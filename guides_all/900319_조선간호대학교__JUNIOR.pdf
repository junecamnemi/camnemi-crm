<link href="/assets/css/popup_zone.css?v=1" type="text/css" rel="stylesheet">

<script>
$(function() {
//팝업 열고 닫기
	$("#left_area .popup").click(function(){
		$("#popup_wrap2").stop().fadeIn(400);
		return false;
	});

	$("#popup_wrap2 .close").click(function(){
		$("#popup_wrap2").stop().fadeOut();
		return false;
	});
    var page_type = "main";
    if(page_type == 'main'){
        if (get_cookie('header_pop') == 'Y') {
            $('#popup_wrap2').hide();
        }else{
			//show면 처음에 들어왔을때 팝업 실행
			//hide면 처음에 들어와두 팝업  안뜸
            $('#popup_wrap2').show();
        }
    }
    else{
        $('#popup_wrap2').hide();
    }
	
	 var popzoneSwiper = new Swiper('#popupzone_box', {
        freeMode: false,
        slidesPerView: 3,
        speed: 1500,

		navigation: {
		  nextEl: '#popupzone_box_next',
		  prevEl: '#popupzone_box_prev',
		},
		observer: true,
		observeParents: true,
        centeredSlidesBounds: true,
        updateOnWindowResize: true,
        autoplay: {
            delay: 3000,
        },
		  pagination: {
			el: '.swiper-pagination',
			clickable: true,
			renderBullet: function (index, className) {
				return '<li class="' + className + '"><a href="#" ></a></li>';
			  
			},
		  },
		breakpoints: {
				1: {
			 slidesPerView: 1,
		   },
			500: {
			 slidesPerView: 1,
		   },
			650: {
			 slidesPerView: 2,
		   },
			 890: {
			 slidesPerView: 3,
		   },
			
		},
        loop: false,
    });

});

 //팝업닫기 이벤트
function set_close() {
  set_cookie('header_pop', 'close', 1);
  set_cookie('header_pop', 'Y', 1);
  $("#popup_wrap2").stop().fadeOut();
  return false;
}

//쿠기설정
function set_cookie(name, value, exp){
	var date = new Date();
	date.setTime(date.getTime() + exp*24*60*60*1000);
	document.cookie = name + '=' + value + ';expires=' + date.toUTCString() + ';path=/';
}

//쿠키가져오기
function get_cookie(name){
	var value = document.cookie.match('(^|;) ?' + name + '=([^;]*)(;|$)');
	return value? value[2] : null;
}
</script>
