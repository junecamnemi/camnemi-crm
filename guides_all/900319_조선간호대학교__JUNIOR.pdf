<script>
let pre_video, work_video
$(function() {
	/*
	document.getElementById('a_video7').addEventListener('loadedmetadata', function() {
	  this.currentTime = 0;
	}, false);*/

	var visual_point = $("#visual_pagination span");
	var visual_list = new Swiper("#visual_wrap", {
		speed: 1500, //속도
		autoplay: { //자동슬라이드 (false-비활성화)
			delay: 10000, // 시간 설정
			disableOnInteraction: false, // false-스와이프 후 자동 재생
		},
		touchRatio: 0,
		effect: "fade",
		fadeEffect: {
			//페이드 기능 정의
			crossFade: true //뒤에 배경이 서서히 사라지면서 나올지 여뷰
		},
		freeMode: false,
		observeParents: false,
		centeredSlidesBounds: false,
		updateOnWindowResize: true,
		observer: false,
		loop: false,
		navigation: {
			nextEl: '#visual_next', //다음 버튼 id 값
			prevEl: '#visual_prev', //이전 버튼 id 값
		},
		pagination: {
			el: '#visual_pagination'
		},
		on: {
			init: function() {
				
				
				var idx = this.activeIndex - 1;
				var myVideo = document.getElementById("a_video0");
				if(pre_video){
					pre_video.load();
					pre_video.pause();
					pre_video = null;
				}
				else{
					work_video = $(this.slides[this.activeIndex]).find('video')[0];
					if(work_video !== undefined){
						pre_video = $(this.slides[this.activeIndex]).find('video')[0];
						work_video.play();
					}
				}

				$('.swiper-slide-active .pc_visual .visual_txt2').css('opacity',0);

					
				$('.swiper-slide-active .pc_visual img').css('height','120%');
				 $('.swiper-slide-active .pc_visual img').animate( {
					height: '100%'
				  }, 1500, 'swing' );


				  $('.swiper-slide-active .pc_visual img').animate( {
					height: '100%'
				  }, 1500, 'swing' );

				

				$('.swiper-slide-active .pc_visual .visual_txt2').css('top','25%');
				 $('.swiper-slide-active .pc_visual .visual_txt2').animate( {
					top: '20%',
					opacity: 1,
					display: 'block',
				  }, 500, 'swing' );


					$('.swiper-slide-active .mo_visual .visual_txt2').css('opacity',0);
				$('.swiper-slide-active .mo_visual img').css('height','120%');
				 $('.swiper-slide-active .mo_visual img').animate( {
					height: '100%'
				  }, 1500, 'swing' );


				  $('.swiper-slide-active .mo_visual img').animate( {
					height: '100%'
				  }, 1500, 'swing' );

				

				$('.swiper-slide-active .mo_visual .visual_txt2').css('top','108px');
				 $('.swiper-slide-active .mo_visual .visual_txt2').animate( {
					top: '58px',
					opacity: 1,
					display: 'block',
				  }, 500, 'swing' );


					

			

			},
			slideChange: function() {
				var idx = this.activeIndex - 1;
				
				console.log(idx);
				if(pre_video){
					pre_video.load();
					pre_video.pause();
					pre_video = null;
				}
				work_video = $(this.slides[this.activeIndex]).find('video')[0];
				if(work_video !== undefined){
					pre_video = $(this.slides[this.activeIndex]).find('video')[0];
					work_video.play();
				}

				$('.swiper-slide-active .pc_visual .visual_txt2').css('opacity',0);


				setTimeout(() => {
					
					$('.swiper-slide-active .pc_visual img').css('height','120%');
					 $('.swiper-slide-active .pc_visual img').animate( {
						height: '100%'
					  }, 1500, 'swing' );


					  $('.swiper-slide-active .pc_visual img').animate( {
						height: '100%'
					  }, 1500, 'swing' );

					
				}, 500);

				setTimeout(() => {
					$('.swiper-slide-active .pc_visual .visual_txt2').css('top','25%');
					 $('.swiper-slide-active .pc_visual .visual_txt2').animate( {
						top: '20%',
						opacity: 1,
						display: 'block',
					  }, 500, 'swing' );
					
				}, 500);

				$('.swiper-slide-active .mo_visual .visual_txt2').css('opacity',0);


				setTimeout(() => {
					
					$('.swiper-slide-active .mo_visual img').css('height','120%');
					 $('.swiper-slide-active .mo_visual img').animate( {
						height: '100%'
					  }, 1500, 'swing' );


					  $('.swiper-slide-active .mo_visual img').animate( {
						height: '100%'
					  }, 1500, 'swing' );

					
				}, 500);

				setTimeout(() => {
					$('.swiper-slide-active .mo_visual .visual_txt2').css('top','108px');
					 $('.swiper-slide-active .mo_visual .visual_txt2').animate( {
						top: '58px',
						opacity: 1,
						display: 'block',
					  }, 500, 'swing' );
					
				}, 500);


			}
		},
	})
	
	$("#visual_pagination span").on('click', function(event) {
		event.preventDefault();
		var idx = $("#visual_pagination span").index(this);
		visual_list.slideTo(idx);
	});

	$("#visual_btn_playstop").click(function(){
		if($(this).hasClass('start') !== false){
			$(this).removeClass('start');
			visual_list.autoplay.stop();
		}
		else{
			$(this).addClass('start');
			visual_list.autoplay.start();
		}
		return false;
	});
});
</script>
