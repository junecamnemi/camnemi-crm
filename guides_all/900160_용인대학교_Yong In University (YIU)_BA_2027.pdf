<form name="header_form" id="header_form" >
<input type="hidden" name="first_search_word" id="first_search_word" />
</form>

<script>
$(function() {
    draw_main_menu();
    $("#h-search-btn").click(function(e){
        var word = $("#h_search_word").val().trim();
        if(!word) {
            alert("검색어를 입력해 주세요.");
            return false;
        }
        var form = document.header_form;
        form.first_search_word.value = word;
        form.action = "/search_result.do";
        form.submit();
    });

});

function draw_main_menu() {
    $.ajax({
        url: "/find_menu.ajax",
        type: "post",
        dataType: 'json',
        success: function(json) {
            switch(json.result.status) {
                case "success":
                    var target = $(".gnb-list");
                    var strHtml = "";
                    var data = json.result.menuList;
                    $(target).empty();
                    if( data ) {
                        var parent_id = 0;
                        var subMenu = false;
                        var subFirst = true;
                        for( var i=0; i < data.length; i++ )
                        {
                            if( data[i].menuDepth == 0) {
                                if( subMenu && !subFirst ) strHtml += '</ul>';
                                strHtml += '<li class="menu_'+i+'">';
                                parent_id = data[i].menuId;
                                strHtml += '<a href="#"><span>' + data[i].menuTitle + '</span></a>';
                                if( i<data.length &&  parent_id == data[i+1].parentId ) {subMenu = true; subFirst = true; continue; }
                                else strHtml += '</li>';
                            }
                            if( subMenu && subFirst) { strHtml += '<ul class="depth2">'; subFirst = false; }
                            if( data[i].menuDepth == 1 ) {
                                if( data[i].parentId == parent_id ) {
                                    strHtml += '<li><a href="'  + data[i].menuUrl + '" target="'+data[i].target+  '">' + data[i].menuTitle + '</a></li>';
                                    continue;
                                }
                            }
                        }
                        $(target).append(strHtml);


                        //1depth click
                      	var $gnb_1depth = $('#header .depth1'),
                      		$gnb_2depth = $('#header .gnb-wrap .depth2');
                      	$gnb_1depth.find('> li > a').on('click', function(){
                      		if(globalLayout == 'desktop'){  //desktop

                      		} else if(globalLayout == 'mobile'){  //mobile
                      			if(!$(this).parent().hasClass('is-active')){
                      				$gnb_1depth.find('> li').removeClass('is-active');
                      				$gnb_1depth.find('.depth2').slideUp(200);
                      				$(this).parent().addClass('is-active');
                      				$(this).siblings('.depth2').slideDown(200);
                      			}
                      		}
                      	})
                    }
                    break;
                case "fail":
                    break;
            }
        }
    });
}

function check_page(title)
{
    var url = "/find_pages.ajax";
    $.ajax({
        url: url,
        type: 'post',
        data: { title: title },
        dataType: 'json',
        success: function(json) {
            switch(json.result.status) {
                case "success":
                    var data = json.result.usePages;
                    var $page_list = $(".page-tab .inner li");
                    
                    //console.log("data: " + JSON.stringify(data,null,2));
                    if( data.length < $page_list.length ) {
                        $(".page-tab .inner").hide();
                        var j = 0;
                        for( var i=0; i<$page_list.length; i++) {
                           var page_txt = $page_list.eq(i).find('span').text();
                           var data_txt = data[j].menuTitle;
                           //console.log("page_txt: " + page_txt + " ,data_txt: " + data_txt);
                           if( page_txt == data_txt ) { if(j<(data.length-1)) j++; continue; }
                           $page_list.eq(i).remove();
                        }
                        $(".page-tab .inner").show();
                    }
                    break;
                case "fail":
                    break;
            }
        }
    });
}
