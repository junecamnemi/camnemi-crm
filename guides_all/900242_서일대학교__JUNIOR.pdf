<script>
	$(document).ready(function() {

		var fPopLength = 2;
		$('.fPopLength').text(fPopLength);

		$('.closeWin').on('click', function() {
			if($('#isToday').is(':checked')) {
				setCookie("isToday", "Y", 1);
			}
			$('.main_full_popup').hide();
		});

		$('.openFullPopup').on('click', function() {
			$(".main_full_popup").fadeIn();
			$('.full_popup .slider').slick('setPosition');
		});

		if($('.openFullPopup').css('display') != "none" && !$('body').hasClass('sub')) {
			if(getCookie("isToday") != "Y") {
				$('.main_full_popup').show();
			}
		}else{
			console.log("쿠키 : "+getCookie("isToday"));
			if(getCookie("isToday") == "Y") {
				$('.main_full_popup').hide();
			}
		}

		if(fPopLength == 0) {
			$('.main_full_popup').hide();
		}
	});

	// 쿠키 굽는 함수 //
	function setCookie(name, value, expiredays) {
		var todayDate = new Date();
		todayDate.setDate(todayDate.getDate() + expiredays);
		document.cookie = name + "=" + escape( value ) + "; path=/; expires=" + todayDate.toGMTString() + ";"
	}

	// 쿠키 얻어오는 함수
	function getCookie(name) {
		var nameOfCookie = name + "=";
		var x = 0;
		while ( x <= document.cookie.length )
		{
			var y = (x+nameOfCookie.length);
			if ( document.cookie.substring( x, y ) == nameOfCookie )
			{
				if ( (endOfCookie=document.cookie.indexOf( ";", y )) == -1 )
					endOfCookie = document.cookie.length;
					return unescape( document.cookie.substring( y, endOfCookie ) );
			}
			x = document.cookie.indexOf( " ", x ) + 1;
			if ( x == 0 )
				break;
		}
		return;
	}



/* icon banner */
function mobileOnlySlider() {
  $(".full_popup .slider").slick({
	slidesToShow: 3,
	slidesToScroll: 1,
	dots: false,
	arrows: true,
	responsive: [
	  {
		breakpoint: 800,
		settings: {
		  slidesToShow: 2,
		}
	  },
	  {
		breakpoint: 500,
		settings: {
		  slidesToShow: 1,
		}
	  }
	]
  });
}

if (window.innerWidth < 1000) {
  mobileOnlySlider();
}
$(window).resize(function (e) {
  if (window.innerWidth < 1000) {
	if (!$('.full_popup .slider').hasClass('slick-initialized')) {
	  mobileOnlySlider();
	}
  } else {
	if ($('.full_popup .slider').hasClass('slick-initialized')) {
	  $('.full_popup .slider').slick('unslick');
	}
  }
});


</script>



