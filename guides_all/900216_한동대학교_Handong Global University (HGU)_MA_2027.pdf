	});
	
	$(".d1").hover(function () {
		$("#head").addClass("on");
		$(".head .d1").removeClass("on");
		$(this).addClass("on");
	});
	
	$(".d1 .a1").focus(function () {
		$("#head").addClass("on");
		$(".head .d1").removeClass("on");
		$(this).parent().addClass("on");
	});

	$(".language").blur(function () {
		$("#head").removeClass("on");
		$(".head .d1").removeClass("on");
	});

</script>


