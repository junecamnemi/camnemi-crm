<script>
	$(document).ready(function(){
		if (window.innerWidth < 768)
		{
			$('.contents').css('height', 'auto');
		}
		else
		{
			$('.contents').css('height', window.innerHeight);
		}
	});
	$(window).resize(function(){
		if (window.innerWidth < 768)
		{
			$('.contents').css('height', 'auto');
		}
		else
		{
			$('.contents').css('height', window.innerHeight);
		}
	});
