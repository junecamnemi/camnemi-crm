<style>
.btn-box{position:absolute; right:30px; padding:0px;}
.btn-box .more-btn{display:flex;position:relative;width:75px;height:30px;padding:0 0 2px 2px; line-height:1;color:#fff;background:var(--primary);filter:drop-shadow(2px 8px 15px var(--primary))}
.btn-box .more-btn > span:nth-child(2){animation-delay:0.5s}
.btn-box .more-btn > span:nth-child(3){animation-delay:1s}
.btn-box .more-btn > span{position:absolute;left:0;top:0px;opacity:0;margin:0;width:100%;height:100%;border:1px solid rgba(250, 166, 26, 0.5); animation:active-circle 1.5s cubic-bezier(1, 2, 0.66, 3) infinite}
@keyframes active-circle{0%{-webkit-transform:scale(1);transform:scale(1);opacity:0.5}50%{opacity:1.0}100%{-webkit-transform:scale(1.2);transform:scale(1.2);opacity:0}}
.btn-1 {
	cursor:pointer;
	z-index:99999;
}
.btn-1:hover {
	background-color:#0FF;
	color:#FFF;
}
</style>

<Script>
	function openInNewTab(url) {
		if(url == '/') {
			$('.goog-te-combo').val('ko').trigger('selected');
			const gtcombo = document.querySelector('.goog-te-combo');
			gtcombo.value = 'ko';
			gtcombo.dispatchEvent(new Event('change'));
		}
		window.open(url, '_blank').focus();
	}
</Script>
