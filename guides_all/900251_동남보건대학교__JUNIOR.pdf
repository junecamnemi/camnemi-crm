<script>
$("#slider106").slick({
	slidesToShow: 3,
	slidesToScroll: 1,
	dots: true,
	arrows: true,
	autoplay: true,
	autoplaySpeed: 4000,
	speed: 1000,
	infinite: true,
	pauseOnHover: false,
	responsive: [
		{
			breakpoint: 1280,
			settings: {
				slidesToShow: 2,
				slidesToScroll: 2,
				infinite: true,
				dots: true
			}
		},
		{
			breakpoint: 768,
			settings: {
				slidesToShow: 1,
				slidesToScroll: 1
			}
		}
	],
	
		fade: false,
		
	
	cssEase: 'cubic-bezier(0.7, 0, 0.3, 1)',
	appendDots: $('#wrap-slider106 .control .paging'),
	prevArrow: '#wrap-slider106 .prevnext .prev',
	nextArrow: '#wrap-slider106 .prevnext .next'
});

$('#wrap-slider106 button.play').on('click', function () {
	$("#slider106").slick("slickPlay");
	$(this).removeClass('on');
	$('#wrap-slider106 button.stop').addClass('on');
});
$('#wrap-slider106 button.stop').on('click', function () {
	$("#slider106").slick("slickPause");
	$(this).removeClass('on');
	$('#wrap-slider106 button.play').addClass('on');
});
</script>


