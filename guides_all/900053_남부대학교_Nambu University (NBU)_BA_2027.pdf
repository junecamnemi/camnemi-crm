		$(document).on("click",'ul.tab li', function(){ // on 이벤트로 변경
			var activeTab = $(this).attr('data-tab');
			$('ul.tab li').removeClass('current');
			$('.tabcontent').removeClass('current');
			$(this).addClass('current');
			$('#' + activeTab).addClass('current');
		});
		$(document).ready(function(){
			$("#nav ul.sub").hide();
			$("#nav ul.menu li").click(function(){
				$("ul",this).slideToggle("fast");
			});
			
		});
		
		$(document).ready(function(){
			 
		    $('.berger_btn>a').on('click', function(){
		        $('.berger_bg').show(); 
		        $('.sidebar_berger').show().animate({
		            right:0
		        });  
		    });
		    $('.berger_close_btn>a').on('click', function(){
		        $('.berger_bg').hide(); 
		        $('.sidebar_berger').animate({
		            right: '-' + 100 + '%'
		                    },function(){
		                        $('.sidebar_berger').hide();          
		                    });  
		    });

		});		
		
		function readyAlert() {
	          alert('현재 준비중에 있습니다.');
	          return;            
		}
		
