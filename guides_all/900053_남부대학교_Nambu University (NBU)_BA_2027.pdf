		$(document).ready(function() {
		    $(".menu01").on("mouseenter", function() {
		        $(".menu01 .subMenu").show(); // menu01 내부 모든 subMenu 보이기
		        $(".sub_menu_bg").show(); // 바깥 subMenu도 보이기
		    });

		    $(".menu01, .sub_menu_bg").on("mouseleave", function(event) {
		        if (!$(event.relatedTarget).closest(".menu01, .sub_menu_bg").length) {
		            $(".menu01 .subMenu, .sub_menu_bg").hide(); // 전체 숨기기
		        }
		    });
		});

	</script>
