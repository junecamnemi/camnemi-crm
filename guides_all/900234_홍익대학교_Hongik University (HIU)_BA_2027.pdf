<!-- 입시일정 팝업 end -->
<script>
	var realToday = moment();
	var today = moment().startOf('month');
	var todayMobile = moment().startOf('month');

	// 현재년도 + 3년까지만 이동 가능
	const viewLimitDate = moment().add(3, 'years').set('month', 11).format('YYYY-MM'); 


	today.add(-2, 'M');
	$(document).ready(function () {
		// 처음 진입시 오늘 날짜로 함수 호출
		fnMakeCal(0);
		fnMakeCalMobile(0);
		// 처음 진입시 첫번째 카테고리 보여주기
		$('.cat-li').eq(0).addClass('active');
		$('.mobile-cal-ul').find('li').eq(0).addClass('active');
		$('.mo-article-ul').each(function () {
			if ($(this).find('li').length > 0) {
			} else {
				$(this).parent('div').remove();
			}
		});

		// pc화면 월 단위 이동
		$(document).on('click', '.prev-month', function () {
			fnMakeCal(-6);

			$('.pc-month-slide').each(function (index) {
				if ($(this).find('ul').attr('class').indexOf(realToday.format('YYYY-MM')) > -1) {
					$(this).addClass('active');
					$(this).find('li').eq(0).find('a').append('<span>Today</span>');
				}
			});
		});
		$(document).on('click', '.next-month', function () {
			if(isNextSlideDateInLimitDate('pc', 6)) {
				fnMakeCal(6);

				$('.pc-month-slide').each(function (index) {
					if ($(this).find('ul').attr('class').indexOf(realToday.format('YYYY-MM')) > -1) {
						$(this).addClass('active');
						$(this).find('li').eq(0).find('a').append('<span>Today</span>');
					}
				});
			} else {
				alert('현재 연도 + 3년까지만 이동 가능합니다.');
			}
		});

		//모바일 화면 월 이동
		$(document).on('click', '.admission-year-m-admission-prev', function () {
			fnMakeCalMobile(-1);

			$('.mobile-date-div').each(function () {
				if ($(this).find('a').attr('class').indexOf(realToday.format('YYYY-MM')) > -1) {
					$(this).parent('.admission-slide').addClass('active');
					$(this).find('a').append('<span>Today</span>');
				}
			});
			$('.mo-article-ul').each(function () {
				if ($(this).find('li').length > 0) {
				} else {
					$(this).parent('div').remove();
				}
			});
		});

		$(document).on('click', '.admission-year-m-admission-next', function () {
			if(isNextSlideDateInLimitDate('mobile', 1)) {
				fnMakeCalMobile(1);

				$('.mobile-date-div').each(function () {
					if ($(this).find('a').attr('class').indexOf(realToday.format('YYYY-MM')) > -1) {
						$(this).parent('.admission-slide').addClass('active');
						$(this).find('a').append('<span>Today</span>');
					}
				});
				$('.mo-article-ul').each(function () {
					if ($(this).find('li').length > 0) {
					} else {
						$(this).parent('div').remove();
					}
				});
			} else {
				alert('현재 연도 + 3년까지만 이동 가능합니다.');
			}
		});

		// 팝업 클릭
		$(document).on('click', '.js-popup-open', function () {
			var startDt = $(this).parents('ul').attr('class').replaceAll('month', '');
			var endDt = $(this).parents('ul').attr('class').replaceAll('month', '');
			startDt = moment(startDt, 'YYYY-MM-DD').startOf('month').format('YYYY-MM-DD');
			endDt = moment(endDt, 'YYYY-MM-DD').endOf('month').format('YYYY-MM-DD');

			var catId = $(this).parent().attr('class').replaceAll('cat', '');
			$.ajax({
				url: '/kr/admission/admission-calendar.do',
				type: 'post',
				data: {
					mode: 'getCalendarListMain',
					boNo: 91,
					startDt: startDt,
					endDt: endDt,
					mstCategoryId: 22,
				},
				success: function (result) {
					var popHtml = '';
					for (var i = 0; i < result.items.length; i++) {
						if (result.items[i].categoryId == catId) {
							popHtml += '<li>';
							popHtml += '<div class="title-date-box">';
							popHtml += '<div class="title-box">';
							popHtml += '<p class="admission-title">';

							for (var j = 0; j < result.cat.length; j++) {
								if (result.items[i].categoryId == result.cat[j].categoryId) {
									popHtml += '<span>[' + result.cat[j].categoryNm + ']</span>';
								}
							}

							popHtml += result.items[i].articleTitle;
							popHtml += '</p>';
							popHtml += '<p>' + result.items[i].articleText + '</p>';
							popHtml += '</div>';
							popHtml += '<p class="date-box">';
							
							var startDate = result.items[i].etcChar1;
							var startHour = result.items[i].etcChar3 == null ? '00' : result.items[i].etcChar3;
							var startMin = result.items[i].etcChar4 == null ? '00' : result.items[i].etcChar4;
							var endDate = result.items[i].etcChar2;
							var endHour = result.items[i].etcChar5 == null ? '00' : result.items[i].etcChar5;
							var endMin = result.items[i].etcChar6 == null ? '00' : result.items[i].etcChar6;
							
							// 시작과 종료가 모두 같은지 확인
							var isSameDateTime = (startDate === endDate && startHour === endHour && startMin === endMin);

							if (isSameDateTime) {
								// 같을 때: 한 번만 표시
								popHtml += startDate + '(' + yoil(moment(startDate)) + ') ' + startHour + ':' + startMin;
							} else {
								// 다를 때: 기존처럼 시작 ~ 종료 표시
								popHtml += startDate + '(' + yoil(moment(startDate)) + ') ' + startHour + ':' + startMin;
								popHtml += ' ~ <span>';
								popHtml += endDate + '(' + yoil(moment(endDate)) + ') ' + endHour + ':' + endMin;
								popHtml += '</span>';
							}
							popHtml += '</p>';
							popHtml += '</div>';
							popHtml += '</li>';
						}
					}

					$('.pop-ul').html(popHtml);
				},
				error: function (data, status, err) {},
			});
		});
	});

	// 현재년도 + 3년까지만 이동 가능
	function isNextSlideDateInLimitDate(device, addMonth) {
		let nextYear = parseInt(today.format('YYYY'));
		let nextMonth = parseInt(today.format('MM')) + addMonth;

		if(device == 'mobile') {
			nextYear = parseInt(todayMobile.format('YYYY'));
			nextMonth = parseInt(todayMobile.format('MM')) + addMonth;
		}

		if(nextMonth > 12) {
			nextYear++;
			nextMonth = nextMonth % 12;
		}

		let nextSlideDate = nextYear+''+String(nextMonth).padStart(2, '0')+'01';


		return viewLimitDate >= moment(nextSlideDate).format('YYYY-MM');
	}

	function fnMakeCalMobile(Number) {
		todayMobile.add(Number, 'M');
		$.ajax({
			url: '/kr/admission/admission-calendar.do',
			type: 'post',
			async: false,
			data: {
				mode: 'getCalendarListMain',
				boNo: 91,
				startDt: todayMobile.startOf('month').format('YYYY-MM-DD'),
				endDt: todayMobile.endOf('month').format('YYYY-MM-DD'),
				mstCategoryId: 22,
			},
			success: function (result) {
				var liIndex = 0;
				$('.mo-cat-li').each(function (index) {
					if ($(this).hasClass('active')) {
						liIndex = index;
					}
				});

				var items = result.items;
				var cat = result.cat;
				cat.sort((a, b) => a.lft - b.lft);
				var mobileHtml = '';
				for (var j = 0; j < cat.length; j++) {
					if (cat[j].categoryParentId == null) {
						mobileHtml += '<li class="mo-cat-li">';
						mobileHtml += '<a class="b-admission-cate" href="#a" title="선택됨">' + cat[j].categoryNm + '</a>';
						mobileHtml += '<div class="b-admission-calendar-m-box">';
						mobileHtml += '<div class="admission-container">';
						mobileHtml += '<div class="admission-wrapper">';
						mobileHtml += '<div class="admission-slide">';
						mobileHtml += '<div class="b-date mobile-date-div">';
						mobileHtml +=
							'<a href="#a" class="mobile-date' + todayMobile.format('YYYY-MM') + '" title="' + todayMobile.format('YYYY년 MM월') + '">' + todayMobile.format('YYYY.MM') + '</a>';
						mobileHtml += '</div>';
						mobileHtml += '<ul class="b-schedule-box">';
						var twodepthCat = new Array();
						for (var i = 0; i < cat.length; i++) {
							if (cat[i].categoryParentId != null) {
								if (cat[j].categoryId == cat[i].categoryParentId) {
									twodepthCat.push(cat[i].categoryId);

									mobileHtml += '<li>';
									mobileHtml += '<div>';
									mobileHtml += '<p class="b-admission-type">' + cat[i].categoryNm + '</p>';
									mobileHtml += '<ul class="mo-article-ul">';
									for (var k = 0; k < items.length; k++) {
										itemCat = items[k].categoryId;
										catCat = cat[i].categoryId;

										if (itemCat == catCat) {
											mobileHtml += '<li>';
											mobileHtml += '<a class="b-title" href="#a" title="' + items[k].articleTitle + ' 바로가기">' + items[k].articleTitle + '</a>';
											mobileHtml +=
												'<span class="b-period">' +
												items[k].etcChar1 +
												'(' +
												yoil(moment(items[k].etcChar1)) +
												') ' +
												items[k].etcChar3 +
												':' +
												items[k].etcChar4 +
												'  ~ ' +
												items[k].etcChar2 +
												'(' +
												yoil(moment(items[k].etcChar2)) +
												') ' +
												items[k].etcChar5 +
												':' +
												items[k].etcChar6 +
												'</span>';
											mobileHtml += '<span class="b-desc">' + items[k].articleText + '</span>';
											mobileHtml += '</li>';
										}
									}
									mobileHtml += '</ul>';
									mobileHtml += '</div>';
									mobileHtml += '</li>';
								}
							}
						}
						mobileHtml += '</ul>';
						mobileHtml += '</div>';
						mobileHtml += '</div>';
						mobileHtml += '</div>';
						mobileHtml += '<div class="control-wrap">';
						mobileHtml += '<a href="#a" class="admission-year-m-admission-prev" title="이전 보기"><span class="hide">이전 보기</span></a>';
						mobileHtml += '<a href="#a" class="admission-year-m-admission-next" title="다음 보기"><span class="hide">다음 보기</span></a>';
						mobileHtml += '</div>';
					}
				}

				$('.mobile-cal-ul').html(mobileHtml);

				$('.mo-cat-li').eq(liIndex).addClass('active');

				//입학 > 대학/대학원 입학 메인 동일한 url의 탭메뉴(입시캘린더 Mobile)
				App.SameUrlMenu.init({
					//mobile
					tabWrap: '.b-admission-calendar-m-wrap',
					tabBox: '.b-admission-calendar-m-wrap > ul',
					tabConbox: '.b-admission-calendar-m-box',
				});
			},
		});
	}

	function fnMakeCal(Number) {
		today.add(Number, 'M');


		$.ajax({
			url: '/kr/admission/admission-calendar.do',
			type: 'post',
			async: false,
			data: {
				mode: 'getCalendarListMain',
				boNo: 91,
				startDt: today.startOf('month').format('YYYY-MM-DD'),
				endDt: today.clone().add(6, 'M').endOf('month').format('YYYY-MM-DD'),
				mstCategoryId: 22,
			},
			success: function (result) {
				var liIndex = 0;
				$('.cat-li').each(function (index) {
					if ($(this).hasClass('active')) {
						liIndex = index;
					}
				});

				var items = result.items;
				var cat = result.cat;

				cat.sort((a, b) => a.lft - b.lft);

				var addHtml = '';
				for (var i = 0; i < cat.length; i++) {
					if (cat[i].categoryParentId == null && cat[i].categoryParentId2 == null) {
						addHtml += '<li class="cat-li">';

						addHtml += '<a class="b-admission-cate" href="#a" title="">' + cat[i].categoryNm + '</a>';
						addHtml += '<div class="b-admission-schedule-box">';
						addHtml += '<div class="b-admission-type-box">';
						addHtml += '<ul>';
						addHtml += '<li><p></p></li>';
						var twodepthCat = new Array();
						var twodepthCatNm = new Array();
						for (var j = 0; j < cat.length; j++) {
							if (cat[i].categoryId == cat[j].categoryParentId) {
								addHtml += '<li><p>' + cat[j].categoryNm + '</p></li>';
								twodepthCat.push(cat[j].categoryId);
								twodepthCatNm.push(cat[j].categoryNm);
							}
						}
						addHtml += '</ul>';
						addHtml += '</div>';
						addHtml += '<div class="b-admission-calendar-box">';
						addHtml += '<div class="admission-container">';
						addHtml += '<div class="admission-wrapper">';

						for (var a = 0; a < 6; a++) {
							var checkYyyyMm = today.clone().add(a, 'M').format('YYYY-MM');
							var yearMonth = today.clone().add(a, 'M').format('YYYY.MM');
							var month = today.clone().add(a, 'M').format('MM');
							addHtml += '<div class="admission-slide pc-month-slide">';
							addHtml += '<ul class="' + checkYyyyMm + 'month">';
							addHtml += '<li class="month-li"><a href="#a" title="' + yearMonth + '">' + yearMonth + '</a></li>';
							for (var j = 0; j < twodepthCat.length; j++) {
								var cnt = 0;
								for (var k = 0; k < items.length; k++) {
									if (twodepthCat[j] == items[k].categoryId && (checkYyyyMm == items[k].etcChar1.substr(0, 7) || checkYyyyMm == items[k].etcChar2.substr(0, 7))) {
										cnt++;
									}
								}
								if (cnt > 0) {
									addHtml += '<li class="' + twodepthCat[j] + 'cat"><a class="js-popup-open" href="#a" data-popup-type="admission-schedule" title="' + yearMonth + ' ' + twodepthCatNm[j] + ' 일정 ' + cnt + '건 팝업 열기"> 일정';
									addHtml += '<span>' + cnt + '</span>';
									addHtml += '</a></li>';
								} else {
									addHtml += '<li></li>';
								}
							}
							addHtml += '</ul>';
							addHtml += '</div>';
						}

						addHtml += '</div>';
						addHtml += '</div>';
						addHtml += '<div class="control-wrap">';
						addHtml += '<a href="#a" class="admission-year-admission-prev prev-month" title="이전 보기"><span class="hide">이전 보기</span></a>';
						addHtml += '<a href="#a" class="admission-year-admission-next next-month" title="다음 보기"><span class="hide">다음 보기</span></a>';
						addHtml += '</div>';
						addHtml += '</div>';
						addHtml += '</div>';
						addHtml += '</li>';
					}
				}
				$('.add-html-ul').html(addHtml);

				$('.add-html-ul li').on('click', function () {
					$('.add-html-ul li').removeClass('active');
					$(this).addClass('active');
				});

				$('.cat-li').eq(liIndex).addClass('active');

				// 입학 > 대학/대학원 입학 메인 동일한 url의 탭메뉴(입시캘린더 PC)
				App.SameUrlMenu.init({
					//pc
					tabWrap: '.b-admission-calendar-wrap',
					tabBox: '.b-admission-calendar-wrap > ul',
					tabConbox: '.b-admission-schedule-box',
				});
			},
			error: function (data, status, err) {},
		});
	}

	// 요일 확인
	function yoil(date) {
		var korean = '';
		if (date.day() == 0) {
			korean = '일';
		} else if (date.day() == 1) {
			korean = '월';
		} else if (date.day() == 2) {
			korean = '화';
		} else if (date.day() == 3) {
			korean = '수';
		} else if (date.day() == 4) {
			korean = '목';
		} else if (date.day() == 5) {
			korean = '금';
		} else if (date.day() == 6) {
			korean = '토';
		}
		return korean;
	}

	$(document).ready(function () {
		//입학 > 대학/대학원 입학 메인 동일한 url의 탭메뉴(입시캘린더 PC)
		App.SameUrlMenu.init({
			//pc
			tabWrap: '.b-admission-calendar-wrap',
			tabBox: '.b-admission-calendar-wrap > ul',
			tabConbox: '.b-admission-schedule-box',
		});

		//입학 > 대학/대학원 입학 메인 동일한 url의 탭메뉴(입시캘린더 Mobile)
		App.SameUrlMenu.init({
			//mobile
			tabWrap: '.b-admission-calendar-m-wrap',
			tabBox: '.b-admission-calendar-m-wrap > ul',
			tabConbox: '.b-admission-calendar-m-box',
		});
	});
</script>
	
	
	
	
