<script type="text/javascript" src="/_res/hongik/_share/search/js/searchPaging.js"></script>
<script>
document.addEventListener("DOMContentLoaded", function() {
    var collIdTextMap = {
        'collId1': '메뉴검색',
        'collId2': '바로가기',
        'collId3': '바로가기',
        'collId4': '전화번호',
        'collId5': '교직원',
        'collId6': '뉴스게시판',
        'collId9': '규정집',
        'collId11': '기타게시판',
        'collId12': '커뮤니티게시판',
        'collId13': '첨부파일'
    };

    function getCollIdClass(element) {
        return Array.from(element.classList).find(function(cls) {
            return cls.startsWith('collId');
        });
    }

    function insertGroupTitle(element, text) {
        if (!element.previousElementSibling ||
            element.previousElementSibling.tagName.toLowerCase() !== 'h2') {

            var h2 = document.createElement('h2');
            h2.textContent = text;
            h2.style.cursor = 'pointer';
            h2.style.padding = '40px 0 40px 0';
            h2.style.fontSize = '2.6rem';
            h2.style.lineHeight = '3rem';
            h2.style.fontWeight = 'var(--font-weight-semibold)';
            h2.style.color = '#fff';
            h2.onclick = function() {
                var currentMenu = document.RsaSearchForm1.menu.value || '';
                document.RsaSearchForm1.menu.value =
                    (currentMenu.indexOf('SYS') !== -1) ? text + '_SYS' : text;
                document.RsaSearchForm1.section.value = '';
                clickFldSet(document.RsaSearchForm1, 'menu', document.RsaSearchForm1.menu.value);
                return false;
            };
            element.parentNode.insertBefore(h2, element);
        }
    }

    // ★ ul 단위로 처리
    var uls = document.querySelectorAll(
        '.search-box .search-inner-box section .search-result-new-box ul'
    );

    uls.forEach(function(ul) {
        var allLi = ul.querySelectorAll(':scope > li');   // 이 ul의 직계 li만
        if (allLi.length === 0) return;

        var lastIndex = allLi.length - 1;
        var prevCollId = null;

        allLi.forEach(function(element, i) {
            var collIdClass = getCollIdClass(element);
            if (!collIdClass) return;

            var isGroupStart = (collIdClass !== prevCollId);
            var nextElement = (i < lastIndex) ? allLi[i + 1] : null;
            var nextCollIdClass = nextElement ? getCollIdClass(nextElement) : null;
            var isGroupEnd = !nextElement || (nextCollIdClass !== collIdClass);
            var isLastLi = (i === lastIndex);

            if (isGroupStart) {
                element.style.borderTop = 'none';
                element.style.paddingTop = '0';
                insertGroupTitle(
                    element,
                    collIdTextMap[collIdClass] || (collIdClass + ' 그룹 시작 제목')
                );
            }

            // 기본값
            element.style.borderBottom = 'none';
            element.style.paddingBottom = '0';

            // 이 ul 안에서, collId 그룹의 마지막이고
            // 이 ul의 마지막 li가 아닐 때만 border-bottom
            if (isGroupEnd && !isLastLi) {
                element.style.borderBottom = '1px solid #fff';
                element.style.paddingBottom = '40px';
            }

            prevCollId = collIdClass;
        });
    });
});



// <!--
    function formSubmit(){
        if(document.RsaSearchForm1.qt.value==""){
            clickFldSet(document.RsaSearchForm1,'menu', '통합검색' );
        }else{
            document.RsaSearchForm1.submit();
        }
        
    }

    function submitWithValues(menuValue, sectionValue) {
          document.getElementById('menu').value = menuValue;       // menu 값 변경
          document.getElementById('section').value = sectionValue; // section 값 변경
          document.getElementById('repiaSearchForm').submit();              // 폼 제출
        }
    $(document).ready(function() {
        
        $("#search-sort-select").change(function() {
            $("#search-sort-select option:selected").each(function() {
                $("#rf").val($(this).val());
                document.RsaSearchForm1.submit();
            });
        });
        
        $("#search-filter-select").change(function() {
            $("#search-filter-select option:selected").each(function() {
                $("#field").val($(this).val());
                document.RsaSearchForm1.submit();
            });
        });
        
$("#select-search-cate").change(function() {
    let selectedVal = $("#select-search-cate option:selected").val();

    let $sysRadio = $('#wr-homepage02:checked');
    let isSysMode = $sysRadio.length > 0 || $('input[name="wr-homepage-name"]:checked').val() === 'SYS';

    if (isSysMode && !selectedVal.endsWith("_SYS")) {
        selectedVal = selectedVal + "_SYS";
    }

    $("#menu").val(selectedVal);
    $("#section").val("");
    document.RsaSearchForm1.submit();
});


    });
</script>
<body class="total-search-open">
      
    <div class="search-box js-search-wrap">
        <div class="gnb-header">
                <p class="logo"><a href="/kr/" title="홍익대학교 바로가기"><img src="/_res/hongik/_share/search/img/common/img-logo.svg" alt="산업과 예술의 만남 홍익대학교"></a>
                </p>
                <div class="header-util-box"><a class="btn-portal white" href="/my/" target="_blank" title="새창열림">MY HONGIK</a></div>
    </div>
    <div class="search-inner-box">
        <section>
            <form id="repiaSearchForm" name="RsaSearchForm1" method="post" action="" onsubmit="return chkSearchForm(this);">
            <div class="search-hompage-box">
                <div class="homepage-chk-box"><span>
                    <input type="radio" class="homepage-radio" id="wr-homepage01" name="wr-homepage-name" checked="checked" value="on"  onclick="submitWithValues('통합검색', 'ALL')">
                    
                    <label for="wr-homepage01">대표홈페이지</label></span><span>
                    <input type="radio" class="homepage-radio" id="wr-homepage02" name="wr-homepage-name" value="on"  onclick="submitWithValues('통합검색_SYS', 'UNIV')">
                    <label for="wr-homepage02">대학/대학원/부속기관 홈페이지</label></span></div>
                </div>
            <div class="search-input-box">
                <label class="hide" for="select-search-cate">정확도</label>
                <!-- 검색 카테고리 셀렉트 -->
					
					<select class="select-cate" id="select-search-cate">
					    
					        <option selected>통합검색</option>
					        <option >메뉴검색</option>
					        <option >바로가기</option>
					        <option >전화번호</option>
					        <option >교직원</option>
					        <option >뉴스게시판</option>
					        <option >규정집</option>
