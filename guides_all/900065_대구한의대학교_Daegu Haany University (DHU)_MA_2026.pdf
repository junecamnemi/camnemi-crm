function setCookie( name, value, expiredays )
{
	var todayDate = new Date();
	todayDate.setDate( todayDate.getDate() + parseInt(expiredays) );	document.cookie = name + "=" + escape( value ) + "; path=/; expires=" + todayDate.toGMTString() + ";"
}

function closeLayer(idx,days){
	var form=document.forms['main_layer_form'+idx];
	var cookie_name= 'LAYER_COOKIE_graduate_'+idx;

	if ( form.popup_end.checked   == true) {
