 <script type="text/javascript">
function change_sound_m_title(id){
	
	if( $("video").prop('muted')==true ) {
        $("#"+id).prop('muted', false);
		$("#"+id+"_img").attr("src", "../kiuphoto/img/mv_sound_on.png");
    } else {
		$("#"+id).prop('muted', true);
		$("#"+id+"_img").attr("src", "../kiuphoto/img/mv_sound.png");
    }
}

function do_change_sound_m_title(id){
	
	if( $("video").get(0).paused == true ) {
        $("#"+id).get(0).play();
		$("#"+id+"_img_do").attr("src", "../contents/img/mv_pause.png");
		
    } else {
		$("#"+id).get(0).pause();
		$("#"+id+"_img_do").attr("src", "../contents/img/mv_play.png");
    }
}


</script>
