<script>
$(document).ready(function(){
    $(".cal-num :button").on("click", function(){
        var $this = $(this);
        $(".cal-num :button").removeClass('on');
        setTimeout(function(){
            $this.addClass('on');
            //alert($this.data('ym'));
            $.ajax({
                url: 'scheduleExamMainData.do',
                type: 'POST',
                //contentType: 'application/json',
                dataType: 'json',
                data: {
                    schYear: $this.data('ym')
                },
                success: function(response) {
                    console.log('통신 성공! 서버 응답 데이터:', response);
                    // 예: 서버가 { "status": "success", "userId": 123 } 를 반환한 경우
                    if(response.status === 'success') {
                        alert('등록 성공! 사용자 ID: ' + response.userId);
                    }
                    if(response.items && response.items[0]) {
                        var $html = `
                <div class="swiper">
                    <div class="swiper-wrapper">`;
                        $(response.items).each(function(i, cal){
                            console.log(cal);
                            var sdate = cal.SDATE;
                            var edate = cal.EDATE;
                            var sday = sdate.substring(8);
                            var sym = (cal.SCH_MONTH).replace(/\-/g, '.');
                            var content = cal.CONTENT;
                            var week = '';
                            if(sdate == edate) {
                                week = sdate.substring(5).replace(/\-/g, '.') + '('+cal.SWEEK + ')';
                            } else {
                                week = sdate.substring(5).replace(/\-/g, '.') + '('+cal.SWEEK + ') ~ ' + edate.substring(5).replace(/\-/g, '.') + '('+cal.EWEEK + ')';
                            }
                            console.log(sdate);
                            console.log(edate);
                            console.log(sday);
                            console.log(sym);
                            console.log(content);
                            console.log(week);
                            $html += `
                        <div class="swiper-slide">
							<div class="item">
								<div class="dt">${sym}.<span class="day">${sday}</span></div>
								<div class="txt">
									<div class="board-con" title="${content}">${content}</div>
									<div class="dt-space">${week}</div>
								</div>
							</div>
						</div>
                            `;
                        });
                        $html += `
                    </div>
                </div>
                <div class="swiper-control">
                    <div class="swiper-btn swiper-prev"><i class="xi-angle-left"></i></div>
                    <div class="swiper-btn swiper-next"><i class="xi-angle-right"></i></div>
                </div>
                        `;
                        $(".cal-slide").html($html);
                        console.log($html);

                        new Swiper(".main-news .swiper ", {
                            a11y: {
                                prevSlideMessage: '이전 슬라이드',
                                nextSlideMessage: '다음 슬라이드',
                                paginationBulletMessage: '총 {{slidesLength}}장의 슬라이드 중 {{index}}번 슬라이드 입니다.',
                            },
                            speed:1000,
                            navigation: {
                                nextEl: ".main-news .swiper-next",
                                prevEl: ".main-news .swiper-prev",
                            },
                            loop:false,
                            autoplay: {
                                delay: 2500,
                                disableOnInteraction: false,
                            },
                            on: {
                                reachEnd() {
                                    this.autoplay.stop(); // 마지막에서 멈춤
                                },
                            },
                            breakpoints: {
                                320: {
                                    slidesPerView: 1,
                                    spaceBetween: 20,
                                },
                                720: {
                                    slidesPerView: 2,
                                    spaceBetween: 20,
                                },
                                1024: {
                                    slidesPerView: 3,
                                    spaceBetween: 20,
                                },
                            },
                            //loop:true
                        });
                        document.querySelectorAll('.scrolling-wrapper').forEach(startScrolling);
                    } else {
                        $(".cal-slide").html('');
                    }
                },
                error: function(xhr, status, error) {
                    console.error('통신 에러 발생:', error);
                    alert('데이터 전송에 실패했습니다.');
                }
            });
        },100);
    });
});

function startScrolling(wrapper) {
	const textWrapper = wrapper.querySelector('.scrolling-text');
	const direction = wrapper.classList.contains('vertical') ? 'vertical' : 'horizontal';
	const wrapperSize = direction === 'horizontal' ? wrapper.offsetWidth : wrapper.offsetHeight;

	// 텍스트 복제하여 무한 스크롤 구현
	textWrapper.innerHTML += textWrapper.innerHTML;

	let position = 0;
	const speed = 1; // 스크롤 속도

	function animate() {
		position -= speed;

		if (direction === 'horizontal') {
			const textWidth = textWrapper.offsetWidth / 2;
			if (Math.abs(position) >= textWidth) position = 0;
			textWrapper.style.transform = `translateX(px)`;
		} else if (direction === 'vertical') {
			const textHeight = textWrapper.offsetHeight / 2;
			if (Math.abs(position) >= textHeight) position = 0;
			textWrapper.style.transform = `translateY(px)`;
		}

		requestAnimationFrame(animate);
	}

	// 텍스트 복제가 완료된 후 애니메이션 시작
	setTimeout(animate, 0);
}
</script>
			
