<body>
    <div id="wrap">
        





<script type="text/javascript">
    $(document).ready(function () {

        var menu_up_down = 1;
        $("#m_menu").click(function () {
            if (menu_up_down == 1) {
                $(".m_gnb").animate({height: "280px"});
                menu_up_down = 0;
            } else {
                $(".m_gnb").animate({height: "0px"});
                menu_up_down = 1;
            }
        });

        var menu_array = new Array();
        $('.gnb_depth2').each(function (i, v) {
            $.ajax({
                url: '/menu/list',
                type: 'post',
                async: false,
                data: {
                    menu_info_seq: '1',
                    menu_seq: $(v).data('parent-seq'),
                    flag: 'child'
                },
                dataType: 'json',
                success: function (res) {
                    var parent = new Array();
                    var child = new Array();
                    res.forEach(function (v, i) {
                        switch (v.menu_depth) {
                            case '1':
                                parent.push({
                                    seq: v.menu_seq,
                                    title: v.menu_title,
                                    parent: v.prt_seq,
                                    link: v.menu_link,
                                    type: v.menu_link_type,
                                    menu_type: v.menu_type
                                });
                                break;
                            case '2':
                                child.push({
                                    parent: v.prt_seq,
                                    title: v.menu_title,
                                    link: v.menu_link,
                                    type: v.menu_link_type,
                                    menu_type: v.menu_type
                                });
                                break;

                        }
                    });
                    menu_array.push({parent: parent, child: child});
                }
            });
        });
        /**
         *  2022-07-15 설명 추가
         *  menu_array .length : 1depth
         *  parant : 2depth 메뉴 array
         *  child : 3depth 메뉴 array
         * @type {number}
         */
        var prevParent = 0;
        menu_array.forEach(function (v, i) {
            prevParent = 0;
            var parent = v.parent;
            //console.table(parent);
            var child = v.child;
            var menu_content = '';
            var m_menu_content = '';
            var site_map_menu_content = '';
//            parent.forEach(function(sv, si) {
//                if(prevParent == 0){
//                    prevParent = sv.parent;
//                }
//                prevParent = sv.parent;
//            });


            parent.forEach(function (sv, si) {
                menu_content = '';
                m_menu_content = '';
                site_map_menu_content = '';
                if (prevParent == 0) {
                    prevParent = sv.parent;
                }

                if (prevParent == sv.parent) {

                    /**
                     *  메뉴 타입 링크 , 게시판, HTML , 분류
                     */
                    var menu_type = sv.menu_type;
                    var menu_link_type = ""; // 새창 , 현재창

                    // pc
                    menu_content += "<li>";

                    // mobile
                    m_menu_content +="<li>";

                    // sitemap

                    site_map_menu_content +="<li>";

                    /**
                     * 새창 현재창 여부
                     */

                    switch(sv.type){
                        case "LNK_001":
                            menu_link_type = "_self";
                            break;
                        case "LNK_002":
                            menu_link_type = "_blank";
                            break;
                        default :
                            menu_link_type = "_self";
                    }

                    /**
                     * 링크 타입 or HTML
                     */
                    if(menu_type === "MNT_001" || menu_type === "MNT_003"){
                        menu_content += '<a href="'+sv.link+'" target="'+menu_link_type+'">'+sv.title+'</a>';
                        m_menu_content += '<a href="'+sv.link+'" target="'+menu_link_type+'">'+sv.title+'</a>';
                        site_map_menu_content += '<a href="'+sv.link+'" target="'+menu_link_type+'">'+sv.title+'</a>';
                    }
                    /**
                     * 게시판
                     */
                    if(menu_type === "MNT_002"){
                        menu_content += '<a href="'+sv.link+'/list" target="'+menu_link_type+'">'+sv.title+'</a>';
                        m_menu_content += '<a href="'+sv.link+'/list" target="'+menu_link_type+'">'+sv.title+'</a>';
                        site_map_menu_content += '<a href="'+sv.link+'/list" target="'+menu_link_type+'">'+sv.title+'</a>';
                    }
                    /**
                     * 분류 3depth 메뉴의 첫번째 요소 링크 가져오기
                     */
                    if(menu_type === "MNT_004"){
                        if(child.length != 0){
                            var firsh_child = child[0];
                            menu_type = firsh_child.menu_type;
                            switch(firsh_child.type){
                                case "LNK_001":
                                    menu_link_type = "_self";
                                    break;
                                case "LNK_002":
                                    menu_link_type = "_blank";
                                    break;
                                default :
                                    menu_link_type = "_self";
                            }
                            /**
                             * 링크 타입 or HTML
                             */
                            if(menu_type === "MNT_001" || menu_type === "MNT_003"){
                                menu_content += '<a href="'+firsh_child.link+'" target="'+menu_link_type+'">'+sv.title+'</a>';
                                m_menu_content += '<a href="'+firsh_child.link+'" target="'+menu_link_type+'">'+sv.title+'</a>';
                                site_map_menu_content += '<a href="'+firsh_child.link+'" target="'+menu_link_type+'">'+sv.title+'</a>';
                            }
                            /**
                             * 게시판
                             */
                            if(menu_type === "MNT_002"){
                                menu_content += '<a href="'+firsh_child.link+'/list" target="'+menu_link_type+'">'+sv.title+'</a>';
                                m_menu_content += '<a href="'+firsh_child.link+'/list" target="'+menu_link_type+'">'+sv.title+'</a>';
                                site_map_menu_content += '<a href="'+firsh_child.link+'/list" target="'+menu_link_type+'">'+sv.title+'</a>';
                            }
                            /**
                             * 분류 4depth 는 지원 안함
                             */
                            if(menu_type === "MNT_004"){
                                menu_content += '<a href="#" target="_self">'+sv.title+'</a>';
                                m_menu_content += '<a href="#" target="_self">'+sv.title+'</a>';
                                site_map_menu_content += '<a href="#" target="_self">'+sv.title+'</a>';
                            }
                        }else{
                            menu_content += '<a href="#" target="_self">'+sv.title+'</a>';
                            m_menu_content += '<a href="#" target="_self">'+sv.title+'</a>';
                            site_map_menu_content += '<a href="#" target="_self">'+sv.title+'</a>';
                        }
                    }

                    menu_content += "</li>";
                    m_menu_content +="</li>";
                    site_map_menu_content +="</li>";

                    $('.gnb_depth2[data-parent-seq="' + sv.parent + '"]').append(menu_content);
                    $('.m_header_drop[data-parent-seq="'+sv.parent+'"]').append(m_menu_content);
                    $('.site_map[data-parent-seq="'+sv.parent+'"]').append(site_map_menu_content);

                } else {

                }
                prevParent = sv.parent;
            });
        });


        $('.gnb > ul >li').on({
            mouseover: function() {
                $(this).find(".gnb_depth2_wrap").show();
            },
            mouseleave: function() {
                $(this).find(".gnb_depth2_wrap").hide();
            }
        });

//팝업
        $("a.popup_open").on("click", function(e){
            $("body").addClass("fixed");
            $(".top-layer-pop").addClass("show");
            
            
            $.ajax({
                url: '/ajax/popup/list',
                type: 'post',
                data:{},
                dataType: 'json',
                success: function (res) {
                    var pop = '';
                    if(res.length > 0){
                        res.forEach(function(v, i){
                            if(v.popup_type == 'I'){ //팝업 타입 이미지
                                pop +='<li>';
                                pop +='<a href="';
                                if(v.link_type == 'P'){
                                    pop += '#none';
                                }else {
                                    pop += v.link_url;
                                }
                                pop +='" target="';
                                if(v.link_type == 'B'){
                                    pop += '_blank';
                                }else if(v.link_type =='N') {
                                    pop += '_self';
                                }else {
                                    pop += '';
                                }
                                pop +='">';
                                pop +='<div class="img">';
                                pop +='<img src="/cmmn/fileView?path='+v.file_path+'&amp;physical='+v.file_sys_nm+'&amp;contentType=image" onerror="this.src=\'/resources/images/site/common/no_image.png\'" alt="'+v.popup_title+'">';
                                pop +='</div>';
                                pop +='<p class="sr-only">'+v.popup_title+'</p>';
                                pop +='</a></li>';

                            }else if(v.popup_type =='H'){ // html
                                pop +='<li>';
                                pop +='<div class="img">'+v.content+'</div>';
                                pop +='<p class="sr-only">'+v.popup_title+'</p>';
                                pop +='</li>';
                            }

                        });
                    }else{
                        pop +='<div class="popup-empty">등록된 팝업이 없습니다</div>';
                    }
                    $('.tpop-list').empty();
                    $('.tpop-list').append(pop);

                    if($('.tpop-list > li').length >0){
                        popupSlick();
                    }
                }
            });
            
            
            

        });

        $(".pop-close").on("click", function () {
            $("body").removeClass("fixed");
            $(".top-layer-pop").removeClass("show");
            $('.tpop-list').slick("unslick");
        });
    });
</script>
<script>

    var site_map = 0;
    // 사이트 맵 버튼 클릭
    function fn_show_site_map(){
        if(site_map == 0){
            $("div[class=sitemap]").css("display","block");
            $("body").css("overflow","hidden");
            site_map = 1
        }else{
            $("div[class=sitemap]").css("display","none");
            site_map = 0
        }
    }
    // 모바일 사이트 맵 온 오프
    function fn_m_show_site_map(type){
        if(type == 'on'){
            $("div.sitemap").css("display","block");
        }else{
            $("div.sitemap").css("display","none");
            $("body").css("overflow","auto");

        }
    }

    // 모바일 햄버거 메뉴 클릭
    function fn_m_menu_active(e,type) {

        if(type == 'on'){
            $(".header_on").css("display","block");
            $("body").css("overflow","hidden");
            $(".header_m").css("z-index","9999");
            $(".header_m").css("background","#fff");
            $("a.menu.m_button").css("display","none");
            $("a.close.m_button").css("display","block");
            $(".logo_b").css("display","block");
            $(".logo_w").css("display","none");

        }else{
            $(".header_on").css("display","none");
            $("body").css("overflow","auto");
            $(".header_m").css("z-index","initial");
            $(".header_m").css("background","transparent");
            $("a.menu.m_button").css("display","block");
            $("a.close.m_button").css("display","none");
            $(".logo_b").css("display","none");
            $(".logo_w").css("display","block");

        }
    }

    // 모바일 메뉴그룹 상세
    function fn_m_menu_group(e) {
        var target = $($(e.target).parent())

        if(target.attr('class') == 'on m_menu_group'){ // close
            target.attr('class','m_menu_group');
            target.children('ul').css('display',"none");

        }else{// open

            // 모든 메뉴 다 닫기
            $("li.on.m_menu_group").attr('class','m_menu_group');
            $("ul.m_menu_group_item").css('display','none');

            // 선택된 메뉴 열기
            target.attr('class', 'on m_menu_group');
            target.children('ul').css('display',"block");

        }
    }

    function mMenuView(t) {
        if (t == 1) {
            $('#gnb').slideDown();
        } else {
            $('#gnb').slideUp();
        }
    }

    //상단 팝업존
    function setCookie(name, value, expiredays) {
        var todayDate = new Date();
        todayDate.setDate(todayDate.getDate() + expiredays);
        document.cookie = name + "=" + escape(value) + "; path=/; expires=" + todayDate.toGMTString() + ";"
    }


    function closePop() {
        setCookie("imgpop", "done", 1);
        $('.top-layer-pop').removeClass('show');
        $('.tpop-list').slick("unslick");
    }

    function popupSlick() {
        //slick
        $('.tpop-list').slick({
            slidesToShow: 4, /* 화면에 보여질 이미지 갯수*/
            slidesToScroll: 4, /*  스크롤시 이동할 이미지 갯수 */
            infinite: true, /* 맨끝이미지에서 끝나지 않고 다시 맨앞으로 이동 */
            dots: true, /*  아래점  */
            // variableWidth : true,
            responsive: [// 반응형 웹 구현 옵션
                {
                    breakpoint: 9999,
                    settings: {
                        slidesToShow: 4,
                        slidesToScroll: 4
                    }
                },

                {
                    breakpoint: 1300,
                    settings: {
                        slidesToShow: 3,
                        slidesToScroll: 3
                    }
                },
                {
                    breakpoint: 1200,
                    settings: {
                        slidesToShow: 2,
                        slidesToScroll: 2
                    }
                }
                ,
                {
                    breakpoint: 480,
                    settings: {
                        slidesToShow: 1,
                        slidesToScroll: 1
                    }
                }
            ]
        });
    }

    function getCookie(name) {
        var Found = false;
        var start, end;
        var i = 0;

        while(i <= document.cookie.length) {
            start = i;
            end = start + name.length;
            if(document.cookie.substring(start, end) == name) {
                Found = true;
                break;
            }
            i++;
        }
        if(Found == true) {
            start = end + 1;
            end = start+name.length-2;
            return document.cookie.substring(start, end);
        }
        return;
    }

    $(document).ready(function() {
        var eventCookie = getCookie("imgpop");
        if (eventCookie == "done") {
            $('.top-layer-pop').removeClass('show');
        }else{
            

        }

    });
</script>
