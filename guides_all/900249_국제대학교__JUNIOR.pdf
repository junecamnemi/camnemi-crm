function mtabEffect(){
	var mtabBtn = $(".mapp-user-tab dt a");
	mtabBtn.click(function(){
		$($(this).attr("href")).addClass("is-open");
		$(this).addClass("is-open");
		$(".mapp-user-tab dd").not($(this).attr("href")).removeClass("is-open");
		$(".mapp-user-tab dt a").not(this).removeClass("is-open");		
		return false;
	});
}


