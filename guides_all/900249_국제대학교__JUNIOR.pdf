				var mVis = {
					init : function() {
						this.mVisSld();
					},
					mVisSld : function() {
						var $mVisItem = $("#mvisual-wr .visimg-eft-wr");
						var $mVisCtn = $("#mvisual-wr .ctrl-btns");
						$mVisItem.on("initialized.owl.carousel", function(event){
							var count = event.item.count;
							if (count < 10 ) {
								count = "0" + count;
							}
							console.log(count)
							$(".item-cnt .total-item", $mVisCtn).text(count);
						});
						$mVisItem.on("translated.owl.carousel", function(event){
							var index =  event.relatedTarget.relative(event.relatedTarget.current()) + 1
							if (index < 10 ) {
								index = "0" + index;
							}
							$(".item-cnt .current-item", $mVisCtn ).text(index);
						});
						$mVisItem.owlCarousel ({
							items : 1
							, loop : true
							, autoplay : true
							, nav : false
							, dotsContainer : $(".ctrl-dots", $mVisCtn)
							, animateOut : "fadeOut"
							, autoplayTimeout : 6000
							, autoplayHoverPause : false
							, mouseDrag : false
						});

						$(".btn-prev", $mVisCtn ).on("click",function(){ $mVisItem.trigger("prev.owl.carousel");$mVisItem.trigger("stop.owl.autoplay");sld.trigger("play.owl.autoplay"); });
						$(".btn-next", $mVisCtn ).on("click",function(){ $mVisItem.trigger("next.owl.carousel");$mVisItem.trigger("stop.owl.autoplay");sld.trigger("play.owl.autoplay"); });
						$(".btn-stop", $mVisCtn ).on("click",function(){
							$(this).hide();
							$(this).prev().show();
							$mVisItem.trigger("stop.owl.autoplay");
						});
						$(".btn-play", $mVisCtn ).on("click",function(){
							$(this).hide();
							$(this).next().show();
							$mVisItem.trigger("play.owl.autoplay");
						});
					}
				}
			</script>
