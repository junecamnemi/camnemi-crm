						var mGal = {
							init : function() {
								this.mGalSld();
							},
							mGalSld : function() {
								var $mGalList = $(".mgal .issue-list");
								var $mGalTxtBox = $(".mgal .mgal-txt-wr");
								$mGalList.owlCarousel ({
									// autoplay : true
									 loop : true
									, nav : true
									, navContainer : $(".mgal .ctrl-btns")
									, dots : false
									, loop : true
									, responsive : {
										0 : {
											items : 1
											, margin : 0
											, autoWidth : false
											, autoHeight : false
										},
										700 : {
											items : 5
											, margin : 28
											, autoWidth : true
											, autoHeight : true
										}
									}
									, onInitialized : onInitialized
									, onTranslate : onTranslate
									, onTranslated : onTranslated
								});
								function onInitialized(event) {
									$firstItem = $(".owl-item.active", $mGalList).eq(0);
									$firstItem.addClass("sld-on");
									$(".owl-item", $mGalList).not($firstItem).removeClass("sld-on");
									mGalItem($firstItem);
								}
								function onTranslate (event) {
									$(".mgal-txt-wr").removeClass("on");
								}
								function onTranslated(event) {
									$currentItem = $(".owl-item.active", $mGalList).eq(0);
									$currentItem.addClass("sld-on");
									$(".owl-item", $mGalList).not($currentItem).removeClass("sld-on");
									mGalItem($currentItem);
								}
								function mGalItem ($obj) {
									var $mGalBox = $(".issue-cont", $obj);
									var mGalTit = $(".subject" , $mGalBox).text();
									var mGalTxt = $(".txt" , $mGalBox).text();
									var mGalDate = $(".date" , $mGalBox).text();
									var mGalLink = $("a" , $obj).attr("href");
									$(".tit", $mGalTxtBox).text(mGalTit);
									$(".txt", $mGalTxtBox).text(mGalTxt);
									$(".date", $mGalTxtBox).text(mGalDate);
									$("a", $mGalTxtBox).attr({
										"href": mGalLink,
										"title": mGalTit
									});
									$(".mgal-txt-wr").addClass("on");
								}
							}
						}
					</script>				</div>
			</div>
