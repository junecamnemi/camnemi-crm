						<script>

							$(function() {
								mPop.init();
							});
							var mPop= {
								init : function() {
									this.mPopSld();
								},
								mPopSld : function() {
									var $mPopList = $(".mpop .datalist");
									var $mPopCtrl = $(".mpop .ctrl-btns-wr");
									var mPopNum = $(".mpop .datalist .item").length;
									var mPopAuto = true
									if(mPopNum == 1 ){
										mPopAuto = false
									}
									$mPopList.on("initialized.owl.carousel", function(event){
										var count = event.item.count;
										$(".total-item", $mPopCtrl).text(count);
									});
									$mPopList.on("translated.owl.carousel", function(event){
										var index =  event.relatedTarget.relative(event.relatedTarget.current()) + 1
										$(".current-item", $mPopCtrl).text(index);
									});
									$mPopList.owlCarousel ({
										 items : 1
										, loop : mPopAuto
										, nav : true
										, navContainer : $(".ctrl-btns", $mPopCtrl)
										, dotsContainer : $(".ctrl-dots", $mPopCtrl)
										, autoplay:true
										, autoplayTimeout:4000
										
									});
								}
							}

						</script>
