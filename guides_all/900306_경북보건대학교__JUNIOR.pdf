<script type="text/javascript">
$('.family-site').find('select').on('change', function(){
	var url		= $(this).val();
	var target	= $(this).find('option:selected').attr('data-target') || '';

	if(target == "_blank") {
		window.open(url);
	} else {
		window.location.href = url;	
	}
});
</script>

<script type="text/javascript">
$(function() {
	/* 인풋데이트 */
	var	option = {changeMonth: true, changeYear: true, gotoCurrent:	false, yearRange:'-100:+1', onSelect:function(){
		$(this).prev('input[type="hidden"]').val(this.value.replace(/-/g,""))}
	};
	$.extend(option,$.datepicker.regional['ko']);
	$("input.date_input").datepicker(option).css({'width':'150px','text-align':'center'});
});
</script>

