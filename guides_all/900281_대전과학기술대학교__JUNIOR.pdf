					, "10 | O7tMHin9AWc | #부동산 #부동산재테크과 #성인학습자 | ★DST 전공 시뮬레이터 ㅣ 부동산재테크과"
					, "11 | YluDLuSQ-B4 | #간호사 #간호학과 #간호국가고시 #보건교사 | ★DST 전공 시뮬레이터 ㅣ 간호학과"
					, "12 | WNYa-8fSeKs | #케어복지상담과 #복지 #성인학습자 #상담심리 | ★DST 전공 시뮬레이터 ㅣ 케어복지상담과"
					, "13 | -VYoQCOAX78 | #컴퓨터 #공학 #소프트웨어 #AI #AI소프트웨어공학과 | ★DST 전공 시뮬레이터 ㅣ AI소프트웨어공학과"
					, "14 | 2oFU3NQt6IQ | #보건복지 #보건복지상담과 #사회복지사 | ★DST 전공 시뮬레이터 ㅣ 보건복지상담과"
					, "15 | rslH4HZmjhY | #경찰 #경호 #경찰경호 | ★DST 전공 시뮬레이터 ㅣ 경찰경호학과"
					, "16 | EbBti4ScCJM | #실내건축 #실내건축디자인과 #디자인 #인테리어 | ★DST 전공 시뮬레이터 ㅣ 실내건축디자인과"
					, "17 | -zituKFp90E | #성인학습자 #미래문화콘텐츠과 #바리스타 #웃음치료사 | ★DST 전공 시뮬레이터 ㅣ 미래문화콘텐츠과"
					, "18 | 8SFHA1nqEmQ | #문헌정보과 #도서관 #사서 | ★DST 전공 시뮬레이터 ㅣ 문헌정보과"
					, "19 | NTEXImtz5D8 | #컴퓨터공학&그래픽과 #컴공 #컴퓨터 #그래픽 | ★DST 전공 시뮬레이터 ㅣ컴퓨터공학&그래픽과"
					, "20 | 6QRUBTvMY5Q | #글로벌산업학과 #글로벌 #유학생 | ★DST 전공 시뮬레이터 ㅣ 글로벌산업학과"
					, "21 | x70MVqxdF0o | #외식조리제빵 #요리 #베이킹 | ★DST 전공시뮬레이터 ㅣ 외식조리제빵계열"
					, "22 | E2uitgQ9vXk | #치위생과 #치과 | ★DST 전공 시뮬레이터 ㅣ 치위생과"
					, "23 | klzrIfv-ZNE | #스마트기계공학과 #기계설계 #모빌리티 #제조전문인력 #취업비자 #뿌리기술전문기업 #산학일체형실습 #지역특화산업 | DST 키워드인터뷰 - 스마트기계공학과"
					, "24 | xiqHxRXGu3k | #문화유산보존기술과 #문화유산수리전문가 #문화유산 #전통문화해설사 #유물 #문화유산연구소 #성인학습자 | DST 키워드인터뷰 - 문화유산보존기술과"
					, "25 | Kqm8scaf2Qg | #자율전공학과 #대전과기대 #자율전공 #진로탐색 #융합교육과정 #진로설계 #마이크로디그리 #공유대학 | DST 키워드인터뷰 - 자율전공학과"
				);
				$tvList = $(".play-tv-list");
				$tvSld = $(".dataList", $tvList );
				$tvListCtrl = $(".play-tv-ctrl", $tvList );
				$tvListDelay = 5000;
				$tvListSpeed = 1000;
				$tvShuffleStd = 4;
				$tvShuffleIdx = 1;
				$tvShuffleNode = "";
				// ** 셔플먼저 하고, 슬라이더 구동
				this.tvShuffle().done( function( message ) {
					// ** console.log( message );
					// ** 썸네일 6개당 item 슬라이더 구동
					tvPlay.tvSld();
				}).fail( function( error ) {
					// ** console.log( error );
				}).always( function() {
					// ** console.log( "** 2. 셔플후 슬라이더 완료" );
					// ** 썸네일 클릭시 영상뷰포트로 유튜브 영상 이동
				});
			},
			tvShuffle : function() {
				$deferred2 = $.Deferred();
				try {
					$tvShuffleArr = shuffle( $tvArr );
					function shuffle( a ) {
						var j, x, i;
						for ( i=a.length; i; i-=1 ) {
							j = Math.floor( Math.random() * i );
							x = a[i - 1];
							a[i - 1] = a[j];
							a[j] = x;
						}
						return a;
					}
					$.each( $tvShuffleArr, function( index, item ) {
						// ** console.log( item );
						$tvInfo = item.split(" | ");
						// ** $tvInfo[0] : 사용않함. Index
						// ** $tvInfo[1] : 영상 index
						// ** $tvInfo[2] : 해쉬태그
						// ** $tvInfo[3] : 영상제목

						if ( index % $tvShuffleStd == 0 ) {
							$tvShuffleNode += "<div class='item #2' data-idx='" + $tvShuffleIdx + "'>";
						}
							$tvShuffleNode += "		<a href='https://youtu.be/" + $tvInfo[1] + "' target='_blank' title='새창열기'>";
							$tvShuffleNode += "			<span class='img'>";
							$tvShuffleNode += "				<img src='https://img.youtube.com/vi/" + $tvInfo[1] + "/hqdefault.jpg' alt=''>";
							$tvShuffleNode += "			</span>";
							$tvShuffleNode += "			<span class='txt-box'>";
							$tvShuffleNode += "				<span class='yb-ico'></span>";
							$tvShuffleNode += "				<span class='hash'>" + $tvInfo[2] + "</span>";
							$tvShuffleNode += "				<span class='tit'>" + $tvInfo[3] + "</span>";
							$tvShuffleNode += "			</span>";
							$tvShuffleNode += "		</a>";
						if ( (index % $tvShuffleStd == ($tvShuffleStd-1)) || (index+1) == $tvShuffleArr.length ) {
							$tvShuffleNode += "</div>";
							$tvShuffleIdx++;
						}
					});
					$tvSld.html( $tvShuffleNode );
					$deferred2.resolve( "** 1. shuffle 성공" );
				} catch( err ) {
					$deferred2.reject( err )
				}
				$(".total-item", $tvListCtrl ).text( $tvShuffleIdx-1 );
				return $deferred2.promise();
			},
			tvSld : function() {
				$tvSld.owlCarousel({
					items: 1
					, autoplay: true
					, autoplayTimeout : $tvListDelay
					, smartSpeed : $tvListSpeed
					, nav : true
					, navText: ["<span class='blind'>이전 장면</span>", "<span class='blind'>다음 장면</span>"]
					, navContainer: $(".play-tv-list .play-tv-ctrl")
					, dots: false
					, loop : true
					// ** , onInitialized : onInitd
					// ** , onTranslate :  onTranse
					, onTranslated : onTransed
				});
				function onTransed( event ) {
					var $element = $(event.target);
					var mTvIdx = $(".owl-item.active .item", $element ).data("idx");
					$(".current-item", $tvListCtrl ).text( mTvIdx );
				}
			}
		}
		var snsPlay = {		// ** SNS 핫핫
			init : function() {
				$snsList = $(".play-sns-list");
				$snsSld = $(".dataList", $snsList);
				this.snsSld();
			},
			snsSld : function() {
				$snsSld.owlCarousel({
					autoplay : true
					, loop : true
					, center : true
					, nav : true
					, navText : ["<span class='blind'>이전 장면 #1</span>", "<span class='blind'>다음 장면 #2</span>"]
					, dots : false
					, responsive : {
						0 : {
							items: 1
							, margin: 0
						}
						, 500 : {
							items: 2
							, margin: 20
						}
						, 769 : {
							items: 3
							, margin: 20
						}
						, 1400 : {
							items: 3
							, margin: 45
						}
					}
				});
			}
		}
		var achPlay = {		// ** 이미지 아카이브
			init : function() {
				this.achSld();
			},
			achSld : function() {
				var $achList = $(".ach-img-list");
				var $achImgBox = $(".ach-box");
				var $achImg = $(".photo", $achImgBox)
				var $achSld = (".dataList", $achList);
				var firstImgSrc = $(".item", $achSld ).eq(0).find("img").attr("src");
				if($achImgBox.find(".hide-img").length  == 0) {
					$achImg.find("img").after("<img src='"+ firstImgSrc +"' class='hide-img' alt=''>");
				}
				$(".ach-img-list .dataList").owlCarousel({
					autoplay: true
					, loop: true
					, nav: true
					, navText: ["<span class='blind'>이전 장면</span>", "<span class='blind'>다음 장면</span>"]
					, navContainer: $("#playAch .ach-btn")
					, dots: false
					, startPosition : 1
					, onInitialized : onSldImg
					, onTranslate : onTrans
					, responsiveRate : 0
					, responsive : {
						0 : {
							items: 2
							, margin: 10
						},
						399 : {
							items: 2
							, margin: 20
						},
						799 : {
							items: 3
							, margin: 25
						}
					}
				});
				function onTrans(event) {
					$element = $(event.target);
					$(".hide-img", $achImgBox).addClass("over");
					setTimeout(function() {
						onSldImg(event);
					}, 300);
				}
				function onSldImg(event) {
					$element = $(event.target);
					$element.find(".owl-item .item").removeClass("on");
					var prevItem = event.item.index - 1;
					$element.find(".owl-item").eq(prevItem).find(".item").addClass("on");
					var slideImg = $(".owl-item .on", $element).find(".img img").attr("src");
					var slideTit = $(".owl-item .on", $element).find(".tit").text();
					var slideLink = $(".owl-item .on", $element).find("a").attr("href");
					console.log(slideLink)
					$achImg.find("img").eq(0).attr("src", slideImg);
					$achImgBox.find(".txt").text(slideTit);
					$achImgBox.find("a").attr("href", slideLink);
					$(".hide-img", $achImgBox).removeClass("over").removeAttr("style");
					setTimeout(function() {
						$(".hide-img", $achImgBox).attr("src", slideImg);
					}, 700);
				}
			}
		}
		var achPlay2 = {		// ** 이미지 아카이브
			init : function() {
				this.achSld();
			},
			achSld : function() {
				var $achList = $(".ach-img-list2");
				var $achImgBox = $(".ach-box2");
				var $achImg = $(".photo2", $achImgBox)
				var $achSld = (".dataList", $achList);
				var firstImgSrc = $(".item", $achSld ).eq(0).find("img").attr("src");
				if($achImgBox.find(".hide-img").length  == 0) {
					$achImg.find("img").after("<img src='"+ firstImgSrc +"' class='hide-img' alt=''>");
				}
				$(".ach-img-list2 .dataList").owlCarousel({
					autoplay: true
					, loop: true
					, nav: false
					, dots: false
					, items: 1
					, margin: 0
					, startPosition: 0
					, autoHeight: true
					, responsiveRate : 0
					, onInitialized : onSldImg
					, onTranslated : onTrans
				});
				function onTrans(event) {
					$element = $(event.target);
					$(".hide-img", $achImgBox).addClass("over");
					setTimeout(function() {
						onSldImg(event);
					}, 300);
				}
				function onSldImg(event) {
					$element = $(event.target);
					$element.find(".owl-item .item").removeClass("on");
					var prevItem = event.item.index - 1;
					$element.find(".owl-item").eq(prevItem).find(".item").addClass("on");
					var slideImg = $(".owl-item .on", $element).find(".img img").attr("src");
					var slideTit = $(".owl-item .on", $element).find(".tit").text();
					var slideLink = $(".owl-item .on", $element).find("a").attr("href");
					console.log(slideLink)
					$achImg.find("img").eq(0).attr("src", slideImg);
					$achImgBox.find(".txt").text(slideTit);
					$achImgBox.find("a").attr("href", slideLink);
					$(".hide-img", $achImgBox).removeClass("over").removeAttr("style");
					setTimeout(function() {
						$(".hide-img", $achImgBox).attr("src", slideImg);
					}, 700);
				}
			}
		}

		// ** 유튜브 자동재생 + 연속재생 기능
		// 2. This code loads the IFrame Player API code asynchronously.
		var tag = document.createElement('script');
		tag.src = "https://www.youtube.com/iframe_api";
		var firstScriptTag = document.getElementsByTagName('script')[0];
		firstScriptTag.parentNode.insertBefore(tag, firstScriptTag);

		// 3. This function creates an <iframe> (and YouTube player) after the API code downloads.
		var player;
		function onYouTubeIframeAPIReady() {
			player = new YT.Player("iframe_youtube", {
				height : "",
				width : "",
				videoId : '5qPkaXsMGSY',
				playerVars : {
					"autoplay" : 0,
					"disablekb" : 'f'
				},
				events: {
					"onReady": onPlayerReady,
					"onStateChange": onPlayerStateChange,
					"onError": onPlayerError
				}
			});
		}

		// 4. The API will call this function when the video player is ready.
		function onPlayerReady(event) {
			event.target.playVideo();
		}

		// 5. The API calls this function when the player's state changes. The function indicates that when playing a video (state=1), the player should play for six seconds and then stop.
		var done = false;
		function onPlayerStateChange(event) {
			if ( event.data == YT.PlayerState.BUFFERING ) {
				playVideo();
			}
			if ( event.data == YT.PlayerState.UNSTARTED ) {
				playVideo();
			}
			if ( event.data == YT.PlayerState.ENDED ) {
				nextVideo();
			}
			if ( event.data == YT.PlayerState.PLAYING && !done ) {
				//setTimeout(unMute, 1000);
				done = true;
			}
		}
		function stopVideo() {
			player.stopVideo();
		}
		function unMute() {
			player.unMute();
		}
		function onPlayerReady(event) {
			event.target.mute();
			//event.target.setVolume(30);
			event.target.playVideo();
		}
		var is_first = true;
		function playVideo() {
			if ( typeof player.playVideo === "function" ) {
				if ( is_first ) {
					player.mute();
				}
				is_first = false;
				player.playVideo();
				player.setVolume( 30 );
			}
		}
		var play_index = 1;
		var youtube_all_array = ["5qPkaXsMGSY", "xG6LBgMZZO0", "wY9yqmfz9kc", "YfNjy9iwpdA"];
		function nextVideo() {
			if ( youtube_all_array.length == play_index ) {
				play_index = 0;
			}
			console.log( play_index + " : " + youtube_all_array[play_index] );
			player.loadVideoById({
				"videoId" : youtube_all_array[play_index],
				"suggestedQuality" : "large"
			});
			play_index++;
		}
		function onPlayerError( event ) {
			console.log( event );
		}
		$(window).load(function() {
			playVideo();
		});
	</script>
</body>
</html>	</body>
</html>


