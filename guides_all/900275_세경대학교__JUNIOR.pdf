<script language="javascript">
	function search(){
		if(bbs_search_form.selected == false)	{
			alert("검색을 체크해 주십시오.");
		} else if(bbs_search_form.search_order.value=="")	{
			alert("검색할 내용을 입력해 주십시오.");
			bbs_search_form.search_order.focus();
		} else {
			bbs_search_form.submit();
		}
	}
</script>

