<script>
	function hasCookie(name) {
		const cookies = document.cookie.split(';');
		for (let i = 0; i < cookies.length; i++) {
			const cookie = cookies[i].trim();
			if (cookie.startsWith(name + '=')) {
				return true;
			}
		}
		return false;
	}

	$(document).ready(function() {
		NetFunnel_Complete();


		
	})

	function goToBoard() {
		let index = $(".notiBox .tabMenu li.on").index();
		if(index == 0) location.href="/grad/contents/acdmicnoti.do?gotoMenuNo=acdmicnoti";
		if(index == 1) location.href="/grad/contents/notice.do?gotoMenuNo=notice";
		if(index == 2) location.href="/grad/contents/gradinfo.do?gotoMenuNo=gradinfo";
	}

</script>
