<script>

	document.getElementById('_word').addEventListener('keydown', function(event) {
		if (event.key === 'Enter') {
			fnSearchSub();
		}
	});


	function fnSearchSub(){
		let openNewWindow = window.open("about:blank");
		openNewWindow.location.href="https://www.dongduk.ac.kr/www/search/list.do?site_code=grad&searchWrd="+$("#_word").val();
	}

	function preview(fid, filePath) {
		let encodedUrl = encodeURIComponent(filePath);
		let convertType = "0";
		let fileType = "URL";
		let requestUrl = "https://viewer.dongduk.ac.kr/SynapDocViewServer/job?fid=" + fid
				+ "&filePath=" + encodedUrl + "&convertType=" + convertType
				+ "&fileType=" + fileType + "&downloadUrl=" + encodedUrl;

		window.open(requestUrl,  "preview");
	}
</script>


