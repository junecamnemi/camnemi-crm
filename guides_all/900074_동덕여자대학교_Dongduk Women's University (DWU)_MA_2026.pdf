<script>
	async function doGTranslateWithPostProcessing(langPair) {
		// doGTranslate 호출 (동기화 방식으로 가정하고 후처리)
		doGTranslate(langPair);

		// MutationObserver 생성
		const observer = new MutationObserver(() => {
			// body 내의 모든 텍스트 노드를 탐색하여 치환
			$('body').find("*").contents().filter(function() {
				return this.nodeType === Node.TEXT_NODE;
			}).each(function() {
				this.nodeValue = this.nodeValue.replace(/Dongdeok/g, "Dongduk");
				this.nodeValue = this.nodeValue.replace(/東徳/g, "同德");
			});
		});

		// body에 대한 변화를 감지하도록 observer 설정
		observer.observe(document.body, { childList: true, subtree: true });

		// 번역이 완료되면 observer 중지
		setTimeout(() => {
			observer.disconnect(); // 더 이상 감지할 필요 없음
		}, 10000); // 10초 후에 중지 (필요에 따라 조정 가능)
	}
</script>
