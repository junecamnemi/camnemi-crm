<script src="/assets/js/front.ui.js"></script>
<script>

	function js_board_search() { //2021.11.11 함수 추가!
		var frm = document.frm;
		str = frm.s.value;
		//str = Filter_XSS(str);	//XSScheck -php에서 적용함!
		frm.s.value = str;
		frm.nPage.value = "1";
		frm.submit();
	}

	function Filter_XSS(str) {  //2021.11.11 XSS관련 추가작업

		temp_str = str.trim();
		temp_str = temp_str.replace("'", "");
		temp_str = temp_str.replace('"', "");
		temp_str = temp_str.replace("--", "");
		temp_str = temp_str.replace(";", "");
		temp_str = temp_str.replace("<", "&lt;");
		temp_str = temp_str.replace(">", "&gt;");
		temp_str = temp_str.replace("&", "&amp;");
		temp_str = temp_str.replace(",", "&quot");
		temp_str = temp_str.replace("=", "");
		temp_str = temp_str.replace("alert","alert_");
		temp_str = temp_str.replace("script","script_");
		temp_str = temp_str.replace("iframe","iframe_");
		temp_str = temp_str.replace("eval","eval_");
		temp_str = temp_str.replace("innerHTML","innerHTML_");
		
		return temp_str;
	}

</script>
</body>
</html>
