						<script>
						function openLoginPopup(){
							if(confirm("서울시립대학교 구성원(교직원, 재학생, 졸업생)만 이용가능합니다. 팝업설정이 차단되어있는지확인하세요.")) {
								
								const popupWindow = window.open("https://sso.uos.ac.kr/svc/tk/Auth.eps?ac=Y&ifa=N&id=www&RelayState=/exsignon/sso/postLogin.jsp", "popupWindow", "width=430,height=670");

								if (!popupWindow || popupWindow.closed || typeof popupWindow.closed === 'undefined') {
									// 팝업 차단이 의심되면 사용자에게 대체 방법으로 confirm 창을 띄움
									if (!confirm("팝업이 차단되었습니다. 통합로그인은 포털홈페이지에서 가능합니다. 포털홈페이지로 이동하시겠습니까?")) {
										return;
									} else {
										window.open("https://portal.uos.ac.kr");
									}
								}
							}
						}
