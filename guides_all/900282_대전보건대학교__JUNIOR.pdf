<script>
 $(document).ready(function () {
 
  let now = new Date("2026-09-18 17:27:18");
  $('[data-date]').each(function(){
   const date = $(this).data("date");
   const dates= date.split('~');
   let date1 ='';
   let date2 = '';
   if(dates.length > 1 ){
    date1 = new Date(dates[0]);
    date2 = new Date(dates[1]);
   }else{
    date1 = new Date(dates[0]+' 00:00:00');
    date2 = new Date(dates[0]+' 23:59:59');
   }
   if(now.getTime() >= date1.getTime() && now.getTime() <= date2.getTime()  ){
    $(this).addClass("active");
    
   }
  });
  $('[data-date2]').each(function(){
   const date = $(this).data("date2");
   const dates= date.split('~');
   let date1 ='';
   let date2 = '';
   if(dates.length > 1 ){
    date1 = new Date(dates[0]);
    date2 = new Date(dates[1]);
   }else{
    date1 = new Date(dates[0]+' 00:00:00');
    date2 = new Date(dates[0]+' 23:59:59');
   }
   if(now.getTime() >= date2.getTime()){
    $(this).css('display', 'none').addClass('active');    
   } else { 
    //하단의 xxxx년 xx월 오픈예정 아예 없애달라고 요청옴 -> display none설정
    $(this).css('display', 'none').addClass('active');
   }
  });
 });
</script>

