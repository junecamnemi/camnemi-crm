            <section class="section" id="section05">
                <div class="layout">
                    <div class="major">
                        <h3 class="major-title">
                            <img src="/html/images/main/new/major-title.png" alt="대전보건대학교 전체학과, Hi.TomoRRow 내일을 기대해 !">
                        </h3>
                        <div class="major-list">
                                   <div class="major-list-item">
                                <strong class="major-list-item-title">
                                    <span class="major-list-item-title-main">
                                        <img src="/html/images/main/new/major-list4.svg" alt="">
                                        <span>전문기술석사과정</span>
                                        <i class="ri-arrow-right-line"></i>
                                    </span>
                                    <div class="major-list-item-import major-list-item-import-noimg">
                                        <span></span>
                                    </div>
                                </strong>
                                <ul class="major-list-item-info">
                                    <li><a href="https://www.hit.ac.kr/cls" target="_blank" title="새창으로 열림">신기술진단검사</a></li>
                                    <li><a href="https://www.hit.ac.kr/radiation" target="_blank" title="새창으로 열림">특수의료장비진단·치료향상</a></li>
        <li><a href="https://www.hit.ac.kr/det" target="_blank" title="새창으로 열림">디지털치위생관리</a></li>
        <li><a href="https://www.hit.ac.kr/chigi" target="_blank" title="새창으로 열림">디지털기반 치과보철</a></li>
