<script>
	$(function(){
		// Modal
		$(document).on('click', '.masterHandle', function(){
			if($(this).find('.introMet').val() == 'M'){
				$('#staticBackdropLabel').text($(this).find(".head-tit").text());
				$('#modalDate').text($(this).find('.date').text());
				$('#modalTit').text($(this).find('.tit').text());
				$('#modalCont').text($(this).find('.cont').val());
				var html = "";
				
				$(this).find('input[name=lastUsing]').each(function(){
					
					html += '<div class="col-md-4 col-12">'
                    	 +		'<div class="btn btn-secondary w-100 btn-temp-01 downFile" data-no="'+$(this).val()+'">'+$(this).data('name')+'</div>'
                    	 +	'</div>'
				});
				
				$('#attachFiles').html(html);
				$("#staticBackdrop").modal('show');
				
			}
		});
		
		$(document).on('click', '.downFile', function(){
			location.href='/usingDownload.do?no='+$(this).data('no');
		});
	});
</script>

