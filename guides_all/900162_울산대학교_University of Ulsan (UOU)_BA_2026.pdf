	<script>
		// 이미지 오류시 대체 이미지
		$(function() {
		    $("img").each(function (i, ele) {
		    	var uri = "";
		    	if($('#imgCheck').attr("class") == 'imgExc'){
		    		uri = "/images/front/default-a4.png";
		    	}else{
		    		uri = "/images/front/default-img.png";
		    	}
		        //이미 load된 이미지들을 처리하기 위한 코드
		        if (ele.src != '' && ele.complete == true && ele.naturalWidth == 0) {
		            $(this).attr("src", uri);
		        }
		        //load되지 않은 이미지들은 error 이벤트를 추가해준다
		        $(this).on('error', function () {
		            $(this).attr("src", uri);
		        });
		    });
		});
	
		function getCookie(name){
			var cookieName = name + "=";
			var i = 0;
			while(i <= document.cookie.length){
				var c = (i + cookieName.length);
				if(document.cookie.substring(i, c) == cookieName){
					if((lastCharCookie = document.cookie.indexOf(";", c)) == -1) lastCharCookie = document.cookie.length;
					return encodeURI(document.cookie.substring(c, lastCharCookie));
				}
				
				i = document.cookie.indexOf(" ", i) + 1
				if(i == 0) break;			
			}
			return "";
		}
		
		function setCookie(name, value, expire){
			var today = new Date(); 
			today.setDate(today.getDate() + expire);
			document.cookie = name + "=" + encodeURI(value) + "; expires=" + today.toGMTString() + "; path=/;";
		}
	</script><meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=0.25, maximum-scale=1.0, user-scalable=no">
