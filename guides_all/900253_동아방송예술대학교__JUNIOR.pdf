        <script type="text/javascript">
        
	        $(document).ready(function() {
		        $('.icon_area a[data-pop]').click(function() {
		            var pop_open_id = $(this).attr('data-pop');	            
		            $('#'+pop_open_id).toggleClass('none');
		            $('body').toggleClass('hidden');
		            
	                var link_length = $('#'+pop_open_id).find('.layer_pop .link_box li').length;	                
	                if (link_length==3) {
		                $('#'+pop_open_id).find('.layer_pop .link_box').css('minWidth','480px');
	                	$('#'+pop_open_id).find('.layer_pop .link_box').css('flex-flow','nowrap');
	                	$('#'+pop_open_id).find('.layer_pop .link_box li').css('width','calc(calc(100% - 50px) / 3');
	                } else {
		                $('#'+pop_open_id).find('.layer_pop .link_box').css('minWidth','320px');
	                	$('#'+pop_open_id).find('.layer_pop .link_box li').css('width','calc(calc(100% - 25px) / 2');    
	                }
		        })
		        
		        $('.layer_pop button').click(function() {       
		            $(this).parents('.layer_area').toggleClass('none');
		            $('body').toggleClass('hidden');
		        })
	                	
	          	$(window).resize(function() {
	          		if ($('.layer_area').not('.none').find('.layer_pop .link_box li').length) {
	          			var link_length =$('.layer_area').not('.none').find('.layer_pop .link_box li').length;	
		                if (link_length==3) {
		                	$('.layer_area').not('.none').find('.layer_pop .link_box li').css('width','calc(calc(100% - 50px) / 3');
		                } else {
		                	$('.layer_area').not('.none').find('.layer_pop .link_box li').css('width','calc(calc(100% - 25px) / 2');
		                }	
	          		}
	          	})

	        });
