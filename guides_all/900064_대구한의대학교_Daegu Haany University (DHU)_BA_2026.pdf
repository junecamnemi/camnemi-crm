<script> var wfBypassCheck = false;var wfContext = '';</script>
<script type="text/javascript">
	// 중복 로딩 방지용 헬퍼
	function isScriptLoaded(partialName) {
		var scripts = document.getElementsByTagName('script');
		for (var i = 0; i < scripts.length; i++) {
			if (scripts[i].src && scripts[i].src.indexOf(partialName) !== -1) {
				return true;
			}
		}
		return false;
	}

	// jquery-ui 관련 파일이 로딩되었는지 확인 (버전 포함 혹은 min 포함 시도 방지)
	function isJqueryUiLoaded() {
		var scripts = document.getElementsByTagName('script');
		for (var i = 0; i < scripts.length; i++) {
			var src = scripts[i].src;
			if (src && src.indexOf('jquery-ui') !== -1) {
				// 버전번호 또는 min 파일이 이미 로딩된 경우 → 로딩 불필요
				if (src.match(/jquery-ui(\.min)?(\.js)?(\?|\#|$)/) || src.match(/jquery-ui[\.\-]([0-9]+)/)) {
					return true;
				}
			}
		}
		return false;
	}

	function loadScript(src, callback) {
		if (isScriptLoaded(src)) {
			if (typeof callback === 'function') callback();
			return;
		}
		var script = document.createElement('script');
		script.src = src;
		script.charset = 'UTF-8';
		script.onload = (typeof callback === 'function') ? callback : function () {};
		document.head.appendChild(script);
	}

	function loadStyle(href) {
		if (document.querySelector('link[href="' + href + '"]')) return;
		var link = document.createElement('link');
		link.rel = 'stylesheet';
		link.href = href;
		document.head.appendChild(link);
	}

	function loadWebFilterResources(withJQuery, onComplete) {
		var loadCoreScripts = function () {
			if (!isJqueryUiLoaded()) {
				loadScript(wfContext + '/webfilter/js/jquery-ui.js', function () {
					loadStyle(wfContext + '/webfilter/css/webfilter.css');
					loadScript(wfContext + '/webfilter/js/webfilter.js', function () {
						if (typeof onComplete === 'function') onComplete();
					});
				});
			} else {
				loadStyle(wfContext + '/webfilter/css/webfilter.css');
				loadScript(wfContext + '/webfilter/js/webfilter.js', function () {
					if (typeof onComplete === 'function') onComplete();
				});
			}
		};

		if (withJQuery) {
			loadScript(wfContext + '/webfilter/js/jquery-1.11.3.min.js', loadCoreScripts);
		} else {
			loadCoreScripts();
		}
	}

	try {
		var needsOldJQuery = true;
		if (typeof jQuery !== 'undefined' && jQuery.fn && jQuery.fn.jquery) {
			var version = jQuery.fn.jquery.split('.');
			var major = parseInt(version[0], 10);
			var minor = parseInt(version[1], 10);
			needsOldJQuery = isNaN(major) || isNaN(minor) || (major < 1 || (major === 1 && minor < 6));
		}
		loadWebFilterResources(needsOldJQuery);
	} catch (e) {
		// fallback
		loadWebFilterResources(true);
	}
</script>
