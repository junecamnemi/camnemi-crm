	function viewPdfjs(pageNumber, id) {
		var $iframe = $('#pdf_object1');
		var iframeWindow = $iframe.prop('contentWindow'); 

		if (!iframeWindow) {
			console.error("iframe contentWindow에 접근할 수 없습니다.");
			return;
		}

		$(".pdf_index").removeClass("on");
		$("#"+id).addClass("on");

		try {
			var pdfViewerApp = iframeWindow.PDFViewerApplication;
			if (pdfViewerApp) {
				pdfViewerApp.page = pageNumber;
			} else {
			}
		} catch (e) {
		}
	}
	</script>

	
