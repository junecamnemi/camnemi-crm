<!-- //wrapper -->
<script>
	$(document).ready(() => {
		const url = (location.pathname+location.search).toLowerCase();
		$('#urlList a').each((i, v) => {
			const data_url = v.dataset.url.toLowerCase();
			v.classList.remove('color--blue');
			if (data_url === url) {
				v.classList.add('color--blue');
			}
		})
	})

	$(document).on('click', '.moveUrl', (e) => {
		const target = e.currentTarget.dataset.target;
		const url = e.currentTarget.dataset.url;
		window.open(url, target);
	})

	var as = document.getElementsByTagName('a');
	for(var i = 0 ; i < as.length; i++){
		if(as[i].getAttribute('target') != '_blank'){
			if( as[i].getAttribute('href') != null
				&& as[i].getAttribute('href').indexOf('/main.do') < 0
				&& as[i].getAttribute('href').indexOf('/file/download.do') < 0
				&& as[i].getAttribute('href').indexOf('javascript') < 0){

				as[i].setAttribute('target', '_self');
			}
		}
	}
</script>
