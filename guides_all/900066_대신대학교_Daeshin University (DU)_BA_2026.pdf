<script type="text/javascript">
$(document).ready(function(){
	$("#gnb_ent, #gnbOver_ent").bind('mouseover focusin', function(){
		if( $(window).width() > 767 ) {
			$("#gnb_ent").stop().animate({height:'400px'},{queue:false, duration:400, easing: 'easeInSine' });
			$("#gnb_ent").css('borderBottom','1px solid #ddd');
		}
	});

	$("#gnb_ent, #gnbOver_ent").bind('mouseout focusout', function(){
		if( $(window).width() > 767 ) {
			$("#gnb_ent").stop().animate({height:'75px'},{queue:false, duration:300, easing: 'easeInSine' });
			$("#gnb_ent").css('borderBottom','none');
		}
	});
});

$('#allmenu_btn_m').click(function() {
	m_height=$(document).height();
	$("#gnb_ent").animate({width:'toggle'},100);

	//if($("#gnbOver").is(':visible'))
	if($("#menu_btn_m").attr('src')=='/img/layout/btn_menuclose.png')
	{
		$("#menu_btn_m").attr('src', '/img/layout/btn_menuopen.png');
		$(".topright_ent").css('display','none');
			menu_bg_animate(0);
	}
	else
	{
		$("#menu_btn_m").attr('src', '/img/layout/btn_menuclose.png');
		$("#gnb_ent").css('height',m_height);
		$(".topright_ent").css('display','block');
			menu_bg_animate(1);
	}

	var accordion_tab = $('.mdepth1on'), accordion_content = $('.mdepth2');


	// When the tab is clicked function
	accordion_tab.on('click', function(e)
	{
		// Disable tab links
		e.preventDefault();

		// Remove the active class
		accordion_tab.removeClass('active');

		accordion_content.slideUp('normal');

//			jQuery("#mobiledepth .mdepth1").css('background-image','url(/img/common/arrow.png)');
//			jQuery("#mobiledepth .mdepth1").css('background-position','90% center');

		if($(this).next().is(':hidden') == true)
		{
			$(this).addClass('active');
			$(this).next().slideDown('normal');
			$("#mobiledepth .mdepth1").css('background-image','url(/img/common/arrow_top.png)');
		}
		else
		{
			$("#mobiledepth .mdepth1").css('background-image','url(/img/common/arrow.png)');
		}
	});
});

