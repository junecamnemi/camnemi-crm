<script>
function tabFunc(obj){
	
	var url = $(obj).find("option:selected").data("url");
	var target = $(obj).find("option:selected").data("target");
	
	if(target=="_blank"){
		window.open(url,target);
	}else{
		location.href=url;
	}
}

