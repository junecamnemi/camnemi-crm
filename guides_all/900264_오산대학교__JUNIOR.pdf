<script>
/* ──────────────────────
   ★ 시작 활성화 설정 여기만 바꾸세요!
   탭 id : 'free' | 'susi1' | 'susi2' | 'jeongsi'
   카드 번호 : 1부터 시작 (왼쪽에서 몇 번째 카드)
   ───────────────────────*/
var INIT = { tab: 'susi1', card: 1 };

/* ── 슬라이드 자동 재생 (이벤트 위임 방식) ── */
(function () {
  const wrapper  = document.getElementById('bannerWrapper');
  const slides   = document.querySelectorAll('.osan-slide');
  let current    = 0;
  let isPlaying  = true;
  let timer      = null;

  function showSlide(idx) {
    slides.forEach(s => s.classList.remove('active'));
    current = (idx + slides.length) % slides.length;
    slides[current].classList.add('active');
  }
  function start() { if (!timer) timer = setInterval(() => showSlide(current + 1), 5000); }
  function stop()  { clearInterval(timer); timer = null; }
  function setToggleState(pressed) {
    document.querySelectorAll('.ou-toggle').forEach(btn => btn.setAttribute('aria-pressed', pressed));
  }

  wrapper.addEventListener('click', function (e) {
    if (e.target.closest('.ou-prev')) {
      showSlide(current - 1);
      if (isPlaying) { stop(); start(); }
    } else if (e.target.closest('.ou-next')) {
      showSlide(current + 1);
      if (isPlaying) { stop(); start(); }
    } else if (e.target.closest('.ou-toggle')) {
      if (isPlaying) { stop();  setToggleState('true');  isPlaying = false; }
      else           { start(); setToggleState('false'); isPlaying = true;  }
    }
  });

  start();
})();

/* ── 카드 활성화 ── */
function activateCard(card) {
  if (!card) return;
  card.parentElement.querySelectorAll('.recruit-card').forEach(c => {
    c.classList.remove('active');
    const ch = c.querySelector('.card-character');
    if (ch) { ch.style.animation = 'none'; void ch.offsetWidth; ch.style.animation = ''; }
  });
  card.classList.add('active');

  /* 캐릭터 이미지가 없으면 생성, 있으면 재활용 */
  if (!card.querySelector('.card-character')) {
    const ch = document.createElement('div');
    ch.className = 'card-character';
    card.appendChild(ch);
  }
}

/* ── 탭 전환 ── */
function showGroup(groupId, btn) {
  document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
  document.querySelectorAll('.card-group').forEach(g => g.classList.remove('active'));
  btn.classList.add('active');
  const target = document.getElementById(groupId);
  if (target) { target.classList.add('active'); activateCard(target.querySelector('.recruit-card')); }
}

/* ── 초기 활성화 (INIT 설정값 적용) ── */
(function () {
  var group = document.getElementById(INIT.tab);
  if (!group) return;

  /* 탭 버튼 active */
  document.querySelectorAll('.tab-btn').forEach(function(btn) {
    var fn = btn.getAttribute('onclick') || '';
    btn.classList.toggle('active', fn.indexOf("'" + INIT.tab + "'") !== -1);
  });

  /* 카드그룹 active */
  document.querySelectorAll('.card-group').forEach(function(g) { g.classList.remove('active'); });
  group.classList.add('active');

  /* 카드 active */
  var cards = group.querySelectorAll('.recruit-card');
  var target = cards[INIT.card - 1] || cards[0];
  activateCard(target);
})();
</script>


