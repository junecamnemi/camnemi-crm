      <div class="page-dots" id="dots"></div>
      <button class="nav-btn" id="nextBtn" onclick="goPage(current+1)">다음 &gt;</button>
    </div>
  </div>
</div>


<!-- ── [4] 동작 스크립트(JS) : 탭 전환 · 페이지 넘김 · 아코디언 · 닫기 기능
        팝업을 body 최상위로 옮기고(GNB에 가려지는 문제 방지), 열려있는 동안
        배경 스크롤/배너 슬라이드쇼를 잠시 멈춰 체감 성능을 높입니다. ── -->
<script>
  // -- body 최상위로 팝업을 옮겨서(portal), 페이지 어딘가의 부모 요소가
  //    z-index/position으로 별도 stacking context를 만들어도 GNB 등에
  //    가려지지 않도록 보장합니다. (헤더에 덮이는 문제의 근본 원인 해결)
  (function(){
    var overlay = document.getElementById('ebook2027Overlay');
    if(overlay && overlay.parentElement !== document.body){
      document.body.appendChild(overlay);
    }
  })();

  var pages = document.querySelectorAll('.page');
  var tabs = document.querySelectorAll('.tab');
  var dotsWrap = document.getElementById('dots');
  var total = pages.length;
  var current = 0;

  for(var i=0;i<total;i++){
    var d = document.createElement('span');
    dotsWrap.appendChild(d);
  }
  var dots = dotsWrap.querySelectorAll('span');

  function goPage(n){
    if(n < 0) n = 0;
    if(n > total-1) n = total-1;
    current = n;
    pages.forEach(function(p,idx){ p.classList.toggle('active', idx===n); });
    tabs.forEach(function(t,idx){ t.classList.toggle('active', idx===n); });
    dots.forEach(function(d,idx){ d.classList.toggle('on', idx===n); });
    document.getElementById('prevBtn').disabled = (n===0);
    document.getElementById('nextBtn').disabled = (n===total-1);
    var scroller = pages[n].querySelector('.page-scroll');
    if(scroller) scroller.scrollTop = 0;
  }

  tabs.forEach(function(t){
    t.addEventListener('click', function(){ goPage(parseInt(this.dataset.page,10)); });
  });

  function closeBook(){
    document.getElementById('ebook2027Overlay').classList.remove('show');
  }

  document.addEventListener('keydown', function(e){
    if(e.key === 'Escape'){ closeBook(); }
    if(document.getElementById('ebook2027Overlay').classList.contains('show')){
      if(e.key === 'ArrowRight'){ goPage(current+1); }
      if(e.key === 'ArrowLeft'){ goPage(current-1); }
    }
  });

  goPage(0);

  // -- 팝업이 열려있는 동안 배경 스크롤/배너 슬라이드쇼를 멈춰서
  //    체감 렉을 줄입니다. (팝업 여닫는 방식은 그대로 두고
  //    class="show" 변화만 감지하므로 기존 onclick 코드는 그대로 써도 됩니다)
  (function(){
    var overlay = document.getElementById('ebook2027Overlay');
    if(!overlay) return;
    var prevBodyOverflow = '';
    var pausedByUs = false;

    function onOpen(){
      prevBodyOverflow = document.body.style.overflow;
      document.body.style.overflow = 'hidden';
      var toggleBtn = document.querySelector('.ou-toggle');
      if(toggleBtn && toggleBtn.getAttribute('aria-pressed') === 'false'){
        toggleBtn.click();
        pausedByUs = true;
      }
    }
    function onClose(){
      document.body.style.overflow = prevBodyOverflow;
      if(pausedByUs){
        var toggleBtn = document.querySelector('.ou-toggle');
        if(toggleBtn) toggleBtn.click();
        pausedByUs = false;
      }
    }

    var wasShown = overlay.classList.contains('show');
    var mo = new MutationObserver(function(){
      var isShown = overlay.classList.contains('show');
      if(isShown && !wasShown){ onOpen(); }
      if(!isShown && wasShown){ onClose(); }
      wasShown = isShown;
    });
    mo.observe(overlay, { attributes:true, attributeFilter:['class'] });
  })();
</script>

