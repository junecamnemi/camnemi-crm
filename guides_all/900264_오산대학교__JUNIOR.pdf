<!-- ============================================================
  2. 히어로 배너 + 입시 일정 아코디언
============================================================ -->
<style>
/* ── 히어로 섹션 공통 ── */
.osan-hero-section {
  width: 100%; position: relative;
  display: flex; flex-direction: column; align-items: center;
  background-color: #fff; overflow-x: hidden;
}

/* ── 슬라이드 배너 ── */
.osan-banner-wrapper {
  position: relative; width: 100%; height: 650px;
}
.osan-slide {
  position: absolute; top: 0; left: 0; width: 100%; height: 100%;
  display: flex; flex-direction: column; justify-content: flex-start;
  opacity: 0; z-index: 1;
  transition: opacity 1s ease-in-out;
  background-repeat: no-repeat; background-position: center; background-size: cover;
  pointer-events: none; /* 비활성 슬라이드 클릭 방지 */
}
.osan-slide::before {
  content: "";
  position: absolute; top: 0; left: 0; width: 100%; height: 100%;
  background: transparent;
  z-index: 1;
}

/* 메인배너 이미지 */
.osan-slide.active  { opacity: 1; z-index: 2; pointer-events: auto; }
.osan-slide.slide-1 { background-image: url('/usr/upload/ftp/2026_bn.jpg'); }
.osan-slide.slide-2 { background-image: url('/usr/upload/ftp/gik_bn.png'); }
.osan-slide.slide-3 { background-image: url('/usr/upload/ftp/op_bn.png'); }

.osan-slide.slide-4 { background-image: url('/usr/upload/ftp/Anchor_bn.jpg'); }
.osan-slide.slide-5 { background-image: url('/usr/upload/ftp/belt_bn.jpg'); }
.osan-slide.slide-6 { background-image: url('/usr/upload/ftp/op_bn.png'); }
.osan-slide.slide-7 { background-image: url('/usr/upload/ftp/stda_bn.jpg'); }
.osan-slide.slide-8 { background-image: url('/usr/upload/ftp/ds_bn.jpg'); }

/* 공통 inner 너비 */
.slide-inner,
.osan-total-container {
  width: 95%; max-width: 1600px;
  margin: 0 auto; box-sizing: border-box;
}

.slide-inner              { position: relative; z-index: 5; padding: 100px 0 0; }

/* ★ 메인배너 타이틀 */
.osan-slide .main-title   {
  font-size: 42px; font-weight: 700; margin-bottom: 12px; line-height: 1.3; word-break: keep-all;
  color: #111111;
  text-shadow: none;
}

/* ★ 메인배너 설명글 - 검정색 및 그림자 완벽 제거 */
.osan-slide .desc-text    {
  font-size: 18px; font-weight: 400; margin-bottom: 30px; opacity: 1;
  color: #111111;
  text-shadow: none;
}

/* 슬라이드별 자세히 보기 버튼 + 컨트롤러 래퍼 */
.slide-detail-row { margin-top: 6px; }

/* 버튼(자세히 보기)과 슬라이드 컨트롤러를 한 줄에 배치, 세로 중앙 정렬 */
.slide-controls-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 20px;
}

/* ★ 자세히 보기 버튼 - 검정색 테두리/글자 및 그림자 완벽 제거 */
.osan-btn-detail {
  display: inline-flex; align-items: center; justify-content: space-between;
  padding: 0 20px; width: 200px; height: 48px;
  border: 1px solid #111111; border-radius: 8px;
  color: #111111; text-decoration: none; font-size: 16px;
  background-color: transparent; transition: .3s;
  text-shadow: none;
  box-shadow: none;
  flex-shrink: 0;
}
.osan-btn-detail:hover {
  background-color: rgba(0, 0, 0, 0.08);
  box-shadow: none;
}

/* ★ 자세히 보기 아이콘 - 검정색 및 그림자 완벽 제거 */
.btn-icon-svg {
  width: 24px; height: 24px; fill: none; stroke: #111111; stroke-width: 2.5;
  stroke-linecap: round; stroke-linejoin: round;
  filter: none;
}

/* 슬라이드 컨트롤 (이전/재생·정지/다음) */
.ou-ctrls { display: flex; align-items: center; gap: 5px; }
.ou-ctrls button { background: none; border: none; cursor: pointer; padding: 5px; display: flex; align-items: center; }

/* ★ 슬라이드 컨트롤 아이콘 - 검정색 및 그림자 완벽 제거 */
.icon-line  {
  width: 24px; height: 24px; fill: none; stroke: #111111; stroke-width: 2.5;
  stroke-linecap: round; stroke-linejoin: round;
  filter: none;
}
.icon-play  { display: none; }
.ou-toggle[aria-pressed="true"] .icon-pause { display: none; }
.ou-toggle[aria-pressed="true"] .icon-play  { display: block; fill: #111111; }

/* ── 입시 일정 컨테이너 ── */
.osan-total-container {
  margin: -250px auto 0;
  display: flex; gap: 20px; align-items: flex-end;
  padding-bottom: 60px; position: relative; z-index: 20;
}

/* 탭 */
.accordion-area { flex: 1; min-width: 0; }
.recruit-tabs   { display: flex; gap: 10px; margin-bottom: 15px; }
.tab-btn {
  padding: 10px 17px; border-radius: 25px; border: none;
  background: rgba(0,0,0,.2); color: #fff; font-weight: 700;
  cursor: pointer; font-size: 14px; backdrop-filter: blur(5px); transition: .3s;
}
.tab-btn.active { background: #e61973; }

/* 카드 그룹 */
.card-group        { display: none; gap: 12px; height: 370px; width: 100%; }
.card-group.active { display: flex !important; }

.recruit-card {
  position: relative; flex: 1; min-width: 110px;
  background: #f4f4f4; border: 2px solid #9f9f9f; border-radius: 15px;
  padding: 25px; cursor: pointer;
  transition: flex .6s cubic-bezier(.4,0,.2,1), background .3s, border .3s;
  display: flex; flex-direction: column; overflow: hidden; box-sizing: border-box;
}
.recruit-card:not(.active):hover { background: #e9e9e9; border-color: #777; filter: brightness(.95); }

/* ★ 활성 카드: 핑크 배경 + 흰색 텍스트 */
.recruit-card.active {
  flex: 3;
  background: #e61973;
  border: 3px solid #e61973;
  box-shadow: 0 10px 30px rgba(230,25,115,.25);
}

/* 카드 워터마크 */
.recruit-card::after {
  content: ""; position: absolute; bottom: -15px; right: -40px;
  width: 170px; height: 170px;
  background: url('/usr/upload/ftp/osanlogo_7op.png') no-repeat center / contain;
  opacity: .8; transition: opacity .4s; pointer-events: none; z-index: 1;
}
.recruit-card.active::after { opacity: 0; }

/* 둥둥 캐릭터 */
@keyframes osan-float {
  0%   { transform: translateY(0px); }
  50%  { transform: translateY(-12px); }
  100% { transform: translateY(0px); }
}
@keyframes osan-char-in {
  0%   { opacity: 0; transform: translateY(-18px) scale(.85); }
  60%  { opacity: 1; transform: translateY(4px) scale(1.03); }
  100% { opacity: 1; transform: translateY(0px) scale(1); }
}
.recruit-card .card-character {
  position: absolute; top: 18px; right: 22px;
  width: 110px; height: 110px;
  background: url('https://www.osan.ac.kr/usr/upload/ftp/mini_dream.png') no-repeat center / contain;
  pointer-events: none; z-index: 3;
  opacity: 0;
}
.recruit-card.active .card-character {
  animation:
    osan-char-in .55s cubic-bezier(.34,1.56,.64,1) forwards,
    osan-float   3s ease-in-out .55s infinite;
}

/* 카드 내부 */
.card-title {
  font-size: 20px; font-weight: 800; color: #222;
  position: relative; z-index: 2; word-break: keep-all; line-height: 1.2; margin-bottom: 5px;
}
.card-date {
  font-size: 27px; font-weight: 900; margin-bottom: 15px;
  color: #9f9f9f; letter-spacing: -1px; position: relative; z-index: 2;
}

/* ★ 활성 카드 텍스트 전부 흰색 */
.recruit-card.active .card-title { color: #fff; }
.recruit-card.active .card-date  { color: rgba(255,255,255,.85); }

.card-content { opacity: 0; visibility: hidden; transition: opacity .4s; height: 0; overflow: hidden; display: flex; flex-direction: column; flex-grow: 1; }
.recruit-card.active .card-content { opacity: 1; visibility: visible; height: auto; margin-top: 5px; }
.card-desc    { font-size: 16px; color: #444; margin-bottom: 20px; line-height: 1.5; font-weight: 500; word-break: keep-all; }

/* ★ 활성 카드 설명 텍스트 흰색 */
.recruit-card.active .card-desc { color: rgba(255,255,255,.9); }

.card-btns            { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; margin-top: auto; }
.card-btns.single-btn { grid-template-columns: 1fr; }
.card-btns a {
  background: #fff; border: 1px solid #ddd; border-radius: 8px;
  padding: 10px 0; text-align: center; font-size: 13px; font-weight: 700;
  text-decoration: none; color: #333; transition: .2s;
}
.card-btns a:hover { border-color: #e61973 !important; color: #e61973 !important; }

/* ★ 활성 카드 버튼: 흰색 배경 + #e61973 텍스트 */
.recruit-card.active .card-btns a {
  background: #fff;
  border: 1px solid rgba(255,255,255,.9);
  color: #e61973;
}
.recruit-card.active .card-btns a:hover {
  background: #fdf2f7 !important;
  border-color: #fff !important;
  color: #e61973 !important;
}

/* ── 우측 바로가기 리스트 ── */
.right-list-area {
  width: 320px; height: 370px; background: #fff; border-radius: 12px;
  display: flex; flex-direction: column; overflow: hidden;
  box-shadow: 0 10px 30px rgba(0,0,0,.1);
  border: 2px solid #9f9f9f;
}
.list-item {
  flex: 1; display: flex; align-items: center; padding: 0 20px;
  font-weight: 700; color: #444; text-decoration: none;
  border-bottom: 1px solid #f0f0f0; transition: .3s; font-size: 14px;
  gap: 12px;
}
.list-item:last-child { border-bottom: none; }
.list-item:hover { background: #fdf2f7; color: #e61973; padding-left: 26px; }
.list-item:hover .list-item-arrow { stroke: #e61973; }

.list-item-icon {
  width: 32px; height: 32px; flex-shrink: 0;
  background: #fdf2f7; border-radius: 8px;
  display: flex; align-items: center; justify-content: center;
  transition: background .3s;
}
.list-item:hover .list-item-icon { background: #fce8f1; }
.list-item-icon svg { width: 18px; height: 18px; stroke: #e61973; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

.list-item-label { flex: 1; }

.list-item-arrow {
  width: 16px; height: 16px; flex-shrink: 0;
  fill: none; stroke: #e61973; stroke-width: 2.5;
  stroke-linecap: round; stroke-linejoin: round;
  transition: stroke .3s;
}

/* ── 반응형 ── */
@media screen and (max-width: 1650px) {
  .osan-banner-wrapper                  { height: 580px; }
  .slide-inner                          { padding: 80px 0 0; }
  .osan-total-container                 { flex-direction: column; align-items: center; margin-top: -220px; }
  .accordion-area                       { width: 100%; }
  .right-list-area                      { width: 100%; margin-top: 15px; height: auto; }
  .list-item                            { padding: 16px 20px; min-height: 60px; font-size: 15px; }
}
@media screen and (max-width: 1300px) {
  .osan-banner-wrapper                  { height: 550px; }
  .slide-inner                          { padding-top: 60px; }
  .osan-slide .main-title               { font-size: 26px; }

  /* 모바일: 컨트롤러가 자세히 보기 버튼 "아래"로 배치 */
  .slide-controls-row                   { flex-direction: column; align-items: flex-start; gap: 15px; }

  .osan-total-container                 { margin-top: -80px; }
  .card-group                            { flex-direction: column; height: auto; gap: 10px; }
  .recruit-card                          { flex: none !important; min-height: 100px; padding: 20px; }
  .card-desc                             { margin-bottom: 25px; }
  .card-title                            { font-size: 18px; }
  .card-date                             { font-size: 22px; }
}
</style>

