<style>
.osun-adm-news-section {
  width: 95%; max-width: 1600px;
  margin: 0 auto 40px;
  display: flex; gap: 40px;
  box-sizing: border-box;
}

/* ── 사이드 탭 ── */
.osun-adm-side-menu-tab {
  width: 280px; flex-shrink: 0;
  background: #fff; border-radius: 12px;
  display: flex; flex-direction: column;
  overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,.1);
  border: 2px solid #9f9f9f;
}
.osun-adm-tab-item {
  flex: 1; display: flex; align-items: center;
  padding: 0 18px 0 18px; min-height: 64px;
  font-weight: 700; color: #444; text-decoration: none;
  border-bottom: 1px solid #f0f0f0;
  transition: .3s; font-size: 14px; box-sizing: border-box;
  gap: 12px;
}
.osun-adm-tab-item:last-child { border-bottom: none; }
.osun-adm-tab-item:hover { background: #fdf2f7; color: #e61973; padding-left: 24px; }
.osun-adm-tab-item:hover .adm-tab-icon { background: #fce8f1; }
.osun-adm-tab-item:hover .adm-tab-arrow { stroke: #e61973; }

.adm-tab-icon {
  width: 34px; height: 34px; flex-shrink: 0;
  background: #fdf2f7; border-radius: 8px;
  display: flex; align-items: center; justify-content: center;
  transition: background .3s;
}
.adm-tab-icon svg {
  width: 18px; height: 18px;
  stroke: #e61973; fill: none;
  stroke-width: 2; stroke-linecap: round; stroke-linejoin: round;
}
.adm-tab-label { flex: 1; }
.adm-tab-arrow {
  width: 14px; height: 14px; flex-shrink: 0;
  fill: none; stroke: #e61973;
  stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round;
  transition: stroke .3s;
}

.osun-adm-news-content { flex: 1; min-width: 0; display: flex; gap: 40px; }
.osun-adm-list-column  { flex: 1; min-width: 0; }

.osun-adm-content-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 0 14px; margin: 0;
  font-size: 18px; font-weight: 800; color: #111;
  border-bottom: 2px solid #e61973;
}
.osun-adm-content-header > a {
  font-size: 14px !important; font-weight: 400 !important;
  color: #999 !important; text-decoration: none !important; padding: 0 !important;
}
.osun-adm-content-header > a:hover { color: #e61973 !important; }

.osun-adm-board-wrap ul,
.osun-adm-board-wrap ol { list-style: none !important; margin: 0 !important; padding: 0 !important; }
.osun-adm-board-wrap li { display: block !important; padding: 0 !important; margin: 0 !important; }

.osun-adm-board-wrap a {
  display: flex !important; align-items: center !important;
  padding: 15px 0 !important; gap: 8px !important;
  color: #111 !important; font-size: 16px !important; font-weight: 600 !important;
  text-decoration: none !important;
  border-bottom: 1px solid #f0f0f0 !important;
  transition: color .2s !important; width: 100% !important;
}
.osun-adm-board-wrap a:hover { color: #e61973 !important; }

.osun-adm-board-wrap a span:first-of-type { display: none !important; }
.osun-adm-board-wrap a span:last-of-type {
  flex-shrink: 0 !important; margin-left: auto !important;
  font-size: 13px !important; font-weight: 400 !important;
  color: #aaa !important; white-space: nowrap !important;
}

.osun-adm-board-wrap .new,
.osun-adm-board-wrap .icon_new,
.osun-adm-board-wrap img { display: none !important; }

@media (max-width: 1300px) {
  .osun-adm-news-section { flex-direction: column; gap: 20px; }
  .osun-adm-side-menu-tab { width: 100%; flex-direction: row; flex-wrap: wrap; }
  .osun-adm-tab-item { flex: 1 0 45%; min-height: 52px; justify-content: flex-start; padding: 0 15px; border-right: 1px solid #f0f0f0; }
  .osun-adm-tab-item:hover { padding-left: 15px; }
  .osun-adm-news-content { gap: 30px; }
}
@media (max-width: 640px) {
  .osun-adm-news-content { flex-direction: column; gap: 30px; }
}
</style>

