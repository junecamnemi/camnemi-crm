<style>
/* ── 퀵 메뉴 : PC ── */
.right-quick-menu {
  width: 90px; height: 440px;
  position: fixed; right: 30px; top: 200px;
  background: #fff; border-radius: 15px;
  box-shadow: 0 0 10px rgba(0,0,0,.1);
  display: flex; flex-direction: column;
  z-index: 15; overflow: hidden;
}
.right-quick-menu .con {
  height: calc(100% - 40px); width: 100%;
  display: flex; flex-direction: column; align-items: center;
  justify-content: space-between;
  padding: 12px 0 0; box-sizing: border-box;
}
.right-quick-menu .con a {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  width: 100%; padding: 10px 0;
  text-decoration: none; color: #333; font-size: 14px; font-weight: 500;
  box-sizing: border-box; text-align: center;d
}
.right-quick-menu .con a img { width: 36px; height: auto; }

/* 강조 항목 */
.right-quick-menu .con a.highlight {
  background: #ed1b71; color: #fff;
  padding: 14px 0; border-radius: 0; margin-bottom: 0;
}
.right-quick-menu .con a.highlight span { color: #fff; }
.right-quick-menu .con a.highlight img  { filter: brightness(0) invert(1); }

/* TOP 버튼 */
.right-quick-menu .top {
  height: 40px; width: 100%;
  background: #fff; color: #000;
  display: flex; align-items: center; justify-content: center;
  font-size: 14px; font-weight: 400;
  border-radius: 0 0 15px 15px; flex: 0 0 40px;
}

/* ── 퀵 메뉴 : 태블릿·모바일 ── */
@media (max-width: 1860px) {
  .right-quick-menu {
    background: transparent; box-shadow: none;
    width: auto; height: auto; position: static;
  }
  .right-quick-menu .con { padding: 0; gap: 0; height: auto; }
  .right-quick-menu .con a:not(.highlight),
  .right-quick-menu .top { display: none !important; }

  /* 관심학과 등록 → 하단 중앙 알약 버튼 */
  .right-quick-menu .con a.highlight {
    position: fixed; left: 50%; transform: translateX(-50%);
    bottom: calc(16px + env(safe-area-inset-bottom)); z-index: 9999;
    display: flex; flex-direction: row; align-items: center; justify-content: center;
    gap: 8px; width: min(92vw, 360px); padding: 12px 20px;
    border-radius: 9999px; background: #ed1b71; color: #fff; text-decoration: none;
    box-shadow: 0 8px 24px rgba(237,27,113,.35);
  }
  .right-quick-menu .con a.highlight img  { width: 22px; height: auto; filter: brightness(0) invert(1); margin: 0; }
  .right-quick-menu .con a.highlight span { color: #fff; font-size: 15px; line-height: 1.2; white-space: nowrap; }
  .right-quick-menu .con a.highlight:active {
    transform: translateX(-50%) translateY(1px);
    box-shadow: 0 6px 18px rgba(237,27,113,.35);
  }
}

/* 물결을 감싸고 있는 부모 컨테이너 (예: 메인 배너 영역) */
.main-visual {
    position: relative; /* 물결 위치의 기준점이 됨 */
}

/* 물결 영역 스타일 */
.wave {
    position: absolute;
    bottom: -70px; /* 배너 맨 아래에 딱 맞게 배치 (상황에 따라 세밀한 조절 필요) */
    left: 0;
    width: 100%;
    z-index: 10; /* 다른 요소들보다 위에 보이도록 설정 */
}

/* 물결 이미지 스타일 */
.wave img {
    width: 160%; /* 브라우저 가로폭에 꽉 차게 늘림 */
    display: block;
    pointer-events: none;
}
@media (max-width: 1780px) {
  .right-quick-menu .con a.highlight br { display: none; }
  .right-quick-menu .con a { margin-top: 0 !important; }
}
</style>

