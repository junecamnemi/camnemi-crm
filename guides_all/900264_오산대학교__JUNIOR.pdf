<!-- ??????????????????????????????????????????????????????????????
     [오산대학교 2027학년도 수시1차 모집요강 e북 팝업] ? 코드 시작
     ? 나중에 삭제하거나 수시2차용으로 수정할 때는
        이 줄부터 맨 아래 "코드 끝" 줄까지 통째로 지우고 새로 넣으면 됩니다.
     ?????????????????????????????????????????????????????????????? -->

<!-- ── [1] 폰트 불러오기 (Jua 제목용 서체 + Pretendard 본문 서체) ── -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Jua&display=swap" rel="stylesheet">
<link rel="stylesheet" as="style" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable.css">

<!-- ── [2] 스타일(CSS) : #ebook2027Overlay 안에서만 적용되도록 스코프 처리되어 있어 사이트 다른 부분과 충돌하지 않습니다 ── -->
<style>
  :root{
    --bg:#0083FF;
    --pink:#FF4892;
    --pink-light:#ffe4f0;
    --purple:#7048FF;
    --purple-light:#ece4ff;
    --ink:#1b2559;
    --paper:#ffffff;
    --sub:#6b7699;
  }
  #ebook2027Overlay *{box-sizing:border-box;}
  #ebook2027Overlay{
    font-family:'Pretendard', sans-serif;
    color:var(--ink);
  }

  /* 오버레이 */
  #ebook2027Overlay{
    position:fixed; inset:0;
    background:rgba(10,20,60,.6);
    display:none;
    align-items:center;
    justify-content:center;
    padding:20px;
    z-index:2147483000;
  }
  #ebook2027Overlay.show{ display:flex; }

  /* 팝업(책) */
  .book{
    position:relative;
    width:min(1200px, 100%);
    height:min(860px, 92vh);
    background:linear-gradient(165deg,#0091ff 0%, var(--bg) 45%, #0072e0 100%);
    border-radius:32px;
    display:flex;
    flex-direction:column;
    overflow:hidden;
    animation:pop .25s cubic-bezier(.2,1.4,.4,1);
  }
  @keyframes pop{ from{ transform:scale(.92); opacity:0;} to{ transform:scale(1); opacity:1;} }

  .book-head{
    color:#fff;
    padding:18px 24px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    flex:0 0 auto;
  }
  .book-head h1{
    font-family:'Jua', sans-serif;
    margin:0;
    font-size:19px;
    letter-spacing:.2px;
    min-width:0;
    word-break:keep-all;
  }
  .closeBtn{
    width:32px; height:32px;
    border-radius:50%;
    border:none;
    background:rgba(255,255,255,.22);
    color:#fff;
    font-size:16px;
    cursor:pointer;
    display:flex;
    align-items:center;
    justify-content:center;
    flex:0 0 auto;
  }
  .closeBtn:hover{ background:rgba(255,255,255,.38); }

  /* 탭 */
  .tabs{
    display:flex;
    gap:6px;
    padding:0 20px 12px;
    overflow-x:auto;
    flex:0 0 auto;
    scrollbar-width:none;
  }
  .tabs::-webkit-scrollbar{ display:none; }
  .tab{
    flex:0 0 auto;
    font-family:'Jua', sans-serif;
    font-size:15.5px;
    color:#fff;
    background:rgba(255,255,255,.16);
    border:none;
    padding:9px 15px;
    border-radius:999px;
    cursor:pointer;
    white-space:nowrap;
    opacity:.75;
    transition:background .15s ease, opacity .15s ease;
  }
  .tab.active{ background:#fff; color:var(--bg); opacity:1; }

  /* 페이지(흰 카드) */
  .pages{
    flex:1 1 auto;
    min-height:0;
    background:var(--paper);
    border-radius:26px 26px 0 0;
    padding:0;
    display:flex;
    flex-direction:column;
    position:relative;
  }
  .page{
    display:none;
    flex-direction:column;
    height:100%;
    min-height:0;
  }
  .page.active{ display:flex; animation:fadein .2s ease; }
  @keyframes fadein{ from{opacity:0; transform:translateY(6px);} to{opacity:1; transform:translateY(0);} }

  .page-scroll{
    flex:1 1 auto;
    min-height:0;
    overflow-y:auto;
    -webkit-overflow-scrolling:touch;
    padding:26px 28px 20px;
  }
  .page-scroll::-webkit-scrollbar{ width:8px; }
  .page-scroll::-webkit-scrollbar-thumb{ background:#dbe6ff; border-radius:8px; }

  /* 하단 페이지 넘김 */
  .book-foot{
    flex:0 0 auto;
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:12px 22px;
    background:var(--paper);
    border-top:1px solid #eef1fb;
  }
  .nav-btn{
    font-family:'Jua', sans-serif;
    font-size:15.5px;
    color:var(--bg);
    background:#eef5ff;
    border:none;
    padding:9px 16px;
    border-radius:999px;
    cursor:pointer;
    display:flex;
    align-items:center;
    gap:5px;
  }
  .nav-btn:disabled{ opacity:.35; cursor:default; }
  .page-dots{ display:flex; gap:6px; }
  .page-dots span{ width:6px; height:6px; border-radius:50%; background:#dbe6ff; }
  .page-dots span.on{ background:var(--bg); width:16px; border-radius:4px; }

  /* ===== 공통 컴포넌트 ===== */
  .sec-title{
    font-family:'Jua', sans-serif;
    font-size:23px;
    color:var(--ink);
    margin:0 0 4px;
    display:flex; align-items:center; gap:8px;
  }
  .sec-desc{ font-size:16.5px; color:var(--sub); margin:0 0 18px; line-height:1.6; }

  /* 표지 */
  .cover{
    align-items:flex-start; justify-content:center; text-align:left; height:100%;
    background:linear-gradient(165deg,#0091ff 0%, var(--bg) 45%, #0062cc 100%);
    margin:-1px;
  }
  .cover-badge{
    display:inline-block;
    background:rgba(255,255,255,.25);
    color:#fff;
    font-size:15px;
    font-weight:700;
    font-family:'Jua', sans-serif;
    padding:8px 16px;
    border-radius:999px;
    margin-bottom:18px;
  }
  .cover h2{
    font-family:'Jua', sans-serif;
    color:#fff;
    font-size:38px;
    line-height:1.4;
    margin:0 0 16px;
  }
  .cover p{ color:#ffffff; font-size:17px; line-height:1.8; max-width:460px; margin:0 0 26px; font-weight:500; }
  .cover-links{ display:flex; flex-wrap:wrap; gap:10px; }
  .cover-btn{
    font-family:'Jua', sans-serif;
    font-size:16.5px;
    padding:13px 20px;
    border-radius:14px;
    text-decoration:none;
    display:inline-flex; align-items:center; gap:6px;
  }
  .cover-btn.primary{ background:#fff; color:var(--bg); }
  .cover-btn.ghost{ background:rgba(255,255,255,.16); color:#fff; border:1px solid rgba(255,255,255,.5); }
  .cover-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:10px;
    margin-top:26px;
    max-width:480px;
  }
  .cover-chip{
    background:rgba(255,255,255,.16);
    border-radius:14px;
    padding:14px 10px;
    text-align:center;
    color:#fff;
    font-size:15px;
    font-weight:600;
    line-height:1.5;
    cursor:pointer;
  }
  .cover-chip b{ display:block; font-family:'Jua', sans-serif; font-size:21px; margin-bottom:4px; }

  /* 타임라인 */
  .timeline{ position:relative; padding-left:26px; margin:6px 0 22px; }
  .timeline::before{
    content:"";
    position:absolute; left:7px; top:6px; bottom:6px;
    width:2px; background:#e3eaff;
  }
  .t-item{ position:relative; padding-bottom:22px; }
  .t-item:last-child{ padding-bottom:0; }
  .t-dot{
    position:absolute; left:-26px; top:2px;
    width:16px; height:16px; border-radius:50%;
    background:var(--pink);
    border:3px solid #ffe4f0;
  }
  .t-item.out .t-dot{ background:var(--purple); border-color:var(--purple-light); }
  .t-label{ font-family:'Jua', sans-serif; font-size:18px; color:var(--ink); margin-bottom:3px; }
  .t-date{ font-size:17px; color:var(--pink); font-weight:600; }
  .t-item.out .t-date{ color:var(--purple); }
  .t-note{ font-size:15px; color:var(--sub); margin-top:3px; }

  .callout{
    background:#f4f8ff;
    border-radius:16px;
    padding:16px 18px;
    font-size:16px;
    line-height:1.8;
    color:var(--ink);
    margin-bottom:10px;
  }
  .callout.warn{ background:#fff5f5; }
  .callout.info{ background:#eef7ff; }
  .callout b{ color:var(--pink); }
  .callout .addr{ display:inline-block; margin-top:4px; color:var(--bg); font-weight:600; }

  /* 모집인원 표 */
  .qtable-wrap{ border-radius:22px; overflow:hidden; border:1px solid #eef1fb; margin-bottom:14px; }
  .qtable-scroll{ overflow-x:auto; -webkit-overflow-scrolling:touch; }
  table.qtable{ border-collapse:separate; border-spacing:0; width:100%; min-width:760px; font-size:15.5px; text-align:center; table-layout:fixed; }
  table.qtable thead th{ background:#f4f8ff; color:var(--ink); font-family:'Jua', sans-serif; font-weight:400; font-size:14.5px; padding:10px 4px; border-bottom:2px solid #e3eaff; }
  table.qtable thead th.grp-in{ background:var(--pink); color:#fff; font-size:17px; padding:12px 4px; border-bottom:none; }
  table.qtable thead th.grp-out{ background:var(--purple); color:#fff; font-size:17px; padding:12px 4px; border-bottom:none; }
  table.qtable thead th.sub-in{ background:var(--pink-light); color:#c4118f; }
  table.qtable thead th.sub-out{ background:var(--purple-light); color:#5a2cc9; }
  table.qtable tbody th, table.qtable tbody td{ padding:7px 5px; border-bottom:1px solid #f1f3fb; word-break:keep-all; }
  table.qtable tbody th.dept-g{ background:#f8faff; font-family:'Jua', sans-serif; font-size:14.5px; color:var(--bg); vertical-align:middle; }
  table.qtable tbody td.dept-n{ text-align:left; padding-left:8px; font-weight:600; font-size:15px; }
  table.qtable td.dept-n a, table.qtable th.dept-g a{ color:inherit; text-decoration:none; }
  table.qtable td.dept-n a:hover, table.qtable th.dept-g a:hover{ color:var(--pink); text-decoration:underline; }
  table.qtable td.in{ color:#c4118f; font-weight:600; background:#fffafc; }
  table.qtable td.out{ color:#5a2cc9; background:#fbfaff; }
  table.qtable td.tot{ color:var(--bg); font-weight:600; background:#f7fbff; }
  table.qtable td.for{ color:var(--purple); }
  .badge-sm{ display:inline-block; font-size:11.5px; font-family:'Jua', sans-serif; padding:2px 6px; border-radius:999px; margin-left:4px; color:#fff; background:var(--purple); vertical-align:middle; }

  /* 아코디언 (지원자격/제출서류) */
  .acc{ border:1px solid #eef1fb; border-radius:16px; margin-bottom:10px; overflow:hidden; }
  .acc-h{
    display:flex; align-items:center; justify-content:space-between;
    padding:13px 16px; cursor:pointer; background:#fafcff;
  }
  .acc-h .t{ font-weight:600; font-size:16.5px; color:var(--ink); display:flex; align-items:center; gap:8px; }
  .dot{ display:inline-block; width:9px; height:9px; border-radius:50%; flex-shrink:0; }
  .dot-pink{ background:var(--pink); }
  .dot-purple{ background:var(--purple); }
  .acc-h .arrow{ font-size:12.5px; color:var(--sub); transition:transform .2s ease; }
  .acc.open .arrow{ transform:rotate(180deg); }
  .acc-b{ max-height:0; overflow:hidden; transition:max-height .25s ease; }
  .acc.open .acc-b{ max-height:600px; }
  .acc-b-inner{ padding:2px 16px 14px; }
  .chk-list{ list-style:none; margin:0; padding:0; }
  .chk-list li{ position:relative; padding-left:20px; font-size:15.5px; line-height:1.7; color:var(--ink); margin-bottom:5px; word-break:keep-all; }
  .chk-list li::before{ content:""; position:absolute; left:2px; top:7px; width:7px; height:7px; border-radius:50%; background:var(--pink); }
  .acc.type-out .chk-list li::before{ color:var(--purple); }
  .chk-sub{ font-size:14.5px; color:var(--sub); margin:2px 0 6px 20px; line-height:1.6; }

  /* 뱃지형 아이콘 태그 */
  .icon-tag{ font-size:15px; }

  /* 반응형 */
