<script src="https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>
<script>
$(document).ready(function(){
	$('.translation-btn').on('click', function(e) {
		e.preventDefault();
		$('#_gnb .global').addClass('active');
	});
	$('.translation-links a').on('click', function() {
		$('.translation-links a').removeClass('active');
		$(this).addClass('active');
		const tolang = $(this).attr('data-lang');
		const gtcombo = document.querySelector('.goog-te-combo');
		if (gtcombo == null) {
			alert("Error: Could not find Google translate Combolist.");
			return false;
		}
		gtcombo.value = tolang; // 변경할 언어 적용
		gtcombo.dispatchEvent(new Event('change')); // 변경 이벤트 트리거
		$('#_gnb .global').removeClass('active');
	});
	$('.translation-btn-close').on('click', function() {
		$('#_gnb .global').removeClass('active');
	});

	// 번역이 완료된 후 호출되는 MutationObserver 설정
    const observer = new MutationObserver(function(mutations) {
		var eTitle = document.title;
		document.title = eTitle.replace(/\Kyemyung/g,"Keimyung");
        mutations.forEach(function(mutation) {
            if (mutation.type === 'childList' || mutation.type === 'characterData') {
                // 번역된 텍스트에서 잘못된 번역을 교체
                replaceTextInBody();
            }
        });
    });

	 // body를 감시
    observer.observe(document.body, {
        childList: true,
        subtree: true,
        characterData: true
    });
});

function googleTranslateElementInit() {
	//new google.translate.TranslateElement({pageLanguage: 'ko', autoDisplay: false}, 'google_translate_element');
	//new google.translate.TranslateElement({pageLanguage: 'en', layout: google.translate.TranslateElement.InlineLayout.SIMPLE}, 'google_translate_element');
	//new google.translate.TranslateElement({pageLanguage: 'ko', includedLanguages : 'en,ja'}, 'google_translate_element');
	new google.translate.TranslateElement({pageLanguage: 'ko', autoDisplay: false}, 'google_translate_element');
}

function replaceTextInBody() {
	const replaceData = {
	  "Kyemyung": "Keimyung"
	  //,"Department of Library": "Library Library"
	};
	$("body *").not("script, style").contents().each(function() {
        if (this.nodeType === Node.TEXT_NODE) { // 텍스트 노드만 처리
            let updatedText = this.nodeValue;
            // replaceMap의 각 키-값 쌍을 순회하며 텍스트 교체
            for (const [target, replacement] of Object.entries(replaceData)) {
                updatedText = updatedText.replace(new RegExp(target, "g"), replacement);
            }
			/*
			if(updatedText.indexOf(target)>-1){
				updatedText = updatedText.replace(new RegExp(target, "g"), replacement);
			}
			*/
            if (updatedText !== this.nodeValue) {
                this.nodeValue = updatedText; // 텍스트 교체
            }
        }
    });
}

function googleTranslateElementInit() {
	//new google.translate.TranslateElement({pageLanguage: 'ko', autoDisplay: false}, 'google_translate_element');
	//new google.translate.TranslateElement({pageLanguage: 'en', layout: google.translate.TranslateElement.InlineLayout.SIMPLE}, 'google_translate_element');
	//new google.translate.TranslateElement({pageLanguage: 'ko', includedLanguages : 'en,ja'}, 'google_translate_element');
	new google.translate.TranslateElement({pageLanguage: 'ko', autoDisplay: false}, 'google_translate_element');
}
</script>

