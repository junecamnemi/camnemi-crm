<link rel="stylesheet" href="https://unpkg.com/swiper/swiper-bundle.min.css"/>

<script src="https://unpkg.com/swiper/swiper-bundle.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
    console.log('DOM loaded, initializing Swiper...');
    
    // Swiper 초기화를 약간 지연시켜 DOM이 완전히 로드된 후 실행
            setTimeout(function() {
        console.log('Initializing Swiper...');
        
        // 기존 Swiper 인스턴스가 있다면 제거
        if (window.bookSwiper) {
            window.bookSwiper.destroy(true, true);
        }
        
        const swiperElement = document.querySelector('#book-gallery-slider .swiper');
        if (!swiperElement) {
            console.error('Swiper element not found!');
            return;
        }
        
        const swiper = new Swiper('#book-gallery-slider .swiper', {
            loop: true,
            autoplay: { 
                delay: 3000,
                disableOnInteraction: false
            },
            navigation: {
                nextEl: "#book-gallery-slider .swiper-button-next",
                prevEl: "#book-gallery-slider .swiper-button-prev"
            },
            slidesPerView: 1,
            spaceBetween: 20,
            breakpoints: {
                900: {
                    slidesPerView: 2,
                    spaceBetween: 15
                },
                1200: {
                    slidesPerView: 4,
                    spaceBetween: 10
                }
            }
        });
        
        window.bookSwiper = swiper;
    }, 800);
});
</script>
<script>
    // 배너 텍스트 데이터
    var bannerTexts = [
        {
            subtitle: "참 교사를 육성하는 지성교육",
            title: "참 교사를 육성하는 지성교육",
            description: "우리대학은 가톨릭 교회의 사제직을 지망하는 신학생과 수도자, 평신도 지도자들이 스승 예수그리스도께서 가르치신 진리를 탐구하고 복음을 선포하며 사랑을 실천하여 민족과 인류의 구원에 이바지하게 한다."
        },
        {
            subtitle: "참 신앙인을 길러내는 영성교육",
            title: "참 신앙인을 길러내는 영성교육",
            description: "우리대학은 가톨릭 교회의 신앙인을 길러내는 수도자와 평신도 지도자들이 스승 예수그리스도께서 가르치신 진리를 탐구하고 복음을 선포하며 사랑을 실천하여 민족과 인류의 구원에 이바지하게 한다."
        },
        {
            subtitle: "참 목자를 양성하는 사목교육",
            title: "참 목자를 양성하는 사목교육",
            description: "우리대학은 가톨릭 교회의 목자를 양성하는 수도자와 평신도 지도자들이 스승 예수그리스도께서 가르치신 진리를 탐구하고 복음을 선포하며 사랑을 실천하여 민족과 인류의 구원에 이바지하게 한다."
        }
    ];
    
    var currentTextIndex = 0;
    
    // 비디오 자동 재생 설정
    var video = document.querySelector('.banner-video');
    if (video) {
        video.muted = true;
        video.loop = true;
        video.autoplay = true;
        
        // 비디오 재생 시도
        video.play().then(function() {
            console.log('비디오 재생 성공');
        }).catch(function(error) {
            console.log('비디오 재생 실패:', error);
        });
    }
    
    // 자동 텍스트 변경 (5초마다)
    setInterval(function() {
        changeBannerText(1);
    }, 5000);
    
    // 메뉴 드롭다운 (데스크톱 전용)
    var menuTimeout;
    function bindDesktopHover() {
        $('.navigation li').each(function() {
            var $li = $(this);
            var $subNav = $li.find('.sub-nav');
            if ($subNav.length > 0) {
                $li.on('mouseenter.desktopHover', function() {
                    clearTimeout(menuTimeout);
                    $subNav.css({
                        'opacity': '1',
                        'visibility': 'visible',
                        'pointer-events': 'auto',
                        'display': 'block'
                    });
                });
                $li.on('mouseleave.desktopHover', function() {
                    menuTimeout = setTimeout(function() {
                        $subNav.css({
                            'opacity': '0',
                            'visibility': 'hidden',
                            'pointer-events': 'none'
                        });
                    }, 300);
                });
                $subNav.on('mouseenter.desktopHover', function() {
                    clearTimeout(menuTimeout);
                    $(this).css({
                        'opacity': '1',
                        'visibility': 'visible',
                        'pointer-events': 'auto',
                        'display': 'block'
                    });
                });
                $subNav.on('mouseleave.desktopHover', function() {
                    var $self = $(this);
                    menuTimeout = setTimeout(function() {
                        $self.css({
                            'opacity': '0',
                            'visibility': 'hidden',
                            'pointer-events': 'none'
                        });
                    }, 300);
                });
            }
        });
        $('.navigation').on('mouseleave.desktopHover', function() {
            menuTimeout = setTimeout(function() {
                $('.navigation .sub-nav').css({
                    'opacity': '0',
                    'visibility': 'hidden',
                    'pointer-events': 'none'
                });
            }, 300);
        });
    }
    function unbindDesktopHover() {
        $('.navigation li').off('.desktopHover');
        $('.navigation .sub-nav').off('.desktopHover');
        $('.navigation').off('.desktopHover');
    }
    if (window.matchMedia('(min-width: 768px)').matches) {
        bindDesktopHover();
        window._hoverBound = true;
    }
    window.addEventListener('resize', function() {
        var isDesktop = window.matchMedia('(min-width: 768px)').matches;
        if (isDesktop && !window._hoverBound) {
            bindDesktopHover();
            window._hoverBound = true;
        } else if (!isDesktop && window._hoverBound) {
            unbindDesktopHover();
            window._hoverBound = false;
        }
    });
    
    // 배너 텍스트 변경 함수
    function changeBannerText(direction) {
        // 현재 인덱스 업데이트
        if (typeof window.currentTextIndex === 'undefined') {
            window.currentTextIndex = 0;
        }
        
        window.currentTextIndex += direction;
        
        // 인덱스 범위 체크
        if (window.currentTextIndex >= bannerTexts.length) {
            window.currentTextIndex = 0;
        } else if (window.currentTextIndex < 0) {
            window.currentTextIndex = bannerTexts.length - 1;
        }
        
        // 텍스트 업데이트
        setBannerText(window.currentTextIndex);
    }

    // 특정 인덱스의 배너 텍스트 설정
    function setBannerText(index) {
        if (index >= 0 && index < bannerTexts.length) {
            window.currentTextIndex = index;
            
            var bannerText = document.getElementById('bannerText');
            var subtitle = document.getElementById('bannerSubtitle');
            var title = document.getElementById('bannerTitle');
            var description = document.getElementById('bannerDescription');
            
            if (bannerText && subtitle && title && description) {
                // 페이드 아웃 효과
                bannerText.style.opacity = '0';
                bannerText.style.transform = 'translateY(30px) scale(0.95)';
                
                // 페이드 아웃 완료 후 텍스트 변경
                setTimeout(function() {
                    subtitle.textContent = bannerTexts[index].subtitle;
                    title.textContent = bannerTexts[index].title;
                    description.textContent = bannerTexts[index].description;
                    
                    // 애니메이션 클래스 추가
                    bannerText.classList.add('changing');
                    subtitle.classList.add('changing');
                    title.classList.add('changing');
                    description.classList.add('changing');
                    
                    // 페이드 인 효과
                    bannerText.style.opacity = '1';
                    bannerText.style.transform = 'translateY(0) scale(1)';
                    
                    // 애니메이션 클래스 제거
                    setTimeout(function() {
                        bannerText.classList.remove('changing');
                        subtitle.classList.remove('changing');
                        title.classList.remove('changing');
                        description.classList.remove('changing');
                    }, 600);
                }, 300);
                
                // 도트 업데이트
                var dots = document.querySelectorAll('.banner-dots .dot');
                dots.forEach(function(dot, i) {
                    dot.classList.toggle('active', i === index);
                });
            }
        }
    }
    
    // 메인 비디오 재생 함수
    function playMainVideo() {
        const mainVideo = document.getElementById('main-video');
        const overlay = document.getElementById('main-video-overlay');
        const notice = document.getElementById('autoplay-notice');
        
        if (mainVideo) {
            // 현재 비디오에 자동재생 파라미터 추가
            const currentSrc = mainVideo.src;
            if (!currentSrc.includes('autoplay=1')) {
                const separator = currentSrc.includes('?') ? '&' : '?';
                mainVideo.src = currentSrc + separator + 'autoplay=1&mute=0';
            }
            
            // 오버레이와 안내 메시지 숨기기
            if (overlay) overlay.style.display = 'none';
            if (notice) notice.style.display = 'none';
        }
    }
    
    // 갓등중창단 비디오 변경 함수
    function changeMainVideo(videoId, title) {
        const mainVideo = document.getElementById('main-video');
        const videoInfo = document.querySelector('.video-info h3');
        const overlay = document.getElementById('main-video-overlay');
        const notice = document.getElementById('autoplay-notice');
        
        // 비디오 소스 변경 (자동재생 포함)
        mainVideo.src = `https://www.youtube.com/embed/${videoId}?autoplay=1&mute=0&rel=0&modestbranding=1&enablejsapi=1`;
        
        // 제목 변경
        videoInfo.textContent = title;
        
        // 오버레이와 안내 메시지 숨기기
        if (overlay) overlay.style.display = 'none';
        if (notice) notice.style.display = 'none';
        
        // 부드러운 전환 효과
        mainVideo.style.opacity = '0';
        setTimeout(() => {
            mainVideo.style.opacity = '1';
        }, 300);
    }
    
    // 신입생 모집 비디오 재생 함수
    function playAdmissionVideo() {
        const admissionVideo = document.getElementById('admission-main-video');
        const overlay = document.getElementById('admission-video-overlay');
        const notice = document.getElementById('admission-autoplay-notice');
        
        if (admissionVideo) {
            // 현재 비디오에 자동재생 파라미터 추가
            const currentSrc = admissionVideo.src;
            if (!currentSrc.includes('autoplay=1')) {
                const separator = currentSrc.includes('?') ? '&' : '?';
                admissionVideo.src = currentSrc + separator + 'autoplay=1&mute=0';
            }
            
            // 오버레이와 안내 메시지 숨기기
            if (overlay) overlay.style.display = 'none';
            if (notice) notice.style.display = 'none';
        }
    }
    
    // 페이지 로드 시 초기화
    document.addEventListener('DOMContentLoaded', function() {
        // 메인 비디오 오버레이가 보이도록 설정
        const overlay = document.getElementById('main-video-overlay');
        const notice = document.getElementById('autoplay-notice');
        
        if (overlay) overlay.style.display = 'flex';
        if (notice) notice.style.display = 'flex';
        
        // 신입생 모집 비디오 오버레이 설정
        const admissionOverlay = document.getElementById('admission-video-overlay');
        const admissionNotice = document.getElementById('admission-autoplay-notice');
        
        if (admissionOverlay) admissionOverlay.style.display = 'flex';
        if (admissionNotice) admissionNotice.style.display = 'flex';
});
</script>








