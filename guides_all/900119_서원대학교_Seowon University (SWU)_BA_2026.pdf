	<link href="/sites/iphak/style/css/style.css?v=49821028" rel="stylesheet">

	
			<!-- PC + TABLET + MOBILE -->
			<link media="only screen and (max-width: 460px)" href="/sites/iphak/style/css/style_common_Mobile.css?v=49821028" rel="stylesheet">
			<!--
			<link media="only screen and (min-width: 461px) and (max-width: 890px)" href="/sites/iphak/style/css/style_common_Tablet.css?v=49821028" rel="stylesheet">
			<link media="only screen and (min-width: 891px)" href="/sites/iphak/style/css/style_common_Desktop.css?v=49821028" rel="stylesheet">
			-->
		  
	
	
	
	

	
			<!-- PC + TABLET + MOBILE -->
			<script>
				function adjustStyle(width) {
					var isMobile = true;
					var isTablet = true;
					var $w7viewPort = $("#resResponsiveViewport");
					width = parseInt(width);
					if ( isMobile && (width < 460)) {/*mobile*/
						$("._responsiveObj").removeClass("Desktop");
						$("._responsiveObj").removeClass("Tablet");
						$("._responsiveObj").addClass("Mobile");
						$w7viewPort.attr("content", "width=460, user-scalable=no");
						$("body").css("zoom","1");
					} else if ( isTablet && ((width >= 461) && (width <= 890)) ) {/*Tablet*/
						$("._responsiveObj").removeClass("Desktop");
						$("._responsiveObj").addClass("Tablet");
						$("._responsiveObj").removeClass("Mobile");
						$w7viewPort.attr("content", "width=890, user-scalable=no");
						$("body").css("zoom","1");
					} else if ((width > 891)) {/*Desktop*/
						$("._responsiveObj").addClass("Desktop");
						$("._responsiveObj").removeClass("Tablet");
						$("._responsiveObj").removeClass("Mobile");
