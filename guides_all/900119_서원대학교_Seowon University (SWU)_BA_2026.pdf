function printByJquery(option) {  
	console.log(" printByJquery ");
	$("#_content").printElement(option);
}
     
function jf_quickPrint() {
	printByJquery({
		printMode: 'popup', //팝업설정 popup = 팝업창 , iframe = iframe
		styleToAdd:'width:100%; height:100%;',
		pageTitle:' 프린트 미리보기', //팝업 타이틀
		leaveOpen: true //false = 인쇄후 창닫기
	});
}   
       
</script>

	
