<script>
	$(".cate-name").each(function(i) {
		var _thisClassList = $(".cate-name").eq(i).attr("class");
		var numberClassList = Number(_thisClassList.replace("cate-name color-", ""));

		if(numberClassList%3 == 0) {
			$(".cate-name").eq(i).addClass("type3")
		} else if(numberClassList%3 == 1) {
			$(".cate-name").eq(i).addClass("type2")
		} else if(numberClassList%3 == 2) {
			$(".cate-name").eq(i).addClass("type1")
		}
	})
</script>



 
