<!-- 상단 배너 스크립트 2020-07-22 한승화 추가 -->
<script>
	$(document).ready(function() {
		// PC화면 시 상단배너 슬라이드
		var pcSlide = $("#slider").lightSlider({
			item:2,
			mode: 'slide',
			loop: true,      
			auto: true,      
			keyPress: true,  
			pager: true,    
			speed: 1500,     
			pause: 5000,
			slideMargin: 0,
			controls:false,
			enableTouch:false,
			enableDrag:false,
			currentPagerPosition: 'middle',
			addClass:'slide_pc'
		});
		
		// Moblie화면 시 상단배너 슬라이드
		var mSlide = $("#slider_m").lightSlider({
			item:1,
			mode: 'slide',
			loop: true,      
			auto: true,      
			keyPress: true,  
			pager: true,    
			speed: 1500,     
			pause: 5000,
			slideMargin: 0,
			controls:false,
			enableTouch:false,
			enableDrag:false,
			currentPagerPosition: 'middle',
			addClass:'slide_m'
		});
		
		$(window).resize(function(){
			var winReWidth = $(window).width(); // 브라우저 창의 넓이
			// 화면 리사이즈시 동작(슬라이드 함수 재실행)
			if(winReWidth < 820){
				mSlide.refresh();
			}else{
				pcSlide.refresh();
			}
		});
	});
</script>
<!-- 상단 배너 스크립트 2020-07-22 한승화 추가 -->