<script type="text/javascript">

$(document).ready(function(){
    fn_service_init();
    fn_service_contents();
    
});

function fn_service_init(){
    fn_service_R01();
	accodion(".eecalender_content", ".tit", ".cont");
}

function isValidCombineSearch() {
    if($.trim($("#aside_SEARCH_KEWORD").val())=="") {
        alert("검색 키워드를 입력하세요.");
        return false;
    }
    return true;
}

//모집전형 관리 조회
function fn_service_R01(){
    fn_comm_ajax({
        url: "/ajax/CM_MN02_SVC/CM_MN01_R40.do", 
        dataType: "json",
        async: false,
        success: function(data) {
        	//$("#recuitTemplate").tmpl(data[0]).appendTo("#recuitLayout");
        	$("#recuitLayout").empty();
        	for (var idx=0; idx<data.length; idx++) {
        		if(data[idx].USE_AT == "Y"){
    				$("#recuitTemplate_noti").tmpl(data[idx]).appendTo("#recuitLayout");
    			}else{
    				$("#recuitTemplate").tmpl(data[idx]).appendTo("#recuitLayout");
    			}
        		
        		fn_link_R98(data[idx].SERVICE_SN);
            } 
        }
    });
}

/* function fn_service_R02(SERVICE_SN) {
    fn_comm_ajax({
        url: "/ajax/CM_MN02_SVC/CM_MN01_R41.do", 
        dataType: "json",
        data: {PID : SERVICE_SN},
        success: function(data) {
        	for (var idx=0; idx<data.length; idx++) {
        		$("#serviceItem_"+data[idx].PID+" > ul").empty();
        		$("#serviceTemplate").tmpl(data).appendTo("#serviceItem_"+data[idx].PID+" > ul");
        		fn_link_R98(data[idx].SERVICE_SN);
        	}
        }
    });
} */

//링크 조회
function fn_link_R98(sn){
    fn_comm_ajax({
        url: "/ajax/CM_MN02_SVC/CM_MN01_R42.do",
        dataType: "json",
        data: "SERVICE_SN="+sn,
        success: function(data) {
            for (var idx=0; idx<data.length; idx++) {
            	
            	if(data[idx].SERVICE_TYPE=="1"){
            		//$("#linkitem1_"+data[idx].SERVICE_SN).empty();
            		$("#linkitem1_"+data[idx].SERVICE_SN).find("p.application").show();
                	$("#linkTemplate1").tmpl(data[idx]).appendTo("#linkitem1_"+data[idx].SERVICE_SN);	
            	}else{
            		//$("#linkitem2_"+data[idx].SERVICE_SN).empty();
            		//$(".application").hide();
            		//$("#linkitem1_"+data[idx].SERVICE_SN).find("p.application").hide();
            		$("#linkTemplate2").tmpl(data[idx]).appendTo("#linkitem2_"+data[idx].SERVICE_SN);
            		if(idx==0){
            			$("#linkitem2_"+data[idx].SERVICE_SN).find(".btnzone").css("margin-top","0").parent().css("margin-top","10px");
            		}
            	}
            }
        }
     });
};

function fn_service_contents() {
    var bbsRowCnt = 6;
    fn_comm_ajax({
        url: "/ajax/CM_MN02_SVC/CM_MN02_R21.do",
        data: "DOMAIN_SN=5&bbsRowCnt="+bbsRowCnt,
        async: false,
        success: function(data) {
            $.each(data, function(jsonName, grpData){
                var GRP_SN = grpData.GRP_SN;
                if (GRP_SN==null || GRP_SN==undefined) {
                    return;
                }

                // Quick Menu
                if (GRP_SN==3) {
                    var contentsArr = grpData.contentsList;
                    $("#quickMenuTemplate").tmpl(contentsArr).appendTo("#quickMenu");
                } 
            });
        }
    });
}
</script>
<!-- 입시캘린더 -->
