<script type="text/javascript">
$(document).ready(function(){
    fn_init();
});

function fn_init() {
    fn_main_contents();
    fn_department();
    fn_main_P01();
}

function fn_main_contents() {
    var bbsRowCnt = 6;
    fn_comm_ajax({
        url: "/ajax/CM_MN02_SVC/CM_MN02_R21.do",
        data: "DOMAIN_SN=5&bbsRowCnt="+bbsRowCnt,
        async: false,
        success: function(data) {
            $.each(data, function(jsonName, grpData){
                var GRP_SN = grpData.GRP_SN;
                if (GRP_SN==null || GRP_SN==undefined) {
                    return;
                }

                // 게시판 2개
                if (GRP_SN==0) {
                    var contentsArr = grpData.contentsList;
                    $("#bbsTabTemplate").tmpl(contentsArr).appendTo("#bbsTab");
                    for (var idx=0; idx<contentsArr.length; idx++) {
                        var bbsList = contentsArr[idx].bbsList;
                        var slider = "#slider" + (idx+1) + " > ul";
                        $("#bbsTabListTemplate").tmpl(bbsList).appendTo(slider);
                    }

                    var $board = $(".boardzone");
                    $board.find(".boardtit h2 a").on("click",function(){
                        if($(this).closest(".boardbox").hasClass("on")) return false;
                        $(this).closest(".boardbox").addClass("on").siblings().removeClass("on");
                        return false; 
                    });

                } else

                // 아래 좌측 4개
                if (GRP_SN==1) {
                    var contentsArr = grpData.contentsList;
                    $("#multiBanner1Template").tmpl(contentsArr).appendTo("#multiBanner1");
                } else

                // 전화번호 안내 3개
                if (GRP_SN==2) {
                    var contentsArr = grpData.contentsList;
                    $("#telZoneTemplate").tmpl(contentsArr).appendTo("#telzone");
                }

                // Quick Menu
                if (GRP_SN==3) {
                    var contentsArr = grpData.contentsList;
                    $("#quickMenuTemplate").tmpl(contentsArr).appendTo("#quickMenuMain");
                }
            });
        }
    });
}

function fn_department() {
    fn_comm_ajax({
        url: "/ajax/CM_MJ10_SVC/CM_MJ10_R03.do", 
        dataType: "json",
        data: {DOMAIN_SN : "5"},
        success: function(data) {
            for (var idx=0; idx<data.length; idx++) {
                fn_subject(data[idx].MENU_SN, idx);
            }
        }
    });
}

function fn_subject(MENU_SN, idx) {
    fn_comm_ajax({
        url: "/ajax/CM_MJ10_SVC/CM_MJ10_R04.do", 
        dataType: "json",
        data: {MENU_SN : MENU_SN},
        success: function(data) {
            $("#departmentTemplate").tmpl(data).appendTo("#department_" + idx);
        }
    });
}

function getCookie(name){
    var wcname = name + "=";
    var wcstart, wcend, end;
    var i = 0;
    while(i <= document.cookie.length) {
        wcstart = i;
        wcend   = (i + wcname.length);
        if(document.cookie.substring(wcstart, wcend) == wcname) {
            if((end = document.cookie.indexOf(";", wcend)) == -1)
                end = document.cookie.length;
            return document.cookie.substring(wcend, end);
        }
        i = document.cookie.indexOf("", i) + 1;
        
        if(i == 0)
            break;
    }
    return "";
}
</script>
</head>
<body>

<link rel="stylesheet" href="/resources/template/ko/css/pop_zone.css" />
<script>
function fn_main_P01() {
    fn_comm_ajax({
        url: "/ajax/CM_MN02_SVC/CM_MN02_P01.do",
        data: {DOMAIN_SN: domainSn },
        dataType: "json",
        success: function(data, textStatus, jqXHR) {
            for (var idx=0; idx<data.length; idx++) {
                var POPUP_OPTION = data[idx].POPUP_OPTION;
                var ARR_OPTION = POPUP_OPTION.split(",");
                data[idx].WIDTH = ARR_OPTION[0].substring(ARR_OPTION[0].indexOf("=")+1);
                data[idx].HEIGHT = ARR_OPTION[1].substring(ARR_OPTION[1].indexOf("=")+1);
                data[idx].TOP = ARR_OPTION[2].substring(ARR_OPTION[2].indexOf("=")+1);
                data[idx].LEFT = ARR_OPTION[3].substring(ARR_OPTION[3].indexOf("=")+1);
            }
            $("#listPopupTemplate").tmpl(data).appendTo("#pop_zone");
            
            for (var idx=0; idx<data.length; idx++) {
                var popupSn = data[idx].POPUP_SN;
                var cookieName = "main_PU_"+domainSn+popupSn;
                if (document.cookie.indexOf(cookieName+"=dummy") > -1 )   
                    $("#popup"+popupSn).hide();
            }
        }
    });
}

function fn_nopopup24(obj) {
    if ($(obj).prop("checked") == true) {
        var sn = $(obj).val();
        setCookie("main_PU_"+domainSn+sn, "dummy", 1);
        fn_popup_close(sn);
    }    
}

function fn_popup_close(sn) {
   $("#popup"+sn).hide(); 
}

function setCookie(name, value, expiredays) {
    var today = new Date();
    today.setDate(today.getDate() + expiredays);
    document.cookie = name + "=" + escape(value) + "; path=/; expires=" + today.toGMTString() + ";";
}
</script>

<div id="pop_zone"></div>
<script type="text/x-jquery-tmpl" id="listPopupTemplate">
    <div id="popup{%= POPUP_SN %}" class="pop" style="width:{%= WIDTH %}px;height:{%= HEIGHT %}px;top:{%= TOP %}px;left:{%= LEFT %}px;">
        <div class="ct">{%html CN %}</div>
        <p class="close">
            {%if CLOSE_COOKIE_AT=="Y"%}
			<span class="chk">
				<input type="checkbox" name="BTN_NOPOPUP24" value="{%= POPUP_SN %}" onclick="fn_nopopup24(this)" id="pop_{%= POPUP_SN %}"/><i></i>
			</span>
			<label for="pop_{%= POPUP_SN %}">오늘 하루 열지 않기</label>
            {%/if%}
            <button onclick="fn_popup_close({%= POPUP_SN %})" title="레이어 팝업 닫기">닫기</button>
        </p>
    </div>
</script>
