		var lnbCrt1 = $("#lnb > li:nth-child(2) > div > ul > li:nth-child(" + (gnbDep1) + ")");
		var lnbCrt2 = $("#lnb > li:nth-child(3) > div > ul > li:nth-child(" + (lnbDep1) + ")");
		var lnbCrt3 = $("#lnb > li:nth-child(4) > div > ul > li:nth-child(" + (lnbDep2) + ")");
		
		if(gnbCrt1) gnbCrt1.addClass("current");
		if(gnbCrt2) gnbCrt2.addClass("current");
		if(lnbCrt1) lnbCrt1.addClass("current");
		if(lnbCrt2) lnbCrt2.addClass("current");
		if(lnbCrt3) lnbCrt3.addClass("current");
	});
</script> </header>
