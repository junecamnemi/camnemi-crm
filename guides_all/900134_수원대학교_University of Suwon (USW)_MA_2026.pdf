			<script>
				function chk_submit(frmname){
					var frm = $("form[name='"+frmname+"']");
					var total_keyword = $("#search_krwd", frm).val();

					if($.trim(total_keyword) == ""){
						alert("검색어를 입력바랍니다.");
						$("#search_krwd", frm).focus();
						return false;
					}
				}
			</script>

