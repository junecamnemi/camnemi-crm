					<script type="text/javascript">
						//<![CDATA[
						$(document).ready(function() {

							$('.username-label').animate({ opacity: "0.5" })
								.click(function() {
									var thisFor	= $(this).attr('for');
									$('.'+thisFor).focus();
							});

							$('.username').focus(function() {

								$('.username-label').animate({ opacity: "0" }, "fast");

									if($(this).val() == "username")
										$(this).val() == "";

								}).blur(function() {

									if($(this).val() == "") {
										$(this).val() == "username";
										$('.username-label').animate({ opacity: "0.5" }, "fast");
									}
								});
							});
						//]]>
					</script>

