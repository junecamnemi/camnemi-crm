<script>
	function cal_prev() {
		var thisDate = '2026-09';
		var thisYear = thisDate.substring(0,4);
		var thisMonth = thisDate.substring(5,7);
		var thisDay = "1";
		var d = new Date(thisYear,thisMonth-1,thisDay);
		d.setMonth( d.getMonth() - 1 );
		var yy = d.getFullYear();
		var mm = d.getMonth()+1; mm = (mm < 10) ? '0' + mm : mm;
		var yymm = yy+"-"+mm;

		location.href = "/grad/design/index.asp?thisDate=" + yymm;

	}

	function cal_next() {
		var thisDate = '2026-09';
		var thisYear = thisDate.substring(0,4);
		var thisMonth = thisDate.substring(5,7);
		var thisDay = "1";
		var d = new Date(thisYear,thisMonth-1,thisDay);
		d.setMonth( d.getMonth() + 1 );
		var yy = d.getFullYear();
		var mm = d.getMonth()+1; mm = (mm < 10) ? '0' + mm : mm;
		var yymm = yy+"-"+mm;

		location.href = "/grad/design/index.asp?thisDate=" + yymm;
	}

	function cal_academic() {
		var thisDate = '2026-09';
		var thisYear = thisDate.substring(0,4);
		var thisMonth = thisDate.substring(5,7);
		var thisDay = "1";
		var d = new Date(thisYear,thisMonth-1,thisDay);
		var yy = d.getFullYear();
		var mm = d.getMonth()+1; mm = (mm < 10) ? '0' + mm : mm;
		var yymm = yy+"-"+mm;

		location.href = "/grad/design/academic_calendar.asp?oa=4&left=degree1_1&thisDate=" + yymm;
	}
</script>


