<script></script><script>
// --- 기존 메뉴 토글 및 앱 설치 스크립트 ---
let deferredPrompt;
window.addEventListener('beforeinstallprompt', (e) => {
  e.preventDefault();
  deferredPrompt = e;
});

function handleInstallClick() {
  if (deferredPrompt) {
    deferredPrompt.prompt();
    deferredPrompt.userChoice.then((choiceResult) => {
      deferredPrompt = null;
    });
  } else {
    toggleMenu('install-guide');
  }
}

function toggleMenu(menuId) {
  const menu = document.getElementById(menuId);
  const isAlreadyOpen = menu && menu.classList.contains('open');
  closeAllMenus();
  
  if (menu && !isAlreadyOpen) {
    menu.classList.add('open');
    if (menuId === 'menu-admission') document.getElementById('btn-admission')?.classList.add('active');
    if (menuId === 'menu-visa') document.getElementById('btn-visa')?.classList.add('active');
    if (menuId === 'menu-registration') document.getElementById('btn-registration')?.classList.add('active');
  }
}

function closeAllMenus() {
  document.querySelectorAll('.submenu-overlay').forEach(el => el.classList.remove('open'));
  document.querySelectorAll('.nav-item').forEach(el => el.classList.remove('active'));
}

// --- 언어 감지 및 다국어 자동 번역 스크립트 ---
const translations = {
  ko: {
