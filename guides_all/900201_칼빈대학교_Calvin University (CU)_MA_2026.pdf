    @import url('https://fonts.googleapis.com/css2?family=Pretendard:wght@300;400;500;600;700&display=swap');

    .calvin-quick-bar {
        font-family: 'Pretendard', -apple-system, BlinkMacSystemFont, system-ui, Roboto, sans-serif;
        max-width: 1000px; /* 메인 컨텐츠 영역과 너비 통일 */
        margin: 0 auto 40px;
        background-color: #ffffff;
        border: 1px solid #f1f5f9;
        border-radius: 16px; /* 둥근 모서리로 모던함 강조 */
        display: flex;
        justify-content: space-between;
        align-items: stretch;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03); /* 부드러운 그림자 */
        padding: 8px; /* 내부 여백 추가로 아이템들이 떠있는 느낌 부여 */
        gap: 8px; /* 아이템 간격 */
    }

    /* 개별 메뉴 아이템 (기본 PC 스타일) */
    .quick-item {
        flex: 1; 
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none; 
        padding: 16px 12px;
        border-radius: 12px; /* 아이템 자체도 둥글게 */
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        gap: 12px;
        background-color: transparent;
    }

    /* 마우스 호버 & 활성화 상태 */
    .quick-item:hover { 
        background-color: #f8fafc;
        transform: translateY(-2px);
    }
    
    .quick-item.active {
        background-color: #002855; /* 기존 캘빈 레드(#8a1529)에서 이전 페이지들과 톤을 맞춘 네이비로 변경. 원하시면 #8a1529로 복원 가능 */
        box-shadow: 0 4px 12px rgba(0, 40, 85, 0.15);
    }
    
    .quick-item:hover .quick-icon { color: #002855; }
    .quick-item.active .quick-icon { color: #ffffff; }
    
    .quick-item:hover .quick-text-kr { color: #002855; }
    .quick-item.active .quick-text-kr { color: #ffffff; }
    
    .quick-item:hover .quick-text-en { color: #64748b; }
    .quick-item.active .quick-text-en { color: rgba(255, 255, 255, 0.7); }

    /* 아이콘 */
    .quick-icon {
        width: 28px; /* 너무 크지 않게 조정 */
        height: 28px;
        color: #475569; /* 기본은 부드러운 회색 */
        transition: all 0.3s ease;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .quick-icon svg { width: 100%; height: 100%; fill: currentColor; }

    /* 텍스트 그룹 */
    .quick-text-group { text-align: left; display: flex; flex-direction: column; justify-content: center; }
    
    .quick-text-kr {
        font-size: 15px;
        font-weight: 600;
        color: #334155;
        display: block;
        margin-bottom: 2px;
        transition: color 0.3s ease;
        letter-spacing: -0.02em;
    }
    
    .quick-text-en {
        font-size: 12px;
        font-weight: 400;
        color: #94a3b8;
        display: block;
        transition: color 0.3s ease;
        letter-spacing: 0.02em;
    }

    /* 📱 모바일 반응형 (한 줄에 6개 배치) */
    @media (max-width: 768px) {
        .calvin-quick-bar {
            flex-wrap: nowrap;
            border-radius: 12px;
            padding: 6px;
            gap: 4px;
            margin: 0 16px 24px; /* 모바일 좌우 여백 */
        }
        .quick-item {
            flex: 1; 
            flex-basis: 0; 
            flex-direction: column; 
            padding: 12px 2px; 
            gap: 6px; 
            border-radius: 8px;
        }
        
        /* 모바일 호버 이펙트 간소화 (터치 기기 고려) */
        .quick-item:hover { transform: none; }
        
        .quick-icon {
            width: 22px; 
            height: 22px;
            margin-bottom: 2px;
        }
        .quick-text-group {
            text-align: center;
            width: 100%; 
            align-items: center;
        }
        .quick-text-kr {
            font-size: 11px; 
            font-weight: 600;
            margin-bottom: 0;
            letter-spacing: -0.05em; 
            white-space: nowrap; 
        }
        .quick-text-en {
            display: none; /* 모바일에서는 영문 숨김 처리하여 깔끔하게 (6개 배치 공간 확보) */
        }
    }

	.device_type_m .pc_section #padding_w20260110b0a95dc87e7ca {
		height: 15px !important;
	}
	@media all and (max-width:768px) {
		.pc_section #padding_w20260110b0a95dc87e7ca {
			height: 15px !important;
		}
	}

    @import url('https://fonts.googleapis.com/css2?family=Pretendard:wght@300;400;500;600;700;800&display=swap');

    /* 공통 컨테이너 설정 */
    .calvin-layout-container {
        font-family: 'Pretendard', -apple-system, BlinkMacSystemFont, system-ui, Roboto, sans-serif;
        max-width: 1000px;
        margin: 0 auto;
        padding: 20px;
        box-sizing: border-box;
        color: #333d4b;
        letter-spacing: -0.02em;
    }
    .calvin-layout-container * { box-sizing: border-box; }

    /* 언어 선택 탭 */
    .lang-selector { 
        display: flex; 
        gap: 8px; 
        margin-bottom: 40px; 
        justify-content: center; 
        flex-wrap: wrap; 
    }
    .lang-btn-process { 
        background: #f8fafc; 
        border: none; 
        padding: 10px 24px; 
        border-radius: 30px; 
        cursor: pointer; 
        font-size: 14px; 
        font-weight: 500; 
        color: #64748b; 
        transition: all 0.3s ease; 
        box-shadow: inset 0 0 0 1px #e2e8f0;
    }
    .lang-btn-process:hover { 
        background: #f1f5f9; 
        color: #334155; 
    }
    .lang-btn-process.active { 
        background: #002855; 
        color: white; 
        box-shadow: 0 4px 12px rgba(0, 40, 85, 0.2); 
        font-weight: 600; 
    }

    /* 다국어 섹션 토글 */
    .process-lang-content { 
        display: none; 
    }
    .process-lang-content.active { 
        display: block; 
        animation: fadeIn 0.4s ease forwards; 
    }

    /* 입학 진행 절차 (Process Flow) 디자인 */
    .process-header {
        text-align: center;
        margin-bottom: 40px;
    }
    .process-header h2 {
        font-size: 28px;
        font-weight: 700;
        color: #002855;
        margin: 0 0 8px 0;
    }
    .process-header p {
        font-size: 15px;
        color: #64748b;
        margin: 0;
        font-weight: 400;
    }

    .process-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
    }

    .process-card {
        background: #ffffff;
        border: 1px solid #f1f5f9;
        border-radius: 16px;
        padding: 24px;
        position: relative;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        display: flex;
        flex-direction: column;
    }

    .process-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 30px rgba(0, 40, 85, 0.08);
        border-color: #cbd5e1;
    }

    .step-num {
        font-size: 48px;
        font-weight: 800;
        color: #f8fafc;
        position: absolute;
        top: 10px;
        right: 16px;
        line-height: 1;
        z-index: 1;
        transition: color 0.3s ease;
    }

    .process-card:hover .step-num {
        color: #f1f5f9;
    }

    .process-content {
        position: relative;
        z-index: 2;
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .process-content h4 {
        font-size: 16.5px;
        font-weight: 700;
        color: #1e293b;
        margin: 16px 0 12px 0;
        line-height: 1.4;
    }

    .process-content p {
        font-size: 14px;
        color: #475569;
        line-height: 1.6;
        margin: 0;
        word-break: keep-all;
    }

    /* Step 6 국내/국외 분할 설명 부분 */
    .split-desc {
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin-top: 4px;
    }

    .split-item {
        background: #f8fafc;
        padding: 12px 14px;
        border-radius: 8px;
        font-size: 13.5px;
        color: #475569;
        line-height: 1.4;
        word-break: keep-all;
    }

    .split-item strong {
        display: block;
        color: #002855;
        font-size: 13px;
        margin-bottom: 6px;
    }

    /* 애니메이션 및 반응형 */
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    @media (max-width: 900px) {
        .process-grid { grid-template-columns: repeat(2, 1fr); }
    }
    
    @media (max-width: 500px) {
