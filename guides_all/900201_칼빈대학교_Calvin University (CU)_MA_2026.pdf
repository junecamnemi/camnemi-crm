/* ✅ 현재 페이지 활성화 자동 감지 스크립트 */
(function() {
    var currentPath = window.location.pathname; 
    var menuItems = document.querySelectorAll('.quick-item');

    menuItems.forEach(function(item) {
        var linkUrl = item.getAttribute('href');
        try {
            var urlObj = new URL(linkUrl, window.location.origin);
            if (linkUrl && currentPath.indexOf(urlObj.pathname) !== -1 && urlObj.pathname !== '/') {
                item.classList.add('active');
            }
        } catch(e) {
            // URL 파싱 에러시 무시
        }
    });
})();


/* 언어 탭 전환 기능 */
function changeLangProcess(lang) {
    // 탭 버튼 활성화 변경
    document.querySelectorAll('.lang-btn-process').forEach(function(btn) {
        btn.classList.remove('active');
    });
    document.querySelector('.lang-btn-process[onclick="changeLangProcess(\'' + lang + '\')"]').classList.add('active');
    
    // 내용 숨김 및 표시
    document.querySelectorAll('.process-lang-content').forEach(function(content) {
        content.classList.remove('active');
        void content.offsetWidth; // 애니메이션 초기화를 위한 강제 리플로우
    });
    document.querySelector('.process-' + lang).classList.add('active');
}

