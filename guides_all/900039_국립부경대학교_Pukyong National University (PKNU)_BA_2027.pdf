								<option value="1">학부과정(Undergraduate)</option>
								<option value="2">대학원과정(Graduate)</option>
								<option value="3">연수과정(Korean language program)</option>
							</select>
						</div>

						<div class="textname">
							<input type="text" id="name" name="name" placeholder="이름을 입력하세요 (Please enter your name)">
							<input type="text" id="tel" name="tel" placeholder="연락처를 입력하세요 (Please enter your phone number)">
							<input type="text" id="email" name="email" placeholder="이메일을 입력하세요 (Please enter your email)">
						</div>

						<div class="textcontact">
							<textarea type="text" id="contents" name="contents" placeholder="내용을 입력하세요 (Please enter your content)"></textarea>
						</div>

						<div class="contact_btn">
							<input type="submit" class="contact_btn_submit" value="문의하기 (Inquire)">
						</div>
					</div>
				</div>
			</section>
			<script>
			$(function(){
				$('.contact_btn_submit').click(function(){
					var inquiry = $('#inquiry').val();
					var name = $('#name').val();
					var tel = $('#tel').val();
					var email = $('#email').val();
					var contents = $('#contents').val();
					var mode = 'insert';

					if(name == '') {
						alert('이름을 입력하세요 (Please enter your name)');
						$('#name').focus();
						return false;
					}
					if(tel == '') {
						alert('연락처를 입력하세요 (Please enter your phone number)');
						$('#tel').focus();
						return false;
					}
					if(email == '') {
						alert('이메일을 입력하세요 (Please enter your email)');
						$('#email').focus();
						return false;
					}
					if(contents == '') {
						console.log(contents);
						alert('내용을 입력하세요 (Please enter your content)');
						$('#contents').focus();
						return false;
					}

					if($('#submitChk').val() == 'N'){
						$('#submitChk').val('Y');
					} else {
						alert('데이터 전송중입니다.');
						return false;
					}

					$.ajax({
						type:"POST",
						url:"/program/ajax/talk_write_ok.php",
						data : ({mode:mode, inquiry:inquiry, name:name, tel:tel, email:email, contents:contents}),

						success: function (data){
							if(data == 'success') {
								$('#submitChk').val('N');
								$('#name').val('');
								$('#tel').val('');
								$('#email').val('');
								$('#contents').val('');
								alert('등록완료되었습니다.');
							}
						}
					});
				});
			});
			</script>
			<!-- //Guide Book & Contact -->

			<!-- SNS -->
			<section id="sns_section" class="sns_section">
				<div class="inner">
					<div class="m_tit">SNS</div>

					<div class="sns_con">
						<ul class="instagram">
						<!--
							<li><figure><img src="/image/sns01.jpg" alt=""></figure></li>
							<li><figure><img src="/image/sns02.jpg" alt=""></figure></li>
							<li><figure><img src="/image/sns03.jpg" alt=""></figure></li>
							<li><figure><img src="/image/sns04.jpg" alt=""></figure></li>
							<li><figure><img src="/image/sns05.jpg" alt=""></figure></li>
							<li><figure><img src="/image/sns06.jpg" alt=""></figure></li>
							<li><figure><img src="/image/sns07.jpg" alt=""></figure></li>
							<li><figure><img src="/image/sns08.jpg" alt=""></figure></li>
						-->
						</ul>
					</div>
				</div>
			</section>
			<script>

			var token = 'IGQWRPOEQzQUNRbXloM1BxRGYwYmN0Ti0zLThONkJkTE5ia09HaWVxZADVxbHd3RTNaNHNYOC05YjlVMmY0ZAE9xVnNJRHVkNlBPdC1QUkV2UUpnMDZArNVNGbXNxTk5EelVPMEQ0SGtEWnhmWTNYd3Rrb0YwV0puTDAZD';


			$.ajax({
				type: 'GET',
				dataType: 'jsonp',
				cache: false,
				url: 'https://graph.instagram.com/me/media?access_token=' + token + '&fields=id,caption,media_type,media_url,thumbnail_url,permalink,timestamp',
				success: function(response){
					var post = '';
					//console.log(response);
					var max_cnt = 7;
					if(response.data != undefined && response.data.length > 0) {

						for(i = 0; i < response.data.length; i++){
							if(i > max_cnt) break;
							var item = response.data[i];
							var image_url = '';

							if(item.media_type === "VIDEO"){
								image_url = item.thumbnail_url;
							}else{
								image_url = item.media_url;
							}
							post += '<li style="background-image:url('+image_url+');">';
								post += '<a href="'+ item.permalink +'" target="_blank"></a>';
							post += '</li>';
						}
						//console.log(i + '/' + response.data.length);
						$('.instagram').html(post);
					}

				}
			});
			</script>
		</div>
	</div>
