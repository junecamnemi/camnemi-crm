<script type="text/javascript">
	function changeType(obj)
	{
		
		var types      = obj.value;
		var changeName =  "tblSelType"+types;
		var typeLength = frm.rdoSelTypeCode.length;

		for(var i=1; i<typeLength+1; i++)
		{
			if(i == Number(types))
				document.getElementById(changeName).style.display='';
			else
				document.getElementById("tblSelType"+i).style.display='none';
		}
	}


   function init()
   {
	   frm.rdoSelTypeCode[0].checked = true;
	   changeType( frm.rdoSelTypeCode[0]);
   }

   function doNextPage()
   {
	   var url = "/ipsi/ipsi00102.do";
	   frm.action = url;
	   frm.submit();
   }
</script>
