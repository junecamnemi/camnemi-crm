<script>
		var currentAddress = location.href;

		//www아닌 서브도메인인 경우 www로 이동
		if(currentAddress){
			//if( currentAddress.indexOf( "Board/Board.do" ) > -1 ){
				var host = window.location.hostname;
				if(host.split('.').length > 3 && host.indexOf("www") < 0){
					var subdomain = host.split('.')[0];
					//currentAddress = currentAddress.replace(subdomain, "www");
					//console.log(currentAddress);
					document.location = currentAddress.replace(subdomain, "www");
				}
			//}
		}

		var isDevelopMode = ""
		if( isDevelopMode != "Y"  ){
			if( currentAddress.indexOf( "http://" ) > -1 ){
				currentAddress = currentAddress.replace("http://","https://");
				location.href = currentAddress;
			}
		}
</script>
<script>
document.addEventListener('DOMContentLoaded', function () {
  const buttons = document.querySelectorAll('button.bdp-btn');

  buttons.forEach(button => {
    const span = button.querySelector('span');
    if (span && span.textContent.trim() === 'E-mail 보내기') {
      button.style.display = 'none';
    }
  });
});
</script>
