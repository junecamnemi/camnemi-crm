			<script>
				$(function(){
					mVisual.init();
				});
				var mVisual = {
					init : function(){
						this.mVisSlide();
					},
					mVisSlide : function() {
						var mVisSld = $("#mVisual .datalist");
						var mVisLen = $(".item", mVisSld ).length;
						var mVisCtrl = mVisSld.prev();
						var mVisAuto = $(".ctrl-auto", mVisCtrl );
						var mVisDot = $(".ctrl-dots", mVisCtrl );
						var mVisDelay = 5000;
						var mVisSpeed = 750;
						if ( mVisLen == 1 && $(".item", mVisSld ).hasClass("no-data") ) {
							// no-data
						} else {
							// not-no-data
						}
						mVisCtrl.addClass("has"+mVisLen);
						mVisSld.slick({
							infinite : true
							, slidesToShow : 1
							, slidesToScroll : 1
							, speed : mVisSpeed
							, fade : true
							, cssEase : 'linear'
							, autoplay : true
							, appendArrows : mVisSld.prev().prev()
							, dots : true
							, appendDots : mVisDot
							, prevArrow : "<button type='button' class='slick-prev'>이전</button>"
							, nextArrow : "<button type='button' class='slick-next'>다음</button>"
						});
						$(".btn-stop", mVisAuto ).on("click",function(){
							$(this).hide();
							$(this).next().show().focus();
							mVisSld.slick("slickPause");
						});
						$(".btn-play", mVisAuto ).on("click",function(){
							$(this).hide();
							$(this).prev().show().focus();
							mVisSld.slick("slickPlay");
						});
					}
				}
			</script>
