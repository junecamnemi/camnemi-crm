		<script>
			$(function() {
				quickLinkPkg.init();
			});
			var quickLinkPkg = {
				init : function() {
					$quickLinkWr = $("#quickLink");
					$quickLinkHead = $(".role-head", $quickLinkWr );
					$quickLinkBody = $(".role-body", $quickLinkWr );
					$quickLinkFoot = $(".role-foot", $quickLinkWr );
					$quickLinkMflag = $(".toggler", $quickLinkFoot );
					$stdEle = $("#container-wrap");
					this.posDetect();
					this.mCSB_reset();
					this.mCSB_brResizing();
					this.naviResizing();
					this.naviM_evt();
				},
				posDetect : function() {
					$(window).on("scroll", function() {
						if ( $quickLinkHead.css("position") == "relative" ) {		// ** pc 구간.
							$scrollTop = $(this).scrollTop();
							$stdEleTop = $stdEle.offset().top + 30 ;
							if ( $stdEleTop < $scrollTop ) {
								$quickLinkWr.addClass("fixed");
							} else {
								$quickLinkWr.removeClass("fixed");
							}
							quickLinkPkg.naviResizing();
						}
					});
					$(window).on("resize", function() {
						quickLinkPkg.naviResizing();
					});
					$(window).on("load", function() {
						$stdEleTop = $stdEle.offset().top + 30 ;
						$winLoadScrollPos = $(this).scrollTop();
						// ** console.log( "$winLoadScrollPos : " + $winLoadScrollPos + " / $stdEleTop : " + $stdEleTop );
						if ( $winLoadScrollPos >= $stdEleTop ) {
							$quickLinkWr.addClass("fixed");
						} else {
							$quickLinkWr.removeClass("fixed");
						}
					});
				},
				mCSBset : function() {
					if ( util.isPC() && $quickLinkMflag.css("display") == "none" && $quickLinkHead.css("position") == "relative" ) {
						$quickLinkBody.mCustomScrollbar({
							theme : "dark-thick"
							,scrollInertia : 300
							,scrollbarPosition : "outside"
							,scrollButtons : {
								enable : false
							}
						});
					}
				},
				mCSB_brResizing : function() {
					$brResizeFnc = null;
					$(window).on("resize", function() {
						clearTimeout( $brResizeFnc );
						$brResizeFnc = setTimeout( quickLinkPkg.mCSB_reset , 200 );
					});
				},
				mCSB_reset : function() {
					if ( $(window).width() > 999 ) {
						// ** console.log( "pc" );
						$quickLinkWr.removeClass("mSet");
						quickLinkPkg.mCSBset();
						$quickLinkBody.show();
					} else {
						// ** console.log( "mobile" );
						$quickLinkWr.addClass("mSet");
						if ( $quickLinkBody.hasClass("mCustomScrollbar") ) {
							$quickLinkBody.mCustomScrollbar('destroy').removeAttr("style").removeClass("mCS_destroyed").css({ "height":"" }).addClass("#7").hide();
						} else {
						}
					}
				},
				naviResizing : function() {
					if ( $quickLinkHead.css("position") == "relative" && !$quickLinkWr.hasClass("mSet") ) {			// ** pc 구간에서 실행
						$windH = $(window).height();

						// ** 어떤 상황이건간에 max-height 셋팅
						$qlMaxH = Number( util.getNumberOnly( $quickLinkBody.css("max-height") ) );
						$qlMaxHGuess = $windH - 150;
						if ( $qlMaxHGuess <= $qlMaxH ) {
							$quickLinkBody.css({ "max-height":$qlMaxHGuess+"px" });
						}


						// ** fixed 발생여부에 따라 퀵링크 Navi 높이 변경
						if ( $windH <= 850 ) {
							// ** console.log( "리사이즈 실행" );
							if ( $quickLinkWr.hasClass("fixed") ) {
								$quickLinkBody.css({ "height":$windH - 150 + "px" }).addClass("#1");
							} else {
								$quickLinkBody.css({ "height":$windH - $quickLinkWr.offset().top - 150 + "px" }).addClass("#2");
							}
						} else {
							// ** console.log( "리사이즈 원복" );
							$quickLinkBody.css({ "height":"" }).addClass("#3");
						}

						// ** Footer 출현여부에 따라 퀵링크 Navi 높이 변경
						$scTop = $(window).scrollTop();
						$contH = $("#container-wrap").outerHeight();
						$contT = $("#container-wrap").offset().top;
						$contB_pos = $contT - $windH + $contH;
						$contB_gap = $scTop - $contB_pos;
						if ( $scTop >= $contB_pos ) {
							// ** console.log( "Footer 출현" );
							$quickLinkBody.css({ "height":$windH - (Number( util.getNumberOnly($quickLinkWr.css("top")) ) + $contB_gap + 116) + "px" }).addClass("#4");
						} else {
							// ** console.log( "Footer 사라짐" );
							$quickLinkBody.css({ "height":"" }).addClass("#5");
						}
					} else {	// ** mobile 구간 진입시 높이값 초기화
						$quickLinkBody.css({ "height":"" }).addClass("#6");
					}
				},
				naviM_evt : function() {
					$quickLinkMflag.on("click", function() {
						if ( $(this).hasClass("over") ) {
							$(this).removeClass("over");
							$quickLinkBody.slideUp();
						} else {
							$(this).addClass("over");
							$quickLinkBody.slideDown();
						}
					});
				}
			}
		</script>
