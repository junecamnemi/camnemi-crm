<script>
					$.ajax({
						cache : false,
						url : '/info/ajx_json/MainBoard.do?site_code=info&pageSize=6&mCode=MN078&skin=galleryInfo1&mgr_seq=942&category=',
						type : 'post',
						datatype : 'script',
						resetForm : false,
						beforeSubmit : function(formData, jqForm, options) {
							var obj = jqForm[0];
							return true;
						},
						success : function(responseText, statusText) {
							$("#mGallery .datalist").html(responseText);
						},
						complete : function() {
							mGallery.init();
						}
					});
					var mGallery = {
						init : function(){
							this.mGallerySlide();
						},
						mGallerySlide : function() {
							var mGallery = $("#mGallery");
							var mGallerySld = $(".datalist", mGallery );
							var mGalleryCtrl = $(".dataCtrl", mGallery );
							var mGalleryNums = $(".dataNums", mGalleryCtrl );
							var mGalleryNumPres = $(".pres", mGalleryNums );
							var mGalleryNumTotal = $(".total", mGalleryNums );
							var mGalleryLen = $(".item", mGallerySld ).length;
							var mGalleryDelay = 5000;
							var mGallerySpeed = 750;
							mGalleryNumTotal.text( mGalleryLen );
							if ( mGalleryLen == 1 && $(".item", mGallerySld ).hasClass("no-data") ) {
								// no-data
								mGalleryCtrl.hide();
							} else {
								// not-no-data
							}
							mGallerySld.owlCarousel({
								items : 1
								, loop : true
								, autoplay : false
								, nav : true
								, navText : ["이전", "다음"]
								, navContainer : mGalleryCtrl
								, autoplayTimeout : mGalleryDelay
								, autoplayHoverPause : false
								, dots : false
								, smartSpeed : mGallerySpeed
								, onTranslated : onTransed
							});
							function onTransed( event ) {
								var element = $(event.target);
								var mGalleryThisPresNum = $(".owl-item.active .item", element ).data("idx");
								mGalleryNumPres.text( mGalleryThisPresNum );
							}
						}
					}
</script>					<!--
