					<span class="t1">Masan University Interview</span>
					<span class="t2">우수취업자 인터뷰</span>
				</div>
				<div class="role-body">
					<div class="datalist owl-carousel">
					</div>
					<div class="dataCtrl">
						<div class="dataNums">
							<span class="pres">1</span>/<span class="total"></span>
						</div>
					</div>
				</div>
