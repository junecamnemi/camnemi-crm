						<script>
							$(function(){
								mPopup.init();
							});
							var mPopup = {
								init : function(){
									this.mPopupSlide();
								},
								mPopupSlide : function() {
									var mPopup = $("#mPopup");
									var mPopupSld = $(".datalist", mPopup );
									var mPopupCtrl = $(".dataCtrl", mPopup );
									var mPopupNums = $(".dataNums", mPopupCtrl );
									var mPopupNumPres = $(".pres", mPopupNums );
									var mPopupNumTotal = $(".total", mPopupNums );
									var mPopupAutos = $(".dataAuto", mPopupCtrl );
									var mPopupDots = $(".dataDots", mPopupCtrl );
									var mPopupLen = $(".item", mPopupSld ).length;
									var mPopupDelay = 5000;
									var mPopupSpeed = 750;
									mPopupNumTotal.text( mPopupLen );
									if ( mPopupLen == 1 && $(".item", mPopupSld ).hasClass("no-data") ) {
										// no-data
									} else {
										// not-no-data
									}
									mPopupSld.owlCarousel({
										items : 1
										, loop : true
										, autoplay : true
										, nav : true
										, navText : ["이전", "다음"]
										, autoplayTimeout : mPopupDelay
										, autoplayHoverPause : false
										, dots : true
										, dotsContainer : mPopupDots
										, smartSpeed : mPopupSpeed
										, onTranslated : onTransed
									});
									function onTransed( event ) {
										var element = $(event.target);
										var mPopupThisPresNum = $(".owl-item.active .item", element ).data("idx");
										mPopupNumPres.text( mPopupThisPresNum );
									}
									$(".btn-stop", mPopupAutos ).on("click",function(){
										$(this).hide();
										$(this).next().show().focus();
										mPopupSld.trigger("stop.owl.autoplay");
									});
									$(".btn-play", mPopupAutos ).on("click",function(){
										$(this).hide();
										$(this).prev().show().focus();
										mPopupSld.trigger("play.owl.autoplay", [mPopupDelay]);
									});
								}
							}
						</script>
					</div>
