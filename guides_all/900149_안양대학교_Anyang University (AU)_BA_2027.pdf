	<script>

        const CONST_POST_TYPE_CODE_PERIOD = "PERIOD";
		
		let curUrl = window.location.href;
		let isPreView = false;
		let curData = "2026-09-18 17:26:26";

		if ( curUrl.indexOf("pageseq") > -1 ) {
			isPreView = true;
		}


        function showCheck(curDate, start, end){
            let isShow = false;
            if ( start<= curDate && curDate <= end ) {
                isShow = true;
            }
            return isShow;
        }

        function dateFormat(strData){
            let rStr = "";
            if ( !isEmpty(strData))
                rStr = strData.substring(0, 4)+"."+strData.substring(5, 7)+"."+strData.substring(8, 10);
             return rStr;
        }

		function checkDtlList(dataList){
			let isData = false;
			if ( dataList.length == 0 ) return isData;
			$(dataList).each(function(idx, obj){
				let tempDtlPostType = obj.D_POST_TYPE_CODE
				let tempDtlStart = obj.D_START_DATETIME;
				let tempDtlEnd = obj.D_END_DATETIME;				
				if ( tempDtlPostType == CONST_POST_TYPE_CODE_PERIOD ) {
					if ( showCheck(curData, tempDtlStart, tempDtlEnd) ) {
						isData = true;
						return false;
					} 
				} else {
					isData = true;
					return false;
				}
			});
			return isData;
		}

		// data 를 받아서 화면 그리자.. 
		function makeScreen(objData)
		{
			//console.table("원본", objData);
			let curData = "2026-09-18 17:26:26";
			let showData = [];
			let maxCnt = isEmpty(objData.MAX_CONFIG) ? "8" : objData.MAX_CONFIG;
			let showMstData = [];

			// 노출할 게시물 1개만 선택 
			$(objData.data).each(function(idx, obj){
				// 마스터 정보 체크
				let tempMstStart = obj.M_START_DATETIME;
				let tempMstEnd = obj.M_END_DATETIME;
				let tempMstPostType = obj.M_POST_TYPE_CODE

				// 마스터 체크 
				if ( tempMstPostType == CONST_POST_TYPE_CODE_PERIOD ) {
					if ( showCheck(curData, tempMstStart, tempMstEnd) ) {
						if ( checkDtlList(obj.DTL_LIST) ) {
							// 게시대상은 1개로 고정됨.
							showMstData = obj.DTL_LIST;
							return false;
						}
					} 
				} else {
					if ( checkDtlList(obj.DTL_LIST) ) {
						// 게시대상은 1개로 고정됨.
						showMstData = obj.DTL_LIST;
						return false;
					}				
				}
			});

			// 게시물 상세 내용 체크 
			let dtlCnt = 0; //해당개시물관련 체크 후 카운터를 위해서 인덱스 재정의
			$(showMstData).each(function(idx, obj){

				if ( maxCnt <= dtlCnt ) return false;
				//if ( maxCnt <= idx ) return false;

				let tempDtlPostType = obj.D_POST_TYPE_CODE
				let tempDtlStart = obj.D_START_DATETIME;
				let tempDtlEnd = obj.D_END_DATETIME;				
				if ( tempDtlPostType == CONST_POST_TYPE_CODE_PERIOD ) {
					if ( showCheck(curData, tempDtlStart, tempDtlEnd) ) {
						//console.log("노출", obj.SEQ);
						showData.push(obj);
						dtlCnt++;
					} 
				} else {
					//console.log("노출", obj.SEQ);
					if(tempDtlPostType != 'STOP' ) {
						showData.push(obj);
						dtlCnt++;
					}
				}
			});


			//console.table(showData);
			// 화면 그립시다.. 
			// 카테고리 리스트들도 차후 설정 파일에 넣어서 css style 정리 하자 
			let cssList = {
				"1" : "cate_common",
				"2" : "cate_ss",
				"3" : "cate_js",
				"4" : "cate_p",
				"5" : "cate_f",
				"6" : "cate_add"
			};

			let lblList = {
				"1" : "공통",
				"2" : "수시",
				"3" : "정시",
				"4" : "편입",
				"5" : "재외국민",
				"6" : "추가"
			};

			if(showData.length > 0) {
				$('#issueBtn > .num').text(showData.length);
			} else {
				$('#issueBtn > .num').text(0);
			}
			
		
			$.each(showData, function(i, item){
				let tempCss = cssList[item.BANNER_TEXT];
				let tempLbl = lblList[item.BANNER_TEXT];
				let inHtnl = '';
				inHtnl += ' <div class="issue_box"> ';
				inHtnl += '     <a href="'+item.CONTENT_URL+'" target="'+item.CONTENT_URL_TARGET+'"> ';
				inHtnl += '         <span class="cate '+tempCss+'">'+tempLbl+'</span> ';
				inHtnl += '         <p class="tit"> ';
				inHtnl += '             <span class="mini">'+item.TITLE_TEXT+'</span> ';
				inHtnl += '             <span class="txt"><span class="txt">'+item.MAIN_TEXT+'</span></span> ';
				inHtnl += '         </p> ';
				// inHtnl += '         <span class="date">'+dateFormat(item.D_INS_DT)+'</span> ';
				inHtnl += '     </a> ';
				inHtnl += ' </div>';

				$(".issue_con").append(inHtnl);
			});
			
			let curBannerCnt = $('.issue_box').length;
			if ( curBannerCnt < maxCnt ) {
				for (let loopIdx = 1; loopIdx <= (maxCnt-curBannerCnt); loopIdx++) {
					$(".issue_con").append('<div class="issue_box"><div class="none"></div></div>');
				}
			}
		}

        function init() {
