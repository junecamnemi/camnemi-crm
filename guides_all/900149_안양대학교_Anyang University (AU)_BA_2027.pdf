                if(!pdf_indexActive) {
                    pdf_indexActive = "Index";
                }
                $('.pdf_idx .idx_active').text(pdf_indexActive);
                $('.pdf_idx .idx_active').click(function(){
					if($('.idx_list li').length > 0){
						$(this).next('.idx_list').toggleClass('on');
					}
                });

                $('.pdf_idx_list .idx_list li').click(function(){
                    $('.pdf_idx_list .idx_list li').removeClass('active');
                    $(this).addClass('active');
                    pdf_indexActive = $(this).text();
                    $('.pdf_idx_list .idx_list').removeClass('active');
                    $('.pdf_idx_list .idx_list').removeClass('on');
                    $('.pdf_idx .idx_active').text(pdf_indexActive);
                });

