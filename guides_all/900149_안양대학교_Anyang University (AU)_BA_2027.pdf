			function fbSearch(){

				var val = $('#searchVal').val();
				
				if(!val) {
					alert("검색어를 입력해 주세요.");
					return false;
				}

				var str = val.replace(/\s/g, "");  
				if(str == "") {
					alert('검색어를 입력해 주세요.');
					return false;
				}


				$('#searchFrm').submit();
			}


