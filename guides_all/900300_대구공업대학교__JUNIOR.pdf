//댓글등록 클릭 (세션작업필요)
$('.poll_insert').click(function (e) {
	
	var infoSeq = "5008";
	var par =  $('input:radio[name=par]:checked').val();
	var parEtc = $("#parEtc").val();
	
	var params = {
			"infoSeq" : infoSeq
			,"par" : par
			,"parEtc" : parEtc
	}
	
	if ( par ==  undefined) {
		alert('평가점수를 입력하십시오.');
		
		return false;
		
	}
	
	if ( $("#parEtc").val() == '' || $("#parEtc").val() == null ) {
		alert('평가내용을 입력하십시오.');
		
		return false;
	}
	
	
	$.post("/poll/insertPoll.do", params, function(data) {
		if(data){
			alert('평가 등록이 완료되었습니다.');
			window.location.reload();
		}
	});
	
	e.preventDefault();
	return false;
	
});

</script>
</html>
						


