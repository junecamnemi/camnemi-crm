      \u003Cdiv data-gc-type=\"resource\"\u003E\n                \u003Ca href=\"\u002Fapi\u002Ffile\u002Fbinary\u002F52533\" target=\"_blank\" title=\"신청서 새창에서 다운로드\" download=\"\"\u003E신청서 다운로드\u003C\u002Fa\u003E\n            \u003C\u002Fdiv\u003E\n        \u003C\u002Fdiv\u003E\n    \u003C\u002Fdiv\u003E--\u003E\n\n    \u003Cdiv class=\"guidelint-tab-wrap\"\u003E\n        \u003Cdiv class=\"component-tab\" data-gc-type=\"tab\"\u003E\n            \u003Cdiv class=\"component-tab-header\"\u003E\n                \u003Cdiv\u003E\n                    \u003Cbutton class=\"active\" data-gc-type=\"text\"\u003E전형일정 &amp; 지원자격\u003C\u002Fbutton\u003E\n                \u003C\u002Fdiv\u003E\n                \u003Cdiv\u003E\n                    \u003Cbutton data-gc-type=\"text\"\u003E모집학과 및 인원\u003C\u002Fbutton\u003E\n                \u003C\u002Fdiv\u003E\n                \u003Cdiv\u003E\n                    \u003Cbutton data-gc-type=\"text\"\u003E제출서류\u003C\u002Fbutton\u003E\n                \u003C\u002Fdiv\u003E\n                \u003Cdiv\u003E\n                    \u003Cbutton data-gc-type=\"text\"\u003E합격 &amp; 등록\u003C\u002Fbutton\u003E\n                \u003C\u002Fdiv\u003E\n                \u003Cdiv\u003E\n                    \u003Cbutton data-gc-type=\"text\"\u003E유의사항 &amp; 문의\u003C\u002Fbutton\u003E\n\t\t\t\t\u003C\u002Fdiv\u003E\n                \u003C!--div\u003E\n                    \u003Cbutton data-gc-type=\"text\"\u003E공통사항\u003C\u002Fbutton\u003E\n                \u003C\u002Fdiv--\u003E\n            \u003C\u002Fdiv\u003E\n            \u003Cdiv class=\"component-tab-content\"\u003E\n                \u003Cdiv\u003E\n                    \u003Ch2 class=\"h2style2\" data-gc-type=\"text\"\u003E전형일정\u003C\u002Fh2\u003E\n                    \u003Cdiv class=\"table-wrap content-margin-left-bottom\"\u003E\n                        \u003Ctable class=\"iphak-table-style3 table-w800\"\u003E\n                            \u003Ccaption class=\"invisible\"\u003E전형일정\u003C\u002Fcaption\u003E\n                            \u003Ccolgroup\u003E\n                                \u003Ccol style=\"width:15%;\"\u003E\n                                \u003Ccol style=\"width:18%;\"\u003E\n                                \u003Ccol style=\"width:40%\"\u003E\n                                \u003Ccol style=\"width:17%\"\u003E\n                            \u003C\u002Fcolgroup\u003E\n\n                            \u003Cthead\u003E\n                            \u003Ctr\u003E\n                                \u003Cth scope=\"col\" data-gc-type=\"text\"\u003E구분\u003C\u002Fth\u003E\n                                \u003Cth scope=\"col\" data-gc-type=\"text\"\u003E일시\u003C\u002Fth\u003E\n                                \u003Cth scope=\"col\" data-gc-type=\"text\"\u003E장소\u003C\u002Fth\u003E\n                                \u003Cth scope=\"col\" data-gc-type=\"text\"\u003E비고\u003C\u002Fth\u003E\n                                \u003C\u002Ftr\u003E\n                            \u003C\u002Fthead\u003E\n                            \u003Ctbody\u003E\n                            \u003Ctr\u003E\n                                \u003Ctd class=\"text-center\" data-gc-type=\"text\"\u003E원서접수 및\u003Cbr\u003E서류제출\u003C\u002Ftd\u003E\n                                \u003Ctd class=\"text-center\" data-gc-type=\"text\"\u003E2026.09.07.(월) ~ 09.30.(수)\u003C\u002Ftd\u003E\n                                \u003Ctd data-gc-type=\"text\"\u003E\n\t\t\t\t\t\t\t\t\t• 방문접수 : 경남정보대학교 국제교류처(미래관 T건물 1층)\u003Cbr \u002F\u003E\n                                    • 우편접수 : 우)47011 부산광역시 사상구 주례로 45 경남정보대학교 국제교류처\n                                 \u003C\u002Ftd\u003E\n                                \u003Ctd data-gc-type=\"text\"\u003E방문 또는 우편 접수\u003Cbr\u003E(원본서류제출)\u003C\u002Ftd\u003E\n                            \u003C\u002Ftr\u003E\n                            \u003Ctr\u003E\n                                \u003Ctd class=\"text-center\" data-gc-type=\"text\"\u003E면접고사\u003C\u002Ftd\u003E\n                                \u003Ctd class=\"text-center\" data-gc-type=\"text\"\u003E접수일 ∼ 2026.10.16.(금)\u003C\u002Ftd\u003E\n                                \u003Ctd data-gc-type=\"text\"\u003E면접장소 및 면접시간은 개별통보\u003C\u002Ftd\u003E\n                                \u003Ctd data-gc-type=\"text\"\u003E\u003C\u002Ftd\u003E\n                            \u003C\u002Ftr\u003E\n                            \u003Ctr\u003E\n                                \u003Ctd class=\"text-center\" data-gc-type=\"text\"\u003E합격자발표\u003C\u002Ftd\u003E\n                                \u003Ctd class=\"text-center\" data-gc-type=\"text\"\u003E면접일 ~ 2026.10.30.(금)\u003C\u002Ftd\u003E\n                                \u003Ctd data-gc-type=\"text\"\u003E개별통보\u003C\u002Ftd\u003E\n                                \u003Ctd data-gc-type=\"text\"\u003E\u003C\u002Ftd\u003E\n                            \u003C\u002Ftr\u003E\n                            \u003Ctr\u003E\n                                \u003Ctd class=\"text-center\" data-gc-type=\"text\"\u003E등록금 납부\u003C\u002Ftd\u003E\n                                \u003Ctd class=\"text-center\" data-gc-type=\"text\"\u003E2026.12.23.(수) 16:00까지\u003C\u002Ftd\u003E\n                                \u003Ctd data-gc-type=\"text\"\u003E대학지정 농협 전국 각지점\u003C\u002Ftd\u003E\n                                \u003Ctd data-gc-type=\"text\"\u003E\u003C\u002Ftd\u003E\n                            \u003C\u002Ftr\u003E\n                            \u003C\u002Ftbody\u003E\n                        \u003C\u002Ftable\u003E\n\t\t\t\t\t\t\u003Cp class=\"point2 content-margin-bottom\"\u003E※ 상기 일정은 관할 출입국관리사무소 및 해외공관의 상황에 따라 변경 가능성이 있음\u003Cbr\u003E\n\t\t\t\t\t  ※ 모집인원 미달시 2027. 02. 27.(토)까지 추가 모집 가능\u003C\u002Fp\u003E\n                    \u003C\u002Fdiv\u003E\n\t\t\t\t\t\n                  \u003Ch2 class=\"h2style2\" data-gc-type=\"text\"\u003E지원자격\u003C\u002Fh2\u003E\n                    \u003Cdiv class=\"table-wrap content-margin-left-bottom\"\u003E\n                        \u003Ctable class=\"iphak-table-style3 table-w800\"\u003E\n                            \u003Ccaption class=\"invisible\"\u003E\n                            지원자격\n                            \u003C\u002Fcaption\u003E\n                            \u003Ccolgroup\u003E\n                            \u003Ccol style=\"width:15%;\"\u003E\n                            \u003Ccol style=\"width:40%;\"\u003E\n                            \u003Ccol style=\"width:45%;\"\u003E\n                           \u003C\u002Fcolgroup\u003E\n                            \u003Cthead\u003E\n                                \u003Ctr\u003E\n                                    \u003Cth scope=\"col\" data-gc-type=\"text\"\u003E구분\u003C\u002Fth\u003E\n                                    \u003Cth colspan=\"2\" scope=\"col\" data-gc-type=\"text\"\u003E자격\u003C\u002Fth\u003E\n                                \u003C\u002Ftr\u003E\n                            \u003C\u002Fthead\u003E\n                            \u003Ctbody\u003E\n                                \u003Ctr\u003E\n                                    \u003Ctd class=\"text-center\" data-gc-type=\"text\"\u003E국적 자격\u003C\u002Ftd\u003E\n\n                                    \u003Ctd colspan=\"2\" data-gc-type=\"text\"\u003E\n\t\t\t\t\t\t\t\t\t\t\u003Cul\u003E\n\t\t\t\t\t\t\t\t\t\t  \u003Cli class=\"dash-line\" data-gc-type=\"text\"\u003E부모 모두 외국국적을 소지한 외국인(부, 모, 본인 모두 외국인)\u003C\u002Fli\u003E\n\t\t\t\t\t\t\t\t\t\t\t\u003Cli class=\"dash-line\" data-gc-type=\"text\"\u003E 복수(이중)국적 소지자는 외국인으로 인정하지 않음\u003C\u002Fli\u003E\n\t\t\t\t\t\t\t\t\t\t\u003C\u002Ful\u003E\n\t\t\t\t\t\t\t\t  \u003C\u002Ftd\u003E\n                                \u003C\u002Ftr\u003E\n                                \u003Ctr\u003E\n                                    \u003Ctd rowspan=\"2\" class=\"text-center\" data-gc-type=\"text\"\u003E학력 자격\u003C\u002Ftd\u003E\n                                    \u003Ctd data-gc-type=\"text\"\u003E① 부모 모두가 외국인인 외국인(고등교육법시행령 제29조 제2항 6호)\u003C\u002Ftd\u003E\n                                    \u003Ctd data-gc-type=\"text\"\u003E\n\t\t\t\t\t\t\t\t\t\t\u003Cul\u003E\n\t\t\t\t\t\t\t\t\t\t\t\u003Cli class=\"dash-line\" data-gc-type=\"text\"\u003E국내외 정규 고등학교 졸업자 2027년 2월 28일 이전 졸업자 또는 예정자\u003C\u002Fli\u003E\n\t\t\t\t\t\t\t\t\t\t\t\u003Cli class=\"dash-line\"\u003E 기타 관련법령에 의하여 위와 동등한 학력이 있다고 인정되는 자\u003C\u002Fli\u003E\n                                    \t\u003C\u002Ful\u003E\n\t\t\t\t\t\t\t\t\t\u003C\u002Ftd\u003E\n                                \u003C\u002Ftr\u003E\n                                \u003Ctr\u003E\n                                \t\u003Ctd data-gc-type=\"text\"\u003E② 외국에서 우리나라 초․중등교육에 상응하는 교육과정을 전부 이수한 외국인(고등교육법시행령제29조 제2항 7호)\u003C\u002Ftd\u003E\n                               \t  \u003Ctd data-gc-type=\"text\"\u003E\n\t\t\t\t\t\t\t\t\t  \t\u003Cul\u003E\n                                         \u003Cli class=\"dash-line\" data-gc-type=\"text\"\u003E해외 1개국 내에서 학제가 동일한 학교에서 초·중등학교 전 과정을 이수한 경우 이수 \n  연한이 12년이 되지 않더라도 전 교육과정 이수자로 인정.(해외 한 국가에서 전 교육과정을 이수할 때, 이수 연한이 12년이 되지 않더라도 전 교육과정을 이수자로 인정함)\u003C\u002Fli\u003E\n                                         \u003Cli class=\"dash-line\"\u003E 학제가 다른 해외 2개 국가 이상에서 전 과정을 이수한 자\u003Cbr\u003E\n\t\t\t\t\t\t\t\t\t\t\t(11학년제, 12학년제 공통 : 경우 초·중등과정의 마지막 3년을 해당국에서 이수한 경우에만 고등학교 과정으로 인정)\n                                           (13학년제 이상 : 10~12학년 또는 11~13학년을 해당국에서 이수한 경우 고등학교 과정으로 인정) \u003C\u002Fli\u003E\n                                \t\t\u003C\u002Ful\u003E\n\t\t\t\t\t\t\t\t\t\u003C\u002Ftd\u003E\n                                \u003C\u002Ftr\u003E\n                                \u003Ctr\u003E\n                                    \u003Ctd class=\"text-center\" data-gc-type=\"text\"\u003E어학 자격\u003C\u002Ftd\u003E\n                                    \u003Ctd colspan=\"2\" data-gc-type=\"text\"\u003E\u003Cul\u003E\n                                         \u003Cli class=\"dash-line\" data-gc-type=\"text\"\u003E한국어능력이 전공 수학 능력으로 인정받은 외국인\u003C\u002Fli\u003E\n                                    \u003C\u002Ful\u003E\u003C\u002Ftd\u003E\n                                \u003C\u002Ftr\u003E\n                            \u003C\u002Ftbody\u003E\n                        \u003C\u002Ftable\u003E\n\t\t\t\t\t\t\u003Cp class=\"point2 content-margin-bottom\"\u003E※ 서류위조 및 변조 등으로 인해 입학 전·후 확인되면 학칙 등에 따라 재입학 불가하며 관계 법령에 따라 조치가 될 수 있음\u003Cbr\u003E\n\t\t\t\t\t  ※ 대학 자체 한국어능력시험 통과자는 지원 학기만 인정됨\u003C\u002Fp\u003E\n                \t\u003C\u002Fdiv\u003E\n                \u003C\u002Fdiv\u003E\n\n                \u003Cdiv class=\"tab-invisible\"\u003E\n                    \u003Ch2 class=\"h2style2\" data-gc-type=\"text\"\u003E모집학과 및 인원\u003C\u002Fh2\u003E\n                    \u003Cdiv class=\"table-wrap content-margin-left-bottom\"\u003E\n                        \u003Ctable class=\"iphak-table-style3 table-small\"\u003E\n                            \u003Ccaption class=\"invisible\"\u003E모집학과 및 인원\u003C\u002Fcaption\u003E\n                            \u003Ccolgroup\u003E\n                                \u003Ccol style=\"width:30%;\"\u003E\n                                \u003Ccol style=\"width:20%\"\u003E\n                                \u003Ccol style=\"width:25%\"\u003E\n                                \u003Ccol style=\"width:25%\"\u003E\n                            \u003C\u002Fcolgroup\u003E\n\n                            \u003Cthead\u003E\n\t\t\t\t\t\t\t\t\u003Ctr\u003E\n\t\t\t\t\t\t\t\t\t\u003Cth scope=\"col\" data-gc-type=\"text\"\u003E모집 학과\u003C\u002Fth\u003E\n\t\t\t\t\t\t\t\t\t\u003Cth scope=\"col\" data-gc-type=\"text\"\u003E학제\u003C\u002Fth\u003E\n\t\t\t\t\t\t\t\t\t\u003Cth scope=\"col\" data-gc-type=\"text\"\u003E주\u002F야\u003C\u002Fth\u003E\n\t\t\t\t\t\t\t\t\t\u003Cth scope=\"col\" data-gc-type=\"text\"\u003E모집인원\u003C\u002Fth\u003E\n\t\t\t\t\t\t\t\t\u003C\u002Ftr\u003E\n                            \u003C\u002Fthead\u003E\n\t\t\t\t\t\t\t\u003Ctbody\u003E\n\t\t\t\t\t\t\t\t\u003Ctr\u003E\n\t\t\t\t\t\t\t\t  \u003Ctd class=\"text-center\" data-gc-type=\"text\"\u003E반도체전자과\u003C\u002Ftd\u003E\n\t\t\t\t\t\t\t\t  \u003Ctd class=\"text-center\" data-gc-type=\"text\"\u003E2년\u003C\u002Ftd\u003E\n\t\t\t\t\t\t\t\t  \u003Ctd class=\"text-center\" data-gc-type=\"text\"\u003E주간\u003C\u002Ftd\u003E\n\t\t\t\t\t\t\t\t  \u003Ctd class=\"text-center\" data-gc-type=\"text\"\u003E40\u003C\u002Ftd\u003E\n\t\t\t\t\t\t\t  \u003C\u002Ftr\u003E\n\t\t\t\t\t\t\t\t\u003Ctr\u003E\n\t\t\t\t\t\t\t\t  \u003Ctd class=\"text-center\" data-gc-type=\"text\"\u003E전기과\u003C\u002Ftd\u003E\n\t\t\t\t\t\t\t\t  \u003Ctd class=\"text-center\" data-gc-type=\"text\"\u003E2년\u003C\u002Ftd\u003E\n\t\t\t\t\t\t\t\t  \u003Ctd class=\"text-center\" data-gc-type=\"text\"\u003E주간\u003C\u002Ftd\u003E\n\t\t\t\t\t\t\t\t  \u003Ctd class=\"text-center\" data-gc-type=\"text\"\u003E20\u003C\u002Ftd\u003E\n\t\t\t\t\t\t\t  \u003C\u002Ftr\u003E\n\t\t\t\t\t\t\t\t\u003Ctr\u003E\n\t\t\t\t\t\t\t\t  \u003Ctd class=\"text-center\" data-gc-type=\"text\"\u003E기계과\u003C\u002Ftd\u003E\n\t\t\t\t\t\t\t\t  \u003Ctd class=\"text-center\" data-gc-type=\"text\"\u003E2년\u003C\u002Ftd\u003E\n\t\t\t\t\t\t\t\t  \u003Ctd class=\"text-center\" data-gc-type=\"text\"\u003E주간\u003C\u002Ftd\u003E\n\t\t\t\t\t\t\t\t  \u003Ctd class=\"text-center\" data-gc-type=\"text\"\u003E40\u003C\u002Ftd\u003E\n\t\t\t\t\t\t\t  \u003C\u002Ftr\u003E\n\t\t\t\t\t\t\t\t\u003Ctr\u003E\n\t\t\t\t\t\t\t\t  \u003Ctd class=\"text-center\" data-gc-type=\"text\"\u003E전기수소자동차과\u003C\u002Ftd\u003E\n\t\t\t\t\t\t\t\t  \u003Ctd class=\"text-center\" data-gc-type=\"text\"\u003E2년\u003C\u002Ftd\u003E\n\t\t\t\t\t\t\t\t  \u003Ctd class=\"text-center\" data-gc-type=\"text\"\u003E주간\u003C\u002Ftd\u003E\n\t\t\t\t\t\t\t\t  \u003Ctd class=\"text-center\" data-gc-type=\"text\"\u003E40\u003C\u002Ftd\u003E\n\t\t\t\t\t\t\t  \u003C\u002Ftr\u003E\n\t\t\t\t\t\t\t\t\u003Ctr\u003E\n\t\t\t\t\t\t\t\t  \u003Ctd class=\"text-center\" data-gc-type=\"text\"\u003E화공에너지공학과\u003C\u002Ftd\u003E\n\t\t\t\t\t\