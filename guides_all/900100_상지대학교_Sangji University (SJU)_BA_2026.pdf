<!-- 1. 챗봇 안내 말풍선 (CSS 클래스는 이전과 동일하게 사용) -->
<div class="gomgomi-speech-bubble" id="gomgomiBubble">
    27학년도 상지대학교 입시는<br>곰곰이에게 물어보세요!
</div>

<!-- 2. 챗봇 구동 스크립트 (호스트 div는 제거함) -->
<script id="chatbot-widget-script"
    src="https://mllm.o2ai.co.kr/embed_sangji/widget.umd.js"
    data-institution="sangji"
    data-collection-id="78113abaffd9-d68fba03"
    type="module">
</script>

<!-- 3. 말풍선 열림/닫힘 토글 제어 스크립트 -->
<script>
    document.addEventListener("DOMContentLoaded", function() {
        const bubble = document.getElementById('gomgomiBubble');
        
        document.addEventListener('click', function(event) {
            if (!bubble) return;

            // 말풍선 자체를 클릭한 경우는 무시 (유지)
            if (event.target === bubble || bubble.contains(event.target)) {
                return; 
            }
            
            // 챗봇 위젯을 클릭한 경우: 말풍선의 hidden 클래스를 토글(추가/제거 반복)
            const clickedChatbot = event.target.closest('[id^="chatbot-widget"]');
            if (clickedChatbot) {
                bubble.classList.toggle('hidden');
            }
        });
    });
</script>
<!-- // 챗봇 탑재 끝 -->

