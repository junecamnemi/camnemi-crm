<script>
$(function(){
	
	function getCookie(name) {
		var value = document.cookie.match('(^|;) ?' + name + '=([^;]*)(;|$)');
		return value? value[2] : null;
	}
	
	if(getCookie("sangji") == null){
	
		$.ajax({
    		type: 'GET',
        	url:'https://sso.sangji.ac.kr:4443/api/sso/login/check',
        	xhrFields: {
            	withCredentials: true
        	},
        	cache: false,
        	dataType: 'json',
        	crossDomain: true,
        	success:function(data){
            	if(data.dataMap.valid) {
            		location.href = 'https://sso.sangji.ac.kr:4443/sso/auth?client_id=homepage&response_type=code&rd_c_p=kor&redirect_uri=http://www.sangji.ac.kr/sso/ssoLoginResult.do';
            	}
        	},
        	error: function(jqXHR, textStatus, errorThrown){
            	console.log(jqXHR,textStatus,errorThrown);
        	}

		});
	}
	
	if(getCookie("sangji") != null){
	
		$.ajax({
    		type: 'GET',
        	url:'https://sso.sangji.ac.kr:4443/api/sso/login/check',
        	xhrFields: {
            	withCredentials: true
        	},
        	cache: false,
        	dataType: 'json',
        	crossDomain: true,
        	success:function(data){
            	if(!data.dataMap.valid) {
            		location.href = '/sso/ssoLogout.do';
            	}
        	},
        	error: function(jqXHR, textStatus, errorThrown){
            	console.log(jqXHR,textStatus,errorThrown);
        	}

		});
	}
});
</script>


