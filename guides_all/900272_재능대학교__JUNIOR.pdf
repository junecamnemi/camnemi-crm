		<script>
			mainSwiper = new Swiper('.mainSwiper', {
				// Optional parameters
				spaceBetween: 0,
				loop: true,
				effect: 'slide',
				longSwipes: true,
				autoplay: {
					delay: 5000,
					disableOnInteraction: true // 쓸어 넘기거나 버튼 클릭 시 자동 슬라이드 정지.
				},

				//* If we need pagination
				pagination: {
					el: '.mainSwiper .swiper-pagination',
					clickable: true,
					renderBullet: function (index, className) {
						var mainSwiperAlts = [];
						$('.mainSwiper .swiper-slide').each(function (i) {
							if($(this).data('alt') != undefined){
								mainSwiperAlts.push($(this).data('alt'));
							}else{
								mainSwiperAlts.push('');
							}
						});

						return '<button class="' + className + '"><span class="blind">' + mainSwiperAlts[index + 1] + '</span></button>';
					},
				},
				//*/
				/* Navigation arrows
                navigation: {
                nextEl: '.swiper-button-next',
                prevEl: '.swiper-button-prev',
                },
                //*/
				/* And if we need scrollbar
                scrollbar: {
                el: '.swiper-scrollbar',
                },
                //*/
			});
			function stopAuto(){mainSwiper.autoplay.stop()}
			function playAuto(){mainSwiper.autoplay.start();}
			$('.mainSwiper .swiper-autoBtn').on('click',function(){
				if($(this).hasClass('stop')){
					var mainSwiperSl = '<span class="blind">슬라이드 멈춤</span>';
					$(this).removeClass('stop');
					$(this).attr('title','슬라이드 멈춤');
					$(this).html(mainSwiperSl);
					playAuto();
				} else {
					var mainSwiperSl = '<span class="blind">슬라이드 재생</span>';
					$(this).addClass('stop');
					$(this).attr('title','슬라이드 재생');
					$(this).html(mainSwiperSl);
					stopAuto();
				}
			});
			/*
            $('.mainSwiper .swiper-slide').on('focusin',function(){stopAuto()});
            $('.mainSwiper .swiper-slide').on('foucusout',function(){playAuto()});
            */
			$(".mainSwiper .swiper-slide").on("focusin", function () {
				mainSwiper.slideTo($(this).data('swiper-slide-index') + 1);
			});
			$(".mainSwiper .swiper-pagination-bullet").on("focusin", function () {
				//mainSwiper.slideTo($(".mainSwiper .swiper-pagination-bullet").index(this) + 1);
				stopAuto();
			});
			$(".mainSwiper .swiper-slide, .mainSwiper .swiper-pagination-bullet, .mainSwiper .swiper-autoBtn").on("focusout", function () {
				setTimeout(function(){
					var mainSwiperArea = document.querySelector('.mainSwiper');
					if (mainSwiperArea.querySelector(':focus') === null && !$('.mainSwiper .swiper-autoBtn').hasClass('stop')) {
						playAuto();
					}
				},100);
			});
		</script>
