	<script>
    $(document).ready(function() {
        var Dday = new Date(2020, 9 - 1, 15);
        var now = new Date();
        var gap = now.getTime() - Dday.getTime();
        var result = Math.floor(gap / (1000 * 60 * 60 * 24)) * -1; // gap을 일(밀리초 * 초 * 분 * 시간)로 나눈다. 이 때 -1 을 곱해야 날짜차이가 맞게 나온다.

        $("#d-day").html(result);
    });

</script>
    
