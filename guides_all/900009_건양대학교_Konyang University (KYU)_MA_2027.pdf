<script>
	$(document).ready(function(){
		var param = $("#mozipMenu");
		var btn = param.find("[class^='left_'] > a");
		var obj = param.find(".frameBox");

		btn.removeClass("on");
		obj.find("iframe").attr("src", btn.first().attr("href"));
		
		btn.bind("click", function(event){
			btn.removeClass("on");
			$(this).addClass("on");

			if($(window).outerWidth() >999){
				var target = $("#mozipMenu").offset().top - $("#header").outerHeight();
				$("html, body").stop(true,false).delay(300).animate({scrollTop:target},700);

				if($(this).attr("href") != "#"){
					var linkTarget = $(this).attr("href");
					obj.find("iframe").attr("src", linkTarget);
					
					event.preventDefault();
				}else{
					return false;
				};	

			}else{
				obj.empty().hide();
			};
		});
	});
</script>


