    <style>
        /*
         * 전주비전대학교 AI 챗봇
         */

        /* 챗봇 창 */
        .chatbot-window {
            position: fixed;
            right: 40px;
            bottom: 190px;

            width: 600px;
            height: 800px;

            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 6px 24px rgba(0, 0, 0, 0.25);

            overflow: hidden;
            display: none;

            z-index: 10000;
        }

        /* 챗봇 상단 헤더 */
        .chatbot-header {
            height: 52px;
            box-sizing: border-box;

            background: #005bac;
            color: #ffffff;

            display: flex;
            align-items: center;
            justify-content: space-between;

            padding: 0 16px;
            font-size: 16px;
            font-weight: bold;
        }

        /* 닫기 버튼 */
        .chatbot-close {
            width: 36px;
            height: 36px;

            background: transparent;
            border: none;

            color: #ffffff;
            font-size: 22px;
            line-height: 36px;

            cursor: pointer;
            padding: 0;
        }

        .chatbot-close:hover {
            opacity: 0.75;
        }

        /* AI 사이트 iframe */
        .chatbot-frame {
            display: block;
            width: 100%;
            height: calc(100% - 52px);
            border: none;
        }

        /* FOX 캐릭터 버튼 */
        .chatbot-button {
            position: fixed;
            right: 35px;
            bottom: 35px;

            width: 130px;
            height: 130px;

            border: none;
            background: transparent;

            cursor: pointer;
            z-index: 9999;
            padding: 0;
        }

        /* 캐릭터 이미지 */
        .chatbot-icon {
            display: block;
            width: 100%;
            height: 100%;

            object-fit: contain;

            opacity: 1;

            transition:
                opacity 0.25s ease,
                transform 0.25s ease;

            filter: drop-shadow(
                0 4px 6px rgba(0, 0, 0, 0.16)
            );
        }

        /* 이미지 변경 효과 */
        .chatbot-icon.image-changing {
            opacity: 0;
            transform: scale(0.9);
        }

        /* 말풍선 */
        .chatbot-tooltip {
            position: fixed;

            right: 180px;
            bottom: 68px;

            box-sizing: border-box;
            width: 340px;
            min-height: 90px;

            display: flex;
            align-items: center;
            justify-content: center;

            background: #ffffff;
            border: 1px solid #eeeeee;
            border-radius: 22px;

            padding: 14px 20px;

            box-shadow:
                0 3px 14px rgba(0, 0, 0, 0.18);

            font-size: 14px;
            font-weight: 600;
            color: #333333;
            line-height: 1.6;
            text-align: center;

            cursor: pointer;
            z-index: 9998;

            white-space: normal;
            word-break: keep-all;
        }

        /* 말풍선 꼬리 */
        .chatbot-tooltip::after {
            content: "";

            position: absolute;
            right: -10px;
            top: 50%;

            transform: translateY(-50%);

            border-left: 11px solid #ffffff;
            border-top: 9px solid transparent;
            border-bottom: 9px solid transparent;
        }

        /* 말풍선 테두리 꼬리 */
        .chatbot-tooltip::before {
            content: "";

            position: absolute;
            right: -12px;
            top: 50%;

            transform: translateY(-50%);

            border-left: 12px solid #dddddd;
            border-top: 10px solid transparent;
            border-bottom: 10px solid transparent;

            z-index: -1;
        }

        .chatbot-tooltip:hover {
            background: #f8fbff;
        }

        /* 캐릭터 흔들림 효과 */
        @keyframes chatbotShake {
            0% {
                transform: rotate(0deg) scale(1);
            }

            20% {
                transform: rotate(-9deg) scale(1.08);
            }

            40% {
                transform: rotate(9deg) scale(1.08);
            }

            60% {
                transform: rotate(-6deg) scale(1.05);
            }

            80% {
                transform: rotate(6deg) scale(1.05);
            }

            100% {
                transform: rotate(0deg) scale(1);
            }
        }

        .chatbot-button.shake {
            animation: chatbotShake 0.8s ease-in-out;
        }

        /*
         * 769px 이상 1536px 이하 화면에서는 숨김
         * 기존 홈페이지 퀵메뉴 정책 유지
         */
        @media (min-width: 769px) and (max-width: 1536px) {
            .chat_bot {
                display: none !important;
            }
        }

        /* 모바일 반응형 */
        @media (max-width: 768px) {

            .chat_bot {
                display: block !important;
            }

            /*
             * 모바일에서는 iframe을 사용하지 않고
             * 새 창으로 연결
             */
            .chatbot-window {
                display: none !important;
            }

            .chatbot-button {
                right: 12px;
                bottom: 16px;

                width: 92px;
                height: 92px;
            }

            .chatbot-tooltip {
                right: 105px;
                bottom: 26px;

                width: calc(100% - 130px);
                max-width: 310px;
                min-height: 76px;

                padding: 10px 14px;

                font-size: 13px;
                line-height: 1.5;
                border-radius: 18px;
            }
        }

        /* 작은 모바일 화면 */
        @media (max-width: 420px) {

            .chatbot-button {
                width: 82px;
                height: 82px;

                right: 8px;
                bottom: 12px;
            }

            .chatbot-tooltip {
                right: 92px;
                bottom: 20px;

                width: calc(100% - 108px);
                max-width: none;
                min-height: 72px;

                padding: 9px 11px;

                font-size: 12px;
                line-height: 1.5;
            }
        }
    </style>

    <!-- 챗봇 iframe 창 -->
    <div
        class="chatbot-window"
        id="chatbotWindow"
        role="dialog"
        aria-modal="false"
        aria-label="전주비전대학교 AI 상담"
    >
        <div class="chatbot-header">

            <span>전주비전대학교 AI 상담</span>

            <button
                type="button"
                class="chatbot-close"
                id="chatbotCloseButton"
                aria-label="AI 상담창 닫기"
            >
                ✕
            </button>

        </div>

        <iframe
            class="chatbot-frame"
            id="chatbotFrame"
            src="https://jvision.ai/admission"
            title="전주비전대학교 AI 챗봇"
            loading="lazy"
        >
        </iframe>
    </div>

    <!-- 고정 말풍선 -->
    <div
        class="chatbot-tooltip"
        id="chatbotTooltip"
        role="button"
        tabindex="0"
        aria-label="전주비전대학교 AI 상담 열기"
    >
        안녕하세요.<br>
        저는 전주비전대학교 AI 상담 챗봇입니다.<br>
        궁금한 점을 자유롭게 질문해 주세요.
    </div>

    <!-- FOX 캐릭터 버튼 -->
    <button
        type="button"
        class="chatbot-button"
        id="chatbotButton"
        aria-label="전주비전대학교 AI 상담 열기"
        aria-expanded="false"
    >
        <img
            src="/common/img/ai/fox1.png"
            alt="전주비전대학교 AI 상담"
            class="chatbot-icon"
            id="foxImage"
        >
    </button>

    <script>
        (function () {

            /*
             * AI 상담 주소
             */
            const chatbotUrl =
                "https://jvision.ai/admission";

            /*
             * FOX 이미지 목록
             *
             * 말풍선은 변경하지 않고
             * 캐릭터 이미지만 순환합니다.
             */
            const foxImages = [
                "/common/img/ai/fox1.png",
                "/common/img/ai/fox2.png",
                "/common/img/ai/fox3.png",
                "/common/img/ai/fox4.png",
                "/common/img/ai/fox5.png",
                "/common/img/ai/fox6.png",
                "/common/img/ai/fox7.png",
                "/common/img/ai/fox8.png",
                "/common/img/ai/fox9.png",
                "/common/img/ai/fox10.png"
            ];

            let imageIndex = 0;

            const chatbotWindow =
                document.getElementById("chatbotWindow");

            const chatbotButton =
                document.getElementById("chatbotButton");

            const chatbotTooltip =
                document.getElementById("chatbotTooltip");

            const chatbotCloseButton =
                document.getElementById("chatbotCloseButton");

            const foxImage =
                document.getElementById("foxImage");

            /*
             * 모바일 디바이스 확인
             */
            function isMobileDevice() {

                const userAgent =
                    navigator.userAgent ||
                    navigator.vendor ||
                    window.opera ||
                    "";

                return /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i
                    .test(userAgent);
            }

            /*
             * 챗봇 창 열림 여부 확인
             */
            function isChatbotOpen() {

                return (
                    chatbotWindow.style.display === "block"
                );
            }

            /*
             * FOX 캐릭터 이미지 변경
             *
             * 말풍선 문구는 변경하지 않습니다.
             */
            function changeFoxImage() {

                if (isChatbotOpen()) {
                    return;
                }

                imageIndex++;

                if (imageIndex >= foxImages.length) {
                    imageIndex = 0;
                }

                foxImage.classList.add(
                    "image-changing"
                );

                setTimeout(function () {

                    foxImage.src =
                        foxImages[imageIndex];

                    foxImage.classList.remove(
                        "image-changing"
                    );

                }, 200);
            }

            /*
             * 챗봇 열기
             *
             * 모바일:
             * 새 창으로 AI 상담 페이지 연결
             *
             * 데스크톱:
             * 홈페이지 내부 iframe 창 표시
             */
            function openChatbot(event) {

                if (event) {
                    event.preventDefault();
                    event.stopPropagation();
                }

                if (isMobileDevice()) {

                    window.open(
                        chatbotUrl,
                        "_blank",
                        "noopener,noreferrer"
                    );

                    return;
                }

                chatbotWindow.style.display =
                    "block";

                chatbotTooltip.style.display =
                    "none";

                chatbotButton.setAttribute(
                    "aria-expanded",
                    "true"
                );
            }

            /*
             * 챗봇 닫기
             */
            function closeChatbot(event) {

                if (event) {
                    event.preventDefault();
                    event.stopPropagation();
                }

                chatbotWindow.style.display =
                    "none";

                chatbotTooltip.style.display =
                    "flex";

                chatbotButton.setAttribute(
                    "aria-expanded",
                    "false"
                );
            }

            /*
             * FOX 버튼 클릭
             */
            chatbotButton.addEventListener(
                "click",
                openChatbot
            );

            /*
             * 말풍선 클릭
             */
            chatbotTooltip.addEventListener(
                "click",
                openChatbot
            );

            /*
             * 닫기 버튼 클릭
             */
            chatbotCloseButton.addEventListener(
                "click",
                closeChatbot
            );

            /*
             * 말풍선 키보드 접근
             *
             * Enter 또는 Space 키 입력 시 열기
             */
            chatbotTooltip.addEventListener(
                "keydown",
                function (event) {

                    if (
                        event.key === "Enter" ||
                        event.key === " "
                    ) {
                        openChatbot(event);
                    }
                }
            );

            /*
             * 챗봇 창 외부 클릭 시 닫기
             */
            document.addEventListener(
                "click",
                function (event) {

                    if (!isChatbotOpen()) {
                        return;
                    }

                    const clickedInsideWindow =
                        chatbotWindow.contains(
                            event.target
                        );

                    const clickedButton =
                        chatbotButton.contains(
                            event.target
                        );

                    const clickedTooltip =
                        chatbotTooltip.contains(
                            event.target
                        );

                    if (
                        !clickedInsideWindow &&
                        !clickedButton &&
                        !clickedTooltip
                    ) {
                        closeChatbot();
                    }
                }
            );

            /*
             * ESC 키로 챗봇 닫기
             */
            document.addEventListener(
                "keydown",
                function (event) {

                    if (
                        event.key === "Escape" &&
                        isChatbotOpen()
                    ) {
                        closeChatbot();
                    }
                }
            );

            /*
             * 이미지가 로드되지 않을 경우
             * 기본 이미지로 대체
             */
            foxImage.addEventListener(
                "error",
                function () {

                    const defaultImage =
                        "/common/img/ai/fox1.png";

                    if (
                        foxImage.src.indexOf(
                            "fox1.png"
                        ) === -1
                    ) {
                        foxImage.src =
                            defaultImage;
                    }
                }
            );

            /*
             * 5초마다 FOX 이미지만 변경
             */
            setInterval(
                changeFoxImage,
                5000
            );

            /*
             * 5초마다 FOX 버튼 흔들기
             */
            setInterval(function () {

                if (isChatbotOpen()) {
                    return;
                }

                chatbotButton.classList.remove(
                    "shake"
                );

                /*
                 * 애니메이션 재실행을 위해
                 * 브라우저 리플로우 발생
                 */
                void chatbotButton.offsetWidth;

                chatbotButton.classList.add(
                    "shake"
                );

                setTimeout(function () {

                    chatbotButton.classList.remove(
                        "shake"
                    );

                }, 800);

            }, 5000);

        })();
    </script>

</div></body>
</html>
