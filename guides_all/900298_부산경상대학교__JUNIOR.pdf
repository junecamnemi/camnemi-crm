										<p class="eng">AI cultural content school</p>
									</div>
								</div>
								<div class="swiper-slide" data-slide-index="1">
									<div class="thumb-box">
										<img src="/images/iphak_25/mdept_thumb_img02.jpg" alt="">
									</div>
									<div class="txt-box">
										<p class="tit">인문경상스쿨</p>
										<p class="eng">Humanities and Business School</p>
									</div>
								</div>
								<div class="swiper-slide" data-slide-index="2">
									<div class="thumb-box">
										<img src="/images/iphak_25/mdept_thumb_img03.jpg" alt="">
									</div>
									<div class="txt-box">
										<p class="tit">미래평생교육스쿨</p>
										<p class="eng">Future Lifelong Education School</p>
									</div>
								</div>
							</div>
						</div>
					</div>
					<script>
						var mDeptThumbs = new Swiper(".mdept-thumbs", {
							spaceBetween: 10,
							slidesPerView: 2,
							freeMode: true,
							watchSlidesProgress: true,
						});
						
						var mDeptSlider = new Swiper(".mdept-slider", {
							spaceBetween: 30,
							slidesPerView: 1,
							on: {
								slideChange: function() {
									var currentIndex = this.activeIndex;
									var thumbsWrapper = document.querySelector('.mdept-thumbs .swiper-wrapper');
									var thumbSlides = thumbsWrapper.querySelectorAll('.swiper-slide');
									
									// 모든 썸네일 표시
									thumbSlides.forEach(function(slide) {
										slide.style.display = '';
									});
									
									// 현재 슬라이드에 해당하는 썸네일 숨기기
									thumbSlides.forEach(function(slide) {
										var slideIndex = parseInt(slide.getAttribute('data-slide-index'));
										if (slideIndex === currentIndex) {
											slide.style.display = 'none';
										}
									});
									
									// 썸네일 슬라이더 업데이트
									mDeptThumbs.update();
								},
								init: function() {
									// 초기화 시에도 현재 슬라이드 숨기기
									this.emit('slideChange');
								}
							}
						});
						
						// 썸네일 클릭 이벤트
						document.querySelectorAll('.mdept-thumbs .swiper-slide').forEach(function(thumbSlide) {
							thumbSlide.addEventListener('click', function() {
								var targetIndex = parseInt(this.getAttribute('data-slide-index'));
								mDeptSlider.slideTo(targetIndex);
							});
						});
					</script>
				</div>
			</div>
		</div>
	</div>		<!-- 관리자 로그인 -->
		<script>
			function login(){
				$("#frm_footer").submit();
			}
		</script>
		<form id="frm_footer" action="/Login" method="POST">
