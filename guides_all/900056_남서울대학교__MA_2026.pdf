<script type="text/javascript">
function fn_login(){
	var siteDomain = 'http://www.nsu.ac.kr';
	var url = 'https://sso.nsu.ac.kr/login?redirect_url=';
	url += encodeURI( siteDomain );
	
	location.href=url;
}

$(document).ready(function(){
	var cookies = document.cookie.split(';');
	
	var val = '';
	
	for(var i in cookies){
		if(cookies[i].search('access_token') != -1){
			val = cookies[i].replace('access_token' + '=', '');
		}
	}
	
	if(val != ''){
		$('ul.join > li.login').html('');
	}
});
	
</script>

