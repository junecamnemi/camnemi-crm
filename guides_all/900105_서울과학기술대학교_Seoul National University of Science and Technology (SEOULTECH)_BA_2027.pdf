document.addEventListener("DOMContentLoaded", function () {
    document.querySelectorAll("p.boan").forEach(function (el) {
      var text = el.textContent.trim();
      if (text.length >= 2) {
    	el.textContent = text.charAt(0) + "*" + text.slice(2);  
      }
    });
  });
 
function content_print(){
	var w = 840;
	var h = 550;
	
	var dualScreenLeft = window.screenLeft != undefined ? window.screenLeft : screen.left;
    var dualScreenTop = window.screenTop != undefined ? window.screenTop : screen.top;

    var width = window.innerWidth ? window.innerWidth : document.documentElement.clientWidth ? document.documentElement.clientWidth : screen.width;
    var height = window.innerHeight ? window.innerHeight : document.documentElement.clientHeight ? document.documentElement.clientHeight : screen.height;

    var left = ((width / 2) - (w / 2)) + dualScreenLeft;
    var top = ((height / 2) - (h / 2)) + dualScreenTop;
    
	window.open("", 'contentPopup' , 'top=' + top + ', left=' + left + ' ,width='+w+',height='+h+',scrollbars=yes, directories=no' );

	contentPopupForm.contentBody.value = jQuery("#bbs_con").html();
	
	contentPopupForm.target = "contentPopup";
	contentPopupForm.submit();
	contentPopupForm.contentBody.value="";

}

function recomEvent(){
	resultData = requestData('boardRecomCountAdd', {'board_manager_seq':$('board_manager_seq').value, 'board_seq':$('board_seq_view').value});
	
	recomAfterEvent(resultData);
}

function recomAfterEvent(resultData){
	var defaultRecomCount = 0;
	
	if(resultData['state'] == 0){
		alert('오류가 발생하였습니다.\n\n잠시후 다시 시도 해 주십시오.');
	} else if(resultData['state'] == 1){
		alert('이미 추천한 게시물입니다.');
	} else if(resultData['state'] == 2){
		$('recomCnt').innerText = defaultRecomCount+1;
		alert('추천되었습니다.');
	} else if(resultData['state'] == 3){
		alert('본 메뉴는 로그인 후에 사용이 가능합니다.');
	} else {
		alert('잘못된 정보입니다.');
	}
}

function boardRecom() {
	if(confirm('게시물을 추천 하시겠습니까?')) {
		recomEvent();
	}
}
function boardReplayAdd(group_step) {

	if(group_step > 4){
		alert("답글은 5단계까지만 가능합니다.");
		return;
	}
	
	
	
	alert("권한이 없습니다.");
	
}
