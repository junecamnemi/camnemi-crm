<script type="text/javascript">
var startNum = 0;
var endNum   = 1000;
var sortType = 'DESC';
var commentTotalCount = 0;

// HTML 이스케이프
function escapeHtml(str) {
	if (str == null) return '';
	return String(str)
		.replace(/&/g, '&amp;')
		.replace(/</g, '&lt;')
		.replace(/>/g, '&gt;')
		.replace(/"/g, '&quot;')
		.replace(/'/g, '&#39;');
}

// 줄바꿈 -> <br>
function nl2br(str) {
	return escapeHtml(str).replace(/\r\n|\r|\n/g, '<br>');
}

// 댓글 등록
function addComment(up_comment_seq) {
	
		alert('로그인 후에 사용 가능합니다.');
		location.href = "/login/loginPage.do";
		return;
	

	

	var contentStr = '';

	if (up_comment_seq == 0) {
		if ($('re_content').value == '' || $('re_content').value == null) {
			alert('당신의 의견을 남겨 주세요.');
			$('re_content').focus();
			return;
		}
		contentStr = $('re_content').value;
	} else {
		var contentId = 'content' + up_comment_seq;

		if ($(contentId).value == '' || $(contentId).value == null) {
			alert('당신의 의견을 남겨 주세요.');
			$(contentId).focus();
			return;
		}
		contentStr = $(contentId).value;
	}

	var commentMap = {};
	commentMap['board_seq'] = $('comment_board_seq').value;
	commentMap['board_manager_seq'] = $('comment_manager_seq').value;
	commentMap['content'] = contentStr;
	commentMap['up_board_comment_seq'] = up_comment_seq;

	requestData('addBoardComment', commentMap, function(data) {
		var ok =
			data === true ||
			data === "true" ||
			(data && (data.result === true || data.result === "true")) ||
			(data && data.result && (data.result.result === true || data.result.result === "true"));

		if (ok) {
			commentListAjax();
		} else {
			alert("댓글 등록 횟수를 초과하였습니다.\n잠시후 다시 시도해주세요.");
			return;
		}
	});
}

// 댓글/대댓글 HTML 생성
function buildCommentHtml(item, isReply, memberType, replyCount) {
	var myId = '';
	var isAdmin = ('false' === 'true');
	var canEdit = (memberType == "true" && (item.user_id == myId || isAdmin));

	var crtdt  = item.crt_str ? item.crt_str.substr(0, 16) : '';
	var crtdt2 = item.crt_str ? item.crt_str.substr(0, 10) : '';
	var uptdt  = item.upt_str ? item.upt_str.substr(0, 16) : '';

	var viewDate = '';
	if (crtdt == uptdt) {
		viewDate = crtdt;
	} else {
		viewDate = crtdt2 + ' (' + uptdt + ' 수정)';
	}

	var html = '';
	html += '<div class="reply_box' + (isReply ? ' re' : '') + '" id="section_' + item.board_comment_seq + '" data-comment-seq="' + item.board_comment_seq + '">';

	// 본문
	html += '	<div class="box">';
	
	if (item.del_dt == null) {
		if (isAdmin == true) {
			html += '		<p class="name">' + escapeHtml(item.user_name)
			/* + '(' + escapeHtml(item.user_id) + ')' */ 
			+ '</p>';
		} else {
			if(item.user_name.length >= 2) {
				html += '		<p class="name">' + item.user_name.charAt(0) + "*" + item.user_name.slice(2) + '</p>';
			}
		}

		html += '		<div class="txt">';
		html += '			<p id="content_' + item.board_comment_seq + '">' + nl2br(item.content) + '</p>';
		html += '		</div>';

		html += '		<div class="bot">';
		html += '			<div class="left">';
		html += '				<span>' + escapeHtml(viewDate) + '</span>';

		if (!isReply) {
			if (replyCount > 0) {
				html += '				<a href="javascript:void(0);" class="form_pop_btn">답글쓰기 <b>' + replyCount + '</b></a>';
			} else {
				html += '				<a href="javascript:void(0);" class="form_pop_btn">답글쓰기</a>';
			}
		}

		html += '			</div>';

		if (canEdit) {
			html += '			<div class="right">';
			html += '				<a href="javascript:void(0);" title="댓글수정하기" class="mod_pop_btn">수정</a>';
			html += '				<a href="javascript:void(0);" title="댓글삭제하기" class="del_btn">삭제</a>';
			html += '			</div>';
		}

		html += '		</div>';
	} else {
		html += '		<div class="txt">';
		html += '			<p id="content_' + item.board_comment_seq + '">삭제된 댓글입니다.</p>';
		html += '		</div>';
	}

	html += '	</div>';

	// 답글 작성 폼(부모댓글만)
	if (item.del_dt == null && !isReply) {
		html += '	<div class="re_form" style="display:none;">';
		html += '		<div class="icon">';
		html += '			<img src="/images/kor/sub/re_form_icon.png" alt="">';
		html += '		</div>';
		html += '		<div class="form_wrap">';
		html += '			<textarea id="content' + item.board_comment_seq + '" placeholder="댓글을 작성해 주세요."></textarea>';
		html += '			<a href="javascript:void(0);" class="form_btn">등록</a>';
		html += '		</div>';
		html += '	</div>';
	}

	// 수정 폼
	if (item.del_dt == null && canEdit) {
		html += '	<div class="mod_form" style="display:none;">';
		html += '		<div class="form_wrap">';
		html += '			<p class="name">' + escapeHtml(item.user_name) + '</p>';
		html += '			<textarea id="modify_content_' + item.board_comment_seq + '">' + escapeHtml(item.content) + '</textarea>';
		html += '			<div class="bot">';
		html += '				<div class="left">';
		html += '					<span>' + escapeHtml(viewDate) + '</span>';
		html += '				</div>';
		html += '				<div class="right">';
		html += '					<a href="javascript:void(0);" title="수정저장하기" class="mod_save_btn">저장</a>';
		html += '					<a href="javascript:void(0);" title="수정취소하기" class="mod_pop_back">취소</a>';
		html += '				</div>';
		html += '			</div>';
		html += '		</div>';
		html += '	</div>';
	}

	html += '</div>';

	return html;
}

// 댓글 리스트 조회
function commentListAjax() {
	var memberType = jQuery("#sessionType").val();

	jQuery.ajax({
		type : "POST",
		url  : "/selectBoardComment.do",
		data : {
			"board_seq" : jQuery('#comment_board_seq').val(),
			"start_num" : startNum,
			"end_num"   : endNum,
			"sortType"  : sortType
		},
		success : function(data) {
			var list = data.boardCommentList || [];
			var comment_cnt = list.length;
			var appendHtml = '';
			var cmmtVaildCnt = 0;

			var parentList = [];
			var childMap = {};
			var item, i, j;

			if (comment_cnt < 1) {
				appendHtml += '<div class="reply_box">';
				appendHtml += '	<div class="box">';
				appendHtml += '		<div class="txt"><p>작성된 댓글이 없습니다.</p></div>';
				appendHtml += '	</div>';
				appendHtml += '</div>';
			} else {
				// 부모 / 자식 분리
				for (i = 0; i < comment_cnt; i++) {
					item = list[i];

					// 부모댓글: board_seq == up_board_comment_seq
					if (item.board_seq == item.up_board_comment_seq) {
						parentList.push(item);
					} else {
						if (!childMap[item.up_board_comment_seq]) {
							childMap[item.up_board_comment_seq] = [];
						}
						childMap[item.up_board_comment_seq].push(item);
					}
				}

				// 렌더링
				for (i = 0; i < parentList.length; i++) {
					item = parentList[i];
					var children = childMap[item.board_comment_seq] || [];
					var replyCount = 0;

					for (j = 0; j < children.length; j++) {
						if (children[j].del_dt == null) {
							replyCount++;
						}
					}

					appendHtml += buildCommentHtml(item, false, memberType, replyCount);

					if (item.del_dt == null) {
						cmmtVaildCnt++;
					}

					for (j = 0; j < children.length; j++) {
						appendHtml += buildCommentHtml(children[j], true, memberType, 0);

						if (children[j].del_dt == null) {
							cmmtVaildCnt++;
						}
					}
				}
			}

			jQuery('#reply_wrap').html(appendHtml);
			jQuery('.write_wrap').find('textarea').val('');

			if (cmmtVaildCnt > 0) {
				jQuery('#commentLength').text(cmmtVaildCnt);
			} else {
				jQuery('#commentLength').text('0');
			}
		},
		error : function(request, status, error) {
			alert("error : " + error);
		}
	});
}

// 댓글 접기/펼치기
function viewComment() {
	var $list = jQuery('#reply_wrap');
	var $write = jQuery('.write_wrap');

	if ($list.is(':visible')) {
		$list.slideUp(150);
		$write.slideUp(150);
	} else {
		$list.slideDown(150);
		$write.slideDown(150);
	}
}

jQuery(document).ready(function() {
	commentListAjax();

	// 답글 폼 열기/닫기
	jQuery(document).on('click', '.form_pop_btn', function() {
		
			alert('로그인 후에 사용 가능합니다.');
			location.href = "/login/loginPage.do";
			return;
		

		var $replyBox = jQuery(this).closest('.reply_box');

		jQuery('.re_form').not($replyBox.find('.re_form')).hide();
		jQuery('.mod_form').hide();

		$replyBox.find('.re_form').toggle();
	});

	// 답글 등록
	jQuery(document).on('click', '.form_btn', function() {
		var commentSeq = jQuery(this).closest('.reply_box').data('comment-seq');
		addComment(commentSeq);
	});

	// 수정 폼 열기
	jQuery(document).on('click', '.mod_pop_btn', function() {
		var $replyBox = jQuery(this).closest('.reply_box');

		jQuery('.re_form').hide();
		jQuery('.mod_form').not($replyBox.find('.mod_form')).hide();

		$replyBox.find('.mod_form').show();
	});

	// 수정 취소
	jQuery(document).on('click', '.mod_pop_back', function() {
		jQuery(this).closest('.mod_form').hide();
	});

	// 댓글/답글 수정 저장
	jQuery(document).on('click', '.mod_save_btn', function() {
		
			alert("댓글 수정 권한이 없습니다.");
			return false;
		

		var board_comment_seq = jQuery(this).closest('.reply_box').data('comment-seq');
		var contentStr = jQuery('#modify_content_' + board_comment_seq).val();

		var commentMap = {};
		commentMap['board_comment_seq'] = board_comment_seq;
		commentMap['board_seq'] = $('comment_board_seq').value;
		commentMap['board_manager_seq'] = $('comment_manager_seq').value;
		commentMap['modify_content'] = contentStr;

		requestData('modifyBoardComment', commentMap, function(data) {
			commentListAjax();
		});
	});

	// 댓글/답글 삭제
	jQuery(document).on('click', '.del_btn', function() {
		
			alert("댓글을 삭제할 권한이 없습니다.");
			return false;
		

		if (!confirm('댓글을 삭제하시겠습니까?')) {
			return;
		}

		var board_comment_seq = jQuery(this).closest('.reply_box').data('comment-seq');

		var commentMap = {};
		commentMap['board_comment_seq'] = board_comment_seq;
		commentMap['board_seq'] = jQuery('#boardCommentForm').find('#comment_board_seq').val();

		requestData('deleteBoardComment', commentMap, function(data) {
			commentListAjax();
		});
	});
});
</script>

