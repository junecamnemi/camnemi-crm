	$('boardForm').method='get';
	$('boardForm').submit();
}
function boardViewNew(seq,board_manager_seq) {
	$('board_seq_view').value = seq;
	$('board_manager_seq').value = board_manager_seq;
	$('boardForm').action = 'view.do';
	$('boardForm').submit();
}

//image view 사이즈 줄이기 
function imgResize(str)
{
	var x, y = "";
	var ch_x_val , ch_y_val = "";
	var arr = []
	var strReg = new RegExp("<img*[^>]*","gim");
	arr =  str.match(strReg);
	
	if(arr != null){
		for(var i=0; i<arr.length; i++){
			x = arr[i].substring(arr[i].indexOf('width:'), arr[i].length);
			x_val = x.substring(x.indexOf(":") + 1, x.indexOf("px"));
			
			y = arr[i].substring(arr[i].indexOf('height:'), arr[i].length);
			y_val = y.substring(y.indexOf(":") + 1, y.indexOf("px"));
			
			if(x_val > 820){
				ch_x_val = arr[i].replace("width:"+x_val+"px", "width:100%");
				str = str.replace(arr[i], ch_x_val);
				ch_y_val = ch_x_val.replace("height:"+y_val+"px;", "height:100%;");
				str = str.replace(ch_x_val, ch_y_val);				
			}
		}
	}
	
	return str;
}

function altCheck(str) {
	var alt = "";
	var alt_val = "";
	var arr = [];
	var arr2 = [];
	var strReg = new RegExp("<img*[^>]*>","gim"); 
	arr =  str.match(strReg);
	
	if(arr != null){
		for(var i=0; i<arr.length; i++){
			document.getElementById("img_temp").empty();
			document.getElementById("img_temp").innerHTML = arr[i];
			var img_temp = document.getElementById("img_temp").getElementsByTagName('img')[0];
			if(img_temp != null && img_temp != ""){
				if(img_temp.alt == null || img_temp.alt == ""){
					img_temp.alt = "image"; 
					str = str.replace(arr[i], document.getElementById("img_temp").innerHTML);
				}
			}
		}
	}
	
	return str;
}

function HTMLDecode(str)
{
   str = str.replace(/&lt;/gi,"<");
   str = str.replace(/&amp;/gi,"&");
   return str;
}

function fnLoadContent()
{
	var strContent = "";
	strContent += HTMLDecode(document.textareaForm["board_textarea"].value);
	strContent = imgResize(strContent);
	// strContent = altCheck(strContent);
	strContent = strContent.replace(/FONT-SIZE/g,'line-height:100%;FONT-SIZE');
	'';
	var objView = document.getElementById("divView");
	objView.innerHTML = strContent;
}

jQuery(document).ready(function(){
	jQuery("#divView img").each(function(){
		if(jQuery(this).attr('alt') == ""){
			jQuery(this).attr("alt", 'image');			
		}
	});
	
	jQuery('.clipBoardURL').click(function(){
		var clipUrl = jQuery(this).prev('.ebookUrl').text().trim();
		
		if(browserCheck()){		
			// IE일 경우
			window.clipboardData.setData("Text", clipUrl);
			alert("복사되었습니다");
		} else {
			// IE가 아닐 경우
			prompt("Ctrl + C를 눌러 복사하세요", clipUrl);	
		} 
	});	
	jQuery('.in > .fa').removeClass("fa-heart-o");
	jQuery('.in > .fa').addClass("fa-heart");
	
	
	var favourite_yn = '';
	
	if(favourite_yn == "Y"){
		jQuery("#favouritePc").attr("src","/images/kor/sub/bookmark_on_icon.png");
		jQuery("#favouriteTab").attr("src","/images/kor/sub/bookmark_on_icon.png");
		jQuery("#favouriteMob").attr("src","/images/kor/sub/bookmark_on_icon.png");
	}else{
		jQuery("#favouritePc").attr("src","/images/kor/sub/bookmark_icon.png");
		jQuery("#favouriteTab").attr("src","/images/kor/sub/bookmark_icon.png");
		jQuery("#favouriteMob").attr("src","/images/kor/sub/bookmark_icon.png");
	}
});

// 신고하기
function formSubmit() {

	if($('contentStr').value == ''){
		alert('신고내용을 입력하세요.');
		$('contentStr').focus();
		return;
	}

	if(confirm('게시물을 신고 하시겠습니까?')){
		$('contentReport').value = $('contentStr').value;
		$('boardForm').action = 'modifyBoardReportState.do';
		$('boardForm').submit();
	}
}

//신고하기 취소
function cancelSubmit() {
	$('contentStr').value = '';
}

//즐겨찾기 등록_2024.04
function addFavouriteLst(boardseq){
	jQuery.ajax({
		type  : "POST",
 		url   : "updateFavouriteBoard.do",
		data  : { "board_seq" : boardseq },
		success : function onSuccess(data) {
			if(data != null){
				if(data.result == "success"){
					if(data.value == "Y"){
						jQuery(".fa").removeClass("fa-heart-o");
						jQuery(".fa").addClass("fa-heart");
						jQuery("#favour_" + boardseq).addClass("in");
						jQuery('.info').text("이 게시물이 '나의콘텐츠 > 즐겨찾기'에 추가되었습니다.");
						
						jQuery("#favouritePc").attr("src","/images/kor/sub/bookmark_on_icon.png");
						jQuery("#favouriteTab").attr("src","/images/kor/sub/bookmark_on_icon.png");
						jQuery("#favouriteMob").attr("src","/images/kor/sub/bookmark_on_icon.png");
					} else {
						jQuery(".fa").addClass("fa-heart-o");
						jQuery(".fa").removeClass("fa-heart");
						jQuery("#favour_" + boardseq).removeClass("in");
						jQuery('.info').text("이 게시물이 '나의콘텐츠 > 즐겨찾기' 목록에서 삭제되었습니다.");
						
						jQuery("#favouritePc").attr("src","/images/kor/sub/bookmark_icon.png");
						jQuery("#favouriteTab").attr("src","/images/kor/sub/bookmark_icon.png");
						jQuery("#favouriteMob").attr("src","/images/kor/sub/bookmark_icon.png");
					}
					jQuery('.info').fadeIn().delay(1200).fadeOut();
				} else {
					if(data.value == -1){
						alert("로그인 후에 사용 가능합니다.");
						location.href="/login/loginPage.do";
					}
				}
			}
		},
		error : function(request,status,error) {
			alert("Error : " + error);
		}
	});
}

function goTop(){
	jQuery('html').scrollTop(0);
}
