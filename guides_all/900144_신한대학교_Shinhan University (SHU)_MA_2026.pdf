	<div class="artclView">
		
			
				<p style="margin: 0px; padding: 0px; font-family: arial, 'Nanum Gothic', nanumgothic, 돋움, dotum, tahoma, sans-serif; border: 0px; display: table; table-layout: fixed; width: 950px; height: 24px; color: rgb(34, 34, 34); letter-spacing: -0.48px; font-size: 13.3333px;"><span style="margin: 0px; padding: 0px; font-size: 12pt;">○ 2026학년도 후기 대학원 신,편입생 3차 모집요강<br style="margin: 0px; padding: 0px;"></span></p>
<p style="margin: 0px; padding: 0px; font-family: arial, 'Nanum Gothic', nanumgothic, 돋움, dotum, tahoma, sans-serif; border: 0px; display: table; table-layout: fixed; width: 950px; height: 24px; color: rgb(34, 34, 34); letter-spacing: -0.48px; font-size: 13.3333px;"><span style="margin: 0px; padding: 0px; font-size: 12pt;"><br style="margin: 0px; padding: 0px;"></span></p>
