	<!-- 240508 구글번역기능 추가 요청(한국어, 영어, 베트남어, 일본어, 프랑스어) -->
	<script>
		//240425 구글번역기능 추가 요청(한국어, 영어, 베트남어, 일본어, 프랑스어)
	function googleTranslateElementInit() {
		
		console.log("trans init");
