	$(window).bind('resize', function(e) {
		setYoutubeResize();
	});

	function setYoutubeResize(){
		windowWidth = window.innerWidth;
		windowHeight = window.innerHeight;
		if(windowWidth > 1198){
			$("#videoPop").css("width","800px");
			$("#videoPop").css("height","484px");
			$("#videoPop").css("top",(windowHeight / 2) - 242 + $(window).scrollTop() + 'px');
			$("#videoPop").css("left",(windowWidth / 2) - 400 + $(window).scrollLeft() + 'px');
			$("#youtubeFrame").attr("height","450");
		}else if(windowWidth > 960 && windowWidth <= 1198){
			$("#videoPop").css("width","754px");
			$("#videoPop").css("height","484px");
			$("#videoPop").css("top",(windowHeight / 2) - 242 + $(window).scrollTop() + 'px');
			$("#videoPop").css("left",(windowWidth / 2) - 377 + $(window).scrollLeft() + 'px');
			$("#youtubeFrame").attr("height","450");
		}else if(windowWidth > 768 && windowWidth <= 960){
			$("#videoPop").css("width","728px");
			$("#videoPop").css("height","484px");
			$("#videoPop").css("top",(windowHeight / 2) - 242 + $(window).scrollTop() + 'px');
			$("#videoPop").css("left",(windowWidth / 2) - 364 + $(window).scrollLeft() + 'px');
			$("#youtubeFrame").attr("height","450");
		}else if(windowWidth <= 768){
			$("#videoPop").css("width","400px");
			$("#videoPop").css("height","334px");
			$("#videoPop").css("top",(windowHeight / 2) - 167 + $(window).scrollTop() + 'px');
			$("#videoPop").css("left",(windowWidth / 2) - 200 + $(window).scrollLeft() + 'px');
			$("#youtubeFrame").attr("height","300");
		}		
	}

	var embed_lyaer;
	function openVideoPop(target){
		var $target = $('#'+target);
		$target.show();
		
		$("#videoPop").html(embed_lyaer);

		$("#comLightBox").show();
//		$('#youtubeFrame')[0].contentWindow.postMessage('{"event":"command","func":"' + 'playVideo' + '","args":""}', '*',);
		$('#youtubeFrame').focus();

		var offset = $("#youtubeFrame").offset();
//		$("html, body").animate({scrollTop: offset.top},400);
		setYoutubeResize();
	}

	function closeLayer(target) {
//		$('#youtubeFrame')[0].contentWindow.postMessage('{"event":"command","func":"' + 'pauseVideo' + '","args":""}', '*',); 
		embed_lyaer = $("#videoPop").html();
		$("#videoPop").html("");
		var $target = $('#'+target);
		$target.hide();
		$("#comLightBox").hide();
		$("#playBtn").focus();
	}
//-->

// 팝업 및 슬라이드js작업 S
var banner;
function setCookie( name, value, expiredays ) {
	var todayDate = new Date();
	todayDate.setDate( todayDate.getDate() + expiredays ); 
	document.cookie = name + "=" + escape( value ) + "; path=/; expires=" + todayDate.toGMTString() + ";"
}

function closePop() {
	if ($('#not_today').is(':checked')) {
		console.log("하루간 안보기");

		setCookie( "maindiv", "done" , 1 );
	}
	document.all['outtopbanner'].style.display = "none";
	banner = false;
}

cookiedata = document.cookie;

/*
if ( cookiedata.indexOf("maindiv=done") < 0 ){
	document.all['outtopbanner'].style.display = "block";
	banner = true;
}
else {
	document.all['outtopbanner'].style.display = "none";
	banner = false;
}

var bannerOnOff; var index1; var index2; var index3; var index4; var delay = false;
var delayFalse = setInterval(function(){
     delay = false;
}, 1000); */

function mobileCheck(){
	if($(window).width() < 1184 || $(window).height() < 769){
		$('#topbanner').css({position: 'relative'});
		$('#topbanner').css({height: '102px'});
		$('#topbannerwrap').css({position: ''});
		$('#tb_layer').css({position: ''});
		$('.wrap').css({position: ''});
		$('.item').css({position: 'relative'});
		$('.topbannerbox').css({width: '100%'});
		$('.item').css({width: '700px'});
	}
	
	if($(window).width() < 600) {
		$('.item').css({width: '100vw'});
	}

	if($(window).width() > 1184) {
		$('.item').css({width: '900px'});
		$('.item').css({position: 'absolute'});
		$('.topbanner').css({position: 'fixed'});
		$('.wrap').css({position: 'relative'});
		$('.topbannerbox').css({width: '420px'});
	}
}

//methods
var winWidth; var winHeight;
function sizeCheck(){
	index2=1;
	$('#topbanner').css({position: 'fixed'});
	if(banner){
		$('#topbanner').show();
		$('.topbanner').show();
		bannerOnOff = 'on';
	}
	mobileCheck();
}

sizeCheck();

window.onresize = function(event) {
	sizeCheck();
	winWidth=$(window).width();
	winHeight=$(window).height();
};

$("body").on('mousewheel DOMMouseScroll', function(e) {
	if(banner){
		var E = e.originalEvent;
		delta = 0;
		if (E.detail) {
			delta = E.detail * -40;
		}else if(E.wheelDelta){
			delta = E.wheelDelta;
		}else if(E.deltaY){
			delta = E.deltaY * -1;
		};

		if(delta > 0){ //스크롤업
			if(window.scrollY <= 0){
				$('.topbanner').slideDown();
				$('.outtopbanner').slideDown();
				bannerOnOff = 'on';
			}
		}else{
			if(bannerOnOff = 'on'){
				$('.topbanner').slideUp();
				$('.outtopbanner').slideUp();
				bannerOnOff = 'off';
			}
		}
	}
});

var swiper = new Swiper(".mySwiper", {
	slidesPerView: 2,
	spaceBetween: 0,
	autoplay: {
	delay:3000
	},
	loop:true,
	pagination: {
	el: ".swiper-pagination",
	clickable: true,
	loopedSlides: 2,
	},
});
// 팝업 및 슬라이드js작업 E
</script>

