<script>
	$(function(){
		// 주요사이트 바로가기
		$('#siteGoForm1').submit(function(){
			var link_url = $('#go_site01 option:selected').val();
			if(link_url == '')
			{
				alert('이동할 주요사이트를 선택하세요.');
				$('#go_site01').focus();
				return false;
			}
			else $(this).attr('action', link_url);

      		window.open(link_url, '_blank');
			return false;
		});
	});
</script>
