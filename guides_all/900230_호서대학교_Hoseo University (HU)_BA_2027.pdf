<script>
	var as = document.getElementsByTagName('a');
	for(var i = 0 ; i < as.length; i++){
		if(as[i].getAttribute('target') != '_blank'){
			if( as[i].getAttribute('href') != null
				&& as[i].getAttribute('href').indexOf('/main.do') < 0
				&& as[i].getAttribute('href').indexOf('/file/download.do') < 0
				&& as[i].getAttribute('href').indexOf('javascript') < 0){

				as[i].setAttribute('target', '_self');
			}
		}
	}
</script>
