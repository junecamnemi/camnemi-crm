<script>	
	
	
	

	$(document).ready(function () {
		$("#id_searchtext").keydown(function (key) {
			if (key.keyCode == 13) {
				searchForm();
			}
		});

		$("#id_chkusercode").keydown(function (key) {
			if (key.keyCode == 13) {
				Chk_UserCode();
			}
		})
	})

	function searchCategory(categoryid) {
		var url = '/submenu.do?menuurl=' + encodeURIComponent($("#id_menuurl").val());

		if (categoryid != "") { 
			url += '&categoryid=' + categoryid;
		}

		document.location.href = url;
	}

	function searchForm() {
		var url = '/submenu.do?menuurl=' + encodeURIComponent($("#id_menuurl").val());

		if ($("#id_category").val()) {
			url += '&categoryid=' + $("#id_category").val();
		}
		if ($("#id_searchNo").val()) {
			url += '&searchNo=' + $("#id_searchNo").val();
		}
		if ($("#id_searchtext").val()) {
			url += '&searchtext=' + encodeURIComponent($("#id_searchtext").val());
		}

		document.location.href = url;
	}

	function pop_pass_open(board_seq, secretYn) {
		$("input[name=userpwd]").val('');
		$("input[name=board_seq]").val(board_seq);
		if(board_seq==2029){
			alert("외국인 안내 영상은 추후 공개될 예정입니다.(10월 예정)\n" +
					"제공 언어: 러시아어, 베트남어, 영어, 중국어");
		}

		if (secretYn == "Y") {
			$("#pop_area").show();
		} else {
			$("#frm").submit();
		}
	}

	function Chk_UserCode() {
		if ($("#id_userpwd").val() == "") {
			alert("비밀번호를 입력하세요.");
			return false;
		}

		$("#frm").submit();
	}

	function openUrl(link_url, link_type, board_seq) {
		if(board_seq != null && board_seq != ''){
			$.ajax({
				url: "/ajax/updateBoardDataHit.do",
				data: {
					board_seq: board_seq
				},
				type: "post",
				dataType: "json",
				success: function (data) {
					if (data != null) {
						if(data < 1){
							alert('hit update error 001: ' + data);
						}
					}else{
						alert('hit update error 002: ' + data);
					}
				}
			});
		}

		// 1. URL 객체를 사용하여 URL 파싱
		const urlObject = new URL(link_url);
		const searchParams = urlObject.searchParams;

		// URL에서 쿼리 문자열만 추출
		//const queryString = link_url.split('?')[1];
		// 쿼리 문자열 추출
		const queryString = link_url.includes("?") ? link_url.split("?")[1] : "";

		if (queryString) {
			// 쿼리 문자열을 '&' 기준으로 분리
			const params = queryString.split('&');

			let decodedMenuurl = '';
			let otherParams = '';

			// 각 파라미터를 순회하며 'menuurl'과 그 외 파라미터 분리
			for (const param of params) {
				// +, &, =, / 대응
				if (param.startsWith('menuurl=')) {
					// 'menuurl=' 부분을 제외한 순수한 값만 추출
					const menuurlValue = param.substring(8);

					// 추출된 값의 '+'를 '%2B'로 변환
					decodedMenuurl = menuurlValue.replace(/\+/g, '%2B');

					// 올바르게 디코딩
					decodedMenuurl = decodeURIComponent(decodedMenuurl);

				} else {
					// 'menuurl'이 아닌 다른 파라미터는 그대로 저장
					if (otherParams) {
						otherParams += '&' + param;
					} else {
						otherParams = param;
					}
				}
			}

			// 3. 디코딩된 값을 다시 설정
			searchParams.set('menuurl', decodedMenuurl);
		}

		//const newUrl = urlObject.origin+urlObject.pathname+'?'+searchParams.toString();
		const newUrl = urlObject.origin + urlObject.pathname + (searchParams.toString() ? "?" + searchParams.toString() : "");

		if (link_type == "1") {
			window.open(newUrl)
		} else {
			document.location.href = newUrl;
		}

	}

</script> 
