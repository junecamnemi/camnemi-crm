<script>

	function openUrl(link_url, link_type) {
		// 1. URL 객체를 사용하여 URL 파싱
		const urlObject = new URL(link_url);
		const searchParams = urlObject.searchParams;

		// URL에서 쿼리 문자열만 추출
		//const queryString = link_url.split('?')[1];
		// 쿼리 문자열 추출
		const queryString = link_url.includes("?") ? link_url.split("?")[1] : "";


		let decodedMenuurl = '';
		let otherParams = '';

		if (queryString) {
			// 쿼리 문자열을 '&' 기준으로 분리
			const params = queryString.split('&');


			// 각 파라미터를 순회하며 'menuurl'과 그 외 파라미터 분리
			for (const param of params) {
				// +, &, =, / 대응
				if (param.startsWith('menuurl=')) {
					// 'menuurl=' 부분을 제외한 순수한 값만 추출
					const menuurlValue = param.substring(8);

					// 추출된 값의 '+'를 '%2B'로 변환
					decodedMenuurl = menuurlValue.replace(/\+/g, '%2B');

					// 올바르게 디코딩
					decodedMenuurl = decodeURIComponent(decodedMenuurl);

				} else {
					// 'menuurl'이 아닌 다른 파라미터는 그대로 저장
					if (otherParams) {
						otherParams += '&' + param;
					} else {
						otherParams = param;
					}
				}
			}

			// 3. 디코딩된 값을 다시 설정
			searchParams.set('menuurl', decodedMenuurl);
		}

		//const newUrl = urlObject.origin+urlObject.pathname+'?'+searchParams.toString();
		// 새 URL 생성 (쿼리스트링이 없으면 그대로 이동)
		const newUrl = urlObject.origin + urlObject.pathname + (searchParams.toString() ? "?" + searchParams.toString() : "");

		if (link_type == "1") {
			window.open(newUrl)
		} else {
			document.location.href = newUrl;
		}

	}

	function setParentHref(obj) {
		if ($("ul.gnb > li." + $(obj).find("ul.gnb_depth2 li").length > 0)) {
			console.log($(obj).find(">a").attr("href"));
			$(obj).find(">a").attr("href",$(obj).find("li > a").eq(0).attr("href"));
			console.log($(obj).find(">a").attr("href"));
			$(obj).find(">a").attr($(obj).find("li > a").eq(0).attr("href"));
			$(obj).find(">a").attr("target", $("." + $(obj).find(">a").data("menuno") + "> .gnb_depth2 > li:eq(0) > a").attr("target"));
		}
	}

	function leftSearchForm(content_type) {
		var url = '/search.do?';

		if(content_type != null){
			if(content_type.indexOf('hash') > -1){
				var hashtag = $("#" + content_type).html();
				content_type = null;
				/*해시태그 클릭 시 전체 검색으로 오픈*/
				hashtag = hashtag.split("#")[1];

				$("#id_left_searchtext").val(hashtag);
			}else if(content_type != ''){
				url += '&content_type=' + content_type;
			}
		}

		if($("#id_left_searchtext").val().indexOf('#') > -1){
			// url += '&searchNo=4'
			/*해시태그 클릭 시 전체 검색으로 오픈*/
			url += '&searchNo=1'
		}else{
			url += '&searchNo=1'
		}

		if ($("#id_left_searchtext").val()) {
			url += '&searchtext=' + encodeURIComponent($("#id_left_searchtext").val());
		}

		document.location.href = url;
	}

	$(function () {
		$(document).on("click", "ul.gnb li", function () {
			// setParentHref($(this));
		});
	});
</script>

	
	
	
