<!--승인대기 회원 카운트 수 표시 -->
<div class="alert" id="confmViewDiv" style="display: none;">
	<div class="top_bar copy">
		<h3>알림!</h3>
		<p>
			<a href="javascript:" class='b-close' title="닫기"><input type="hidden" value=""><img src="/images/co/lo/cancel.png" alt="닫기"/></a>
		</p>
	</div>
