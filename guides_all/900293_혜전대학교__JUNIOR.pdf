		<p class="user_img">
			<img src="/images/co/lo/user.png" alt="사용자">
		</p>
		<p class="user_txt" id='confmViewDivCnt'></p>

	</div>
</div>










<script>
$( document ).ready(function() {
	var mberCnt = "";
	var agreCnt = "";
	//회원 승인 대기 수 알림 ( 승인대기 회원, 학급홈페이지 승인대기정보, 학년코드, 개인정보동의여부, 비밀번호 변경 여부)
	var strCtx ="admission";
	if(mberCnt !="" && strCtx!='apple'){
		alertMberCnt( mberCnt , agreCnt );
	}
});

	$(".banner_box .control .list").click(function(){

		location.href="/admission/bannerList.do";
	})


	//회원 승인 대기 수 알림 ( 승인대기 회원, 학급홈페이지 승인대기정보, 학년코드, 개인정보동의여부, 비밀번호 변경 여부)
	function alertMberCnt( mberCnt, agreCnt){
		if ( mberCnt > 0 ) {
			var addHtmlCnt ="<strong>승인 대기 회원은 <strong>&nbsp;<strong style='font-size:20px;'>"+mberCnt+"명<br></strong>";
			
			addHtmlCnt +="입니다.";

			var windowWidth = $( window ).width();
			//모바일
			if(windowWidth < 500) {
				var addHtmlCnt ="승인 대기 회원은 "+mberCnt+"명\n";
			
				addHtmlCnt +=" 입니다.";

			//윈도우
			} else {
				$('#confmViewDivCnt').html(addHtmlCnt);

				$('#confmViewDiv').bPopup({
					modalClose : false,
					opacity : 0.3,
					speed : 450,
	 				autoClose : 2000,
	 				followSpeed: 1000,
					transition: 'slideDown',
					transitionClose: 'slideBack',
					positionStyle: 'fixed',
					onClose:function(){
						/*
						//개인정보 동의 여부 체크
						 if ( agreCnt > 0 ) {
							  $("#agreAt").val('N');
							  $("#login_form").attr('action','/admission/sb/sbscrb/indvdlinfoAgerPage.do').submit();

						 //비밀번호 변경주기 체크
						 }  else {
							  location.href = "/admission/main.do";
						 }
						*/
					 }


				});

				// 닫기
				$(".b-close").click(function(){
					$('#confmViewDiv').bPopup().close();
				});

			}
		}
	}
	
</script>













	</body>

</html>







