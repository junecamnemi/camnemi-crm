			<script>
			$(document).on('click', '.cont > a.FAQ', function() {
				var sysId = 'admission';
				var nttSn = $(this).attr('nttSn');
				var bbsId = $(this).attr('bbsId');
				var top = (Math.max(0, (($(window).height() - $(this).outerHeight()) / 2) + $(window).scrollTop()));
				var left =(Math.max(0, (($(window).width() - $(this).outerWidth()) / 2) + $(window).scrollLeft()));
				var mi = $(this).attr('mi');
				var mobileAt = 'N';
				
				
				if(mobileAt != "Y")
				{
					$.ajax({
						type : "post",
						url : "/admission/na/ntt/selectNttCnInfo.do",
						data : { 
							sysId : $("#sysId").val(),
							nttSn : nttSn
						},
						success : function(data) {
							
							var htmlData = "";
							var data = JSON.parse(data);
							var nttCn = data.nttCn;
							htmlData += nttCn;
							htmlData += "<br><br><span class='faqlist'>\n";
							htmlData += "더 자세한 내용은 FAQ게시판에서 확인하실 수 있습니다.<br/>\n";
							htmlData += "<a href='/admission/na/ntt/selectNttList.do?mi="+mi+"&bbsId="+bbsId+"'>FAQ게시판으로 이동</a>\n";
							htmlData += "</span>";
							//게시물 내용 설정
							$('#faqInfo').html(htmlData);
							
							$('#faqBpopup').bPopup({
								modalClose : false,
								opacity : 0.3,
								position:[600, 130],
								positionStyle:'fixed'
							});
						},
						error : function(data) {
							alert("오류가 발생하였습니다.\n관리자에게 문의하세요.");
						}		
					});	
				}
				else
				{
					location.href ="/admission/na/ntt/selectNttList.do?mi="+mi+"&bbsId="+bbsId;
				}	
			});
			
			//닫기
			$(document).on('click','#faqclose',function(){
				$('#faqBpopup').bPopup().close();
			});
			</script>
		</div>
		
