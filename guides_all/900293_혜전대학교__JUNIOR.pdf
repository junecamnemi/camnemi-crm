<script type="text/javascript">
function formatDateMonth(date) {
	var d = new Date(date),
	
	month = '' + (d.getMonth() + 1) , 
	year = d.getFullYear();
	
	if (month.length < 2) month = '0' + month; 
	
	return [year, month].join('.');
}

function formatDateDay(date) {
	var d = new Date(date),
	
	day = '' + d.getDate();
	
	if (day.length < 2) day = '0' + day; 
	
	return day;
}

$(function(){
	$(".notice h3 a").click(function(){
		var current = $(this).parent().hasClass("current");
		var read = $(this).parent().hasClass("read");
		var bbsId = $(this).parent().attr("id");
		var menuId = $(this).parent().attr("data-sn");
		var sysId = "admission";
		var html = "";
		
		if($(this).attr("title") == "공지사항" || current || read){
			return;
		} else {
			$(this).parent().addClass("read");
			$.ajax({
				url : "/admission/ma/selectMainNttList.do",
				type: "POST",
				data: {bbsId: bbsId},
				dataType :"JSON",
				success:function(data){
					if(data != null){
						html += "<div class='cont'>\n";
						for(var i=0; i<data.length; i++) {
							var nttMonth = formatDateMonth(data[i].regDt);
							var nttDay = formatDateDay(data[i].regDt);
							if(bbsId == "50") {
								html += "\t<a class='FAQ' nttSn="+data[i].nttSn+" bbsId="+bbsId+" mi="+menuId+" href='#faqInfo'>\n";
							} else {
								html += "\t<a href='/"+sysId+"/na/ntt/selectNttInfo.do?nttSn="+data[i].nttSn+"&bbsId="+bbsId+"&mi="+menuId+"'>\n";
							}
							html += "\t\t<dl>\n"
							html += "\t\t\t<dt>"+data[i].nttSj+"</dt>\n";
							html += "\t\t\t<dd>\n";
							html += "\t\t\t\t<p>"+(data[i].nttCn).substring(0,20)+"...</p>\n";
							html += "\t\t\t\t<div class='date'>\n";
							html += "\t\t\t\t\t<p class='y-m'>"+nttMonth+"</p>\n";
							html += "\t\t\t\t\t<p class='day'>"+nttDay+"</p>\n";
							html += "\t\t\t\t</div>\n";
							html += "\t\t\t</dd>\n";
							html += "\t\t</dl>\n";
							html += "\t</a>\n";
						}
						html += "</div>\n";
						html += "<a href='/"+sysId+"/na/ntt/selectNttList.do?mi="+menuId+"&bbsId="+bbsId+"' class='btn_more' title='더보기'><span>더보기</span></a>\n";
						
						/* FAQ */
						if(bbsId == "50") {
							$("#faqbbs").html(html);
						/* Q&A */
						} else if (bbsId == "51") {
							$("#qnabbs").html(html);
						/* 입시자료실 */
						} else if (bbsId == "57") {
							$("#ipsidata").html(html);
						}
					}else{
						alert("오류가 발생하였습니다.\n관리자에게 문의하세요.");
					}
				},
				error: function(xhr,status, error){
					alert("오류가 발생하였습니다.\n관리자에게 문의하세요.");
				}
			});
		}
	});
})
</script>

<script>
$(document).ready(function(){
	
	popupRolling();
	//메인미니리스트 탭이동
	$(".notice h3 a").click(function(){
		$(".notice h3").removeClass("current");
		$(this).parent("h3").addClass("current");		
		$(".notice .notibox").removeClass("on");
		$(".notice .list_box").removeClass("on");
		var idx = $(".notice h3 a").index($(this));
		$(".notice .list_box:eq("+idx+")").addClass("on");
	});
	
	function popupRolling(){
		var firstPop = $('.pop').find("li.on").length;
		$('.preCnt').text(firstPop);
	}
	
});
</script>
