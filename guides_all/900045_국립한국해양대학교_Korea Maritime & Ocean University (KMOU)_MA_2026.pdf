<!--입시캘린더 당월부터 노출  -->				            
<script> 
function getYear(){
    var date = new Date();
    var year = date.getFullYear();
    var month = ("0" + (1 + date.getMonth())).slice(-2);
    var day = ("0" + date.getDate()).slice(-2);

    return year;
}

function getMonth(){
    var date = new Date();
    var year = date.getFullYear();
    var month = ("0" + (1 + date.getMonth())).slice(-2);
    var day = ("0" + date.getDate()).slice(-2);

    return month;
}
											$(function(){
												var yy = getYear();												
												var aa = getMonth();
												if(aa == 1) {
													goIpsischedul(yy + '/05','prev');
												} else if(aa == 2) {
													goIpsischedul(yy + '/06','prev');
												} else if(aa == 3) {
													goIpsischedul(yy + '/07','prev');
												}else if(aa == 4) {
													goIpsischedul(yy +'/08','prev');
												}else if(aa == 5) {
													goIpsischedul(yy +'/09','prev');
												}else if(aa == 6) {
													goIpsischedul(yy +'/10','prev');
												}else if(aa == 7) {
													goIpsischedul(yy +'/11','prev');
												}else if(aa == 8) {
													goIpsischedul(yy + '/12','prev');
												}else if(aa == 9) {
													goIpsischedul((yy +1) + '/01','prev');
												}else if(aa == 10) {
													goIpsischedul((yy +1) +'/02','prev');
												}else if(aa == 11) {
													goIpsischedul((yy +1) +'/03','prev');
												}else if(aa == 12) {
													goIpsischedul((yy +1) + '/04','prev');
												}   
												
											});
											
											</script>

