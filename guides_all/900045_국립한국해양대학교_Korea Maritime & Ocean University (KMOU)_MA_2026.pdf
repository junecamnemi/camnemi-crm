<script>
$(document).ready(function(){
	//메인미니리스트 탭이동
	$(".notice h2 a").click(function(){
		$(".notice h2 a").removeClass("current");
		$(this).addClass("current");
		$(".notice .list_box").removeClass("on");
		/* $(".notice .list_box").removeClass("on");
		var idx = $(".notice h2 a").index($(this));
		$(".notice .list_box:eq("+idx/2+")").addClass("on"); */
		$(this).parent().next().addClass("on");
	});


	$(".calender table tbody td a").click(function(){
		$(".calender table tbody td div.cal_layer").css('display', 'none');
		var idx = $(".calender table tbody td a").index($(this));
		//td에 a태그가 2개씩 존재
		$(".calender table tbody td div.cal_layer:eq("+idx/2+")").css('display', 'block');

	});

	$(".calender .cal_list a.btn_close").click(function(){
		$(".calender table tbody td div.cal_layer").css('display', 'none');
	});


	
	
	
	
	
	var usePopYN = getCookie("popCookie71281");
	if(usePopYN != "hide") {
		$("#"+"popupNormal71281").dialog({
		    autoOpen: true,
		    modal: false,
		    resizeable : false,
		    title: "2027학년도 재외국민 특별전형 최종 합격자 발표 안내",
		    width: 510,
		    height: 383,
		    show:{
		  		effect:"blind",
		  		duration: 100
		    },
		    hide:{
		   	 	effect:"blind",
		   	 	duration: 100
		    },						    
		    position: {my:'left+0 top+380', at: 'left top' }
		}).dialog('open');
	}
	
	
	
	
	
	
	var usePopYN = getCookie("popCookie71244");
	if(usePopYN != "hide") {
		$("#"+"popupNormal71244").dialog({
		    autoOpen: true,
		    modal: false,
		    resizeable : false,
		    title: "2027학년도 신입생 수시모집 모집 안내",
		    width: 510,
		    height: 383,
		    show:{
		  		effect:"blind",
		  		duration: 100
		    },
		    hide:{
		   	 	effect:"blind",
		   	 	duration: 100
		    },						    
		    position: {my:'left+0 top+0', at: 'left top' }
		}).dialog('open');
	}
	
	
	
	
});

function goIpsischedul(srchDate, schedulGbn){
	$.ajax({
		type: "POST",
		url: "/ipsi/is/ipsischedul/selectSchduList.do",
		dataType: "json",
		data:{srchDate:srchDate ,schedulGbn:schedulGbn },
		success:function(result){
			$("#ipsischedul").html(result); 
		},
		error:function(data) {   
			alert("오류가 발생하였습니다.\n관리자에게 문의하세요.");
		}

	});
}

function calClose(){
	$(".calender table tbody td div.cal_layer").css('display', 'none');
}

function calDtail(id){
	$(".calender table tbody td div.cal_layer").css('display', 'none');
	$("#"+id).css('display', 'block');
}
</script>

