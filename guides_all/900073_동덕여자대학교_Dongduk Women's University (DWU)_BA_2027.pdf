	function fn_print(){
		$("#content").printThis({
			debug: false, // 디버그 모드 활성화 여부
			importCSS: true, // 페이지의 CSS를 프린트에 포함할지 여부
			importStyle: true, // 스타일 태그를 프린트에 포함할지 여부
			printContainer: true, // 프린트할 요소의 컨테이너 포함 여부
			loadCSS: "/ncmsrsc/templete/ipsi01/css/print.css", // 추가로 불러올 CSS 파일
			//pageTitle: "프린트 문서 제목", // 프린트 문서의 제목
			removeInline: false, // 인라인 스타일을 제거할지 여부
			removeInlineSelector: ".remove-this", // 인라인 스타일을 제거할 요소의 선택자
			printDelay: 333, // 프린트 전 대기 시간 (밀리초)
			header: "<h1>동덕여자대학교</h1>", // 프린트할 때 상단에 추가할 내용
			//footer: "<h1>프린트 푸터</h1>", // 프린트할 때 하단에 추가할 내용
			base: false, // 기본 URL을 설정할지 여부
			formValues: true, // 폼 값을 복사할지 여부
			canvas: false, // 캔버스 요소를 복사할지 여부
			doctypeString: '<!DOCTYPE html>', // 프린트할 문서의 doctype
			removeScripts: false, // 스크립트를 제거할지 여부
			copyTagClasses: true, // 태그 클래스를 복사할지 여부
			beforePrintEvent: null, // 프린트 전 이벤트
			beforePrint: null, // 프린트 전 콜백 함수
			afterPrint: null // 프린트 후 콜백 함수


		});
		/*
		var initBody = document.body.innerHTML; //body영역 저장
		window.onbeforeprint = function () { //프린터 출력 전 이벤트
			document.body.innerHTML = document.getElementById('content').innerHTML; //원하는 영역 지정 'div_print'
		}
		window.onafterprint = function () { //프린터 출력 후 이벤트
			document.body.innerHTML = initBody;
		}
		window.print();
		*/
	}

</script><script type="text/javascript">
	//<[[!CDATA[
	$(document).ready(function(){
	})

	var queryString = "&schM=list&page=1&viewCount=12&id=&schBdcode=&schGroupCode=";

	/* 글 조회 화면 function */
	function fn_goView(id, notice) {
		var tmpQuery = queryString;
		tmpQuery = common_js.fn_replaceQueryString(tmpQuery, "schM", "view");
		tmpQuery = common_js.fn_replaceQueryString(tmpQuery, "id", id);

		if (notice) {
			tmpQuery += "&notice="+notice;
		}

		//location.href="/user/board/info-list_view_ipsi_info.do?" + tmpQuery;
		location.href="?" + tmpQuery;
	}

	/* pagination 페이지 링크 function */
	function fn_egov_link_page(pageNo){
		location.href="?" + common_js.fn_replaceQueryString(queryString, "page", pageNo);
	}

	function fn_orderby(fld, orderby){
		var tmpQuery = queryString;
		var f = document.listForm;
		tmpQuery = common_js.fn_replaceQueryString(tmpQuery, "ordFld", fld);
		tmpQuery = common_js.fn_replaceQueryString(tmpQuery, "ordBy", orderby);
		tmpQuery = common_js.fn_replaceQueryString(tmpQuery, "viewCount", f.viewCount.value);
		tmpQuery = common_js.fn_replaceQueryString(tmpQuery, "schFld", f.schFld.value);
		tmpQuery = common_js.fn_replaceQueryString(tmpQuery, "schStr", f.schStr.value);
		tmpQuery = common_js.fn_replaceQueryString(tmpQuery, "page", "1");

		location.href="?" + tmpQuery;
	}

	function fn_search(){
		var tmpQuery = queryString;
		var f = document.listForm;
		tmpQuery = common_js.fn_replaceQueryString(tmpQuery, "viewCount", f.viewCount.value);
		tmpQuery = common_js.fn_replaceQueryString(tmpQuery, "schFld", f.schFld.value);
		tmpQuery = common_js.fn_replaceQueryString(tmpQuery, "schStr", f.schStr.value);
		
		tmpQuery = common_js.fn_replaceQueryString(tmpQuery, "page", "1");

		location.href="?" + tmpQuery;
	}

	function fn_viewcount(){
		var tmpQuery = queryString;
		var f = document.listForm;
		tmpQuery = common_js.fn_replaceQueryString(tmpQuery, "viewCount", f.viewCount.value);
		tmpQuery = common_js.fn_replaceQueryString(tmpQuery, "page", "1");

		location.href="?" + tmpQuery;
	}

	
	//]]>

	function fnFileInfo(fileId){
		$.ajax({
			url: "/jfile/readDownloadFiles.do",
			data : {
				fileId : fileId
			},
			dataType: 'json',
			success: function (data) {
				const fileList = data.fileList;
				console.log(data.fileList);
				if (fileList.length > 0) {
					const file = fileList[0];
					//const fileIdx = file.fileIdx;
					//const fileSeq = file.fileSeq;
					const fileMask = file.fileMask;
					const fileName = file.fileName;
					let downloadUrl = "https://ipsi.dongduk.ac.kr/afile/fileDownloadById/"+fileId+".do"

					preview(fileMask,downloadUrl)
				}
			},
			error: function (request, status, error) {
				alert("code:" + request.status + "\n" + "message:" + request.responseText + "\n" + "error:" + error);
			}
		});
	}


</script>

