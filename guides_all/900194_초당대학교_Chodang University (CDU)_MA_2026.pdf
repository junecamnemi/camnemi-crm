<script>
var app_path = "";
var isAdmin = false;
var isLogin = false;
var redirect_url = "/index.do";

$(function(){
	setGlobalMenu();
	setScroll();
	AOS.init({offset: 30});
	getShift("2026-09-18");
	$(window).scrollTop(0);


	if($("body").hasClass("pc") === true)
	{
		/* 팝업 OPEN */
		
	}

	//상단 팝업이 있을 경우
	if($(".popupArea").length > 0)
	{
		//상단 팝업 롤링처리
		var popupSlider = $("#popupSlider").bxSlider({
			auto: true,
			pause: 8000,
			controls: true,
			nextText: '<img src="'+app_path+'/images/btn_pop_next.png" />',
			prevText: '<img src="'+app_path+'/images/btn_pop_pre.png" />',
			nextSelector: '.popup_right',
			prevSelector: '.popup_left',
			pagerCustom: "#popupPaging",
			onSlideBefore: function() {
				$("#popupPaging > a > img").each(function(idx){
					if(idx == popupSlider.getCurrentSlide()){
						$(this).attr( "src", $(this).attr("src").replace("_off.","_on.") );
						$(this).attr( "alt", "position" );
					}else{
						$(this).attr( "src", $(this).attr("src").replace("_on.","_off.") );
						$(this).attr( "alt", "next" );
					}
				});
				popupSlider.startAuto(true);
			}
		});

		//닫기 버튼을 눌렀을 경우
		$(".popup_close .closeBtn").click(function(event){
			$(".popupArea").slideUp(300);
		});
	}
});

$(window).resize(function(){
	var mobileWidth = 1025;
	var tableWidth = 768;

	var headerHeight = $("#header").height();
	var popupHeight = $(".popupArea").height();

	if (!pcOnly){
		if(window.innerWidth < mobileWidth && !$("body").hasClass("mobile")){
			$("#header").css("top", 0);
			$(".main_visual").css("padding-top", headerHeight); //메뉴 위치조정
			$(".popupArea").hide();
		}

		if(window.innerWidth > mobileWidth && !$("body").hasClass("pc")){
			$("#header").css("top", popupHeight);
			$(".main_visual").css("padding-top", headerHeight + popupHeight + "px"); //메뉴 위치조정

			
		}
	} else {
		//$("#fullpage").css("padding-top","271px");
		//$("#header").css("top","140px");
		//$(".popupArea").show();
	}
}).resize();

