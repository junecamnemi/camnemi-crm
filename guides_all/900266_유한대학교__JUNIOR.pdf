<script>
	//카카오톡 채널
	function fnOpenKakaoChannel() {
	  const href = 'https://pf.kakao.com/_WbJgxb/chat';
	  const width = 430;
	  const height = 750;
	  const left = window.screenX + (window.outerWidth - width) - 20;
	  const top = 80;
	  const options =
		'popup=yes' +
		',width=' + width +
		',height=' + height +
		',left=' + left +
		',top=' + top +
		',resizable=yes' +
		',scrollbars=yes' +
		',status=no' +
		',toolbar=no' +
		',menubar=no' +
		',location=no';
	  window.open(href, 'kakao_popup', options);
	}
	//카카오톡 1:1 상담
	function fnOpenChatBot() {
	  const href = 'https://pf.kakao.com/_WbJgxb/chat';
	  const width = 430;
	  const height = 750;
	  const left = window.screenX + (window.outerWidth - width) - 20;
	  const top = 80;
	  const options =
		'popup=yes' +
		',width=' + width +
		',height=' + height +
		',left=' + left +
		',top=' + top +
		',resizable=yes' +
		',scrollbars=yes' +
		',status=no' +
		',toolbar=no' +
		',menubar=no' +
		',location=no';

	  window.open(href, 'chatbot_popup', options);
	}
	document.addEventListener('DOMContentLoaded', () => {
	  document.querySelectorAll('#btnKakao, #btnKakao2').forEach(btn => {
		btn.addEventListener('click', (e) => {
		  e.preventDefault();
		  fnOpenKakaoChannel();
		});
	  });
	});
</script>
