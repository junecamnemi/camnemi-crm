function fn_topTotalSearch(){
	var f = document.topSearchForm1;
	if( f.totalKey.value == "" ){
		alert("검색어를 입력해 주세요.");
		f.totalKey.focus();
		return ;
	}
	else {
		f.action = "/totalSearch.do";
		f.submit();
	}

}
function fn_chkEnter() {
	var f = document.topSearchForm1;
	var key = event.keyCode;

	if (key == 13) {
		fn_topTotalSearch();
	}
}
