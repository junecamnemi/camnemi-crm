	<script>
	  /*iFrame Auto Height*/
	  function iframeCssImport() {
		var $head = $("#iframe").contents().find("head");
		var $html = $("#iframe").contents().find("html");
		var $body = $("#iframe").contents().find("body");
		$html.css('overflow','hidden');
		$body.css('overflow','hidden');
		$head.append($("<link/>", { rel: "stylesheet", href: "/sites/style_guide/style/css/w_reset.css?version=1", type: "text/css" }));
	  }
	  function iframeHieght() {
		setTimeout(function(){
		  var the_height = $("#iframe").contents().find('#_JW_prFl_basic').innerHeight();
		  document.getElementById('iframe').height =the_height;
		  $("#iframe").css('opacity',1);
		}, 300);
	  }

	  $('#iframe').load(function(){
		iframeCssImport();
		iframeHieght();
	  });

	  $(window).resize(function(){
		if($('#iframe').length > 0) {
		  iframeHieght();
		}
	  });
	</script>

  




















 


