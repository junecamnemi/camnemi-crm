<script src="https://t1.kakaocdn.net/kakao_js_sdk/2.4.0/kakao.min.js"
  integrity="sha384-mXVrIX2T/Kszp6Z0aEWaA8Nm7J6/ZeWXbL8UpGRjKwWe56Srd/iyNmWMBhcItAjH" crossorigin="anonymous"></script>
<script>
  Kakao.init('aad40ca8d965f61ae1c891be1a4db24f'); // 사용하려는 앱의 JavaScript 키 입력
</script>
<script type="text/javascript">

	function printPage(){
		window.print();
	}

	function getCurrentURL() {
		return window.location.href;
	}
	
	function shareMessage() {
		var currentURL = getCurrentURL();
	    Kakao.Share.sendDefault({
	      objectType: 'feed',
	      content: {
	        title: '포스텍 학부 외국인 입학',
	        description: '#포스텍 학부 외국인 입학',
	        imageUrl:
	          'http://cpx-egov-kus.red.syworks.net/content/02comm/css/images/common/bsc_kus_logo.png',
	        		  //http://k.kakaocdn.net/dn/Q2iNx/btqgeRgV54P/VLdBs9cvyn8BJXB3o7N8UK/kakaolink40_original.png 이런식의 사진 링크를 넣어주세요~

	        link: {
	          // [내 애플리케이션] > [플랫폼] 에서 등록한 사이트 도메인과 일치해야 함
	          mobileWebUrl: currentURL,
	          webUrl: currentURL,
	        },
	      },
	      social: {
	        likeCount: 286,
	        commentCount: 45,
	        sharedCount: 845,
	      },
	      buttons: [
	        {
	          title: '웹으로 보기',
	          link: {
	            mobileWebUrl: currentURL,
	            webUrl: currentURL,
	          },
	        },
	        {
	          title: '앱으로 보기',
	          link: {
	            mobileWebUrl: currentURL,
	            webUrl: currentURL,
	          },
	        },
	      ],
	    });
	  }
	 function shareNaver() {
     	var url = encodeURI(encodeURIComponent(getCurrentURL()));
        var title = encodeURI(getCurrentURL());
        var shareURL = "https://share.naver.com/web/shareView?url=" + url + "&title=" + title;
        document.location = shareURL;
     }

	 function shareTwitter() {
	    var sendText = "포스텍 학부 외국인 입학"; // 전달할 텍스트
	    var sendUrl = getCurrentURL(); // 전달할 URL
	    window.open("https://twitter.com/intent/tweet?text=" + sendText + "&url=" + sendUrl);
	 }
	 function shareFacebook() {
	    var sendUrl = getCurrentURL(); // 전달할 URL
	    window.open("http://www.facebook.com/sharer/sharer.php?u=" + sendUrl);
	 }

	 function copyLink() {
		 var currentURL = window.location.href;

		  // 텍스트 선택을 도와주는 코드
		  var tempInput = document.createElement('input');
		  tempInput.value = currentURL;
		  document.body.appendChild(tempInput);
		  tempInput.select();
		  document.execCommand('copy');
		  document.body.removeChild(tempInput);

		  alert('URL이 클립보드에 복사되었습니다: ' + currentURL);
	 }
</script>
	 	 
