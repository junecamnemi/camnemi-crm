							<script type="text/javascript">
$(document).ready(function(){

	function getFirstSeq() {
		return $( document ).find("div.tabmenu").find(".tab_type1 a:first").data("seq");
	}

	function setPdfViewer( dataSeq ) {

		if( !dataSeq ) dataSeq = getFirstSeq();

		let data = [];
		data.push( {'name': "admissionType", 'value':"international"} );
		data.push( {'name': "dataSeq", 'value':dataSeq} );

		$.ajax( {
			"url" : "page/pdfViewer.do" ,
			"dataType" : "html" ,
			"data" :  data,
			"success" : function ( result ) {
				// console.log("result > ", result);
				let divName = "div.pdfViewer." +dataSeq;
				$(divName).html( result );
			}
		} );
	}

	$( document ).find("div.tabmenu").find(".tab_type1 a").click(function(){
		let $this = $(this);
		let dataSeq = $this.data("seq");

		setPdfViewer( dataSeq );
	});

	$( document ).find("select[name=selPdfSelect]").change(function(){
		let $this = $(this);
		let dataSeq = $this.find("option:selected").data("seq");

		setPdfViewer( dataSeq );
	});

	setPdfViewer();


});

</script>
