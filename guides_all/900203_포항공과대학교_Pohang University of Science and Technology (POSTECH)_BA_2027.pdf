	<script type="text/javascript">
	$( document ).ready( function () {
		// 언어변경 : 한국어 - kor, 영어 - eng
		$("#langChange").on("change", function(){
			var sclType = $(this).val();
			$.ajax({
				"url" : "/comm/member/user/userLangProc.do" ,
				"dataType": "text" ,
				"data": {
					"sclType" : sclType ,
					"id" : "",
				},
				"success": function( result ) {
					location.reload();
				}
			});
		} );
	} );
</script>
