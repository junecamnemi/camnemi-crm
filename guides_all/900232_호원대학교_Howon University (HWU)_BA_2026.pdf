			<div class="number_title__135645__ s_size_100">
				<ul>
					<li><span>2.</span><p>편입학 지원자격</p></li>
				</ul>
			</div>

			</div>
			<div style = "word-break:break-all;margin:0 0px 30px 0px;">			<!-- ...................  135646 : 표 2.0 ...................... -->
						
