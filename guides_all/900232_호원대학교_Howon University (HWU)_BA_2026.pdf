			</div>
			<div style = "word-break:break-all;margin:0 0px 30px 0px;">			<!-- ...................  135648 : 표 2.0 ...................... -->
						
			<!-- 표 2.0 -->
			
			<div class="table__135648__">
				<div class="table_inner">
					<table>
						<tr>
																					<td style="background-color:#c6d9f0;font-size:16px;color:#000000;font-weight:bold;text-align:center;vertical-align:middle;">구분</td>
																					<td style="background-color:#c6d9f0;font-size:16px;color:#000000;font-weight:bold;text-align:center;vertical-align:middle;">입학구분</td>
																					<td style="background-color:#c6d9f0;font-size:16px;color:#000000;font-weight:bold;text-align:center;vertical-align:middle;">모집인원</td>
