	<script>
		function login(){
			$("#returnUrl").val(window.location.href);
			$("#portal-form").attr("action", "/portalLogin/global/portalLoginForm.do").submit();
		}

		function logout(){
			var functionLocation = location;

			var scheme = functionLocation.protocol;
			var port = (functionLocation.port == 0 ) ? 80 : functionLocation.port
			var domain = functionLocation.hostname;
			var fnctUrl = "/portalLogin/skukr/logoutProcess.do";
			var returnUrl = "?returnUrl=" + functionLocation.href;

			var fullUrl = scheme + "//"+ domain + fnctUrl + returnUrl;


			location.href = 'http://sso.sungkyul.ac.kr/sso/pmi-logout-url.jsp?pmi-logout-url=http://sso.sungkyul.ac.kr/sso/pmi-logout.jsp&returl=' + fullUrl;

		}

		function portal(){
			$("#portal-form").attr("action", "/portalLogin/global/portalLoginForm.do").submit();
		}

	</script>

	<form id="portal-form" method="post">
		<input type="hidden" id="returnUrl" name="returnUrl" value=""/>
	</form>

