<div id="top_etc" class="clearfix headerBar">
    <div class="top_etc_wrap">
        <ul class="clearfix inner">
            <li class="on item lang"><a href="#" onclick="moveToLogin();return false;">로그인</a></li>
            <!-- 2024.02.13 아래 열린총장식 메뉴 주석처리 함(100K5) -->
