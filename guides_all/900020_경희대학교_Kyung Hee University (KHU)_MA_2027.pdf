	if ($(this).closest(".q").hasClass("active")){
		$(this).attr({"title":"답변 닫기"});
	}else{
		$(this).attr({"title":"답변 열기"});
	}

	target.slideToggle(150);
	other.slideUp(150);

	return false;
});

