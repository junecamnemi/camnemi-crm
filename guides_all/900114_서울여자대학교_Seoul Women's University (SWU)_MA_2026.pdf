<link rel="stylesheet" href="/Web-home/fnct/imageSlide/fullPopup/css/style.css">

<div class="_fnctWrap wrap_fullPopup">
	
	
	<h2 id="popupTitle">풀팝업<span id="total34">(<b>1</b> 개)</span></h2>
	<div id="wrap-slider34" class="container">
		<!--슬라이더-->
		<ul class="slider" id="slider34">
		</ul>
		<!--슬라이더-->
		<!--콘트롤-->
		<div id="control" class="control">
			<div class="numbering">
				<div>팝업건수 : 총</div>
				<span class="now">1</span>
				<span class="total" id="totalnum34">1</span>
				<div>건</div>
			</div>
			
				
			
			
				
			
			
				
					<div class="prevNext">
						<button type="button" class="prev" title="이전 슬라이드">이전</button>
						<button type="button" class="next" title="다음 슬라이드">다음</button>
					</div>
				
			
			<div class="wrapClose">
				<button type="button" class="closeFullPopup" title="풀팝업 닫기"><span>닫기</span></button>
