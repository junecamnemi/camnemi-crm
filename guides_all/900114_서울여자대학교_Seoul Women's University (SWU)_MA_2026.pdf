<script>
$(document).ready(function() {
    $.ajax({
        type: "post",
        cache: false,
        async: true,
        url: '/imageSlide/grd/34/getJsonImageSlideArtclList.do',
        success: function(artclList) {
            var artclLen = artclList ? artclList.length : 0;
            $('.openFullPopup i').text(artclLen);

            if (artclLen > 0) {
                $("#total34").html(artclLen);
                $("#totalnum34").html(artclLen);

                var html = "";
                const zero = (n) => n < 10 ? '0' + n : n;

                $(artclList).each(function() {
                    html += "<li>";
                    if (this.linkUseYn == "Y") {
                        var titleAttr = (this.linkTy == "_BLANK") ? " target='_blank' title='" + this.sj + " 새창 열림'" : " title='" + this.sj + " 이동'";
                        html += "<a href='" + this.urlAddr + "'" + titleAttr + ">";
                    }
                    html += "  <div class='item'>";
                    html += "    <div class='item_1'>";
                    html += "      <img src='" + this.imgPath + this.cnvrFile + "' alt='" + (this.alt ? this.alt : this.sj) + "'>";
                    html += "    </div>";
                    html += "    <div class='item_2'>";
                    html += "      <p class='txt_1'><span>" + this.sj + "</span></p>";
                    html += "      <p class='txt_2'><span>" + (this.alt ? this.alt : "") + "</span></p>";
                    html += "    </div>";
                    html += "  </div>";
                    if (this.linkUseYn == "Y") html += "</a>";
                    html += "</li>";
                });
                
                var $slider = $("#slider34");
                var $wrap = $('#wrap-slider34');

                $slider.html(html);

                $slider.on('init reInit afterChange', function(event, slick, currentSlide) {
                    var now = (currentSlide ? currentSlide : 0) + 1;
                    /*$wrap.find('.numbering > .now').text(zero(now));
                    $wrap.find('.numbering > .total').text(zero(slick.slideCount));*/
					$wrap.find('.numbering > .now').text(now);
                    $wrap.find('.numbering > .total').text(slick.slideCount);
                });

                $slider.slick({
                    slidesToShow: 3,
                    autoplay: true,
                    autoplaySpeed: 5000,
                    speed: 1000,
                    
                        fade: false,
                        
                    
                    slidesToScroll: 1,
                    infinite: (artclLen > 3),
                    arrows: (artclLen > 3),
                    dots: (artclLen > 3),
                    pauseOnHover: true,
                    pauseOnFocus: true,
                    appendDots: $wrap.find('.control .paging'),
                    prevArrow: $wrap.find('.prevNext .prev').attr('title', '이전 이미지 보기'),
                    nextArrow: $wrap.find('.prevNext .next').attr('title', '다음 이미지 보기'),
                    responsive: [
                        { breakpoint: 1280, settings: { slidesToShow: 2, infinite: (artclLen > 2) } },
                        { breakpoint: 768, settings: { slidesToShow: 1, infinite: (artclLen > 1) } }
                    ]
                });

                $wrap.find('button.play').on('click', function () {
                    $slider.slick("slickPlay");
                    $(this).removeClass('on').attr('aria-pressed', 'false');
                    $wrap.find('button.stop').addClass('on').attr('aria-pressed', 'true').focus();
                });
                $wrap.find('button.stop').on('click', function () {
                    $slider.slick("slickPause");
                    $(this).removeClass('on').attr('aria-pressed', 'false');
                    $wrap.find('button.play').addClass('on').attr('aria-pressed', 'true').focus();
                });

                // 사이트 첫 접속 시 자동 실행 로직
                if ($slider.find('.slick-slide').length > 0 && getCookie("isToday") != "Y" && !$('body').hasClass('sub')) {
                    if ($('.fullPopup .dim_layer').length === 0) {
                        $('.fullPopup').prepend('<div class="dim_layer"></div>');
                    }
                    $('body').addClass('scroll_lock'); 
                    $('.fullPopup').addClass('active');
                }

                if (artclLen <= 3) {
                    $('#control').addClass('invisible');
                }
            } else {
                $("#slider34").html("<li class='nodata'>생성된 데이터가 없습니다.</li>");
            }
        }
    });
});
</script>





<script type="text/javascript">
$(document).ready(function() {
    var $openBtn = null;

    // 팝업 수동 열기 (클릭 시)
    $('.openFullPopup').on('click', function() {
        var count = parseInt($(this).find('i').text()) || 0;
        if (count > 0) {
            $openBtn = $(this);
            
            if ($('.fullPopup .dim_layer').length === 0) {
                $('.fullPopup').prepend('<div class="dim_layer"></div>');
            }
            
            $('.fullPopup').addClass('active').attr('aria-hidden', 'false');
            $('body').addClass('scroll_lock'); 
            
            setTimeout(function() {
                $('.fullPopup').find('.closeFullPopup').focus();
            }, 100);

            $(document).on('keydown.popup', function(e) {
                if (e.keyCode === 27) closePopupLogic();
                if (e.keyCode === 9) {
                    var $focusable = $('.fullPopup').find('a, button, input, [tabindex="0"]').filter(':visible');
                    var first = $focusable.first()[0];
                    var last = $focusable.last()[0];

                    if (e.shiftKey && document.activeElement === first) {
                        $(last).focus(); e.preventDefault();
                    } else if (!e.shiftKey && document.activeElement === last) {
                        $(first).focus(); e.preventDefault();
                    }
                }
            });
        }
    });

    // 팝업 닫기 공통 로직 (딤 제거, 스크롤 해제 포함)
    function closePopupLogic() {
        $('.fullPopup').removeClass('active').attr('aria-hidden', 'true');
        $('.fullPopup .dim_layer').remove(); 
        $('body').removeClass('scroll_lock'); 
        
        $(document).off('keydown.popup'); 
        if ($openBtn) $openBtn.focus(); 
    }

    $('.closeFullPopup').on('click', closePopupLogic);

    $('.closeToday').on('click', function() {
        setCookie("isToday", "Y", 1); 
        closePopupLogic();
    });
});

// 쿠키 함수 (SameSite=Lax 적용)
function setCookie(name, value, expiredays) {
    var todayDate = new Date();
    todayDate.setDate(todayDate.getDate() + (expiredays || 1));
    document.cookie = name + "=" + encodeURIComponent(value) + "; path=/; expires=" + todayDate.toUTCString() + "; SameSite=Lax;";
}

function getCookie(name) {
    var value = document.cookie.match('(^|;) ?' + name + '=([^;]*)(;|$)');
    return value ? decodeURIComponent(value[2]) : null;
}
</script>
