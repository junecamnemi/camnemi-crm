<script>
function goPagePdf(pg, el) {
	$("#pdf").attr("page",pg);
	$("#pdf").attr('src','/admission/resource/pdfjs-dist/web/viewer.html?file=/upload/GUIDES/20260703082859001.pdf#navpanes=0&toolbar=0&statusbar=0&view=FitV&pagemode=none&page='+pg);
	$("#pdf_list li").removeClass("on");
	$(el).parents("li").addClass("on");
	//alert($("#pdf").attr("page"));
	console.log(el);
}
</script>
