<script>
//━━━━━━━━━━━━━━━━━━━━━━━
// 공백이나 널인지 확인(@return : boolean) / Trim이 있어야함
//───────────────────────
String.prototype.isBlank = function() {
	var str = this.trim();
	for(var i = 0; i < str.length; i++) {
		if ((str.charAt(i) != "\\t") && (str.charAt(i) != "\\n") && (str.charAt(i)!="\\r")) {
			return false;
		}
	}
	return true;
}

$('.header .btn_sitemap').show();
$('.header .btn_popUp').hide();

$(document).ready(function(){
	$("input[name=s_total_search_text_temp], input[name=s_total_search_text_temp_mo]").keydown(function (key) {

		if(key.keyCode == 13){//키가 13이면 실행 (엔터는 13)
			searchBook();
		}
	
	});
	$('.allMenu_renew button').click(function(){
		searchBook();
	});
		
	searchBook = function (){
		//검색 찾는 로직 구현
		var s_total_search_text_temp = $("input[name=s_total_search_text_temp]").val();
		var s_total_search_text_temp_mo = $("input[name=s_total_search_text_temp_mo]").val();

		if(s_total_search_text_temp == ""){
			s_total_search_text = s_total_search_text_temp_mo;
		}else{
			s_total_search_text = s_total_search_text_temp;
		}

		if(s_total_search_text ==""){
			alert("검색어를 입력하여 주시기 바랍니다.");
			return false;
		}

		$("input[name=s_total_search_text]").val(s_total_search_text);
//console.log($("input[name=s_total_search_text]").val());
		document.TotalForm.submit();
	};
});

	$('.btn_seacrch').on('click', function(){
		$(this).toggleClass('on');
		$('.search_area').toggleClass('on');
	});

	var winWid = window.innerWidth;

	function searchOff(){
		if( winWid < 1280 ){
			$('.btn_seacrch').removeClass('on');
			$('.search_area').removeClass('on');
		}
	}
	searchOff();

	window.addEventListener('resize', function(){
		winWid = window.innerWidth;
		searchOff();
	});

</script>

