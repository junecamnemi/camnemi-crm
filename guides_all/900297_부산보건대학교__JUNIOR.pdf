            <div id="IContents_div내용" class="board-view-cont">
                
                
                <p class="0">
   <b style="font-size: 1rem; letter-spacing: -0.03rem;"><span style="letter-spacing: 0pt; font-size: 20px; font-family: &quot;맑은 고딕&quot;, &quot;Malgun Gothic&quot;;">◎&nbsp;</span><span style="font-size: 20px; font-family: &quot;맑은 고딕&quot;, &quot;Malgun Gothic&quot;;">단순유학</span></b>
</p>
