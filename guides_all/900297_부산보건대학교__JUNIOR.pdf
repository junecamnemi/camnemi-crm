    <div id="IContents_divView">
        <div class="board-view">
            <div class="board-view-title">
                <h3><a href="/ipsi/boardview/2/311" id="IContents_atitle" class="title" target="_parent">
                    2026학년도 재외국민, 외국인 및 새터민 전형 서류 안내</a></h3>
                <p class="board-info"><span><i class="material-icons notranslate" aria-hidden="true">create</i>&nbsp;입학처</span><span id="IContents_span작성일시"><i class="material-icons notranslate" aria-hidden="true">access_time</i>&nbsp;2025.07.02 15:54</span><span><i class="material-icons notranslate" aria-hidden="true">visibility</i>&nbsp;2344</span></p>
