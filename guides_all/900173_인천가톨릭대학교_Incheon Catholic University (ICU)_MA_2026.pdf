                $('.btn_mobm_close, .mob_back').click(function () {
                        $('.left_nav_wrap').removeClass("mobm_open");
                        $('.mob_back').removeClass("mob_back_on");
                        $('.mobm_open').css("box-shadow", "none");
                });
            })
        </script>
