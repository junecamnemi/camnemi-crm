            $(document).ready(function () {
                $('#nheader_main ul').mouseenter(function () {
                    $('#nheader_02')
                        .stop(true, true)
                        .slideDown();
                })

                $('#nheader_main ul').mouseleave(function () {
                    $('#nheader_02')
                        .stop(true, true)
                        .slideUp();
                })
                $('#nheader_main ul li').mouseenter(function () {
                    $(this).addClass('on');
                })

                $('#nheader_main ul li').mouseleave(function () {
                    $(this).removeClass('on');
                })

                $('#nheader_02').mouseenter(function () {
                    $('#nheader_02')
                        .stop()
                        .slideDown();
                })
                $('#nheader_02').mouseleave(function () {
                    $('#nheader_02')
                        .stop()
                        .slideUp();
                })
            })
        </script>
        <script>
            $(document).ready(function() {
