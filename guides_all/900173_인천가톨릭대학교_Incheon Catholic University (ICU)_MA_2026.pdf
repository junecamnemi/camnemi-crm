    <script>
        $(window).scroll(function(event){
            var height = $(document).scrollTop();
            if( height > 100){
                $('#toTop').addClass('on');
            }else{
                $('#toTop').removeClass('on');
            };
        });
        $(document).ready(function() {
            $('#toTop').click(function(){
            $("html, body").animate({ scrollTop:0}, 600);
            return false;
        });
        })
        
    </script>
