				<script>
					$seviceList = $(".fservice")
					$seviceListBtn = $(".sevice-list-btns");
					$seviceList.mCustomScrollbar({
						theme:"dark-thin",
						axis: "x",
						scrollbarPosition: "inside",
						advanced:{ autoExpandHorizontalScroll:true },
						callbacks:{
							onOverflowX : function(){
								$seviceListBtn.show();
								$(".btn-prev", $seviceListBtn).click(function(e){
									e.preventDefault();
									$seviceList.mCustomScrollbar('scrollTo','+=200');
									$(this).addClass("on").siblings().removeClass("on");
								});
								$(".btn-next", $seviceListBtn).click(function(e){
									e.preventDefault();
									$seviceList.mCustomScrollbar('scrollTo','-=200');
									$(this).addClass("on").siblings().removeClass("on");
								});
							},
							onOverflowXNone: function(){
								$seviceListBtn.hide();
							}
						}
					});
				</script>
