<div class="intro-wrap">     
      <div class="con-box">
          <h4 class="h4-tit01"> 입시일정 안내 (Graduate School Admissions for International Students)</h4>           
          <table cellpadding="0" cellspacing="0" class="yonsei-table" summary=" 2027학년도 외국인전형 입시일정 안내 (Graduate School Admissions for International Students)을 보여주는 표">
                <caption> 2025학년도 외국인전형 입시일정 안내 (Graduate School Admissions for International Students)</caption>
                <colgroup>
                    <col width="8%" />
                    <col width="17%" />
                    <col width="17%" />
                    <col width="*" />
                </colgroup>
                <thead>
                    <tr>
                        <th scope="col">번호</th>
                        <th scope="col" colspan="2">지원절차</th>
                      <th scope="col">2027 전기 입학전형(2027년 3월 신입학)	</th>        
                    </tr>
                </thead>
                <tbody>
                  <tr>
                        <td>1</td>
                        <td colspan="2">입학원서 접수</td>
                    <td>2026. 10. 7.(수) 10:00 ~ 10. 14.(수) 17:00 마감 </td>
                    </tr>
                   <tr>
                        <td>2</td>
                        <td colspan="2">구술시험 대상자 발표</td>
                     <td>2026. 11. 6.(금) 17:00</td>
                    </tr>
                   <tr>
                        <td>3</td>
                        <td colspan="2">구술시험 및 음대실기</td>
                     <td>2026. 11. 14.(토) [학과별 상이할 수 있으므로 모집요강 확인]</td>
                    </tr>
                   <tr>
                        <td>4</td>
                        <td colspan="2">최종 합격자발표</td>
                     <td>2026. 12. 4.(금) 17:00</td>
					  
                    </tr>                  
					                   <tr>
