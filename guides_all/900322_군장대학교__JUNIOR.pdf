    <!-- jQuery (구글 번역용) -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    
    <script type="text/javascript">
        // 구글 번역 초기화 대기 및 언어 변경 함수 (먼저 선언)
        function waitForGoogleTranslate(callback) {
            var attempts = 0;
            var maxAttempts = 50; // 5초 대기 (100ms * 50)
            
            function checkTranslate() {
                var gtcombo = document.querySelector('.goog-te-combo');
                if (gtcombo) {
                    callback();
                } else if (attempts < maxAttempts) {
                    attempts++;
                    setTimeout(checkTranslate, 100);
                } else {
                    console.warn('Google Translate 초기화 실패');
                }
            }
            
            checkTranslate();
        }

        // 언어 변경 함수
        function changeLanguage(lang) {
            var gtcombo = document.querySelector('.goog-te-combo');
            
            if (gtcombo && lang) {
                try {
                    // 한국어를 선택한 경우 원래 상태로 복원
                    if (lang === 'ko') {
                        // 구글 번역을 원래 언어로 복원
                        gtcombo.value = '';
                        var event = new Event('change', { bubbles: true });
                        gtcombo.dispatchEvent(event);
                        
                        // 페이지 리로드하여 원래 상태로 복원
                        setTimeout(function() {
                            // 쿠키에서 구글 번역 설정 제거
                            document.cookie = 'googtrans=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;';
                            document.cookie = 'googtrans=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/; domain=' + window.location.hostname;
                            
                            // 페이지 리로드
                            window.location.reload();
                        }, 100);
                        return true;
                    } else {
                        // 다른 언어로 번역
                        gtcombo.value = lang;
                        var event = new Event('change', { bubbles: true });
                        gtcombo.dispatchEvent(event);
                        return true;
                    }
                } catch (e) {
                    console.error('언어 변경 오류:', e);
                    return false;
                }
            }
            return false;
        }

        // DOM 로드 후 이벤트 바인딩
        document.addEventListener('DOMContentLoaded', function() {
            // 언어 선택 버튼은 common.js의 initLanguageToggle에서 처리되므로 여기서는 구글 번역 이벤트만 처리
            var languageBtn = document.querySelector('.language-btn');
            
            // jQuery가 있으면 사용, 없으면 순수 JavaScript 사용
            var bindEvents = function() {
                var links = document.querySelectorAll('ul.country-links li>a');
                
                links.forEach(function(link) {
                    link.addEventListener('click', function(e) {
                        e.preventDefault();
                        e.stopPropagation();
                        
                        var lang = this.getAttribute('data-lang');
                        
                        if (lang) {
                            // 언어 선택 리스트 닫기
                            var btn = document.querySelector('.language-btn');
                            if (btn) {
                                btn.classList.remove('active');
                            }
                            
                            // 구글 번역이 준비되었는지 확인
                            var gtcombo = document.querySelector('.goog-te-combo');
                            
                            if (gtcombo) {
                                changeLanguage(lang);
                            } else {
                                // 아직 준비되지 않았다면 대기
                                waitForGoogleTranslate(function() {
                                    changeLanguage(lang);
                                });
                            }
                        }
                        
                        return false;
                    });
                });
            };

            // jQuery 사용 (있는 경우)
            if (typeof jQuery !== 'undefined') {
                jQuery(document).ready(function($) {
                    bindEvents();
                    
                    // jQuery 이벤트 위임도 추가
                    $(document).on("click", "ul.country-links li>a", function(e) {
                        e.preventDefault();
                        var lang = $(this).data("lang");
                        if (lang) {
                            waitForGoogleTranslate(function() {
                                changeLanguage(lang);
                            });
                        }
                        return false;
                    });
                });
            } else {
                // 순수 JavaScript
                bindEvents();
            }
        });

        /* 구글 번역 초기화 */
        function googleTranslateElementInit() {
            new google.translate.TranslateElement(
                {pageLanguage: 'ko', autoDisplay: false},
                'google_translate_element'
            );
            
            // 초기화 후 잠시 대기 후 언어 변경 함수 준비
            setTimeout(function() {
                waitForGoogleTranslate(function() {
                    console.log('Google Translate 준비 완료');
                });
            }, 500);
        }
    </script>

    <!-- 구글 번역 스크립트 -->
    <script src="https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>

    <style>
        /* 구글 번역 UI 숨기기 및 레이아웃 보호 */
        iframe.skiptranslate{
            visibility:hidden !important;
        }
        #google_translate_element {
            display: none !important;
        }
        
        .goog-te-banner-frame,
        .goog-te-menu-frame {
            display: none !important;
        }
        
        body {
            top: 0 !important;
        }
        
        /* 구글 번역 드롭다운이 나타나도 레이아웃이 깨지지 않도록 */
        .goog-te-combo {
            display: none !important;
        }
        
        /* 언어 선택 리스트 스타일 유지 */
        .translation-links.country-links {
            list-style: none;
            margin: 0;
            padding: 0;
        }
        
        .translation-links.country-links li {
            margin: 0;
            padding: 0;
        }
        
        .translation-links.country-links li a {
            display: block;
            text-decoration: none;
            color: inherit;
        }
    </style><!--// E: HEADER -->
 
