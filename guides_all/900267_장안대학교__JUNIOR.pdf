<style>
    /* ===========================
        JANGAN ON AIR - 레이아웃 및 스타일
    =========================== */
    #janganOnAir {
        padding: 100px 0;
        background: #fff;
        overflow: hidden;
    }

    #janganOnAir .wrapper {
        max-width: 1450px;
        margin: auto;
    }

    #janganOnAir .onair-wrap {
        display: flex;
        gap: 70px;
    }

    /* 메인 영상 크기 확대 (48%) */
    #janganOnAir .onair-left {
        width: 48%;
    }

    #janganOnAir h2 {
        font-size: 72px;
        font-weight: 900;
        line-height: 1;
        margin-bottom: 20px;
        letter-spacing: -3px;
    }

    #janganOnAir h2 span {
        color: #198cff;
    }

    #janganOnAir .sub {
        font-size: 23px;
        color: #555;
        margin-bottom: 40px;
    }

    #janganOnAir .sns-icons {
        display: flex;
        gap: 18px;
        margin-bottom: 45px;
    }

    #janganOnAir .sns-icons a {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        overflow: hidden;
        transition: .3s;
        box-shadow: 0 8px 25px rgba(0, 0, 0, .15);
        display: inline-block;
    }

    #janganOnAir .sns-icons a:hover {
        transform: translateY(-5px);
    }

    #janganOnAir .sns-icons img {
        width: 100%;
        display: block;
    }

    #janganOnAir .main-video {
        position: relative;
        border-radius: 28px;
        overflow: hidden;
        box-shadow: 0 25px 60px rgba(0, 0, 0, .18);
    }

    #janganOnAir .main-video::before {
        content: "";
        display: block;
        padding-top: 56.25%;
    }

    #janganOnAir iframe {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        border: 0;
    }

    /* ===========================
        비디오 리스트 영역
    =========================== */
    #janganOnAir .onair-right {
        flex: 1;
        overflow: hidden; 
    }

    #janganOnAir .videoSection {
        margin-bottom: 70px;
    }

    #janganOnAir .titleRow {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
        padding-right: 20px; 
    }

    #janganOnAir .titleRow h3 {
        font-size: 36px;
        font-weight: 800;
    }

    #janganOnAir .arrow {
        display: flex;
        gap: 12px;
    }

    #janganOnAir .arrow button {
        width: 58px;
        height: 58px;
        border-radius: 50%;
        border: none;
        background: #f5f5f5;
        font-size: 28px;
        cursor: pointer;
        transition: .3s;
    }

    #janganOnAir .arrow button:hover {
        background: #198cff;
        color: #fff;
    }

    #janganOnAir .videoSlider {
        overflow: visible; 
    }

    #janganOnAir .videoTrack {
        display: flex;
        gap: 22px;
    }

    /* --- 일반 가로형 비디오 카드 --- */
    #janganOnAir .videoCard {
        width: 260px;
        flex: none;
        cursor: pointer;
    }
    #janganOnAir .videoCard .thumb {
        aspect-ratio: 16 / 9; /* 가로형 16:9 비율 */
    }

    /* --- 숏폼(세로형) 비디오 카드 --- */
    #janganOnAir .shortsCard {
        width: 170px; /* 세로형이라 폭을 좁게 설정 */
        flex: none;
        cursor: pointer;
    }
    #janganOnAir .shortsCard .thumb {
        aspect-ratio: 9 / 16; /* 세로형 9:16 비율 */
    }

    /* 썸네일 공통 스타일 */
    #janganOnAir .thumb {
        position: relative;
        overflow: hidden;
        border-radius: 22px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, .12);
        background: #000;
    }

    #janganOnAir .thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover; /* 이미지가 비율에 맞게 꽉 차도록 설정 */
        display: block;
        transition: .35s;
    }

    #janganOnAir .videoCard:hover img,
    #janganOnAir .shortsCard:hover img {
        transform: scale(1.08);
    }

    /* 텍스트 스타일 */
    #janganOnAir .videoCard h4,
    #janganOnAir .shortsCard h4 {
        margin-top: 16px;
        font-size: 24px;
        font-weight: 700;
        line-height: 1.4;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap; /* 제목 한 줄 처리 */
    }

    #janganOnAir .shortsCard h4 {
        font-size: 20px; /* 숏폼은 폭이 좁아서 글자를 조금 작게 */
    }

    #janganOnAir .videoCard p,
    #janganOnAir .shortsCard p {
        margin-top: 10px;
        color: #777;
        font-size: 16px;
    }

    /* ===========================
        반응형 (모바일)
    =========================== */
    @media (max-width: 1200px) {
        #janganOnAir .onair-wrap {
            flex-direction: column;
        }
        #janganOnAir .onair-left {
            width: 100%;
        }
        #janganOnAir .videoCard { width: 220px; }
        #janganOnAir .shortsCard { width: 150px; }
    }

    @media (max-width: 768px) {
        #janganOnAir { padding: 60px 0; }
        #janganOnAir h2 { font-size: 42px; }
        #janganOnAir .titleRow h3 { font-size: 24px; }
        #janganOnAir .videoCard { width: 180px; }
        #janganOnAir .shortsCard { width: 130px; }
        #janganOnAir .videoCard h4, #janganOnAir .shortsCard h4 { font-size: 18px; }
    }
</style>

<section id="janganOnAir">
    <div class="wrapper">
        <div class="onair-wrap">
            
            <!-- 왼쪽 설명 영역 -->
            <div class="onair-left">
                <h2>JANGAN<br><span>ON AIR</span></h2>
                <p class="sub">장안대학교의 다양한 영상을 만나보세요</p>
                
                <div class="sns-icons">
                    <a href="https://www.youtube.com/channel/UCvhJPAXuF1lYznuS8i6Q5jw" target="_blank" title="유튜브">
                        <img src="/kor/images/youtube.png" alt="Youtube">
                    </a>
                    <a href="https://www.facebook.com/people/%EC%9E%A5%EC%95%88%EB%8C%80%ED%95%99%EA%B5%90-Jangan-University/61577291438472/#" target="_blank" title="페이스북">
                        <img src="/kor/images/facebook.png" alt="Facebook">
                    </a>
                    <a href="https://www.instagram.com/janganuniv/" target="_blank" title="인스타그램">
                        <img src="/kor/images/instar.png" alt="Instagram">
                    </a>
                </div>

                <div class="main-video">
                    <iframe id="mainPlayer" width="560" height="315" src="https://www.youtube.com/embed/_xUDGh-MdeE?si=DVj2cIVmzVPx0om0" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
                </div> 
                
            </div>

            <!-- 오른쪽 슬라이더 영역 -->
            <div class="onair-right">
                
                <!-- 추천영상 (가로형) -->
                <div class="videoSection">
                    <div class="titleRow">
                        <h3>최근 업로드 영상</h3>
                        <div class="arrow">
                            <button class="prev1" aria-label="이전">‹</button>
                            <button class="next1" aria-label="다음">›</button>
                        </div>
                    </div>
                    <div class="videoSlider">
                        <div class="videoTrack" id="recommendTrack">
                            <!-- JS 생성 -->
                        </div>
                    </div>
                </div>

                <!-- 최근 업로드 영상 (숏폼 세로형) -->
                <div class="videoSection">
                    <div class="titleRow">
                        <h3>Shorts</h3>
                        <div class="arrow">
                            <button class="prev2" aria-label="이전">‹</button>
                            <button class="next2" aria-label="다음">›</button>
                        </div>
                    </div>
                    <div class="videoSlider">
                        <div class="videoTrack" id="recentTrack">
                        </div>
                    </div>
                </div>
                
            </div>
        </div>
    </div>
</section>

<script>
    // 추천 영상 목록 (가로형)
    const recommendVideos = [
        { title: "호텔관광과 관광레저경영", id: "OuHArVe0oxA", views: "여행·항공부터 호텔·레저까지! 관광 전문가를 꿈꾼다면" },
        { title: "미디어스토리텔링과", id: "ypqEX4V5-qk", views: "호텔조리전공, 취업 경쟁력은 어떻게 만들어질까?" },
        { title: "카페베이커리전공", id: "99dlBcpGY6E", views: "디저트도 커피도 실전처럼! 장안대학교 카페베이커리전공" },
        { title: "유아교육과", id: "gJRdtK2euYo", views: "[졸업생 인터뷰] 행복한 유아교사를 꿈꾼다면? 졸업생이 전하는 생생한 현장 이야기" },
        { title: "패션주얼리디자인", id: "fnw2xLvSmqI", views: "주얼리 디자인부터 공방 창업까지! 장안대학교 패션주얼리디자인과" },


		{ title: "뷰티케어과", id: "lvz2MKghWt8", views: "[졸업생 인터뷰] 학교에서 배운 실무, 현장에서 통했다! 장안대학교 뷰티케어과" },
        { title: "글로벌케어복지과", id: "FdJiTagT5BA", views: "사회복지와 돌봄의 미래를 준비하다, 장안대학교 글로벌케어복지과" },
        { title: "웹툰애니메이션과", id: "qlwhYMUhwPQ", views: "상상을 현실로 만드는 콘텐츠 전문가의 시작, 장안대학교 웹툰애니메이션과" },
		{ title: "창업경영전공", id: "kaOmig4PtrQ", views: "아이디어 발굴부터 창업 실전까지! 장안대학교 창업경영전공" }


        
    ];

    // 최근 영상 목록 (숏폼 세로형)
    const recentVideos = [
		{ title: "장안대", id: "etwU-1RGWt0", views: "장안대 올 것 같은 니가 좋아~!" },
        { title: "패션디자인과", id: "_62zVhD0Sfw", views: "실습 중심 교육으로 패션 전문가의 꿈을 키워가는 곳" },
        { title: "실용음악과", id: "9FOTD92iLws", views: "장안대 실용음악과, 실제로 다녀보면 어떨까?" },
		{ title: "장안대", id: "UpumJHsNACE", views: "장안대학교 2027학년도 수시모집에서 확인하세요 <br>2026. 09. 07.(월) ~ 09. 30.(수)" },
		{ title: "사회복지과", id: "syLjF8A3dV8", views: "졸업생이 직접 들려주는 장안대학교 사회복지과 이야기!" },
        { title: "수시모집", id: "WZ3mtUakUa0", views: "내일은 장안대학교 수시지원 꼭 알아봐주세요"  },
        { title: "장안대학교", id: "B7OBEExb5dg", views: "수도권 대학, 가까움부터 다르다!" },
        { title: "캠퍼스", id: "svDfjOoLO8k", views: "아무것도 보이지 않던 순간, 장안대학교를 발견하기 전까지는…" },
        { title: "장안대 수시모집 요강이 떨어졌다?!", id: "SSG4_2PD_vU", views: " 최우수 1개 학기 성적 반영! <br>26.09.07. ~ 09.30." },
        { title: "실용음악과", id: "9FOTD92iLws", views: "장안대 실용음악과, 실제로 다녀보면 어떨까?" },
        { title: "컴퓨터공학과", id: "r1Fd7jVSmiQ", views: "졸업한 선배가 직접 들려주는 대학생활과 취업 이야기!" }

        
    ];

    // 비디오 렌더링 함수 (isShorts 여부에 따라 클래스를 다르게 부여)
    function draw(list, target, isShorts) {
        let html = "";
        const cardClass = isShorts ? "shortsCard" : "videoCard";

        list.forEach(v => {
            const thumbUrl = `https://img.youtube.com/vi/${v.id}/hqdefault.jpg`;
            html += `
                <div class="${cardClass}" data-id="${v.id}">
                    <div class="thumb">
                        <img src="${thumbUrl}" alt="${v.title}">
                    </div>
                    <h4>${v.title}</h4>
                    <p>${v.views}</p>
                </div>
            `;
        });
        document.getElementById(target).innerHTML = html;
    }

    // 초기 렌더링 (추천영상은 가로형(false), 최근영상은 숏폼(true))
    draw(recommendVideos, "recommendTrack", false);
    draw(recentVideos, "recentTrack", true);

    // 썸네일 클릭 시 메인 플레이어 영상 교체
    document.addEventListener("click", function (e) {
        // 일반 카드와 숏폼 카드를 모두 감지
        const card = e.target.closest(".videoCard, .shortsCard");
        if (!card) return;

        const id = card.dataset.id;
        const mainPlayer = document.getElementById("mainPlayer");

        if (mainPlayer) {
            mainPlayer.src = `https://www.youtube.com/embed/${id}?autoplay=1`;
            window.scrollTo({
                top: document.getElementById("janganOnAir").offsetTop - 70,
                behavior: "smooth"
            });
        }
    });

    /* =======================================
       무한 루프 슬라이드 로직
    ======================================= */
    function slideNext(trackId) {
        const track = document.getElementById(trackId);
        if (track.isAnimating) return;
        track.isAnimating = true;

        // 첫 번째 카드의 실제 넓이를 가져와  계산
        const card = track.firstElementChild;
        if (!card) return;
        const w = card.offsetWidth + 22; 

        track.style.transition = "transform 0.45s ease-out";
        track.style.transform = `translateX(-${w}px)`;

        track.addEventListener("transitionend", function handler() {
            track.style.transition = "none";
            track.appendChild(track.firstElementChild);
            track.style.transform = "translateX(0)";
            track.removeEventListener("transitionend", handler);
            track.isAnimating = false;
        });
    }

    function slidePrev(trackId) {
        const track = document.getElementById(trackId);
        if (track.isAnimating) return;
        track.isAnimating = true;

        const card = track.firstElementChild;
        if (!card) return;
        const w = card.offsetWidth + 22; 

        track.style.transition = "none";
        track.prepend(track.lastElementChild);
        track.style.transform = `translateX(-${w}px)`;

        void track.offsetWidth;

        track.style.transition = "transform 0.45s ease-out";
        track.style.transform = "translateX(0)";

        track.addEventListener("transitionend", function handler() {
            track.removeEventListener("transitionend", handler);
            track.isAnimating = false;
        });
    }

    let autoSlide1 = setInterval(() => slideNext("recommendTrack"), 3500);
    let autoSlide2 = setInterval(() => slideNext("recentTrack"), 4200);

    document.querySelector(".next1").addEventListener("click", function() {
        slideNext("recommendTrack");
        resetInterval();
    });
    
    document.querySelector(".prev1").addEventListener("click", function () {
        slidePrev("recommendTrack");
        resetInterval();
    });

    document.querySelector(".next2").addEventListener("click", function() {
        slideNext("recentTrack");
        resetInterval();
    });
    
    document.querySelector(".prev2").addEventListener("click", function () {
        slidePrev("recentTrack");
        resetInterval();
    });

    function resetInterval() {
        clearInterval(autoSlide1);
        clearInterval(autoSlide2);
        autoSlide1 = setInterval(() => slideNext("recommendTrack"), 3500);
        autoSlide2 = setInterval(() => slideNext("recentTrack"), 4200);
    }
</script>

