    <footer id="footer"><!-- 공통영역 // 하단 --></footer>

    <script>
        const shortcut = new Swiper('.swiper.shortcut', {
            direction: 'horizontal',
            loop: true,
            loopedSlides: 1,
            slidesPerView: 'auto',
            createElements: true,
            loopPreventsSliding: true,
            pagination: { el: '.shortcut .swiper-pagination' },
            navigation: {
                nextEl: '.shortcut .swiper-button-next',
                prevEl: '.shortcut .swiper-button-prev',
            },
            scrollbar: { el: '.shortcut .swiper-scrollbar' },
            keyboard: { enabled: true, onlyInViewport: false },
        });

        const process = new Swiper('.swiper.process', {
            direction: 'horizontal',
            loop: false,
            slidesPerView: "auto",
            initialSlide: 0,
            freeMode: true,
            pagination: { el: '.process .swiper-pagination' },
            navigation: {
                nextEl: '.process .swiper-button-next',
                prevEl: '.process .swiper-button-prev',
            },
            scrollbar: { el: '.process .swiper-scrollbar' },
            keyboard: { enabled: true, onlyInViewport: false },
        });

        const sns = new Swiper('.swiper.sns', {
            direction: 'horizontal',
            loop: true,
            slidesPerView: 'auto',
            pagination: { el: '.sns .swiper-pagination' },
            navigation: {
                nextEl: '.sns .swiper-button-next',
                prevEl: '.sns .swiper-button-prev',
            },
            scrollbar: { el: '.sns .swiper-scrollbar' },
            keyboard: { enabled: true, onlyInViewport: false },
        });

        var majorList = '';
        for (var i = 0; i < major.length; i++) {
            majorList += `<li class="tab_item">`;
            majorList += `  <button type="button" class="tab_link" data-target="#${major[i]['id']}">`;
            majorList += `      <span class="tab_text">${major[i]['item']}</span>`;
            majorList += `  </button>`;
            majorList += `</li>`;
        }

        majorTab += `<div class="tab_list_wrap swiper">`;
        majorTab += `   <ul class="tab_list swiper-wrapper" id="majorList">`;
        for (var i = 0; i < major.length; i++) {
            majorTab += `<li class="swiper-slide tab_item">`;
            majorTab += `  <button type="button" class="tab_link" data-target="#${major[i]['id']}">`;
            majorTab += `      <span class="tab_text">${major[i]['item']}</span>`;
            majorTab += `  </button>`;
            majorTab += `</li>`;
        }
    </script>
