<script>
	$(function() {
		//fncPkg.init();
	});
	var fncPkg = {
		init : function() {
			$ogTitle = $ogUrl = $ogDesc = $ogCont = $ogImg = "";
			this.func1();
		},
		func1 : function() {
			if ( $("body").hasClass("body-main") ) {
				console.log( "* 메인" );
				this.insertData( "고신대학교", location.href, "여러분의 방문을 환영합니다.", "지금 바로 내 꿈의 날개를 달자! 고신대학교는 여러분의 소중한 꿈을 그 무엇보다 귀하게 생각합니다.", "http://www.kosin.ac.kr/kr/_Img/kosinImg.jpg" );
			} else {
				console.log( "* 서브" );
				if ( $(".board-wrap").length > 0 ) {
					console.log( "** 게시판페이지" );
					this.insertData( "고신대학교", location.href, $(".board-view-head .board-view-title h3").text(), "", "http://"+window.location.hostname + $("#boardContents img").eq(0).attr("src") );
				} else {
					console.log( "** 일반서브페이지" );
					this.insertData( "고신대학교", location.href, "고신대학교 2021년도 온라인 시무식, ‘사명 공동체 의식’ 다져", "고신대학교가 새해 업무 첫날", "http://www.kosin.ac.kr/_Data/SiteFiles/kr/a3bf5d26c830e3685b131029f77bd7be.jpg" );
				}
			}
		},
		insertData : function( strTitle, strUrl, strDesc, strCont, strImg ) {
			$strMetaTag = "";
			$strMetaTag += "<meta property='og:title' content='" + strTitle + "'>";
			$strMetaTag += "<meta property='og:url' content='" + strUrl + "'>";
			$strMetaTag += "<meta property='og:description' content='" + strDesc + "'>";
			$strMetaTag += "<meta property='og:content' content='" + strCont + "'>";
			$strMetaTag += "<meta property='og:image' content='" + strImg + "'>";
			$("title").after( $strMetaTag );
		}
	}
</script>	</div><!-- end .doc-pg //-->
</div><!-- end #doc //-->
<iframe name="hiddenframe" class="hidden" style="display:none;" title="빈프레임"></iframe>

<script >

		$(document).ready(function(){			
		
			
			try{	resetFormStyle();}catch(e){	}
			
			//레이어팝업 포커스 오류 보정
			//접근성 필수일경우 닫기 버튼으로 포커스 초기화 되지 않으므로 문제생길 수 있음.
			try{	if(parent.msgPopArr.length>0){	$("input,select,a,button").not("[type='text']").eq(0).focus();		}			}catch(e){	}
			try{$(".calendar").datepicker({});		}catch(e){	}
			
		});


</script>




</body>
</html>
