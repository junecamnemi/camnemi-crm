<script>
var isLogin = '';
$(document).ready(function() {
    $.ajax({
    	type: 'GET',
        url:'https://sysso.seoyeong.ac.kr/api/sso/login/check',
        xhrFields: {
            withCredentials: true
        },
        cache: false,
        dataType: 'json',
        crossDomain: true,
        success:function(data){
			var valid = data.dataMap.valid;
			if(valid == true){
				if(isLogin != 'true'){
					location.href= '/globalsy/lo/login/ssoBandiLogin.do';
				}else if(!isLogin){
					location.href= '/globalsy/lo/login/ssoBandiLogin.do';
				}else{
				}
			}else{
				if(isLogin == 'true'){
					location.href= '/globalsy/sso/logout.do';
				}
			}
        },
        error: function(jqXHR, textStatus, errorThrown){
            console.log(jqXHR,textStatus,errorThrown);
        }
    });
});
</script>



   
