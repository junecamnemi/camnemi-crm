        	<script>
        	
        		//슬라이드
        		$('.banner_con').slick({
					slidesToShow: 1,
					slidesToScroll: 1,
					arrows: false,
					dotted: false,
					autoplay: true,
					autoplaySpeed: 3000,
					fade: true
				});
        		
        		$('.notice_slide').slick({
					slidesToShow: 4,
					slidesToScroll: 1,
					autoplay: true,
					autoplaySpeed: 3000,
					arrows: true,
					prevArrow: $('#aro2_prev01'),
					nextArrow: $('#aro2_next01'),
					responsive: [
					    {
					      breakpoint: 1280,
					      settings: {
					        slidesToShow: 3,
					        slidesToScroll: 1,
					      }
					    },
					    {
					      breakpoint: 992,
					      settings: {
					        slidesToShow: 2,
					        slidesToScroll: 1
					      }
					    },
					    {
					      breakpoint: 520,
					      settings: {
					        slidesToShow: 1,
					        slidesToScroll: 1
					      }
					    }
					    // You can unslick at a given breakpoint now by adding:
					    // settings: "unslick"
					    // instead of a settings object
					  ]
				});
        	
        		//객체 넓이 조절
	        	if ('NodeList' in window && !NodeList.prototype.forEach) {
	        		console.info('polyfill for IE11');
	
	        		NodeList.prototype.forEach = function(callback, thisArg) {
	        			thisArg = thisArg || window;
	        			for (var i = 0; i < this.length; i++) {
	        				callback.call(thisArg, this[i], i, this);
	        			}
	        		};
	        	}
	
	        	$(document).ready(function() {
	        		
	        		var windowWidth = $(window).innerWidth();
	        		var conWidth = $('.wid_box').width();
	        		var icWidth = $('.q_box').width();
	        		var conHeight = $('.q_box').height();
	
	        		blank = (windowWidth - conWidth) /2
	        		bnwd = windowWidth - icWidth - blank
	
	
	        		$('.section01').css({
	        			'width' : bnwd,
	        			'height' : conHeight
	        		});
	        		
	        		$('.ipsi_hd').css({
	        			'padding-left' : blank
	        		});
	        		
	        		$('.ipsi_list').css({
	        			'padding-right' : blank
	        		});
	        		
	        		if (window.innerWidth < 1480) {
	        			blank = (windowWidth - conWidth) /2
	        			bnwd2 = windowWidth - icWidth - blank - 90;
	        			
	        			$('.section01').css({
	        				'width' : bnwd2,
	        				'height' : 'auto'
	        			});
	        			
		        		
		        		$('.ipsi_hd').css({
		        			'padding-left' : blank
		        		});
		        		
		        		$('.ipsi_list').css({
		        			'padding-right' : blank
		        		});
	
	        		}
	        		
	        		if (window.innerWidth < 1280) { // 다바이스 크기가 1300 이하 일때
	        			
        				var windowWidth = $(window).innerWidth();
        				var conWidth = $('.wid_box').width();
        				var icWidth = $('.q_box').width();
        				var conHeight = $('.q_box').height();

        				blank = (windowWidth - conWidth) /2
        				bnwd = windowWidth - icWidth - blank

        				$('.section01').css({
        					'width' : windowWidth,
        					'height' : 'auto'
        				});
        				
        				$('.ipsi_hd').css({
		        			'padding-left' : '30px'
		        		});
        				
        				$('.ipsi_list').css({
		        			'padding-right' : '0'
		        		});
        				
        			}
	
	        		if (window.innerWidth < 992) {
	        			windowWidth = $(window).innerWidth();
	        			$('.section01').css({
	        				'width' : windowWidth,
	        				'height' : 'auto'
	        			});
	        			
	
	        		}
	
	        		$(window).on('resize', function() {
	        			
	        			if (window.innerWidth < 1480) {
		        			blank = (windowWidth - conWidth) /2
		        			bnwd2 = windowWidth - icWidth - blank - 90;
		        			
		        			$('.section01').css({
		        				'width' : bnwd2,
		        				'height' : 'auto'
		        			});
		        			
			        		
			        		$('.ipsi_hd').css({
			        			'padding-left' : blank
			        		});
			        		
			        		$('.ipsi_list').css({
			        			'padding-right' : blank
			        		});
		
		        		}
	        			
	        			if (window.innerWidth < 1280) { // 다바이스 크기가 1300 이하 일때
	
	        				var windowWidth = $(window).innerWidth();
	        				var conWidth = $('.wid_box').width();
	        				var icWidth = $('.q_box').width();
	        				var conHeight = $('.q_box').height();
	
	        				blank = (windowWidth - conWidth) /2
	        				bnwd = windowWidth - icWidth - blank
	
	        				$('.section01').css({
	        					'width' : windowWidth,
	        					'height' : 'auto'
	        				});
	        				
	        				$('.ipsi_hd').css({
			        			'padding-left' : '30px'
			        		});
	        				

			        		$('.ipsi_list').css({
			        			'padding-right' : '0'
			        		});

	        				
	        			}
	        			if (window.innerWidth < 992) {
	        				windowWidth = $(window).innerWidth();
	        				$('.section01').css({
	        					'width' : windowWidth,
	        					'height' : 'auto'
	        				});
	
