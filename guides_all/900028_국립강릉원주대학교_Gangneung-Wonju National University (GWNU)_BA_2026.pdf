    <script nonce="pEZ3XeBGDxgC5LI+whNHBQ==">
        (function() {
            var btn = document.querySelector('.footer-related-btn');
            var list = document.getElementById('footerRelatedList');
            if (!btn || !list) return;
            btn.addEventListener('click', function() {
                var expanded = btn.getAttribute('aria-expanded') === 'true';
                btn.setAttribute('aria-expanded', !expanded);
                list.classList.toggle('open', !expanded);
            });
            document.addEventListener('click', function(e) {
                if (!document.getElementById('footerRelatedSites').contains(e.target)) {
                    btn.setAttribute('aria-expanded', 'false');
                    list.classList.remove('open');
                }
            });
        })();
    </script>
