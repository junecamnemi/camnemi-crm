                    </div>
                </div>
                <div class="rating-input-area">
                    <label for="dgstfnCmnt" class="blind" data-translate="">Other comments</label>
                    <input type="text" id="dgstfnCmnt" name="dgstfnCmnt" class="form-control" placeholder="Enter your comments here…"/>
                    <div class="rating-btn-area">
                        <button type="button" class="btn label-text-medium label-text-medium md bk" id="dgstfnSaveBtn" data-translate="">Submit</button>
                        <button type="button" class="btn small bg-blue-500 col-white label-text-medium bd" id="dgstfnUpdtBtn" style="display: none;" data-translate="">Edit</button>
                        <button type="button" class="btn small border-grey-300 col-grey-700 label-text-medium md" id="dgstfnDelBtn" style="display: none;" data-translate="">Delete</button>
                    </div>
                </div>
            </div>
        </form>
    <script nonce="pEZ3XeBGDxgC5LI+whNHBQ==">
        const dgstfnSaveBtnClickProc = function(e, _this) {
            e.preventDefault();
            e.stopPropagation();
            e.stopImmediatePropagation();

            let $form = $("form[name=dgstfnCmntForm]");
            let evlCd = $form.find("input[name=evlCd]:checked").val();

            if (!evlCd) {
                alert("[Satisfaction] This field is required.");
                return false;
            }

            Message.confirm({
                icon: "question",
                title: "Submit Satisfaction",
                message: "Would you like to submit your satisfaction rating?"
            }, function() {
                let dgstfnObj = {};
                let _nowDate = '2026.09.18';

                dgstfnObj.siteId = 'global';
                dgstfnObj.menuSn = $form.find("input[name=menuSn]").val();
                dgstfnObj.evlCd = evlCd;
                dgstfnObj.evlDt = _nowDate ? _nowDate.replace(/\./g, "") : "";
                dgstfnObj.dgstfnCmnt = $form.find("input[name=dgstfnCmnt]").val();

                let url = "/neibis-api/v1/stats/usr/dgstfn?action=post";

                Ajax.post(url, dgstfnSaveSuc, dgstfnSaveFail, {data: JSON.stringify(dgstfnObj)});
            });
        }

        const dgstfnSaveSuc = function(data) {
            if (data.icon == "success") {
                alert({
                    icon: "success",
                    message: "Your satisfaction rating has been submitted."
                }, function() {
                    location.reload();
                });
                setTimeout(function() {
                    var $modal = $(".modal-alert").last();
                    if ($modal.length > 0) {
                        $modal.find(".action-ok").trigger("click");
                    }
                }, 3000);
            } else {
                alert(data.message || "Submission failed.");
            }
        }

        const dgstfnSaveFail = function(xhr, status, error) {
            let res = xhr?.responseJSON;
            if (res && res?.message) {
                alert(res.message);
            } else {
                alert("Server communication failed.");
            }
        }

        function menuFvrtAction(title, link) {
            let fvrtMenuSn = "1423";
            let fvrtSiteId = "global";
            let fvrtMenuNm = "Announcements";
            let fvrtMenuUrlAddr = getFilteredCurrentUrl();
            let fvrtMenuPath = $('.breadcrumb span:not(.ico-loc-arr)')
                .map(function() {
                    return $(this).text().trim();
                })
                .get()
                .filter(txt => txt !== '')
                .join(' > ');

            const ttl = $('.cont-body .board-view-wrap .view-board-tit h2').first().text().trim();

            if (ttl) {
                fvrtMenuNm = ttl;
            }
            if (title) {
                fvrtMenuNm = title;
            }
            if (link) {
                fvrtMenuUrlAddr = link;
            }

            let obj = new Object;
            obj["menuSn"] = fvrtMenuSn;
            obj["siteId"] = fvrtSiteId;
            obj["menuNm"] = fvrtMenuNm;
            obj["menuUrlAddr"] = fvrtMenuUrlAddr;
            obj["menuPath"] = fvrtMenuPath;

            let url = "/neibis-api/v1/" + fvrtSiteId + "/user/menu/fvrt/" + fvrtMenuSn + "?action=post";

            Ajax.post(url, menuFvrtSuccess, menuFvrtFail, {data: JSON.stringify(obj)});
        }

        const fvrtSaveBtnClickProc = function() {
            
            if (confirm("Login is required. Would you like to log in?")) {
                var callbackUrl = '/cmmn/login.do?_paramReturnUrl=' + window.location.pathname;
                var paramIndex = 0;
                const urlParams = new URLSearchParams(window.location.search);
                urlParams.forEach((value, key) => {
                    if (paramIndex == 0) {
                        callbackUrl += encodeURIComponent("?" + key + "=" + value);
                    } else {
                        callbackUrl += encodeURIComponent("&" + key + "=" + value);
                    }
                    paramIndex++;
                });
                location.href = callbackUrl;
            }
            return false;
            

            menuFvrtAction();
        }

        const menuFvrtSuccess = function(data) {
            if (data.icon == "success") {
                UI.PopupOpen('popup-scrap');
            } else {
                alert(data.message);
                return false;
            }
        }

        const menuFvrtFail = function(xhr, status, error) {
            let res = xhr?.responseJSON;
            if (res && res?.message) {
                alert(res.message);
            } else {
                alert("Server communication failed.");
            }
        }

        $(function() {
            $(document).on("click", ".fvrtSaveBtn", fvrtSaveBtnClickProc);
            $(document).on("click", "#dgstfnSaveBtn", dgstfnSaveBtnClickProc);
        })
    </script>
    </main>
