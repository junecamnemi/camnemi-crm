                        Are you satisfied with this page?
                    </p>
                    <div class="rating-select-area">
                        <div class="rating-options" role="radiogroup" aria-labelledby="ratingLabel">
                            <label class="rating-option">
                                <input type="radio" id="evlCd05" name="evlCd" value="5" class="blind"/>
                                <span class="material-symbols-outlined icon-unchecked" aria-hidden="true">radio_button_unchecked</span>
                                <span class="material-symbols-outlined icon-checked" aria-hidden="true">radio_button_checked</span>
                                <span class="label-text-medium md" data-translate="">Very Satisfied</span>
                            </label>
                            <label class="rating-option">
                                <input type="radio" id="evlCd04" name="evlCd" value="4" class="blind"/>
                                <span class="material-symbols-outlined icon-unchecked" aria-hidden="true">radio_button_unchecked</span>
                                <span class="material-symbols-outlined icon-checked" aria-hidden="true">radio_button_checked</span>
                                <span class="label-text-medium md" data-translate="">Satisfied</span>
                            </label>
                            <label class="rating-option">
                                <input type="radio" id="evlCd03" name="evlCd" value="3" class="blind"/>
                                <span class="material-symbols-outlined icon-unchecked" aria-hidden="true">radio_button_unchecked</span>
                                <span class="material-symbols-outlined icon-checked" aria-hidden="true">radio_button_checked</span>
                                <span class="label-text-medium md" data-translate="">Neutral</span>
                            </label>
                            <label class="rating-option">
                                <input type="radio" id="evlCd02" name="evlCd" value="2" class="blind"/>
                                <span class="material-symbols-outlined icon-unchecked" aria-hidden="true">radio_button_unchecked</span>
                                <span class="material-symbols-outlined icon-checked" aria-hidden="true">radio_button_checked</span>
                                <span class="label-text-medium md" data-translate="">Dissatisfied</span>
                            </label>
                            <label class="rating-option">
                                <input type="radio" id="evlCd01" name="evlCd" value="1" class="blind"/>
                                <span class="material-symbols-outlined icon-unchecked" aria-hidden="true">radio_button_unchecked</span>
                                <span class="material-symbols-outlined icon-checked" aria-hidden="true">radio_button_checked</span>
                                <span class="label-text-medium md" data-translate="">Very Dissatisfied</span>
