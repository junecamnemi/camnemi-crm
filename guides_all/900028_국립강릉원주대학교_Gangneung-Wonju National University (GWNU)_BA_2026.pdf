<script nonce="pEZ3XeBGDxgC5LI+whNHBQ==">

var value = new NeibisValidWrapper();

var _bbsId = "20260604110637";
var _pstSn = "1";
$(function () {

	ActionInit.click(".list-button",listAction);
	ActionInit.click("#cmnt-save-button",cmntSaveAction,this);
	ActionInit.click(".cmnt-del-button",cmntDelAction,this);
	ActionInit.click("#rply-save-button",rplySaveAction);
	ActionInit.click("#save-button",saveAction);
 	ActionInit.click("#updt-button",updateAction);
// 	ActionInit.click(".updt-button",updtMoveAction,this); Post > Get 방식으로 변경 주석처리
	ActionInit.click(".delete-button",delAction,this);
	ActionInit.click(".purge-button",purgeAction,this);
// 	ActionInit.click(".move-button",moveAction,this); Post > Get 방식으로 변경 주석처리
	ActionInit.click("#like-button",likeAction,this);
	value.init();

	$('.list-button').attr('onclick', '');
});

const listAction = function(e){
	e.preventDefault();
	$("#detail-form").attr("action","/global/bbs/1423/list.do").submit();
}

const rplySaveAction = function(){
// 	var upPstSn = $("input[name=pstSn]").val();

	var param = paramRplyBinding();
	Message.confirm({
		icon: "warning",
		title: "답글을 등록하시겠어요?",
		message: "등록하시려면 ‘확인’을 눌러주세요."
    },function(){
    	Ajax.post("/neibis-api/v1/core/bbs/"+_pstSn+"/rply?action=post",rplySuccess,fail,{data:JSON.stringify(param)});
    });



}


const cmntSaveAction = function(e,_this){
	if(!$("#cmntCn").val()){
		alert("댓글을 입력해주세요.");
		$("#cmntCn").focus();
		return false;
	}

	var param = paramCmntBinding();
	Message.confirm({
		icon: "warning",
		title: "댓글을 등록하시겠어요?",
		message: "등록하시려면 ‘확인’을 눌러주세요."
    },function(){
		Ajax.post("/neibis-api/v1/core/bbs/"+_pstSn+"/cmnt?action=post",detailSuccess,fail,{data:JSON.stringify(param)});
    });

}

const cmntDelAction = function(e,_this){
	var cmntSn = $(_this).data("sn");
	var param = paramCmntBinding();

	Message.confirm({
        icon: "warning",
        title: "댓글을 삭제합니다",
        message: "삭제 하시겠어요?"
    },function(){
    	Ajax.post("/neibis-api/v1/core/bbs/"+_pstSn+"/cmnt/"+cmntSn+"?action=delete",detailSuccess,fail,{data:JSON.stringify(param)});
    });
}

const saveAction = function(e){
	
	
	/* 민원답변 '내용' 데이터 갱신 */
	$("#pstCn").val(window.htmlCentralData.html);
	
	
	$(".text-invalid").remove();
	var valid = value.valid("ans-form");
	if(!valid.result){
		var errorArea = typeof $("#"+valid.element.id).closest("td").html() !== "undefined" ? $("#"+valid.element.id).closest("td") : $("#"+valid.element.id).closest("div");
		errorArea.append($("<span>").addClass("text-guide text-invalid").text(valid.message));
		var offset = $("#"+valid.element.id).offset(); //해당 위치 반환
		$("html, body").animate({scrollTop: offset.top-100},400);
		return $("#"+valid.element.id).focus();
	}

	Message.confirm({
		icon: "warning",
		title: "답변을 등록하시겠어요?",
		message: "등록하시려면 ‘확인’을 눌러주세요."
    },function(){
		var param = valid.data
		param.bbsId = _bbsId
		param.pstSn = _pstSn

		if(fileTmprList.length > 0){
			param.fileTmprList = fileTmprList;
		}

		if(atchFileSnArr.length > 0){
			param.atchFileSnArr = atchFileSnArr;
		}
		Ajax.post("/neibis-api/v1/core/bbs/1/ans?action=post",detailSuccess,fail,{data:JSON.stringify(param)});
    });
}

const updtMoveAction = function(e,_this){
	e.preventDefault();
	var pstSn = createHiddenInput("pstSn",_pstSn);

	if($(_this).data("ans-dp") > 0){
		submitToRplyPage(pstSn,getActionParamInputs);
	}else{
		submitToUpdtPage(pstSn,getActionParamInputs);
	}
}



const updateAction = function(e){

	
	/* 민원답변 '내용' 데이터 갱신 */
	$("#pstCn").val(window.htmlCentralData.html);
	
	
	$(".text-invalid").remove();
	var valid = value.valid("ans-form");
	if(!valid.result){
		var errorArea = typeof $("#"+valid.element.id).closest("td").html() !== "undefined" ? $("#"+valid.element.id).closest("td") : $("#"+valid.element.id).closest("div");
		errorArea.append($("<span>").addClass("text-guide text-invalid").text(valid.message));
		var offset = $("#"+valid.element.id).offset(); //해당 위치 반환
		$("html, body").animate({scrollTop: offset.top-100},400);
		return $("#"+valid.element.id).focus();
	}
	Message.confirm({
		icon: "warning",
		title: "답변을 수정하시겠어요?",
		message: "수정하시려면 ‘확인’을 눌러주세요."
    },function(){
		var param = valid.data;
		param.bbsId = _bbsId
		param.pstSn = _pstSn

		if(fileTmprList.length > 0){
			param.fileTmprList = fileTmprList;
		}

		if(atchFileSnArr.length > 0){
			param.atchFileSnArr = atchFileSnArr;
		}
		Ajax.post("/neibis-api/v1/core/bbs/1/ans?action=put",success,fail,{data:JSON.stringify(param)});
    });
}

const delAction = function(e,_this){
	var param = new Object();
	param.bbsId = _bbsId
	param.pstSn = _pstSn

	e.preventDefault();
	Message.confirm({
        icon: "warning",
        title: "게시물을 삭제합니다",
        message: "그래도 삭제 하시겠어요?"
    },function(){
    	let url ="/neibis-api/v1/core/bbs/"+_pstSn+"?action=delete"
    	Ajax.post(url,success,fail,{data:JSON.stringify(param)});
    });


}

const purgeAction = function(e,_this){
	e.preventDefault();
	Message.confirm({
		icon : "error",
		title : "완전삭제 경고",
		message : "이 작업은 취소할 수 없습니다.<br/>게시글, 첨부파일, 댓글이 모두 영구 삭제됩니다.<br/>정말 삭제하시겠습니까?"
	},function(){
		var param = {bbsId : _bbsId, pstSn : _pstSn};
		Ajax.post("/neibis-api/v1/core/bbs/"+_pstSn+"/purge?action=delete",success,fail,{data:JSON.stringify(param)});
	});
}

var _loginUrl = '/global/login.do' + '?url=' + encodeURIComponent(location.pathname + location.search);

function redirectToLogin(){
	Message.confirm({
		icon: 'warning',
		title: '로그인이 필요합니다.',
		message: '로그인 페이지로 이동하시겠습니까?'
	}, function(){
		location.href = _loginUrl;
	});
}

const likeAction = function(e,_this){
	var isLogin = false;
	if(!isLogin){
		redirectToLogin();
		return;
	}
	var $btn = $(_this);
	var param = {bbsId: $btn.data("bbs-id")};
	Ajax.post("/neibis-api/v1/core/bbs/"+_pstSn+"/like?action=post",function(data){
		var result = data.data;
		$('#like-count').text(result.likeCnt);
		if(result.userLiked){
			$btn.addClass('active').css('background','#fee2e2');
			$btn.find('.like-icon').css({'color':'#ef4444','font-variation-settings':"'FILL' 1"});
		}else{
			$btn.removeClass('active').css('background','#fff');
			$btn.find('.like-icon').css({'color':'#999','font-variation-settings':"'FILL' 0"});
		}
	},function(xhr, status, error){
		if(xhr.status === 403){
			redirectToLogin();
		}else{
			Message.fail(xhr, status, error);
		}
	},{data:JSON.stringify(param)});
}

const moveAction = function(e,_this){
// 	var pstSn = $("input[name=pstSn]").val($(_this).data("sn"));
	var pstSn = createHiddenInput("pstSn",$(_this).data("sn"));
	submitToDetail(pstSn,getActionParamInputs);
}

const paramRplyBinding = function(){
	var obj = new Object();
	obj.bbsId = $("input[name=bbsId]").val();
	obj.ansDpVl = $("#ansDpVl").val();
	obj.ttl = $("#rply-ttl").val();
	//obj.pstCn = $("#rply-pstCn").val();
	obj.pstCn = CKEDITOR.instances["rply-pstCn"].getData();
	obj.userNm = $("#userNm").val();
	obj.userCntnId = $("#userCntnId").val();
	obj.userEmlAddr = $("#userEmlAddr").val();

	return obj;
}

const paramCmntBinding = function(){
	var obj = new Object();
	obj.bbsId = $("input[name=bbsId]").val();
	obj.cmntCn = $("#cmntCn").val();
	obj.upCmntSn = 0;
	obj.cmntDpVl = 0;

	if(fileTmprList.length > 0){
		obj.fileTmprList = fileTmprList;
	}

	if(atchFileSnArr.length > 0){
	obj.atchFileSnArr = atchFileSnArr;
	}

	return obj;
}

const detailSuccess = function(data){
	Message.success(data,function(){
// 		var pstSn = createHiddenInput("pstSn",_pstSn);
// 		submitToDetail(pstSn,getActionParamInputs);
// 		$("#detail-form").attr("action","/global/bbs/1423/detail.do").submit();
		location.href = '/global/bbs/1423/detail.do?&pstSn='+_pstSn
	});
}

const rplySuccess = function(data){
	console.log(data);
	Message.success(data,function(){
// 		var pstSn = createHiddenInput("pstSn",_pstSn);
// 		submitToDetail(pstSn,getActionParamInputs);
// 		$("#detail-form").attr("action","/global/bbs/1423/detail.do").submit();
		let moveSn = data?.data?.pstSn;
		if(moveSn){
			location.href = '/global/bbs/1423/detail.do?&pstSn='+moveSn
		}else{
			location.href = '/global/bbs/1423/list.do?'
		}
	});
}

const success = function(data){
	console.log(data);
	Message.success(data,function(){
// 		$("#detail-form").submit();
		location.href = '/global/bbs/1423/list.do?'
	});
}

const fail = function(xhr, status, error){
	Message.fail(xhr, status, error,function(){
		window.location.reload();
	})
}

setCkEditorUplodUrl("neibis","1423", 'N' === 'Y', '');


var thisMenuSn =  "1423";
var thisStieId = "neibis"
var thisEdtrSecd = "1";

	$(document).ready(function(){
		if(thisEdtrSecd =='3'){
			webeditorToggleTabs();
		}else{
			codeToggleTabs();
		}

		setCkEditorUplodUrl(thisStieId,thisMenuSn, 'N' === 'Y', '');
		window.WebEditorPlugin.changeWebContentHtml($("#pstCn").val() || ""); //기존 데이터 동기화 처리 JSTL 바로 넘기면 데이터깨짐
	});
</script><!-- 공통 스크립트 -->
