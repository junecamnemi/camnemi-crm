  <script>
    function closeToday(num) {
        $.cookie('ipsi_popup-'+num, 'false', { expires: 1 });
        $('#myModal-'+num).modal("hide");
    }
  $( document ).ready(function() {

        
            
                
                    if($.cookie('ipsi_popup-1') == undefined) {
                        $.cookie('ipsi_popup-1', 'true', { expires: 1 });
                    }
                    if($.cookie('ipsi_popup-1') == 'true') {
                        $('#myModal-1').modal({backdrop: 'static', keyboard: false}) ;
                        $('#myModal-1').modal('show');
                    }
                
            
        
            
                
            
        
            
                
            
        
            
                
            
        
            
                
            
        
            
                
            
        
            
                
            
        
		
