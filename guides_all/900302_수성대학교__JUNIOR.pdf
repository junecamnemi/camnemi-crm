<link rel="stylesheet" type="text/css" href="/static/css/ive_main.css" />
<style>
    .scale {
      transform: scale(1);
      -webkit-transform: scale(1);
      -moz-transform: scale(1);
      -ms-transform: scale(1);
      -o-transform: scale(1);
      transition: all 0.3s ease-in-out;   /* 부드러운 모션을 위해 추가*/
    }
    .scale:hover, a:hover .scale {
      transform: scale(1.1);
      -webkit-transform: scale(1.1);
      -moz-transform: scale(1.1);
      -ms-transform: scale(1.1);
      -o-transform: scale(1.1);
    }
    .img {overflow:hidden }   /* 부모를 벗어나지 않고 내부 이미지만 확대 */

    .scale2 {
      transform: scale(1);
      -webkit-transform: scale(1);
      -moz-transform: scale(1);
      -ms-transform: scale(1);
      -o-transform: scale(1);
      transition: all 0.3s ease-in-out;   /* 부드러운 모션을 위해 추가*/
    }
    .scale2:hover, a:hover .scale {
      transform: scale(1.02);
      -webkit-transform: scale(1.02);
      -moz-transform: scale(1.02);
      -ms-transform: scale(1.02);
      -o-transform: scale(1.02);
    }
	
.swiper-wrapper {height:auto}	
    .notice-text{
        white-space: nowrap;
        width: 70%;
        height: 25px;
        overflow: hidden;
        text-overflow: ellipsis;

    }

    .btn-today-close {
        background: #EE3E41;
        color: #FFF;
        cursor: pointer;
        font-size: 14px;
        padding: 5px 20px;
    }
    .major_list{
        padding: 5px 5px;
        line-height: 2.7;
        font-size: 13px;
        word-break: keep-all;
        color: lightgray;
        font-weight: bold;
    }
    .major_list span{
        background-color: #dadada;
        padding: 5px 9px;
        border-radius: 23px;
        color: #1b1b1b;
        text-decoration:none;
    }
     .major_list span a{
         text-decoration:none;
         color:black;
     }
    .major_1 span:hover{
        background-color: #dccdf6;
    }
    .major_2 span:hover{
        background-color: #9bb3ef;
    }
    .major_3 span:hover{
        background-color: #feefdc;
    }
    .major_4 span:hover{
        background-color: #caeaf5;
    }
    .mo_shadow{
        box-shadow: 10px 16px 3px 1px #00000042;
    }
    .modal-backdrop {
       background-color:  rgba(0,0,0,0);
    }
    .modal_noback{
        height: 0;
        overflow: visible !important;
    }
    .bt{
        background: #ffffff00;
        cursor: pointer;
    }
    .bt:hover{
        background: #ffffff63;
    }

</style>
<style>
    .main_tile{
        height: 150px;

        display: flex;
        flex-direction: column;
        justify-content: center;
        text-align: center;

        padding: 5%;
        color: white;
        font-size: 28px;
        font-weight: bold;
    }
    .main_tile .cont{
        display: flex;
        justify-content: space-evenly;
    }
    .main_tile .arrow {
        width: 34px;
        height: 34px;
        margin: auto 0;
        border-radius: 17px;
    }
    .main_tile .arrow i{
        font-size: 15px;
        line-height: 34px;
    }
    a.noline:hover{
        text-decoration: none;
    }

    .back_color_2{
        background: #cb006e;
    }
    .back_color_2 .arrow{
        background: white;
        color:#cb006e;
    }
    .back_color_3{
        background:#ff5d6a;
    }
    .back_color_3 .arrow{
        background: white;
        color:#ff5d6a;
    }


</style>
