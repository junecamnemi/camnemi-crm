<body>
 
	

<style>
/* 전체 리스트 박스 스타일 */
ul#list_dept {
    list-style: none;
    margin: 0;
    padding: 10px;
    border: 1px solid #ccc;
    border-radius: 8px;
    background-color: #fff;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    max-width: 300px;
}

/* 상위 버튼 스타일 */
button.linkselect {
    background-color: #2c3e50;
    color: #fff;
    font-size: 16px;
    padding: 4px 19px;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    transition: background-color 0.3s;
}

/* 버튼 호버 효과 */
button.linkselect:hover {
    background-color: linear-gradient(350deg, rgb(252 255 52) 21%, rgb(237 100 76) 100%) !important;
}

/* 계열 제목 스타일 */
.linktitle {
    font-weight: bold;
    margin: 10px 0 5px 0;
    color: #333;
    border-bottom: 1px solid #eee;
    padding-bottom: 28px;
	font-size: 16px;
}

/* 학과 리스트 항목 스타일 */
ul#list_dept li a {
    display: block;
    padding: 0px 3px;
    color: #2c3e50;
    text-decoration: none;
    border-radius: 4px;
    transition: background-color 0.2s;
}

/* 학과 리스트 항목 호버 효과 */
ul#list_dept li a:hover {
    background-color: #eb9393;
}

/* 소형 폰트 클래스 예시 */
.smallfont {
    font-size: 12px;
    margin-left: 5px;
}

/* scroll Bar*/
/* 스크롤바 커스터마이징 (webkit 브라우저용) */
ul#list_dept {
    max-height: 400px; /* 스크롤 발생하도록 높이 제한 */
    overflow-y: auto;
}

/* 스크롤바 폭 */
ul#list_dept::-webkit-scrollbar {
    width: 8px;
}

/* 스크롤바 트랙 (배경) */
ul#list_dept::-webkit-scrollbar-track {
    background: #f1f1f1;
    border-radius: 4px;
}

/* 스크롤바 핸들 (움직이는 막대) */
ul#list_dept::-webkit-scrollbar-thumb {
    background: #999;
    border-radius: 4px;
}

/* 스크롤바 핸들 호버 시 색상 */
ul#list_dept::-webkit-scrollbar-thumb:hover {
    background: #666;
}

/* 파이어폭스용 기본 스타일 */
ul#list_dept {
    scrollbar-width: thin;
    scrollbar-color: #999 #f1f1f1;
}

</style>

<script type="text/javascript">
	
function toggleDeptList() {
        const deptList = document.getElementById("list_dept");
        if (deptList.style.display === "none" || deptList.style.display === "") {
            deptList.style.display = "block";
        } else {
            deptList.style.display = "none";
        }
    }

function goSSOLogin() {
	
	var urlrl = "https://logins.cntu.ac.kr/login.cntu?type=blank_noreload&url=https://ipsi.cntu.ac.kr/";

    location.href = urlrl;    
	
}

function logout() {
	$.ajax({
		type: "POST",
		url: 'ipsia.cntu',
		data: 'mode=logout',
		success: function(ret){
			location.reload();
		}
	});
}

/// 학과 리스트 토글.
function toggleDeptList() {
	if($('#list_dept').css('display') == 'none') {
		$('#list_dept').slideDown(100);
	} else {
		$('#list_dept').slideUp(100);
	}
}

/// 검색바 토글.
function toggleSearchBar() {
	if($('#div_search_bar').css('display') == 'none') {
		$('#div_search_bar').slideDown(100);
		$('#img_search').attr("src", 'img/close.png');
		//document.getElementById('img_search').src = 'img/close.png';
	} else {
		$('#div_search_bar').slideUp(100);
		$('#img_search').attr("src", 'img/serach.png');
		//document.getElementById('img_search').src = 'img/serach.png';
	}
}

/// 탑메뉴 호버 처리
function menuHover(type, idx) {
	if(type == 'on') {
		$('#submenu_'+idx).css('background-color', '#216ac0');
	}
	else {
		$('#submenu_'+idx).css('background-color', '');
	}
}

/// 탑서브메뉴 호버 처리
function submenuHover(type, idx) {
	if(type == 'on') {
		$('#topmenu_'+idx).css('color', '#195dae');
		$('#topmenu_'+idx).css('font-weight', '700');
		$('#topmenu_'+idx).css('border-bottom', '3px solid #195dae');
		$('#topmenu_'+idx).css('margin-top', '-3px');
		$('#topmenu_'+idx).css('transition-duration', '0.0s');
	}
	else {
		$('#topmenu_'+idx).css('color', '');
		$('#topmenu_'+idx).css('font-weight', '');
		$('#topmenu_'+idx).css('border-bottom', '');
		$('#topmenu_'+idx).css('margin-top', '');
		$('#topmenu_'+idx).css('transition-duration', '0.1s');
	}
}


/// 탑 메뉴 클릭 처리
function menuClick(idx) {
	if($(window).width() < 1200) {
		if($('#topmenu_'+idx).hasClass('active')==true) {
			$('#topmenu_'+idx).removeClass('active');
			$('#mobile_sub_'+idx).slideUp(100);
		} else if(idx == 9) {
			alert('test');
		} 
		
		else {
			$('#topmenu_'+idx).addClass('active');
			$('#mobile_sub_'+idx).slideDown(100);
		}
		
		for(var i=1; i<7; i++) {
			if(i!=idx) {
				$('#topmenu_'+i).removeClass('active');
				$('#mobile_sub_'+i).slideUp(100);
			}
		}
	}
	else {
		/* if(idx==1 || idx==2) {
			location.href = 'contents.cntu?cat1='+idx+'&cat2=1';
		}
		else if(idx == 3) {
			location.href = 'board.cntu?mode=qna&cat1='+idx+'&cat2=1';
		}
		else if(idx == 4) {
			location.href = 'contents.cntu?cat1='+idx+'&cat2=2';
		}
		else if(idx == 5) {
			location.href = 'board.cntu?mode=board&boardType=news&cat1='+idx+'&cat2=1';
		} */
		if(idx==9) {
			/*location.href = 'board.cntu?mode=board&boardType=news&cat1=16&cat2=1';*/
			location.href = 'board.cntu?mode=board&boardType=notice&searchMojib=9&cat1=19&cat2=3';
		}
		else if(idx>=6 && idx<=8) {
			location.href = 'contents.cntu?searchMojib='+(idx+1)+'&cat1=1'+(idx+1)+'&cat2=1';
		}
		else {
			location.href = 'contents.cntu?searchMojib='+idx+'&cat1=1'+idx+'&cat2=1';
		}
	}
}



////모바일 메뉴 처리(ON/OFF)
var menuToggle = 'off';
function mobileMenu() {
	if($(window).width() < 1200) {
		
		if(menuToggle == 'off') {
			$('#mobile_menu_back').show();
			$('#mobile_top_menu').slideDown(100);
			
			$('#top_menu_btn').css('background-image', "url(img/btn_menu_on.png)");
			
			menuToggle = 'on';
		}
		else {
			$('#mobile_menu_back').hide();
			$('#mobile_top_menu').slideUp(100);
			
			$('#top_menu_btn').css('background-image', "url(img/btn_menu.png)");
			
			menuToggle = 'off';
		}
		
	}
}

/// 그냥 모바일 메뉴 닫기
function mobileMenuOff() {
	$('#mobile_menu_back').hide();
	$('#mobile_top_menu').slideUp(100);
	
	$('#top_menu_btn').css('background-image', "url(img/btn_menu.png)");
	
	menuToggle = 'off';
}


function toggleQuick() {
	if($('#quick_ul').is(':visible')==false) {
		$('#quick_ul').show();
	}
	else {
		$('#quick_ul').hide();
	}
}


/// 사이트맵 토글.
function toggleSitemap() {
	if($('#sitemap').css('display') == 'none') {
		$('#sitemap').show();
	} else {
		$('#sitemap').hide();
	}
}


$(document).mouseup(function (e){
	//console.log(e.target);
	//console.log($('.linkselect').has(e.target).length);
	/// 학과 선택 박스 외 클릭 시....
	if($('#list_dept').has(e.target).length === 0)
		$('#list_dept').slideUp(100);
});

</script>


