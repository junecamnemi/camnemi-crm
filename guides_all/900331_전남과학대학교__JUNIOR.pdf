/// 파일 받기
function ipsiFileDown(filename) {
  location.href = "filedownload.cntu?path=/upload&filename="+encodeURIComponent(filename);
}

function newWindow(url) {
	var win = window.open(url, '_blank');
	win.focus();
}



//////////// 팝업 배너 처리
var popupslider;

function popupShow() {

	if(checkPopupCookie('close') == false) {
		$('.pu_container').show();
		
		popupslider = $('#popup_slider').bxSlider({
			mode: 'horizontal',
			auto: true,
			/*minSlides: 3,
			maxSlides: 3,*/
			minSlides: 4,
            maxSlides: 4,
			moveSlides : 1,
			slideWidth: 306,
			slideMargin: 40,
			infiniteLoop: true,
			controls: false
		});
		
		$('#btn_close').click(function(){
			$('.pu_container').hide();
			popupslider.destroySlider();
		});
	}

}


$(document).mouseup(function (e){
	if($('.pu_contents').has(e.target).length === 0) {
		$('.pu_container').hide();
		popupslider.destroySlider();
	}	
});


function closeDay() {
	setCookie('close', 'close', 1);
	$('.pu_container').hide();
	popupslider.destroySlider();
}


/// 쿠키 처리 //////////////////////
function checkPopupCookie(cookieName) {
	var cookie = document.cookie;
	
	/// 현재 쿠키가 존재할 경우
	if(cookie.length > 0) {	
		startIndex = cookie.indexOf(cookieName);
		
		if(startIndex != -1) {
			return true;
		}
		else {
			return false;
		}
	}
	else {
		return false;
	}
}

function setCookie(name, value, expiredays) {
	var d = new Date();
	d.setDate(d.getDate() + expiredays);
	document.cookie = name + "=" + escape(value) + "; path=/; expires=" + d.toGMTString() + ";";
}

function removeCookie(name) {
	var d = new Date();
	d.setDate(d.getDate() - 1);
	document.cookie = name + "=" + escape(name) + "; path=/; expires=" + d.toGMTString() + ";";
}
/////////////////////////////////

</script>
    
