    // 초기 설정: 자유전공학부가 선택되어 있으면 보이고, 아니면 숨김
    if ($('#glrtk06').parent().hasClass('active')) {
        $('.home_btn').show();
    } else {
        $('.home_btn').hide();
    }
    
    // 탭 클릭 이벤트
    $('.tab_button').on('click', function() {
        if ($(this).attr('id') === 'glrtk06') {
            $('.home_btn').show(); 
        } else {
            $('.home_btn').hide();  
        }
    });
});
</script>
