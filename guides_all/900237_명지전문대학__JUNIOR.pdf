<script type="text/javascript">
	function validateSearch(){
		var frm = document.RSA_fm;
		if(frm.qt.value == "검색어를 입력하세요"){
			frm.qt.value = "";
		}
			
		if(frm.qt.value == ""){
			alert("검색어를 입력하세요");
			frm.qt.focus();
			return false;
		} else {
			frm.action = "https://www.mjc.ac.kr/RSA/front_new/Search.jsp";
			frm.target = "_blank";
			frm.submit();
		}
	}
	
	function goMenu(menuNum){
		var menuIdx = $('#menuIdx_' + menuNum).val();
		
		if(menuIdx != "" && typeof menuIdx != "undefined")
			location.href = "/ibuilder.do?menu_idx=" + menuIdx;
	}
	
	//function chkEnterKey() {
	//	var key = event.keyCode;
	//	
	//	if (key == 13) {
	//		validateSearch();
	//	}
	//}

function chkEnter() {
	var key = event.keyCode;
	
	if (key == 13) {
		if( $('#userId').val() == '' ){
			alert( '아이디를 입력하세요' );
			$('#userId').focus();
		}else if( $('#userPw').val() == '' ){
			alert( '비밀번호를 입력하세요' );
			$('#userPw').focus();
		}else{
			$('#frmDoc').submit();
		}
	}
}

	function fn_loginProc(){
		var f = document.frmDoc;		
		
		if( f.userId.value == "" || f.userId.value == "아이디" ){
			alert("아이디를 입력해 주세요.");
			$("#userId").val("");
			f.userId.focus();
			return false;
		}
		else if( f.userPw.value == "" || f.userPw.value == "비밀번호"){
			alert("비밀번호를 입력해 주세요.");
			$("#userPw").val("");
			f.userPw.type = "password";
			f.userPw.focus();
			return false;
		}
		else {
			f.target = "_self";
			f.submit();
			//return;
		}
	}

</script>

