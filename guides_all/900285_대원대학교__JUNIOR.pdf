<script>
	// 선택된 언어 확인
	function getTranslatedLang() {
		var match = document.cookie.match(/googtrans=\/[a-z]{2}\/([a-z]{2})/);
		return match ? match[1] : null;
	}

	function setGTransCookie(targetLang) {
//		  var host = location.hostname.replace(/^www\./,'');
//		  var val  = '/ko/' + targetLang;
//		  var exp  = new Date(Date.now()+10*60*1000).toUTCString();
//		  document.cookie = 'googtrans=' + val + '; expires=' + exp + '; path=/;';
//		  document.cookie = 'googtrans=' + val + '; expires=' + exp + '; path=/; domain=.' + host;
//
//		  //document.cookie = 'googtr='+val+'; expires='+exp+'; path=/';
//		  //var exp  = new Date(Date.now()+365*24*60*60*1000).toUTCString();
//		  //document.cookie = 'googtrans='+val+'; expires='+exp+'; path=/';
//		  //document.cookie = 'googtrans='+val+'; expires='+exp+'; path=/; domain=.'+host;
	}

	function clearGTransCookie() {
		var host = location.hostname;
		var parts = host.split('.');
		var domains = [];

		// 현재 호스트 쿠키용 (domain 생략 버전)
		domains.push('current');

		if (parts.length > 2) {
			domains.push('.' + parts.slice(-2).join('.'));
		}

		document.cookie.split(";").forEach(function(c) {
			if (c.indexOf("googtrans") > -1) {
				domains.forEach(function(d) {
					if (d === 'current') {
						document.cookie = c
							.replace(/^ +/, "")
							.replace(/=.*/, "=;expires=" + new Date(0).toUTCString() + ";path=/");
						//console.log("Deleted current domain cookie:", location.hostname);
					} else {
						document.cookie = c
							.replace(/^ +/, "")
							.replace(/=.*/, "=;expires=" + new Date(0).toUTCString() + ";path=/;domain=" + d);
						//console.log("Deleted domain cookie:", d);
					}
				});
			}
		});
	}

	function googleTranslateElementInit() {
		new google.translate.TranslateElement({
			pageLanguage: 'ko',
			autoDisplay: false
		}, 'google_translate_element');
	}

	(function () {
		var gt = document.createElement('script');
		gt.type = 'text/javascript';
		gt.async = true;
		gt.src = '//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit';
		document.getElementsByTagName('head')[0].appendChild(gt);
	})();


	document.getElementById('custom_translate_selector').addEventListener('change', function () {
		var lang = this.value;
		if (lang && lang!=='other') {
		  var select = document.querySelector('.goog-te-combo');
		  if (select) {

			select.value = lang;
			select.dispatchEvent(new Event('change'),{bubbles:true});

			if(lang != "ko") {
			
				setTimeout(function () {
					select.value = lang;
					select.dispatchEvent(new Event('change'),{bubbles:true});
				}, 50);

				setTimeout(function () {
					select.value = lang;
					select.dispatchEvent(new Event('change'),{bubbles:true});
				}, 100);

			}
		  }
		} else if(lang === ""){
			clearGTransCookie(); // 번역 쿠키 삭제
			setTimeout(function() {
				location.reload();
			}, 300);
		}
	});
