	// 2024.11.06. 서브 메뉴
	function smenuClose(n) {
		$.each($('.locationNav > ul > li'),function(lni, lnv) {
			if( !$(lnv).find('a').hasClass("home") && (n==0 || (n>0 && n!=lni)) ) {
				$(lnv).find('a').prop('title',$(lnv).find('a').data('title') + "접힘");
				$(lnv).find('ul').hide();
			}
		});
	}

	$(function() {
		$(".topBanner").show();

//		if(window.navigator.userAgent.toLowerCase() < 0 ){
			$( '.topBanner' ).find( '.bx-viewport' ).height('93px');
			$( '.topBanner' ).find( 'li' ).width('600px');
//		}else{
//			$( '.topBanner' ).find( '.bx-viewport' ).height('62px');
//			$( '.topBanner' ).find( 'li' ).width('400px');
//		}
		var thisMenuId = "daewon_010304040000";
		if(thisMenuId != "") {
			var menuSeq = thisMenuId.split("_")[1].replace(/00/gi, "");
			for(var i=menuSeq.length; i>0; i-=2) {
				$("#topMenu_" + menuSeq.substring(0, i)).addClass("_active");
			}

			//$(".subVisual .subVisualNav span strong").html($("#topMenu_" + menuSeq.substring(0, 2) + " > a").text());
		}

		// 2024.11.06. 변경
		$.each($('.locationNav > ul > li'),function(lni, lnv) {
			if(!$(lnv).find('a').hasClass("home")) {
				$(lnv).find('a').data('title',lni + "depth 메뉴 ");
			}
		});
		smenuClose(0);
		$(document).on("click", ".locationNav > ul > li > a", function() { //페이지 네비게이션 클릭 이벤트
			if($(this).siblings("ul").css('display') == "none") {
				$(this).prop('title',$(this).data('title') + "펼침");
				$(this).siblings("ul").show();

			} else {
				$(this).prop('title',$(this).data('title') + "접힘");
				$(this).siblings("ul").hide();
			}
		});
		//$(document).on("focus", ".locationNav > ul > li:first-child > a", function() {
		//	smenuClose(0);
		//});
		$(document).on("focus", ".fnWrap > ul > li:first-child > a", function() {
			smenuClose(0);
		});
		$(document).on("focus", ".locationNav > ul > li > a", function() { //페이지 네비게이션 클릭 이벤트
			var lnum = $('.locationNav > ul > li').index($(this).closest('li'));
			smenuClose(lnum);
		});

		//$(document).on("click", ".locationNav > ul > li", function() { //페이지 네비게이션 클릭 이벤트
		//	$(this).find("ul").toggle();
		//});

		$(document).on("click", ".campusAnchor", function() { //캠퍼스맵 클릭 이벤트
			var positionId = $(this).attr("id");

			$(".campusmap_wrap .campusAnchor").removeClass("_active");
			$("#" + positionId).addClass("_active");

			campus_view(positionId);
		});

		setDaumMap();
	});

	function searchEngine() {
		if(document.searchForm.qt.value == "") {
			alert("검색어를 입력하세요.");
			searchForm.qt.focus();
			return false;
		}

		return true;
	}

	//메인 구글검색
	function jf_search(form_search) {
		if(document.form_search.q.value == ''){
			if(document.form_search.hl.value == 'en'){
				alert('Please enter keyword.');
			}else if(document.form_search.hl.value == 'cn'){
				alert('Please enter keyword.');
			}else{
				alert('검색어를 입력 하세요.');
			}
			document.form_search.q.focus();
			return false ;
		}

		if(document.form_search.kind.value == "google"){
			document.form_search.target="_blank";
			document.form_search.action="https://www.google.co.kr/search";
			//document.form_search.submit();
		}
	}

	function jf_windowPop(url){
		window.open(url, '', 'top=100px, left=100px, height=800px, width=800px, scrollbars=yes');
	}

	function setDaumMap() {
		var mapTypeControl = new daum.maps.MapTypeControl();
		var zoomControl = new daum.maps.ZoomControl();
		var options = {
			center: campusPositions["center"],
			level: 3
		};

		var comeToUsMap = document.getElementById("comeToUsMap");	//찾아오시는길
		var campusMap = document.getElementById("campusMap");		//캠퍼스 맵
		if(!comeToUsMap && !campusMap) {
			return;
		}

		if(comeToUsMap) {
			mapObj = new daum.maps.Map(comeToUsMap, options);
			markerObj = new daum.maps.Marker({
				map: mapObj,
				position: campusPositions["center"]
			});
		} else if(campusMap) {
			mapObj = new daum.maps.Map(campusMap, options);
			markerObj = new daum.maps.Marker({
				map: mapObj,
				position: campusPositions["mainGate"]
			});
			campus_view("mainGate");
		}
		//mapObj.addControl(mapTypeControl, daum.maps.ControlPosition.TOPRIGHT);
		//mapObj.addControl(zoomControl, daum.maps.ControlPosition.BOTTOMRIGHT);
	}

	function campus_view(ps) {
		if(mapObj) {
			var markerPosition = campusPositions[ps];
			mapObj.setCenter(campusPositions[ps]);
			mapObj.setLevel(3);
			markerObj.setPosition(markerPosition);
		}
	}


	function jf_openPrintWindow() {
		localStorage.removeItem("printStr");
		localStorage.setItem("printStr", $("#wrapContent").html());
		window.open("/mbs/daewon/html/print_contents.html", "printPreviewWindow");
	}

	function hideTopBanner(name, value, expiredays) {
		setCookie(name, value, expiredays);
		$(".topBanner").hide();
		$('.openTopBanner').show();
	}

	//260408 번역 파라미터 추가
	function jf_windowPopTranslated(url) {
    const selectBox = document.querySelector('.goog-te-combo');
    let currentLang = '';
    
    if (selectBox && selectBox.value) {
        currentLang = selectBox.value;
    }

    const separator = url.indexOf('?') !== -1 ? '&' : '?';
    const finalUrl = currentLang ? `lang=` : url;

    window.open(finalUrl, '', 'top=100px, left=100px, height=800px, width=800px, scrollbars=yes');
	}

