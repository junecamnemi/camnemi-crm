		"pap": "파피아멘토어(Papiamentu)",
		"pag": "팡가시난어(Pangasinan)",
		"pa": "펀자브어(구르무키)(ਪੰਜਾਬੀ)",
		"pa-Arab": "펀자브어(샤무키)(پنجابی)",
		"fo": "페로어(Føroyskt)",
		"fa": "페르시아어(فارسی)",
		"pt": "포르투갈어(브라질)(Português)",
		"pt-PT": "포르투갈어(포르투갈)(Português de Portugal)",
		"fon": "폰어(Fon)",
		"pl": "폴란드어(Polski)",
		"ff": "풀라니어(Fulfulde)",
		"fr": "프랑스어(Français)",
		"fr-CA": "프랑스어(캐나다)(Français canadien)",
		"fur": "프리울리어(Furlan)",
		"fy": "프리지아어(Frysk)",
		"fj": "피지어(Na Vosa Vakaviti)",
		"fi": "핀란드어(Suomi)",
		"tl": "필리핀어(Tagalog)",
		"haw": "하와이어(ʻŌlelo Hawaiʻi)",
		"ha": "하우사어(Hausa)",
		"cnh": "하카 친어(Hakha Chin)",
		"hu": "헝가리어(Magyar)",
		"hrx": "훈스뤼크어(Hunsrik)",
		"iw": "히브리어(עברית)",
		"hi": "힌디어(हिन्दी)",
		"hil": "힐리가이논어(Hiligaynon)"
	};
	document.addEventListener('DOMContentLoaded', function () {
		var glang = getTranslatedLang();

		if(glang && glang!="ko") {
			$('#custom_translate_selector option[value^='+glang+']').prop('selected',true);
		}
	});

	const langSelect = document.querySelector('.lang-select');
	const trigger = document.querySelector('.lang-trigger');
	const options = document.querySelectorAll('.lang-options li');
	const realSelect = document.getElementById('custom_translate_selector');
	const selectedText = document.querySelector('.selected-text');

	// 드롭다운 열기/닫기
	trigger.addEventListener('click', () => {
	  langSelect.classList.toggle('active');
	});

	// 옵션 선택
	options.forEach(option => {
	  option.addEventListener('click', (e) => {
		e.stopPropagation();
		const value = option.dataset.value;
		const text = option.textContent;

		if (value === 'other') {
            // 1. 구글 번역 위젯의 실제 select(콤보박스)를 찾습니다.
            const googleCombo = document.querySelector('.goog-te-combo');
            
            if (googleCombo) {
                // 2. 구글 언어 목록을 순회하며 li를 만듭니다.
                const googleOptions = googleCombo.querySelectorAll('option');
				const optionsUl = document.querySelector('.lang-options');
                const existingValues = Array.from(optionsUl.querySelectorAll('li'))
                                    .map(li => li.getAttribute('data-value'))
                                    .filter(val => val !== null);
                // 기존의 "다른언어 선택" li는 삭제 (목록을 새로 채우기 위함)
                option.remove(); 

                googleOptions.forEach(opt => {

					const langCode = opt.value;
					const displayLabel = langNativeMap[langCode] || opt.text;

					const isExist = document.querySelector(`.lang-options li[data-value=""]`);
					const alreadyHas = existingValues.includes(langCode);
					// 이미 UI에 있는 언어(en, vi 등)와 빈 값, 한국어(ko)는 제외

                    if (!alreadyHas && langCode !== "" ) {
                        const newLi = document.createElement('li');
                        newLi.dataset.value = langCode;
                        newLi.textContent = displayLabel;
                        
                        // 새 li 클릭 시 번역 실행 이벤트 연결
                        newLi.addEventListener('click', (e) => {
							e.stopPropagation();
                            selectedText.textContent = displayLabel;
                            realSelect.value = langCode;
                            langSelect.classList.remove('active');
                            
                            // 실제 구글 번역 이벤트 트리거
                            googleCombo.value = langCode;
                            googleCombo.dispatchEvent(new Event('change', { bubbles: true }));
                        });
                        const optionsUl = document.querySelector('.lang-options');
                        optionsUl.appendChild(newLi); // ul 목록에 추가
                    }
                });
                
                // 목록이 새로 생겼으므로 드롭다운이 닫히지 않게 유지 (원할 경우)
                return; 
            } else {
                alert("번역 위젯이 아직 로드되지 않았습니다. 잠시 후 다시 시도해주세요.");
                return;
            }
        }

		selectedText.textContent = text; // 커스텀 UI 변경
		realSelect.value = value;       // 실제 select 값 변경
		langSelect.classList.remove('active'); // 닫기

			const changeEvent = new Event('change', { bubbles: true });
        realSelect.dispatchEvent(changeEvent);
	  });
	});

	// 바깥 클릭 시 닫기
	document.addEventListener('click', (e) => {
	  if (!langSelect.contains(e.target)) {
		langSelect.classList.remove('active');
	  }
	});

	</script>
	<style>

	/* Google 번역 상단 툴바 제거 */

	.skiptranslate {
		display: none !important;
	} 
	body {
		top: 0px !important;
	}
	*/

	/* 번역 UI (작은 팝업) 숨기기 */
	
	.goog-tooltip, 
	.goog-tooltip:hover,
	.goog-text-highlight {
		display: none !important;
		visibility: hidden !important;
	}
		/* ============== 전체 스타일 ============== */
	.lang-select {
	  width: 140px;
	  font-family: 'Noto Sans';
	  font-weight: 14px;
	}

	/* 실제 select 숨김 */
	.real-select {
	  display: none;
	}

	/* 버튼 */
	.lang-trigger {
	  width: 100%;
	  height: 40px;
	  background: #f37321;
	  color: #fff;
	  display: flex;
	  align-items: center;
	  gap: 6px;
	  padding: 0 10px;
	  cursor: pointer;
	  box-sizing: border-box;
	  outline: none;     /* 포커스 테두리 제거 */
	  border: none;      /* 혹시 모를 기본 border 제거 */
	}

	.lang-trigger:focus {
	  outline: none;     /* 포커스 제거 */
	}

	.lang-trigger .globe-icon {
	  width: 16px;
	  height: 16px;
	}

	.lang-trigger .arrow-icon {
	  width: 9px;
	  height: 6px;
	  margin-left: auto;
	}

	/* 드롭다운 리스트 */
	.lang-options {
	  position: absolute;
	  top: 44px;
	  left: 0;
	  width: 100%;
	  background: #fff;
	  border: 1px solid #ccc;
	  list-style: none;
	  padding: 4px 0;
	  margin: 0;
	  box-sizing: border-box;
	  display: none;
	  z-index: 10;
	  overflow-y: auto;
	  max-height: 320px;
	}

	.lang-options li {
	  padding: 8px 10px;
	  font-size: 14px;
	  cursor: pointer;
	  outline: none;
	}

	.lang-options li:focus {
	  outline: none;
	}

	/* hover 시 주황색 */
	.lang-options li:hover {
	  background: #f37321;
	  color: white;
	}

	/* 열렸을때 표시 */
	.lang-select.active .lang-options {
	  display: block;
	}
</style>



