				<div id="nav" class="lnb">
					
<ul><li><div><a href="/content/1" title="입학처장에게 묻기">입학처장에게 묻기</a></div><ul><li><a href="/content/2" title="입학처장에게 묻기">입학처장에게 묻기</a></li></ul></li><li><div><a href="/content/4" title="대학">대학</a></div><ul><li><a href="/content/11" title="대학입학전형 주요사항">대학입학전형 주요사항</a></li><li><a href="/content/12" title="수시모집">수시모집</a></li><li><a href="/content/13" title="정시 (가)군 모집">정시 (가)군 모집</a></li><li><a href="/content/14" title="추가모집">추가모집</a></li><li><a href="/content/15" title="편입학">편입학</a></li><li><a href="/content/16" title="재외국민과 외국인">재외국민과 외국인</a></li><li><a href="/content/18" title="공지사항">공지사항</a></li></ul></li><li><div><a href="/content/19" title="신학대학원">신학대학원</a></div><ul><li><a href="/content/20" title="신학과(M.Div)">신학과(M.Div)</a></li><li><a href="/content/21" title="목회연구과정">목회연구과정</a></li></ul></li><li><div><a href="/content/24" title="대학원">대학원</a></div><ul><li><a href="/content/68" title="일반대학원 박사과정">일반대학원 박사과정</a></li><li><a href="/content/69" title="일반대학원 석사과정">일반대학원 석사과정</a></li></ul></li><li><div><a href="/content/36" title="특수대학원">특수대학원</a></div><ul><li><a href="/content/60" title="사회복지대학원">사회복지대학원</a></li><li><a href="/content/61" title="성서신학대학원">성서신학대학원</a></li><li><a href="/content/62" title="상담대학원">상담대학원</a></li><li><a href="/content/64" title="미래목회대학원">미래목회대학원</a></li><li><a href="/content/63" title="통일선교대학원">통일선교대학원</a></li><li><a href="/content/65" title="국제언어다문화대학원">국제언어다문화대학원</a></li><li><a href="/content/70" title="대안교육대학원">대안교육대학원</a></li></ul></li><li><div><a href="/content/43" title="입시도우미">입시도우미</a></div><ul><li><a href="/content/44" title="입시자료 신청">입시자료 신청</a></li><li><a href="/content/45" title="입시서류 양식">입시서류 양식</a></li><li><a href="/content/46" title="입시 Q&amp;A">입시 Q&amp;A</a></li></ul></li><li><div><a href="/content/71" title="입학신청">입학신청</a></div><ul><li><a href="/content/72" title="입학원서 접수/제출">입학원서 접수/제출</a></li><li><a href="/content/73" title="입학원서 조회">입학원서 조회</a></li></ul></li></ul>
				</div>
				<!-- 햄버거메뉴 -->
				<div class="btn-gnb-menu">
