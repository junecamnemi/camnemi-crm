	<!-- AOS -->

	<script>
	var menuImages = new Array();
	var menuRoots = new Array();
		//window.onload role
		$(document).ready(function(){
			//주메뉴 제어 Begin
			
			var rootIndex = 0;
			menuRoots[rootIndex] = 0;menuImages[0] = { "link":"/../uploads/menu/", "hover":"/../uploads/menu/" }; rootIndex++;menuRoots[rootIndex] = 1;menuImages[1] = { "link":"/../uploads/menu/", "hover":"/../uploads/menu/" }; rootIndex++;menuRoots[rootIndex] = 2;menuImages[2] = { "link":"/../uploads/menu/", "hover":"/../uploads/menu/" }; rootIndex++;menuRoots[rootIndex] = 3;menuImages[3] = { "link":"/../uploads/menu/", "hover":"/../uploads/menu/" }; rootIndex++;menuRoots[rootIndex] = 4;menuImages[4] = { "link":"/../uploads/menu/", "hover":"/../uploads/menu/" }; rootIndex++;menuRoots[rootIndex] = 6;menuImages[6] = { "link":"/../uploads/menu/", "hover":"/../uploads/menu/" }; rootIndex++;menuRoots[rootIndex] = 7;menuImages[7] = { "link":"/../uploads/menu/", "hover":"/../uploads/menu/" }; rootIndex++;			$('div#nav > ul > li').each(function(){
				var $li = $(this);

				// li에 들어왔을 때
				$li.on('mouseenter', function(){
					// 모든 서브메뉴 닫기
					$('div#nav > ul > li > ul').hide();

					// 현재 li 서브메뉴 열기
					$li.find('ul').show();
					// 모든 이미지 기본값으로 리셋
					/*
					for (var i = 0; i < menuImages.length; i++) {
						$('div#nav > ul > li:eq(' + i + ') > div > a > img')
							.attr({ src: menuImages[menuRoots[i]]['link'] });
					}

					// 현재 메뉴 hover 이미지로 교체
					$li.find('a:first img')
						.attr({ src: menuImages[$li.index()]['hover'] });
					*/
					// 글자색 초기화
					$('div#nav > ul > li > div > a').css('color', '');
					// 현재 메뉴만 흰색
					$li.find('> div > a').css('color', '#00387A');
				});

				// li에서 나갔을 때
				$li.on('mouseleave', function(){
					$li.find('ul').hide(); // 현재 li 서브메뉴 닫기
					$li.find('> div > a').css('color', ''); // 글자색 원래대로
				});
			});
			//주메뉴 제어 End


			//관리자 메인비주얼 관리
			if(''){
				var rollHeight = '485';
				var type = 'horizontal';
				var auto = 'true';
				var speed = parseInt('500');
				var data = {'mode' : type , 'speed' : speed};

				''
				data['auto'] = true;
				data['pause'] = '5000';
				''

				$('.bxslider').bxSlider(data);
				if('' && type != 'fade'){
					$('.bx-wrapper img').css('max-width' , '100%');
				}
			}
			//관리자 메인비주얼 관리 End

			//2차 메뉴가 없을때 nosub 클래스 주기
			$('.mobile_top > ul > li').each(function(){
				if($(this).find('ul').index() != 1){
					$(this).addClass('nosub');
				}
			});
			
			//오늘하루 닫기
			/* Javascript */
			var $layerPopup = document.querySelector('.pop-video');
			var $btnLayerPopupClose = document.querySelector('.video-popup .close');
			var $btnLayerPopupTodayHide = document.querySelector('.video-popup .close_box .today');

			//레이어팝업 닫기 버튼 클릭
			if ($btnLayerPopupClose) {
				$btnLayerPopupClose.addEventListener('click', function(){
					layerPopupHide(0);
				});
			}

			//레이어팝업 오늘 하루 보지 않기 버튼 클릭
			if ($btnLayerPopupTodayHide) {
				$btnLayerPopupTodayHide.addEventListener('click', function(){
					layerPopupHide(1);
				});
			}

			//레이어팝업 노출
			function layerPopupShow(){
				if ($layerPopup) {
					$layerPopup.style.display = 'block';
				}
			}
			//레이어팝업 비노출
			function layerPopupHide(state){
				
				//닫기버튼 오늘하루보지않기 버튼 무관하계 레이어팝업은 닫는다.
				if ($layerPopup) {
					$layerPopup.style.display = 'none';
				}

				//오늘하루보지않기 버튼을 누른 경우
				if(state === 1){
					//'testCookie' 이름의 쿠키가 있는지 체크한다.
					if($.cookie('popup') == undefined){
						//쿠키가 없는 경우 testCookie 쿠키를 추가
						$.cookie('popup', 'Y', { expires: 1, path: '/' });
						/**
						 설명 :
						 임의로 testCookie라는 이름에 Y라는 값을 넣어주었고,
						 expires값으로 1을 주어 1일 후 쿠키가 삭제되도록 하였다.
						 path값을 '/'로 주면 해당사이트 모든페이지에서 유효한 쿠키를 생성한다.
						 특정페이지에서만 작동하려면 페이지 경로를 작성하면 된다.
						 **/
					}
				}
			}

			//사이트맵
            $('.mobile_top > ul').addClass('mbtop');
            $('.mbtop > li > div > a').unwrap();
            $('.mbtop > li > ul > li').each(function(){
				if($(this).find('a:first').attr('href') == '#'){
					$(this).find('a:first').attr('href',$(this).find(' > ul > li > a:first').attr('href'));
				}
			});
			
			const targets = ["기숙사안내", "동아리안내"];

			$('#nav.lnb a, .mbtop a').each(function () {
			  const text = $(this).text();

			  if (text.includes('기숙사안내') || text.includes('동아리안내')) {
				$(this).addClass('has-external');
			  }
			});


			//사이트맵 버튼
			$('.btn-gnb-menu').click(function(){
				if($('#header').hasClass('open') == false){
					$('#header').addClass('open');
					$('body,html').css('overflow','hidden');
					setTimeout(function() {
						$('.site-bg').addClass('open');
					}, 500); // 0.5초 후에 실행
				}else{
					$('#header').removeClass('open');
					$('body,html').css('overflow','visible');
					$('.site-bg').removeClass('open');
				}
			});

			//모바일 메뉴 작업
			$('.mbtop > li > a').click(function(){
				var mbtop_li = $(this).parent();
				var midx = mbtop_li.index();

				$('.mbtop > li > ul').removeClass('on');
				$('.mbtop > li').each(function(){
					if($(this).index() != midx){
						$(this).removeClass('open_li');
					}
				});

				if(mbtop_li.find('ul > li').length > 0){
					if(mbtop_li.prop('class') == 'open_li'){
						mbtop_li.removeClass('open_li');
						mbtop_li.find('ul').removeClass('on');
					}else{
						mbtop_li.addClass('open_li');
						mbtop_li.find('ul').addClass('on');
					}
					return false;
				}
			});

			$('.top-btn').click(function (event) {
				event.preventDefault();
				$('html, body').animate({ scrollTop: 0 }, 300);
			});
			$(window).scroll(function () {
			if ($(this).scrollTop() > 200) {
				$('.top-btn').fadeIn(200);
			} else {
				$('.top-btn').fadeOut(200);
			}});
			
			//모바일 전체메뉴
			$(function() {

				var isMobileMenuBound = false;

				function bindMobileMenu() {
					if (window.innerWidth < 1400) {

						if (isMobileMenuBound) return;
						isMobileMenuBound = true;

						var $mbtop = $('#navi .mbtop');

						// ✅ 초기: 3차 전부 닫기
						$mbtop.find('> li > ul > li > ul').hide();

						// ✅ 최초 진입 시: 첫 번째 1차 메뉴 열기
						var $firstLi = $mbtop.children('li:first-child');
						$firstLi.addClass('open_li');
						$firstLi.children('ul').show(); // 2차 보이게

						$(document).on('click.mobileMenu', '#navi .mbtop > li > ul > li > a', function(e) {
							e.preventDefault();

							var $li = $(this).parent('li');
							var $target = $li.children('ul');

							// 3차 없는 경우는 그냥 이동
							if ($target.length === 0) {
								location.href = $(this).attr('href');
								return;
							}

							// 같은 2차 레벨 내 다른 메뉴 닫기
							$li.siblings('li')
								.removeClass('on')
								.children('ul')
								.stop(true, true)
								.slideUp(200);

							// 토글
							if ($li.hasClass('on')) {
								$li.removeClass('on');
								$target.stop(true, true).slideUp(200);
							} else {
								$li.addClass('on');
								$target.stop(true, true).slideDown(200);
							}
						});

					} else {
						// ✅ 1400 이상 → 초기화
						if (!isMobileMenuBound) return;
						isMobileMenuBound = false;

						$(document).off('click.mobileMenu');

						$('#navi .mbtop > li')
							.removeClass('open_li')
							.find('li')
							.removeClass('on')
							.children('ul')
							.removeAttr('style');
					}
				}

				// 최초 실행
				bindMobileMenu();

				// 리사이즈 대응
				$(window).on('resize', function() {
					bindMobileMenu();
				});

			});



			/*-----------------------------------------------------------------*/
			// Select Menu
			/*-----------------------------------------------------------------*/
			$(function(){
				//  CSS셀렉트
				var CSSSELECT = (function(){

					var $baseSelect = $(".cssSelect"),
						$buttonSelect = $baseSelect.find(".open_select"),
						$boxSelect = $baseSelect.find(".box_select");

					$buttonSelect.attr("title","축소됨");

					$buttonSelect.on("click", function(e) {
						//e.preventDefault();
						e.stopPropagation(); // 버블링 차단

						var $this = $(this),
							$top = $this.closest(".cssSelect");
						if($top.hasClass("on")){
							$top.removeClass("on");
							$this.attr("title","축소됨");
						} else {
							$baseSelect.removeClass("on");
							$top.addClass("on");
							$buttonSelect.attr("title","축소됨");
							$this.attr("title","확장됨");
						};
					});

					$(document).on("click.cssSelectClose", function(e){
						if($baseSelect.hasClass("on")){ // cssSelect on일때
							if(!$baseSelect.has(e.target).length){ // cssSelect에 클릭 이벤트가 발생되어 있는게 없다면
								$baseSelect.removeClass("on");
								$buttonSelect.attr("title","축소됨");
							}
						}
					});

				})();
			});

		});

	</script>
</head>
