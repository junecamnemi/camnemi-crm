<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

<script>
const popupSwiper = new Swiper('.popup-swiper', {
  slidesPerView: 3,
  spaceBetween: 32,

  navigation: {
    nextEl: '.popup-next',
    prevEl: '.popup-prev',
  },

  breakpoints: {
    0: { slidesPerView: 1 },
    768: { slidesPerView: 2 },
    1200: { slidesPerView: 3 }
  },

  on: {
    init(swiper) {
      document.querySelector('.popup-count .total').textContent = swiper.slides.length;
      document.querySelector('.popup-count .current').textContent = swiper.realIndex + 1;
    },
    slideChange(swiper) {
      document.querySelector('.popup-count .current').textContent = swiper.realIndex + 1;
    }
  }
});
</script>
