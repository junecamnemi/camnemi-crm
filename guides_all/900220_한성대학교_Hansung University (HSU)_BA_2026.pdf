<link type="text/css" rel="stylesheet" href="/Web-home/fnct/imageSlide/han_popup/css/style.css" />






<div class="_fnctWrap wrap-pop">
	<div class="inner">
		
		<h2 class="hidden">팝업존(<b>0</b> 개)</h2>

		<div class="title">
			<strong>HANSUNG POPUP ZONE</strong>
		</div>

		<div class="box-slider" id="wrap-slider187">
			<div class="slider" id="slider187">
				<ul class="swiper-wrapper">

				</ul>

				<div class="control">
					
						<button type="button" class="prev">이전 슬라이드</button>
						<button type="button" class="next">다음 슬라이드</button>
					
				</div>

				<div class="control2">
					<div class="pop-state">
						<strong class="now"></strong>
						<span>/</span>
						<em class="total"></em>
						
							<div class="playstop">
								<button type="button" class="stop on">슬라이드 정지</button>
								<button type="button" class="play">슬라이드 재생</button>
							</div>
						
					</div>

					<div class="pop-today">
						<span>
							<input type="checkbox" title="오늘하루 열지않기">
							<label></label>
						</span>
						<span>오늘하루 열지않기</span>
					</div>
				</div>

				<div class="pop-close">
					<button type="button" class="btn-close">닫기</button>
				</div>
			</div>
		</div>

		<button type="button" class="empty-close">팝업창 닫기</button>
	</div>
</div>

<script>
	$(document).ready(function() {
		$.ajax({
			type:"post",
			cache:false,
			async:true,
			url:'/imageSlide/hansung/187/getJsonImageSlideArtclList.do',
			success:function(artclList) {
				if( $( artclList ).size() > 0 ) {
					$("#total187").html($( artclList ).size());
					var html = "";
					$( artclList ).each(function() {
						html += "<li class='swiper-slide'>";
						if(this.linkUseYn=="Y"){
							html += "<a href='"+this.urlAddr+"' ";
							if(this.linkTy=="_BLANK"){
								html += "target='_blank' title='새창' ";
							}
							html += ">";
						}
						html += "<p><img src='"+this.imgPath+this.cnvrFile+"' alt='"+this.alt+"'></p>";
						if(this.linkUseYn=="Y"){
							html += "</a>";
						}
						html += "</li>";
					});
					$( ".wrap-pop .swiper-wrapper").html( html );

					// swiper //

					const sliderEl = $('.wrap-pop .slider')
					const slideWrapper = $('.wrap-pop .slider .swiper-wrapper');
					const slideCount = slideWrapper ? slideWrapper.children.length : 0;

					function controlShow() {
						if (slideCount <= 1) {
							sliderEl.addClass("no-slider");
						}
						if ($(window).width() <= 700 && slideCount > 1) {
							sliderEl.removeClass("no-slider");
						}
					}

					controlShow();

					$(window).resize(function(){
						controlShow();
					})

					if (slideCount >= 2) {
						var popSlider = new Swiper(".wrap-pop .slider", {
							slidesPerView: 3,
							spaceBetween: 30,
							speed: 1000,
							
								
								
							
							fadeEffect: { crossFade: true },
							
								
								
									autoplay: {
										delay: 3000,
										disableOnInteraction: false,
									},
								
							
							loop: true,
							loopAdditionalSlides: 1,
							loopFillGroupWithBlank: true,
							observer: true,
							observeParents: true,
							watchSlidesVisibility: true,
							watchSlidesProgress: true,
							pagination: {
								el: "",
								clickable: true,
							},
							navigation: {
								prevEl: ".wrap-pop .prev",
								nextEl: ".wrap-pop .next",
							},
							on: {
								init: function () {
									const looped = typeof this.loopedSlides === "number" ? this.loopedSlides : 0;
									const realIndex = this.realIndex + 1;
									const totalIndex = this.slides.length - this.loopedSlides * 2;

									if (realIndex < 10) {
										$('.wrap-pop .now').addClass("under10");
									}
									if (totalIndex < 10) {
										$('.wrap-pop .total').addClass("under10");
									}
									$('.wrap-pop .now').text(realIndex);
									$('.wrap-pop .total').text(totalIndex);

									$('.wrap-header .pop button span').text(totalIndex);
								},
								slideChange: function () {
									const realIndex = this.realIndex + 1;
									$('.wrap-pop .now').text(realIndex);

									if($(".wrap-pop").hasClass('on')) {
										accSlider('.wrap-pop .slider a', '.wrap-pop .slider .swiper-slide-visible a');
									}
								},
								slideChangeTransitionStart: function () { },
							},
							breakpoints: {
								1200: {
									slidesPerView: 2,
									spaceBetween: 30,
								},
								700: {
									slidesPerView: 1,
									spaceBetween: 20,
								}
							},
						});

						const popStop = $(".wrap-pop .control2 .stop");
						const popPlay = $(".wrap-pop .control2 .play");

						popStop.on("click", function () {
							$(this).removeClass("on");
							popPlay.addClass("on");
							popSlider.autoplay.stop();
						});

						popPlay.on("click", function () {
							$(this).removeClass("on");
							popStop.addClass("on");
							popSlider.autoplay.start();
						});
					}
				}else{
					$( ".wrap-pop .slider" ).html( "<li class='nodata'>팝업이 존재하지 않습니다</li>" );
				}

				//팝업존
				var boxSidePop = $(".wrap-pop");
				var btnOpenPop = $(".wrap-header .pop button");
				var btnClosePop = $(".wrap-pop .pop-close button");
				var btnCookie = $(".pop-today");

				accSlider('.wrap-pop .slider a', '');
				accSlider('.wrap-pop .pop-close button', '');
				accSlider('.wrap-pop .control button', '');
				accSlider('.wrap-pop .control2 .playstop button', '');
				accSlider('.wrap-pop .control2 .pop-today input[type="checkbox"]', '');

				btnOpenPop.on("click", function () {
					if (!$(".wrap-pop .slider li").hasClass('nodata')) {
						boxSidePop.addClass("on");
						boxSidePop.attr('tabindex', 0).focus();
						$('.wrap-header .pop button span').show();
						accSlider('', '.wrap-pop .slider .swiper-slide-visible a');
						accSlider('', '.wrap-pop .pop-close button');
						accSlider('', '.wrap-pop .control button');
						accSlider('', '.wrap-pop .control2 .playstop button');
						accSlider('', '.wrap-pop .control2 .pop-today input[type="checkbox"]');
					} else {
						alert('팝업이 존재하지 않습니다.', function() {
							$('.wrap-header .pop button').focus();
						});
						accSlider('.wrap-pop .slider a', '');
						accSlider('.wrap-pop .pop-close button', '');
						accSlider('.wrap-pop .control button', '');
						accSlider('.wrap-pop .control2 .playstop button', '');
						accSlider('.wrap-pop .control2 .pop-today input[type="checkbox"]', '');
					}
				});

				btnClosePop.on("click", function () {
					boxSidePop.removeClass("on");
					boxSidePop.attr('tabindex', -1)
					setTimeout(function() {
						btnOpenPop.focus();
					},100);

					accSlider('.wrap-pop .slider a', '');
					accSlider('.wrap-pop .pop-close button', '');
					accSlider('.wrap-pop .control button', '');
					accSlider('.wrap-pop .control2 .playstop button', '');
					accSlider('.wrap-pop .control2 .pop-today input[type="checkbox"]', '');
				});

				if ($("body").hasClass("main")) {
					if (!$(".wrap-pop .slider li").hasClass('nodata')) {
						// boxSidePop.addClass("on");
						$('.wrap-header .pop button span').show();
					} else {
						boxSidePop.removeClass("on");
					}
				}

				function TermsAndConditions() {
					days = 1;
					myDate = new Date();
					myDate.setTime(myDate.getTime() + days * 24 * 60 * 60 * 1000);
					document.cookie = "cookiePop=Accepted; expires=" + myDate.toGMTString();
				}

				var cookie = document.cookie
					.split(";")
					.map(function (x) {
						return x.trim().split("=");
					})
					.filter(function (x) {
						return x[0] === "cookiePop";
					})
					.pop();

				if (cookie && cookie[1] === "Accepted") {
					boxSidePop.removeClass("on");
				} else {
					var menuSeq = $("#menuSeq").val();
					if ($("body").hasClass("main")) {
						if (!$(".wrap-pop .slider li").hasClass('nodata')) {
							// boxSidePop.addClass("on");
							$('.wrap-header .pop button span').show();
						}
					}
				}

				btnCookie.on("click keypress touchstart", function () {
					$(".pop-today input").prop("checked", true);
					if ($(".pop-today input").is(":checked")) {
						TermsAndConditions();
						boxSidePop.removeClass("on");
						return false;
					} else {
						return false;
					}
				});
			}
		});
	});
</script>



	<!-- //팝업존 -->

