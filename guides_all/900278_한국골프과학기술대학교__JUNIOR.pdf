	function zip_down(args,title){
		var form = $("#excelform")[0];
		form.target= "";
		form.method= "post";
		form.action = "/modules/zip.down.php";
		form.args.value = args;
		form.printmode.value = "file";
		form.filename.value = title;
		form.submit();	
	}

	function file_modal(gopage){
		$('#file_board').attr('href', gopage);
		$(".noattach-wrap").show();
		
	}
</script>
