				$("div.kg-popup-wrap").css({"display":"block"});
			});	

			//21-07-07cloasePopupzone();
		}else{
			$("div.kg-popup-wrap").addClass("open");
			$("div.kg-popup-wrap").css({"display":"block"});
		}		
	});


