	<script>

        $(document).ready(function() {
            // 컨텐츠 내용 중 이미지(적용), 테이블(적용불가능) 가로길이 변경
            $(".board-contents img, .board-contents table").css("width", "100%");
        });

        function imageOnload(img, maxWidth) {
            var width = img.width;
            var height = img.height;
            if( width > maxWidth ) {
                height = ( height * maxWidth ) / width;
                width = maxWidth;
                img.width = width;
                img.height = height;
            }
        }

	</script>

