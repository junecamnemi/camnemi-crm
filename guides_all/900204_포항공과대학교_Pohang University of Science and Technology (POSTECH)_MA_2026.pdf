        <script>
            function goPasserSearch(target_app_year, target_app, target_step) {
                var f = document.frm_passer;
                
                if(target_app_year==undefined || target_app==undefined || target_step==undefined || target_app_year=="" || target_app=="" || target_step=="") {
                    alert("사용할 수 없는 기능입니다.");
                    return;
                } else{
                    f.passer_mode.value =   "PASSER_SEARCH";
                    f.target_year.value =   target_app_year;
                    f.target_app.value  =   target_app;
                    f.target_step.value =   target_step;

                    f.method    =   "post";
                    f.action    =   "/postech-passer";
                    f.target    =   "_self";

                    f.submit();
                }
            }

            function syncModalDim() {
                const hasOpenModal = jQuery('[data-modal] .modal').filter(':visible').length > 0;
                jQuery('body>.wrap').toggleClass('modal-open', hasOpenModal);
            }
            function openModal($modal) {
                $modal.show();
                syncModalDim();
            }

            function closeModal($modal) {
                $modal.hide();
                syncModalDim();
            }

            jQuery(document).on('click', '.pop_close1, .pop_close2', function () {
                const $modal = jQuery(this).closest('.modal');
                closeModal($modal);
            });



            jQuery(window).ready(function($){
                syncModalDim();

                $("#POPUP_PASSER_NOTICE").click(function(e){
                    if (e.target !== e.currentTarget) return;
                    console.log("aaaaaaaa");
                    $("#POPUP_PASSER_NOTICE .modal").hide(0);
                    syncModalDim();
                })
                
                let $mainModalPosser = $(".POPUP_PASSER_NOTICE .modal");
                const $modal = $('[data-modal]');
                const $wrap = $('body > .wrap');
                if ($modal.length) {
                    $modal.show();
                    $wrap.addClass('modal-open');
                }
                $mainModalPosser.find(".pop_close1").click(function(){
                    let $this = $(this);
                    $this.closest("..POPUP_PASSER_NOTICE .modal").hide();
                    $wrap.removeClass('modal-open');
                })
            });

            jQuery(function () {
                const target = document.querySelector('[data-modal]');
                if (!target) return;

                const observer = new MutationObserver(function () {
                    syncModalDim();
                });

                observer.observe(target, {
                    subtree: true,
                    attributes: true,
                    attributeFilter: ['style', 'class']
                });

                // 최초 상태 체크
                syncModalDim();
            });
        </script>


