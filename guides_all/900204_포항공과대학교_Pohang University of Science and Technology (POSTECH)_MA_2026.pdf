                        <script>

                jQuery(window).ready(function($){

                    function setCookie(name, value, expiredays) {
                        var today = new Date();
                            today.setDate(today.getDate() + expiredays);
                            document.cookie = name + '=' + escape(value) + '; path=/; expires=' + today.toGMTString() + ';'
                    }
                    
                    function getCookie(name) { 

                        var cName = name + "="; 
                        var x = 0; 
                        while ( i <= document.cookie.length ) 
                        { 
                            var y = (x+cName.length); 
                            if ( document.cookie.substring( x, y ) == cName ) 
                            { 
                                if ( (endOfCookie=document.cookie.indexOf( ";", y )) == -1 ) 
                                    endOfCookie = document.cookie.length;
                                return unescape( document.cookie.substring( y, endOfCookie ) ); 
                            } 
                            x = document.cookie.indexOf( " ", x ) + 1; 
                            if ( x == 0 ) 
                                break; 
                        } 
                        return ""; 

                    } 

                    let $mainModalPop = $(".mainModalPop");
                    
                    $mainModalPop.find(".pop_close1").click(function(){
                        let $this = $(this);
                        let $wrap = $('body > .wrap');
                        $this.closest(".mainModalPop").hide();
                        $wrap.removeClass('modal-open');
                    });

                    $mainModalPop.find(".pop_close2").click(function(){
                        let $this = $(this);
                        let $pop = $this.closest(".mainModalPop");
                        let $wrap = $('body > .wrap');
                        let params = $pop.data("params");

                        let post_id = params.post_id;
                        let $chk = $pop.find("input[type=checkbox].today_chk")
                        if( $chk.is(":checked") == true) {
                            setCookie('notToday_' +post_id,'Y', 1);
                        }

                        $this.closest(".mainModalPop").hide();
                        $wrap.removeClass('modal-open');
                    })

                    function init(){
                        let $list = $mainModalPop;
                        for(let i =0; i<$list.length;i++){
                            let $pop = $list.eq(i);
                            let params = $pop.data("params");
                            let post_id = params.post_id;

                            var cval = $.cookie( "notToday_" + post_id )
                            if(cval == "Y") {} else {
                                $pop.show();
                            }
                        }
                    }
                    init();
                    
                });
            </script>

            
                            
			                
                        
