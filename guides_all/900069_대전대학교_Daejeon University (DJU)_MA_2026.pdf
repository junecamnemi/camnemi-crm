<script type="text/javascript">
	var nowYear = "2026";
	var orgMonth = "9";
	var nowDay = "18";
	var lastDay = "30";
    var sysId = "gdhl";
    var menuId = "3985";
    var mvCnt = 0;
    
    //첫 메인 부르는 메소드
    function scMainAjax (nowYear, nowMonth, action) {
    	nowMonth = parseInt(nowMonth);
    	lastDay = ( new Date( nowYear, nowMonth, 0) ).getDate()

    	if (nowMonth < 10) {
			nowMonth = '0' + nowMonth;
		}
    	
    	var srchDate = nowYear + "/" + nowMonth;
    	var dateFirst = nowYear + "/" + nowMonth +"/01";
		var dateEnmt = nowYear + "/" + nowMonth + "/" + lastDay;
		var dayList = "";
		var stDy = $(".date_right > .date_wrap ul > li").first().text();
		var edDy = $(".date_right > .date_wrap ul > li").last().text();
		var tmpStDy = "";
		var tmpEdDy = "";
		var defDay = 9;
		
		
		if (stDy == "" || action == "") {stDy = 1;}
		if (edDy == "" || action == "") {edDy = 9;}
		
		if (action == "prev") {
			if (mvCnt == 0) {
				return;
			}
			
			if (mvCnt == 3) {
				stDy = stDy - 9;
				edDy = stDy + 8;
			} else {
				stDy = parseInt(stDy) - defDay;
				edDy = parseInt(edDy) - defDay;
			}
			mvCnt--;
		}
		
		if (action == "next") {
			if (mvCnt == 3) {
				return;
			}
			stDy = parseInt(stDy) + defDay;
			edDy = parseInt(edDy) + defDay;
			mvCnt++;
		}
		
		for (var i=stDy; i<=edDy; i++) {
			i = parseInt(i);
			if (i < 10) {
				i = "0" + i;
			}
			
			if (i > lastDay) {
				break;
			}
			
			dayList += "<li><span onClick='javascript:daySel(" + "\"" + srchDate + "\/" + i + "\"," + "\"" + nowMonth + "\"" + ");'";
			//dayList += "<li><a href='javascript:daySel(" + "\"" + srchDate + "\/" + i + "\"" + ");'";
			if (i == nowDay && orgMonth == parseInt(nowMonth)) {
				dayList += "class='daySel today'";
			} else {
				dayList += "class='daySel'";
			}
			dayList += ">" + i + "</span></li>";
		}
		
		$(".date_right ul").html(dayList);
		
    		$.ajax({
			type : "POST",
		datatype : "json",
			data : {
					   sysId : sysId,
					   srchDate : srchDate
			},
			url : "/gdhl/sc/schdul/selectMainSchduList.do",
		 success : function(data){
				var schList = JSON.parse(data);
				var bakHtml = "";
				
				if (schList == null || schList == "") {
					bakHtml = "등록된 일정이 없습니다.";
				}
				
				$.each(schList, function(i, listMap) { 
					//var schdulDt = listMap.totalTime.replace(/2020./gi, "");
					//schdulDt = schdulDt.replace(nowMonth + ".", "");
					//schdulDt = schdulDt.replace(nowMonth + ".", "");
					var schdulDt = listMap.totalTime.substring(8,10);
					bakHtml += "<li>";
					if (menuId == null || menuId == "") {
						bakHtml += "<a href='javascript:'>";
					} else {
						bakHtml += "<a href='/" + sysId + "/sv/schdulView/schdulCalendarView.do?mi=" + menuId + "'>";						
					}
					bakHtml += "<span>" + schdulDt + "</span>";	
					bakHtml += listMap.schdulTitle;
					bakHtml += "</a></li>";
					
				});
				
				$(".sche_list > ul").html(bakHtml);
				
				$(".year").text(nowYear);
				$(".month").text(nowMonth);
				
	   		},
	   		error : function(data){
	   			console.log("관리자에게 문의해주세요.");	
	   		}
		});
    	/*  */
    }
    
	$(document).ready(function(){
		
		//첫 메인에 달력 일정 뿌리기
		scMainAjax (nowYear, orgMonth, "");	
		
	});
	
	$(document).on("click", ".daySel", function(){	
		$(".date_right > .date_wrap > ul > li > span").removeClass("today");
		$(this).addClass("today");	
	});
		
	// 이전 달로 이동
	function sche_prev() {
		var curYear = $(".year").text();
		var curMonth = $(".month").text();

		curMonth = parseInt(curMonth) - 1;

		if (curMonth == 0) {
			curMonth = 12;
			curYear = parseInt(curYear) - 1;
		}
		mvCnt = 0;
		scMainAjax (curYear, curMonth, "");
	}
	
	// 다음 달로 이동
	function sche_next() {
		var curYear = $(".year").text();
		var curMonth = $(".month").text();
		
		curMonth = parseInt(curMonth) + 1;

		if (curMonth == 13) {
			curMonth = 1;
			curYear = parseInt(curYear) + 1;
		}
		mvCnt = 0;
		scMainAjax (curYear, curMonth, "");	
	}
	
	// 
	function schd_prev(action) {
		var curYear = $(".year").text();
		var curMonth = $(".month").text();
		
		scMainAjax (curYear, curMonth, action);
	}
	
	function schd_next(action) {
		var curYear = $(".year").text();
		var curMonth = $(".month").text();
		
		scMainAjax (curYear, curMonth, action);
	}
	
	function daySel(paraDate, nowMonth) {
		//$(".date_right > .date_wrap > ul > li > a").removeClass("on");
		//$(this).addClass("on");
		
		$.ajax({
			type : "POST",
		datatype : "json",
			data : {
					   sysId : sysId,
					   paraDate : paraDate
			},
			url : "/gdhl/sc/schdul/selectMainSchduList.do",
		 	success : function(data){
		 		var schList = JSON.parse(data);
				var bakHtml = "";
				
				if (schList == null || schList == "") {
					bakHtml = "등록된 일정이 없습니다.";
				}
				
				$.each(schList, function(i, listMap) { 
					var schdulDt = listMap.totalTime.replace(/2020./gi, "");
					schdulDt = schdulDt.replace(nowMonth + ".", "");
					schdulDt = schdulDt.replace(nowMonth + ".", "");
					
					bakHtml += "<li>";
					if (menuId == null || menuId == "") {
						bakHtml += "<a href='javascript:'>";
					} else {
						bakHtml += "<a href='/" + sysId + "/sv/schdulView/schdulCalendarView.do?mi=" + menuId + "'>";						
					}
					bakHtml += "<span>" + schdulDt + "</span>";	
					bakHtml += listMap.schdulTitle;
					bakHtml += "</a></li>";
					
				});

				$(".sche_list > ul").html(bakHtml);
		 	},
		 	error : function(data){
	   			console.log("관리자에게 문의해주세요.");	
	   		}
		}); 
	}
</script>
   
