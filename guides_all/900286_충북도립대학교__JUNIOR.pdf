						<script type="text/javascript">
	$(function(){
		$('#subMenu .lm_open').click(function(){
			$('#subMenu ul ul').slideUp();
			$(this).parent().find('ul').slideDown();
			$('#subMenu li').removeClass('on');
			$(this).parent().addClass('on');
			$('.lm_close').hide();
			$(this).siblings('.lm_close').show();
		});
		$('#subMenu .lm_close').click(function(){
			$(this).hide();
			$('#subMenu li').removeClass('on');
			$('#subMenu ul ul').slideUp();
		});
		$('body').click(function(e){
			if(!$(e.target).is('#subMenu .lm_open')) {
				$('#subMenu ul ul').slideUp();
				$('#subMenu li').removeClass('on');
				$('.lm_close').hide();
			}
		});
	});
</script>

