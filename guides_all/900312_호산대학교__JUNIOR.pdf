<script type="text/javascript">
$(function() {
	/* 인풋데이트 */
	var	option = {changeMonth: true, changeYear: true, gotoCurrent:	false, yearRange:'-100:+1', onSelect:function(){
		$(this).prev('input[type="hidden"]').val(this.value.replace(/-/g,""))}
	};
	$.extend(option,$.datepicker.regional['ko']);
	$("input.date_input").datepicker(option).css({'width':'90px','text-align':'center'});
});
</script>

<script type="text/javascript">
//상단 메뉴
$('.header').on('focusin mouseenter', function(){
	$('.subgnb_bg').show().stop().animate({"height":"100px"},{duration:500, easing:"easeInOutQuad"});
});
$('.header').on('focusout mouseleave', function(){
	$('.subgnb_bg').stop().animate({"height":"0px"},{duration:500, easing:"easeInOutQuad", complete:function(){
		$('.subgnb_bg').hide();
	}});
});

</script>


