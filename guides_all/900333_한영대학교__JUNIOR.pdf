    <script type="text/javascript">
        function Host() {
            var Dns;
            Dns = location.href;
            Dns = Dns.split("//");
            Dns = Dns[1].substr(0, Dns[1].indexOf("/"));
            return Dns;
        }

        if (getBrowserinfo() == false) {
            document.location.href = '/browsersupport.html';
        }
        else {
            var Host;
            Host = Host();
            var Url = location.href;
            var ChangeUrl = 'www.hanyeong.ac.kr';

            if (Host.indexOf('localhost') != -1) { }
            else if (Host != ChangeUrl) {
                //document.location.href = Url.replace(Host, ChangeUrl);
            }
        }
    </script>
	<script language="JavaScript" type="text/javascript">
		var host = location.host.toLowerCase();
		var currentAddress = location.href; location.href;
		
		// localhost 가 아닐경우 진행
		if (host.indexOf("localhost") == -1) {
			if (host.indexOf("www") == -1) {
				currentAddress = currentAddress.replace("//", "//www.");
				location.href = currentAddress;
			} else {
				if (window.location.protocol != 'https:') {
					location.href = location.href.replace("http://", "https://");
				}
			}
		}
	</script>
    <script type="text/javascript">
        // Popup 스크립트
        function getCookie(name) {
            var nameOfCookie = name + "=";
            var x = 0;
            while (x <= document.cookie.length) {
                var y = (x + nameOfCookie.length);
                if (document.cookie.substring(x, y) == nameOfCookie) {
                    if ((endOfCookie = document.cookie.indexOf(";", y)) == -1)
                        endOfCookie = document.cookie.length;
                    return unescape(document.cookie.substring(y, endOfCookie));
                }
                x = document.cookie.indexOf(" ", x) + 1;
                if (x == 0)
                    break;
            }
            return "";
        }

        // 쿠키를 만듭니다. 아래 closeWin() 함수에서 호출됩니다
        function setcookie(name, value, expiredays) {
            var todayDate = new Date();
            todayDate.setDate(todayDate.getDate() + expiredays);
            document.cookie = name + "=" + escape(value) + "; path=/; expires=" + todayDate.toGMTString() + ";"
        }

        // 체크후 닫기버튼을 눌렀을때 쿠키를 만들고 창을 닫습니다
        function closePopupLayer(value, cookie) {
            var obj = eval("document.forms[0]." + value + "_yn");
            if (obj.checked) {
                setcookie(value, "done", cookie);  // 오른쪽 숫자는 쿠키를 유지할 기간을 설정합니다
            }

            MM_showHideLayers(value, '', 'hide');
        }

        // 미리보기상태에서 닫기 클릭 이벤트
        function preView_closePopupLayer(value) {
            MM_showHideLayers(value, '', 'hide');
        }
    </script>
