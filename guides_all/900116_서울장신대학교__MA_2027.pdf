<script>

var lastScrollY = 0;
$(function(){
	var diffY = document.documentElement.scrollTop;
	$(window).scroll(function(){
		var diffTop = Math.max(document.documentElement.scrollTop, document.body.scrollTop);
		if (diffY != lastScrollY) {
			percent = .10 * (diffY - lastScrollY);
			if (percent > 0) {
				percent = Math.ceil(percent);
			} else {
				percent = Math.floor(percent);
			}
			diffTop = parseInt($("#divMenu").offset().top) + percent;

			lastScrollY = lastScrollY + percent;
		}
		$("#divMenu").stop();
		$("#divMenu").animate({"top": diffTop + 290, "left": $('#container').offset().left + 1030}, 500);
	});

	$(window).resize(function(){
		var diffTop = Math.max(document.documentElement.scrollTop, document.body.scrollTop);
		if (diffY != lastScrollY) {
			percent = .10 * (diffY - lastScrollY);
			if (percent > 0) {
				percent = Math.ceil(percent);
			} else {
				percent = Math.floor(percent);
			}
			diffTop = parseInt($("#divMenu").offset().top) + percent;

			lastScrollY = lastScrollY + percent;
		}
		$("#divMenu").stop();
		$("#divMenu").animate({"top": diffTop + 290, "left": $('#container').offset().left + 1030}, 0);
	});
});

$(document).ready(function() {
	$("#divMenu").animate({"top": 290, "left": $('#container').offset().left + 1030}, 0);
	$("#divMenu").show();
});

</script></div>

