    $(document).ready(function () {
        // 페이지 로드 시 서브메뉴 모두 숨기기
        $(".linkUl").hide();

        // 클릭, Enter/Space, 포커스 시 서브메뉴 토글
        $(".linkUlA").on("click keydown focus", function (e) {
            if (
                e.type === "click" ||
                (e.type === "keydown" && (e.key === "Enter" || e.key === " ")) ||
                e.type === "focus"
            ) {
                e.preventDefault();

                const $this    = $(this);
                const $submenu = $this.closest("li").find(".linkUl");
                const isVisible = $submenu.is(":visible");

                // 다른 열린 메뉴 모두 닫기
                $(".linkUl").hide();
                $(".linkUlA").attr("aria-expanded", "false");

                if (!isVisible) {
                    $submenu.show();
                    $this.attr("aria-expanded", "true");

                    // 클릭/키조작일 때만 첫 항목으로 포커스 이동
                    if (e.type !== "focus") {
                        setTimeout(function () {
                            $submenu.find("a").first().focus();
                        }, 50);
                    }
                }
            }
        });

        // 서브메뉴 항목에서 ESC 누르면 닫기
        $(".linkUl a").on("keydown", function (e) {
            if (e.key === "Escape") {
                const $submenu = $(this).closest(".linkUl");
                $submenu.hide();
                const $opener = $submenu.closest("li").find(".linkUlA");
                $opener.attr("aria-expanded", "false").focus();
            }
        });

        // li.fsite 내부에 포커스가 완전히 벗어나면 서브메뉴 닫기
        $(".fsite").on("focusout", function () {
            const $li = $(this);
            setTimeout(function () {
                // li 내부에 포커스된 요소가 없으면
                if ($li.find(":focus").length === 0) {
                    $li.find(".linkUl").hide();
                    $li.find(".linkUlA").attr("aria-expanded", "false");
                }
            }, 10);
        });
    });
</script>


