  <script type="text/javascript">
(function () {

    function isSafeReturnUrl(url) {
        if (!url) {
            return false;
        }

        url = String(url).trim();

        // 사이트 내부 상대경로만 허용
        return url.charAt(0) === "/"
            && url.indexOf("//") !== 0
            && url.indexOf("/\\") !== 0
            && url.indexOf("\\") === -1
            && url.indexOf("\r") === -1
            && url.indexOf("\n") === -1
            && !/^\/{0,1}(https?:|javascript:|data:)/i.test(url);
    }

    function getListUrl(form) {
        var returnInput = form.querySelector("[name='returnUrl']");

        /*
         * 페이지가 처음 열렸을 때 저장한 정상 returnUrl
         * 예: /planweb/board/list.9is?boardUid=...
         */
        if (returnInput) {
            var originalUrl = returnInput.getAttribute("data-original-return-url");

            if (isSafeReturnUrl(originalUrl)) {
                return originalUrl;
            }
        }

        /*
         * 현재 returnUrl이 정상적인 내부 주소이면 그대로 사용
         */
        if (returnInput && isSafeReturnUrl(returnInput.value)) {
            return returnInput.value.trim();
        }

        /*
         * 이전 페이지가 같은 사이트의 list.9is이면 사용
         */
        try {
            if (document.referrer) {
                var referrer = new URL(document.referrer);

                if (referrer.origin === location.origin
                        && /\/list\.[^/?]+$/i.test(referrer.pathname)) {
                    return referrer.pathname + referrer.search;
                }
            }
        } catch (e) {
        }

        /*
         * 목록 주소를 못 찾은 경우에만 사이트 메인으로 이동
         */
        return "/index.9is";
    }

    function saveOriginalReturnUrl() {
        var inputs = document.querySelectorAll(
            "form input[name='returnUrl'], form input[name='returnurl']"
        );

        for (var i = 0; i < inputs.length; i++) {
            var input = inputs[i];
            var value = String(input.value || "").trim();

            if (isSafeReturnUrl(value)) {
                input.setAttribute("data-original-return-url", value);
            }
        }
    }

    function validateReturnUrl(form) {
        if (!form) {
            return;
        }

        var returnInput =
            form.querySelector("[name='returnUrl']")
            || form.querySelector("[name='returnurl']");

        if (!returnInput) {
            return;
        }

        var returnUrl = String(returnInput.value || "").trim();

        // 외부 URL이거나 비정상 값일 때만 정상 목록 URL로 교체
        if (!isSafeReturnUrl(returnUrl)) {
            returnInput.value = getListUrl(form);
        }
    }

    /*
     * 일반 submit 처리
     */
    document.addEventListener("submit", function (event) {
        validateReturnUrl(event.target);
    }, true);

    /*
     * form.submit() 직접 호출에도 적용
     */
    var originalSubmit = HTMLFormElement.prototype.submit;

    HTMLFormElement.prototype.submit = function () {
        validateReturnUrl(this);
        originalSubmit.call(this);
    };

    /*
     * 페이지 로딩 시 기존 정상 returnUrl 보관
     */
    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", saveOriginalReturnUrl);
    } else {
        saveOriginalReturnUrl();
    }

})();
</script>
