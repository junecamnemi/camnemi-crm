<script src="/js/pdfobject.min.js"></script>
<style>
#divPdf {min-height: 1125px !important;}
</style>
<script>

var myPDF;

var options = {
    pdfOpenParams: { 
        navpanes: 0,
        toolbar: 0,
        statusbar: 0, 
        view: "FitV",
        pagemode: "none",
        page: 1 
    },
    forcePDFJS: true,
    PDFJS_URL: "/pdfJS/web/viewer.html"
};


$(function(){
  
	myPDF = PDFObject.embed("//admission.seoultech.ac.kr/ajaxfile/CMN_SVC/FileView.do?GBN=X12&SITE_NO=2&MENU_NO=890&CONTENTS_NO=1&TYPE_CODE=C0601", '#pdf', options);
	//myPDF = PDFObject.embed("/pdfJS/001_1.pdf", '#pdf', options);
	

	
	//$("#divPdf").attr("src","/pdfJS/web/viewer.html?file="+encodeURIComponent("//admission.seoultech.ac.kr/ajaxfile/CMN_SVC/FileView.do?GBN=X12&SITE_NO=2&MENU_NO=890&CONTENTS_NO=1&TYPE_CODE=C0601"));
	
	fn_comm_ajax({
        url : "/ajaxf/FR_SVC/getContentsFileIndexList.do",
        data : $("#sendForm").serialize(),
        dataType : "json",
        success : function(data) {
        	if (data.length > 0) {
                for(var i=0 ; i<data.length ; i++){
                	var innerHTML = '';
					innerHTML += '<a href="#" class="btnD Arrow step_menu" onclick="javascript:return false;" data-page="'+data[i].PAGE_NO+'" ><span>'+data[i].INDEX_NM+'</span></a>';
					$("#indexNav").append(innerHTML);
                }
        	}
        }
    });
	
	$(document).on('click', '.step_menu', function(){	
		
		var pageNo = $(this).data('page');
		$('#divPdf').contents().find("#thumbnailView a").eq(pageNo-1).trigger('click'); 
		if($(this).next().children().length == 0){  
			$(this).next().remove();
		}
	    $(this).parent().addClass('selected').siblings().removeClass('selected');
	    
	    return false;
	});

	$(document).on('click', '.pdf_page_btn', function(){
		var pageNo = jQuery(this).data('page');
		$('#divPdf').contents().find("#thumbnailView a").eq(pageNo-1).trigger('click'); 
		return false;
	});
	
	$(document).on("click","a#pdfBtn",function(){
    	location.href="//admission.seoultech.ac.kr/ajaxfile/FR_SVC/FileDownload.do?FILE_ORG_NM="+encodeURI(encodeURIComponent('2026학년도 후기(추가) 대학원 신·편입생 모집요강.pdf'))+"&FILE_NM=202607/1784109874933_0.pdf";
    });
    $(document).on("click","a#pdfFullBtn",function(){
    	window.open("//admission.seoultech.ac.kr/ajaxfile/CMN_SVC/FileView.do?GBN=X12&SITE_NO=2&MENU_NO=890&CONTENTS_NO=1&TYPE_CODE=C0601","_pdf","");
    });
    $(document).on("click","a#hwpBtn",function(){
    	location.href="//admission.seoultech.ac.kr/ajaxfile/FR_SVC/FileDownload.do?FILE_ORG_NM="+encodeURI(encodeURIComponent(''))+"&FILE_NM=";
    });
	
});
</script>

<div class="prom_PDF">  
    <form id="sendForm" method="post">
           <input type="hidden" name="MENU_ID" id="MENU_ID" value="890"/>
           <input type="hidden" name="CONTENTS_NO" value=""/>
           <input type="hidden" name="SITE_NO" value="2"/>
           <input type="hidden" name="CSV_FILE_SEQ" value=""/>
	</form>
	
	<div class="LeftBtn">
		<div class="group1">
			<a href="#none" id="pdfFullBtn" class="btnD fullView"><span>전체화면으로 보기</span></a>
			<a href="#none" id="pdfBtn" class="btnD fileDown"><span>PDF 다운로드</span></a>
			
			<a href="https://get.adobe.com/kr/reader/" target="_blank" class="btnD PDFView"><span>PDF뷰어 다운로드</span></a>
		</div>
		<div class="group2" id="indexNav">
		</div>
	</div>
	<div class="PDF_View" id="pdf">
	</div>
	
	
</div>


