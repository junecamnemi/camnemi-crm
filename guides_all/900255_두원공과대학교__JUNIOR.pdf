	$('.top_popup_close > button').on('click', function(e) {
		e.preventDefault();
//		$('.top_popup_item').slideUp();
		$('.top_popup_item').hide();
		$("#slider13").slick('unslick');
		$('body').removeClass('popupOn');
	});

