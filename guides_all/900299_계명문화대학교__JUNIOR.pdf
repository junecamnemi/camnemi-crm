		rsLeftmn  = $(".rspn-leftmenu .over .depth3");
		stdClass = "stdNode";
		schkeyParentStr = ".rspn-leftmenu .over .depth3 .owl-stage";


		if ( $(".lm_l3",rsLeftmn).length > 3 ) {
			rsLeftmn.owlCarousel({
				items : 5
				,startPosition : rsLeftsPos
				,loop : false
				,nav : true
				,dots : false
				,dotsEach : false
				,autoplay : false
				,autoplayTimeout : 4000
				,smartSpeed : 1100
				,autoplayHoverPause : false	//재생/정지버튼 넣을때는 이 옵션 false로, 마우스 인/아웃 이벤트 충돌로 재생/정지 버튼 액션 꼬일수 있음,
				,responsiveClass : true
				,responsive : {
					0:{items : 2},
					410:{items : 2},
					800:{items : 4},
					1000:{items : 5}
				}
				,onInitialized : onInit
				//,onRefreshed : callback
				//,dragged : callback
			});
			function onInit() {
				$(".owl-item.active", rsLeftmn).addClass( stdClass );	// 슬라이도 구동시점에서 active 위치에 stdNode 클래스 셋팅.
			}
			$dirBtn = $(".rspn-leftmenu .owl-nav button");
			$dirBtn.on("click", function() {
				$directionBtn = $(this);
				if ( $directionBtn.hasClass("owl-prev") )		$flag = "P";	// 이전버튼(Prev) 클릭시.
				else if ( $directionBtn.hasClass("owl-next") )	$flag = "N";	// 다음버튼(Next) 클릭시.
				detectPos( $flag );	// 방향버튼으로 stdNode 클래스가 active로 이동하기 직전의 위치(처음/마지막)를 구함.
				setTimeout(
					function() {
						detectEdge( $flag );	// 이동이후의 위치 추출후 stdNode 클래스를 active 위치로 셋팅.
					}
				,200 );	// 시차 설정.
			});
			function detectPos( flag ) {
				$thisNode = $(".owl-item.active." + stdClass , $(schkeyParentStr) );
				$alertString = " 메뉴가 없습니다.";
				if ( flag == "P" )  {
					if ( $thisNode.is(":first-child") ) {
						//console.log( "first" );
						$alertMsg = "이전" + $alertString;
						alert( $alertMsg );
					} else {
						//console.log( "Not first" );
					}
				} else if ( flag == "N" )  {
					if ( $thisNode.is(":last-child") ) {
						//console.log( "last" );
						$alertMsg = "다음" + $alertString;
						alert( $alertMsg );
					} else {
						//console.log( "Not last" );
					}
				}
			}
			function detectEdge( flag ) {
				$schKeyEle = $(".owl-item.active" , $(schkeyParentStr) );
				$(".owl-item" , $(schkeyParentStr) ).removeClass( stdClass );
				$schKeyEle.addClass( stdClass );	// stdClass 클래스로 재셋팅.
			}
		}
	});
</script>
