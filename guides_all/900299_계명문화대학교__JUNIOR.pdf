						<script>
							$(document).ready(function(){
								$(".fsitelink").each(function(){
									$(".tit a",this).click(function(){
										var gr = $($(this).parents(".fsitelink").get(0));
										var toH = $("ul",gr).outerHeight();
										if(gr.hasClass("is-open")){
											gr.removeClass("is-open");
										}
										else {
											gr.addClass("is-open");
										}
										return false;
									});
								});
							});
							$(window).on("load",function(){
								if ( util.isPC() ) {
									$(".fsitelink-cate-box .inwr").mCustomScrollbar({
										theme : "minimal-light"
									});
								}
							});

							$(function() {
								$filterNode = $("#footer-wr .fsitelink-wr .fsitelink .fsitelink-cate-box li");
								$filterNode.each(function() {
									if ( $("a", $(this) ).attr("href").indexOf("/_Popup/") >= 1 ) {
										$extraNode = $("a", $(this) );
										$extraHref = $extraNode.attr("href");
										//console.log( "$extraHref : " + $extraHref );
										$extraNode.attr({ "href":"#n", "onclick":"pop_win2('" + $extraHref + "', '', 800, 900); return false;" });
									}
								});
							});
						</script>
					</div>
					<a href="#doc" class="topBt pc"><span class="blind">본문 상단으로 이동</span><em>TOP</em></a>
				</div>
			</div>
		</div>
	</div>
</div></footer>

