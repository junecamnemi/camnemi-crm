<script>
	var _sso_enabled = 'true';
	_sso_enabled = _sso_enabled == 'true';
	
	function _login() {
		if (_sso_enabled) {
			_sso_login();
		} else {
			location.href = 'https://grad.dankook.ac.kr/c/portal/login?p_l_id=2553';
		}
	}
	
	function _logout() {
		if (_sso_enabled) {
			_sso_logout();
		} else {
			location.href = '/c/portal/logout';
		}
	}
</script>


