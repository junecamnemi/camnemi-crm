					headerContent: "<h3>\ube44\ubc00\ubc88\ud638\ub97c\u0020\uc785\ub825\ud558\uc2ed\uc2dc\uc624\u002e</h3>",
					modal: true,
					render: '#_dku_bbs_web_BbsPortlet_modal',
