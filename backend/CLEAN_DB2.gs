  Logger.log('Stay: '+chk.filter(function(c){return c.pipe==='korea'&&c.stage==='stay';}).length+' Welcome: '+chk.filter(function(c){return c.pipe==='korea'&&c.stage==='welcome';}).length);
  return chk.length;
}