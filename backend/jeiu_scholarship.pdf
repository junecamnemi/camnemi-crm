    <script>
        function makeH3(){
            if($('.pdf-wrap .tab-tit li').length >= 1){
                var htmlH3 = '<h3 id="newH3" class="blind">';
                    htmlH3 += $('.pdf-wrap .tab-tit li').eq(0).find('a').text();
                    htmlH3 += '</h3>'
                $('.pdf-view').before(htmlH3);
            }
            $('.pdf-wrap .tab-tit li a').on('click',function(){
                var newText = $(this).text();
                $('#newH3').text(newText);
            });
        }
    </script>
    <script type="text/javascript">
    	window.onload = function(){
    		setTimeout(function(){
    			goToPage(1);	
                $(".tab-tit li").eq(0).find("a").attr("title","선택됨");
                makeH3();
    		}, 1000);
    	}
   	</script>
    
