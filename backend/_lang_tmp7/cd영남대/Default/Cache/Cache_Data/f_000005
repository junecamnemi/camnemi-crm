@charset "utf-8";

/* 언어 선택 */
.g-lang-box{position:relative;}
.g-lang-box .google_translate_element{display:none;}
.g-lang-box .g-lang-btn{display:flex;align-items:center;}
.g-lang-box .g-lang-btn:before{content:'';display:inline-block;margin:0 5px 0 0;width:20px;height:20px;background:url(/_res/yu/_share/img/common/icon-lang.png
) no-repeat 0 0 / 100%;vertical-align:middle;}
.g-lang-box .g-lang-btn:after{content:'';display:inline-block;width:15px;height:14px;background:#222;mask:url(data:image/png;base64,) no-repeat 0 0 / 100%;vertical-align:middle;transition:all 0.2s;}
.g-lang-box .g-lang-btn.on:after{transform:rotate(180deg);}
.g-lang-box .g-lang-btn span{padding:0 8px 0 4px;font-size:0.875rem;line-height:1rem;color:#222;}
.g-lang-box .translation-links{display:none;position:absolute;top:calc(100% + 12px);left:50%;z-index:100;padding:10px;width:145px;border:1px solid #ddd;background-color:#fff;box-sizing:border-box;transform:translateX(-50%);}
.g-lang-box .translation-links.on{display:block;opacity:1;transform:translateX(-50%) translateY(0);}
.g-lang-box .translation-links li{margin-bottom:10px;}
.g-lang-box .translation-links li:last-of-type{margin-bottom:0;}
.g-lang-box .translation-links li a{display:flex;align-items:center;font-size:0;text-align:left;}
.g-lang-box .translation-links li a.ko{padding:0;} /* 메인 콘텐츠 클래스 충돌 해결 */
.g-lang-box .translation-links li a:before{content:'';display:inline-block;width:18px;height:14px;margin-right:5px;background-repeat:no-repeat;background-size:100%;background-position:center;vertical-align:middle;}
.g-lang-box .translation-links li a.es:before{background-image:url("data:image/svg+xml;base64,");}
.g-lang-box .translation-links li a.fr:before{background-image:url("data:image/svg+xml;base64,");}
.g-lang-box .translation-links li a.ja:before{background-image:url("data:image/svg+xml;base64,");}
.g-lang-box .translation-links li a.ko:before{background-image:url("data:image/svg+xml;base64,");}
.g-lang-box .translation-links li a.mn:before{background-image:url("data:image/svg+xml;base64,");}
.g-lang-box .translation-links li a.us:before{background-image:url("data:image/svg+xml;base64,");}
.g-lang-box .translation-links li a.uz:before{background-image:url("data:image/svg+xml;base64,");}
.g-lang-box .translation-links li a.vi:before{background-image:url("data:image/svg+xml;base64,");}
.g-lang-box .translation-links li a.zh:before{background-image:url("data:image/svg+xml;base64,");}
.g-lang-box .translation-links li a span{display:inline-block;padding:0;width:calc(100% - 35px);font-size:0.8rem;line-height:1;color:#333;vertical-align:middle;}
.others-menu{position:relative;}
.others-menu > .others{position:relative;margin:8px 0 0;padding:8px 0 0;border-top:1px solid #ddd;text-align:center;}

/* 모달 */
.g-modal-backdrop{display:none;position:absolute;top:40px;right:0;z-index:1000;}
.g-modal-backdrop.on{display:block;}
.g-modal{width:300px;background-color:#fff;border-radius:5px;padding:15px;z-index:1000;box-shadow:0 3px 10px rgba(0, 0, 0, 0.3);}
.g-modal-content{margin-bottom:20px;}
.g-lang-box .g-modal-content p{font-size:0.8rem;line-height:1.6;color:#333;margin-bottom:10px;}
.g-lang-box .g-modal-content a{display:inline-block;font-size:0.8rem;line-height:1.6;color:#0d3f7a;font-weight:bold;text-decoration:underline;}
.g-modal-footer{text-align:center;}
.g-modal-footer button{padding:8px 20px;background-color:#0d3f7a;color:#fff;border-radius:4px;font-size:0.8rem;cursor:pointer;}

/* 기존 UI 숨김처리 */
.g-submenu{display:none;}
.translated-ltr body{top:0 !important;}
.skiptranslate>iframe{display:none;}

/* 헤더 깨짐 현상 방지 */
.header-box .logo{flex-shrink:0;margin:0 25px 0 0;}
.util-box{flex-shrink:0;}

@media screen and (max-width: 1024.98px) {
	/* 언어 선택 */
	.g-lang-box{display:flex;justify-content:center;}
}

@media screen and (max-width: 768px) {
	/* 언어 선택 */
	.g-lang-box .g-lang-btn{padding:0;}
	.g-lang-box .g-lang-btn:after{background:#fff;}
	.g-lang-box .g-lang-btn span{display:none;color:#fff;}	
	
	.g-lang-box .translation-links{top:calc(100% + 3px);}
	
	/* 불필요한 상속 CSS 해제 */
	.g-lang-box .translation-links li{display:block;margin-right:0;padding:0;}
	.g-lang-box .translation-links li:after{display:none;}
	.g-lang-box .g-submenu{float:none;width:auto;}
	
	/* 모달 */
	.g-modal-backdrop{position:fixed;top:100px;left:50%;right:unset;transform:translateX(-50%);}
}