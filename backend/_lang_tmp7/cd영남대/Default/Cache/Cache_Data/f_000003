<script>
	$(document).ready(function () {
		//-----------------------------------------------------------------------------------------
		// 실행 오브젝트 목록
		//-----------------------------------------------------------------------------------------
		GoogleTranslateUI.init();
	});
	
	// 뒤로/앞으로 가기 복원 시 재실행
	window.addEventListener('pageshow', function(event) {
		if (event.persisted) {
			removeTranslateScript();
			insertTranslateScript();
		}
	});

	//======================================================================
	//  구글 번역 UI 모듈
	//======================================================================

	//pc
	function initializeGoogleTranslate() {
		new google.translate.TranslateElement({
			pageLanguage: 'ko',
			autoDisplay: false,
			includedLanguages: 'ko,en,zh-CN,ja,vi,mn,uz,fr,es',
		}, 'google_translate_element');
	}
	
	//실행부
	function googleTranslateElementInit() {
		initializeGoogleTranslate();
		initializeGoogleTranslateMobile();
	}
	
	//모바일
	function initializeGoogleTranslateMobile() {
		new google.translate.TranslateElement({
			pageLanguage: 'ko',
			autoDisplay: false,
			includedLanguages: 'ko,en,zh-CN,ja,vi,mn,uz,fr,es',
		}, 'google_translate_element_mobile');
	}
	
	//스크립트 제거
	function removeTranslateScript() {
	  const old = document.querySelector('script[src*="translate_a/element.js"]');
	  if (old) old.parentNode.removeChild(old);
	}
	
	//스크립트 재생성
	function insertTranslateScript() {
	  const script = document.createElement('script');
	  script.defer = true;
	  script.src = 'https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit';
	  document.head.appendChild(script);
	}

	
	var GoogleTranslateUI = {
		init: function () {
			this.bindUI();
			this.bindModalEvents();
			this.bindOthersMenu();
			this.bindLanguageSelector();

			// 초기화 시 모든 드롭다운 닫기
			$('.g-lang-box .translation-links').removeClass('on');
			$('.g-lang-btn').removeClass('on');
			$('.g-modal-backdrop').removeClass('on');
			$('.g-submenu').removeClass('on');
		},

		bindUI: function () {
			// 언어 버튼 클릭 시 처리
			$(document).on('click', '.g-lang-btn', function (e) {
				e.preventDefault();
				e.stopPropagation();

				const $btn = $(this);
				const $ul = $('.g-lang-box .translation-links');

				// 언어 목록이 열려있는 경우
				if ($ul.is(':visible')) {
					$ul.slideUp(300);
					$btn.removeClass('on');
				} else {
					// 닫혀있는 경우 모달 표시
					$('.g-modal-backdrop').addClass('on');
				}
			});

			// 외부 클릭 시 언어 목록 닫기
			$(document).on('click', function (e) {
				if (!$(e.target).closest('.g-lang-box').length &&
					!$(e.target).closest('.g-modal').length) {
					$('.g-lang-box .translation-links').slideUp(300);
					$('.g-lang-btn').removeClass('on');
					$('.g-submenu').slideUp(200);
					$('.g-modal-backdrop').removeClass('on');

					// Others 버튼 다시 표시
					setTimeout(function () {
						$('a.others').show();
					}, 200);
				}
			});
		},

		bindModalEvents: function () {
			// 모달 OK 버튼 클릭 시
			$(document).on('click', '.g-modal-ok', function (e) {
				e.preventDefault();
				$('.g-modal-backdrop').removeClass('on');

				// setTimeout을 사용하여 DOM 업데이트가 완료된 후 실행
				setTimeout(function () {
					const $btn = $('.g-lang-btn');
					const $ul = $('.g-lang-box .translation-links');
					$btn.addClass('on');
					$ul.slideDown(300);
				}, 100);
			});

			// 영문 웹사이트 링크 클릭 시 모달은 닫음
			$(document).on('click', '.eng-website', function () {
				$('.g-modal-backdrop').removeClass('on');
			});
		},

		bindOthersMenu: function () {
			// Others 클릭 시 서브메뉴 토글
			$(document).on('click', 'a.others', function (e) {
				e.preventDefault();
				e.stopPropagation();
				const $this = $(this);
				const $submenu = $this.next('.g-submenu');

				// 서브메뉴 표시하고 Others 버튼 숨기기
				$this.hide();
				$submenu.slideDown(200);

				// 외부 클릭 시 or 언어 선택 시 다시 원래대로
				$(document).one('click', function (event) {
					if (!$(event.target).closest('.g-submenu').length) {
						$submenu.slideUp(200, function () {
							$this.show();
						});
					}
				});
			});
		},

		bindLanguageSelector: function () {
			document.querySelectorAll('.translation-links a[data-lang]').forEach(function (el) {
				el.addEventListener('click', function (event) {
					event.preventDefault();
					const toLang = el.getAttribute('data-lang');
					const gtCombo = document.querySelector('.goog-te-combo');

					if (!gtCombo) {
						alert("Error: Google Translate selector not found.");
						return;
					}

					// 언어 선택 후 메뉴 닫기
					$('.g-lang-box .translation-links').slideUp(300);
					$('.g-lang-btn').removeClass('on');

					// Others 서브메뉴 닫고 Others 버튼 다시 표시
					$('.g-submenu').slideUp(200);
					setTimeout(function () {
						$('a.others').show();
					}, 200);

					function setLanguage() {
						gtCombo.value = toLang;
						gtCombo.dispatchEvent(new Event('change'));

						if (gtCombo.value !== toLang) {
							setTimeout(setLanguage, 100);
						}
					}

					setLanguage();
				});
			});
		}
	};
</script>
