/* 챗봇 스크립트가 강제로 생성하는 이너 박스나 버튼 스타일 조정 */
.tol-chatbot div, 
.tol-chatbot button, 
.tol-chatbot iframe {
    position: absolute !important;
    bottom: 0 !important;
    right: 0 !important;
    margin: 0 !important;
}

/* 이미지에서 보이던 정체불명의 흰색 원형 배경 제거 및 위치 고정 */
.tol-chatbot .shadow-xl, 
.tol-chatbot [class*="bg-white"] {
    background-color: transparent !important;
    box-shadow: none !important;
}
