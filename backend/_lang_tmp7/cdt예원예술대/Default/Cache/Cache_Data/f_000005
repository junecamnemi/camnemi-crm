/* lnb */
#lnb {
	display: inline-block;
	zoom: 1;
	font-size: 14px;
}

#lnb:after {
	display: block;
	clear: both;
	content: '';
}

#lnb>.lnb_area {
	float: left;
	position: relative;
	width: auto;
	height: auto;
	z-index: 1;
	min-width: 150px;
	height: 60px;
	line-height: 60px;
	position: relative;
}

#lnb>.lnb_area:after {
	content: '';
