	}
	$(".link-copy-box a").text(a);
	$(".link-copy-box a").click(function(){
		cp(a);
		alert("주소가 복사되었습니다.");
		return false;
	});

	$(".btn-srch").click(function(){
		window.setTimeout(function(){
