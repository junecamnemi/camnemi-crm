// 레이어 팝업 웹 접근성 준수 (포커스 이동)
function openLayerPopup(selector, returnElement) {
	//$(selector).before('<div class="popup-layer-mask"></div>');
	//$(selector).find(':last').addClass('last');
	//$(selector).append('<a href="#" class="return"></a>');
