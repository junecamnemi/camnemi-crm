// 접근성 준수 (25/02/13 추가)
function closeLayerPopup(selector){
	var returnElement = $('.returnBtn');
	//openLayerPopup으로 적용한 부분 초기화
	$(selector).removeAttr('tabindex');
	if($('.popup-layer-first-child')){
		$('.popup-layer-first-child').removeClass('popup-layer-first-child');
	}
	if($('.popup-layer-last-child')){
		$('.popup-layer-last-child').removeClass('popup-layer-last-child');
	}

	//팝업 버튼으로 초점 회귀
	returnElement.attr('tabindex', 0).focus();
	returnElement.removeAttr('tabindex');
	returnElement.removeClass('returnBtn');
}

