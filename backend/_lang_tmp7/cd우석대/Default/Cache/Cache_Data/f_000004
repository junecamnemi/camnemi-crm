	/* content: ""; */
	/* opacity: 0.3; */
	/* -webkit-transition: opacity 0.3s cubic-bezier(0, 0, 0.25, 1), visibility 0s cubic-bezier(0, 0, 0.25, 1); */
}
.Mainbg .slick-arrow:hover::before {

	opacity: 1;
}
.Mainbg .slick-arrow.slick-prev {
	left: 58px;
