/* 폭은 .haks 의 margin-left(455px)와 맞춘다 — 어긋나면 float 이 잡는 영역과 슬라이더 시작점이
   달라져 나중에 레이아웃이 꼬인다. 실제 제목 이미지는 364px 라 455px 안에 들어온다. */
.hakt{width:455px;color:#fff;float:left;}
.haktits{font-size:30px;}
