/* ==============================
   a11y 슬라이더 컨트롤 (2026-07-19)
============================== */
.swiper-autoplay-toggle{position:absolute;z-index:10;width:36px;height:36px;border:1px solid rgba(0,0,0,.25);border-radius:50%;background:rgba(255,255,255,.9);cursor:pointer;padding:0;}
.swiper-autoplay-toggle::before,.swiper-autoplay-toggle::after{content:'';position:absolute;top:50%;transform:translateY(-50%);width:3px;height:12px;background:#333;}
.swiper-autoplay-toggle::before{left:13px;}
.swiper-autoplay-toggle::after{right:13px;}
.swiper-autoplay-toggle.is-paused::before{left:14px;width:0;height:0;background:none;border-left:11px solid #333;border-top:7px solid transparent;border-bottom:7px solid transparent;}
.swiper-autoplay-toggle.is-paused::after{display:none;}
/* Now bottom — 스크롤바와 이전/다음을 한 래퍼로 묶어 세로 가운데 정렬 */
.now-bottom{position:absolute;left:1%;right:1%;bottom:6px;z-index:50;display:flex;align-items:center;gap:10px;}
.now-bottom .swiper-scrollbar{position:relative;left:auto;bottom:auto;flex:1;width:auto;height:5px;opacity:1 !important;}
.now-controls{position:relative;right:auto;bottom:auto;display:flex;align-items:center;gap:10px;z-index:11;}
.now-toggle{position:relative;top:auto;right:auto;}
.swiper-now-prev,.swiper-now-next{box-sizing:border-box;position:relative;top:auto;right:auto;width:36px;height:36px;margin:0;left:auto;border:1px solid rgba(0,0,0,.25);border-radius:50%;background:rgba(255,255,255,.9);cursor:pointer;z-index:10;}
.swiper-now-prev::after,.swiper-now-next::after{display:none;}
.swiper-now-prev::before,.swiper-now-next::before{content:'';position:absolute;top:50%;left:50%;width:9px;height:9px;border-top:2px solid #333;border-right:2px solid #333;}
.swiper-now-prev::before{transform:translate(-30%,-50%) rotate(-135deg);}
.swiper-now-next::before{transform:translate(-70%,-50%) rotate(45deg);}
.haks .hak-toggle{width:72px;height:72px;border:none;border-radius:0;background:#202A4E;border-radius:50%}
.haks .hak-toggle::before{left:28px;width:4px;height:20px;background:#fff;}
.haks .hak-toggle::after{right:28px;width:4px;height:20px;background:#fff;}
.haks .hak-toggle.is-paused::before{left:30px;width:0;height:0;background:none;border-left:14px solid #fff;border-top:9px solid transparent;border-bottom:9px solid transparent;}
.popimg .pop-toggle{position:relative;right:auto;top:auto;}
.pro-bottom,.pop-bottom{display:flex;align-items:center;justify-content:center;gap:16px;margin-top:16px;}
.pro-bottom .pro-pagination,.pop-bottom .pop-pagination{position:static;width:auto;margin:0;}
/* 접근성(2026-08-05, 결과서 p34 · 검사항목 8-3): 비활성 불릿 #c5c5c5 는 섹션 배경 #eef3ff 위에서 1.55:1(결과서 1.5 재현)이었다. #666666 = 5.17:1.
   ⚠️ 여기에 !important 를 붙이지 마라 — 이 셀렉터는 (0,2,0) 이고 활성 규칙 336행은 !important 지만 (0,1,0) 이라,
      !important 를 붙이면 여기가 이겨서 활성 알약까지 회색이 된다(라이브에서 재현 확인). 값만 바꾼다. */
.pro-bottom .swiper-pagination-bullet{margin:0 4px;opacity:1;background:#666666} /* 래퍼로 감싸며 풀린 스와이퍼 기본 간격(직계 자식 셀렉터) 복원 */
.pro-controls,.pop-controls{display:flex;gap:4px;}
.pro-button-prev,.pro-button-next,.pop-button-prev,.pop-button-next{box-sizing:border-box;position:relative;top:auto;left:auto;right:auto;width:36px;height:36px;background:rgba(255,255,255,.9);border:1px solid rgba(0,0,0,.25);border-radius:50%;cursor:pointer;z-index:10;}
.pro-button-prev::before,.pro-button-next::before,.pop-button-prev::before,.pop-button-next::before{content:'';position:absolute;top:50%;left:50%;width:9px;height:9px;border-top:2px solid #333;border-right:2px solid #333;}
.pro-button-prev::before,.pop-button-prev::before{transform:translate(-30%,-50%) rotate(-135deg);}
.pro-button-next::before,.pop-button-next::before{transform:translate(-70%,-50%) rotate(45deg);}
.pro-toggle{position:relative;left:auto;top:auto;}
.medswiper .swiper-autoplay-toggle,.baswiper .swiper-autoplay-toggle{left:auto;top:347px;bottom:auto;right:10px;}
.sns-controls{display:flex;gap:10px;margin-top:24px;}
.sns-nav{position:relative;z-index:10;width:36px;height:36px;border:1px solid rgba(0,0,0,.25);border-radius:50%;background:rgba(255,255,255,.9);cursor:pointer;padding:0;}
.sns-nav::before{content:'';position:absolute;top:50%;left:50%;width:9px;height:9px;border-top:2px solid #333;border-right:2px solid #333;}
.sns-nav-prev::before{transform:translate(-30%,-50%) rotate(-135deg);}
.sns-nav-next::before{transform:translate(-70%,-50%) rotate(45deg);}
/* A11Y: 첫/마지막 슬라이드에서 비활성 표시 — Swiper 기본(.swiper-button-disabled)과 같은 값으로 맞춘다 */
/* 접근성(2026-08-05, 결과서 p33 · 검사항목 8-3): opacity:.35 때문에 비활성 화살표가 사진 배경 위에서 2.56:1(결과서 2.3) 이었다.
   밝기를 낮추는 방식 자체를 뺀다 → 10.90:1. 비활성 구분은 아래 1008행의 점선 테두리가 이미 하고 있어(5.3.1 대응으로 넣은 것) 단서는 유지된다.
   ※ 첫 슬라이드에서 prev 가 항상 비활성이라 페이지를 열면 바로 보이는 자리다. */
.sns-nav[aria-disabled="true"]{pointer-events:none;}
@media only all and (max-width:1200px){
	.medswiper .swiper-autoplay-toggle,.baswiper .swiper-autoplay-toggle{top:10px;} /* acbox 100% 구간 — 카드 높이 가변이라 하단(347px) 대신 상단 고정 */
}
@media only all and (max-width:720px){
	.swiper-autoplay-toggle,.sns-nav,.swiper-now-prev,.swiper-now-next,.pro-button-prev,.pro-button-next,.pop-button-prev,.pop-button-next{width:28px;height:28px;}
	.swiper-autoplay-toggle::before{left:10px;height:10px;}
	.swiper-autoplay-toggle::after{right:10px;height:10px;}
	.swiper-autoplay-toggle.is-paused::before{left:11px;border-left:9px solid #333;border-top:6px solid transparent;border-bottom:6px solid transparent;}
	.sns-nav::before,.swiper-now-prev::before,.swiper-now-next::before,.pro-button-prev::before,.pro-button-next::before,.pop-button-prev::before,.pop-button-next::before{width:8px;height:8px;}
	/* A11Y: 뉴스우석 이전/다음 되살리기 — 위 814·815행 `#section5 .swiper-button-prev/next{display:none}`(개발사 기존 규칙)이
	   같은 클래스를 쓰는 뉴스우석 버튼까지 숨겨, 720px 이하에서 키보드로 슬라이드를 넘길 수단이 사라졌다(6.1.1).
	   슬라이드는 넘어가는 상태(isLocked=false)인데 버튼만 없던 것. 동일 특이도라 뒤에 선언해 되살린다. */
	#section5 .swiper-now-prev,#section5 .swiper-now-next{display:flex;}
	/* 모바일에서 상단 슬라이드와 겹치던 것 해소 — .now-bottom 이 absolute+bottom 이라 margin-top 은 무효라서,
	   같은 크기(16px)의 간격을 슬라이더 하단 패딩으로 만든다(기존 20px + 16px). 실측 간격 14px·겹침 -13px */
	#section5 .nowswiper{padding-bottom:36px !important;}
}

/* ==============================
   비활성 화살표 표시 (A11Y)
============================== */
/* 접근성(5.3.1 색에 무관한 콘텐츠 인식 — 6-2 활성/비활성을 색으로만 구분 금지):
   비활성 화살표가 swiper.css 의 opacity:.35 하나로만 구분돼 있었다(= 명도/색 차이뿐).
   비활성일 때만 점선 테두리를 줘 선 종류로도 구분되게 한다(활성=실선 또는 무테, 비활성=점선).
   ※ box-sizing 을 함께 지정해 테두리가 굵어져도 버튼 크기가 변하지 않게 한다. */
.swiper-button-disabled,.sns-nav[aria-disabled="true"]{box-sizing:border-box;border:2px dashed #333;border-radius:50%;}
/* 우석PRIDE 화살표만 파란 배경(#1b5bb2) 위에 얹힌 투명 버튼이라 검정 점선이 묻힌다 — 흰 점선으로 */
.hak-controls .swiper-button-disabled{border-color:#fff;}

/* ==============================
   헤더 스크림 (A11Y 명도대비)
============================== */
/* 접근성(5.3.2 명도대비): 상단 유틸(.toplink)·GNB 흰 글자가 메인 비주얼 사진 위에 얹혀 있어
   밝은 슬라이드에서 3.1~4.5:1 로 기준 미달이었다(픽셀 실측). 슬라이드가 돌면 값도 계속 변한다.
   히어로 전체를 어둡게 하지 않고 헤더가 놓이는 위쪽 띠에만 그라디언트를 깔아 대비를 확보한다.
   ※ .mv::before 로는 안 된다 — 슬라이더가 자체 스택 컨텍스트를 만들어 스크림이 슬라이드 아래로 깔린다.
   ※ 이 파일은 메인에서만 로드되므로 서브에는 영향이 없다(서브는 .subg 딤으로 해결). */
.topnav{background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.42));}
.header:not(.navbar-fixed-top, .on){background: linear-gradient(rgba(0,0,0,0.42), rgba(0,0,0,0));}
