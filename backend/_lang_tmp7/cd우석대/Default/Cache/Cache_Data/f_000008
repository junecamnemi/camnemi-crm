/* reset */
*{padding:0;margin:0;-webkit-text-size-adjust:none;}

body, div, dl, dt, dd, ul, ol, li, h1, h2, h3, h4, h5, h6, pre, code, form, fieldset, legend, p, blockquote, th, td{margin:0;padding:0;}
article, aside, details, figcaption, figure, footer, header, hgroup, main, nav, section, summary{display:block;}
fieldset, img{border:0 none;vertical-align:middle;}
dl, ul, ol, menu, li{list-style:none;list-style-type:none;}
ul:after, ol:after{display:block;height:0;content:"";float:none;clear:both;}

blockquote, q{quotes:none;}
blockquote:before,
blockquote:after,
q:before,
q:after{content:'';content:none;}

address, caption, cite, code, dfn, em, var{font-style:normal;}

a{color:inherit;text-decoration:none;background:transparent;}
a:focus,
a:active,
a:hover{text-decoration:none;}

table{border-collapse:collapse;border-spacing:0;width:100%;}
th, td{padding:0;word-break:break-all;}
img{border:0 none;vertical-align:middle;max-width:100%;}
legend, .blind{overflow:hidden;position:absolute;top:0;left:0;width:1px;height:1px;font-size:0;line-height:100px;white-space:nowrap;}

.clear:after{content:'';display:block;clear:both;}
.hide{overflow:hidden;position:absolute;left:-9999px;width:0 !important;height:0 !important;font-size:0 !important;line-height:0 !important;margin:0 !important;padding:0 !important;}
.skip, .blind{position:absolute;width:1px;height:1px;margin:0;padding:0;background:none;font-size:3px;color:transparent;line-height:0;}
/* left/top 을 0·2px 이 아니라 6px 로 띄운 것은 포커스 링이 화면 밖으로 잘리지 않게 하기 위함이다. */
#skipNavi a{display:inline-block;position:fixed;left:6px;top:-9999px;padding:10px 30px;font-size:15px;color:#fff;background:#1a1a1a;z-index:99999;}
#skipNavi a:focus-visible{top:6px;outline-style:dashed;outline-width:2px;outline-color:#ff0000;outline-offset:2px;box-shadow:none;}
/* 링 억제는 폴백용 빈 div(tabindex=-1)에만 — id 가 실제 초점 요소로 옮겨가면 그 링을 죽이면 안 된다 */
#contentBody[tabindex="-1"]{outline:none;box-shadow:none;}
.visually-hidden{position:absolute; width:1px; height:1px; margin:-1px; padding:0; overflow: hidden; clip:rect(0,0,0,0); white-space: nowrap; border:0;}

img[usemap]{ width: 100%;  height:auto; display: block;}

a, input, textarea, select, button{/*outline:none;*/}
/* 접근성(6.1.2 초점 이동과 표시): 브라우저 기본 링만으로는 포커스가 안 보이는 곳이 있어 전역 지정.
   어두운 배경(.allMenu 등)은 아래에서 흰색으로 개별 재정의한다. */
a:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible, video:focus-visible, [tabindex]:focus-visible{outline:3px solid #fff;outline-offset:0;box-shadow:0 0 0 6px #ff0000;}
/* ── 안쪽 링(in)을 써야 하는 곳 ──────────────────────────────
   조상에 overflow:hidden 이 걸려 있고 요소가 그 안쪽 여백 없이 가장자리에 닿아 있어,
   바깥쪽 링(offset +2px)이 잘리는 영역들. 브라우저 실측 + CSS 정적분석으로 수집했다.
   새로 발견되면 이 목록에 추가한다. offset 만 덮어쓰므로 색·두께는 전역 규칙을 상속한다.
     .toplink   상단 고정바(50px)를 line-height:47px 로 꽉 채움 + 화면 맨 위라 뷰포트로도 잘림
     .bzone     .bzonew/.bzone 둘 다 overflow:hidden 인데 .bzone 엔 패딩이 없음
     .policybox 푸터 정책링크. ul 이 overflow:hidden, li{flex:1} 이라 빈틈이 없음 (전 페이지 48회)
     .footlogo  .footaddress .inner 가 overflow:hidden
     .third-menu / .fourth-menu / .prenav  서브 좌측·상단 메뉴. 셋 다 패딩 0 + a 가 li 를 꽉 채움
     .gallerybox_page_list  게시판 갤러리. a 에 인라인 width/height 로 박스와 동일 크기 지정
     .tab_container  메인 소식 탭
     .swiper-container / .swiper  슬라이더는 구조상 항상 overflow:hidden 이다
     #tab1 / .popimg  공지 슬라이더·팝업의 컨트롤 줄이 컨테이너 아래 경계에 붙어 있음
     #hamburger 모바일 전체메뉴. #hamburger 와 ul.mtree 가 둘 다 overflow:auto 이고
                주 메뉴 a 가 화면 폭을 꽉 채워(500px 화면에서 항목 폭 500px) 바깥 링 9px 이
                좌우 전부 잘렸다. 초점 14개 중 10개가 잘림 — 주 메뉴 8개는 링이 아예 안 보였다(2026-08-13 실측)
   ⚠️ 대상에 [tabindex] 를 반드시 포함할 것 — Swiper 의 이전/다음은 <button> 이 아니라
      <div class="swiper-button-prev" tabindex="0"> 라서 a·button 만 적으면 안 걸린다. */
.toplink a:focus-visible, .toplink [tabindex]:focus-visible,
.bzone a:focus-visible,
.policybox a:focus-visible,
.footlogo a:focus-visible,
.third-menu a:focus-visible,
.fourth-menu a:focus-visible,
.prenav a:focus-visible,
.gallerybox_page_list .box a:focus-visible,
.tab_container a:focus-visible, .tab_container button:focus-visible, .tab_container [tabindex]:focus-visible,
#tab1 a:focus-visible, #tab1 button:focus-visible, #tab1 [tabindex]:focus-visible,
.popimg a:focus-visible, .popimg button:focus-visible, .popimg [tabindex]:focus-visible,
.swiper-container a:focus-visible, .swiper-container button:focus-visible, .swiper-container [tabindex]:focus-visible,
.swiper a:focus-visible, .swiper button:focus-visible, .swiper [tabindex]:focus-visible,
#hamburger a:focus-visible, #hamburger button:focus-visible, #hamburger [tabindex]:focus-visible{outline-width:2px;outline-offset:-2px;box-shadow:inset 0 0 0 4px #ff0000;}
/* 뉴스우석·학사공지 카드는 잘리는 조상까지 여유가 1889/900/500 전부 21px 이상이라 안쪽 링이 필요 없다.
   위 그룹이 조상 셀렉터라 딸려 들어와 글자 앞을 5px·4px 덮었다 — 바깥 링으로 되돌린다(2026-08-07 실측) */
.nowswiper a:focus-visible,
#tab1 .notbox a:focus-visible{outline-width:3px;outline-offset:0;box-shadow:0 0 0 6px #ff0000;}
.introLayer .popNw:focus{outline:none;box-shadow:none;} /* 로드 시 대화상자로 프로그램적 초점만 주고 링은 안 보이게 — 첫 Tab부터 링이 뜬다 */
/* 슬라이더(.popSwiper)는 overflow:hidden + 변형된 트랙이라 아웃라인이 잘리거나 슬라이드에 덮인다.
   아웃라인 대신 ::after 테두리로 링을 그린다(inset:0 → 안 잘림, z-index → 슬라이드 위에 얹혀 안 덮임). */
/* .introLayer .popSwiper 초점 표시 3줄은 2026-08-05 제거 — 슬라이더 껍데기의 tabindex="0" 을 없애
   더 이상 초점을 받지 않게 되어 죽은 규칙이 됐다. outline:none 이 남아 있으면 나중에 초점을 다시
   줄 때 표시가 조용히 사라지므로 함께 지운다 */
/* 뷰포트 밖으로 나가는 경우는 안쪽 링 대신 여백으로 해결한다(아이콘이 링에 덮이는 것 방지).
   .logt 은 상단 고정바 안에서 위쪽 여유가 4.8px 뿐이라 offset 을 0 으로 낮춰 4px 만 나가게 한다. */
/* 팝업 슬라이드는 <a> 가 인라인이라 박스(310x24)가 이미지(310x386)보다 작고,
   이미지가 박스를 덮어 inset 그림자가 뒤로 깔린다 — SNS 슬라이더와 같은 가상요소 방식으로 그린다 */
.popimg a{display:inline-block;line-height:0;}
.popimg a:focus-visible{outline:none;box-shadow:none;position:relative;}
.popimg a:focus-visible::after{content:"";position:absolute;left:-3px;top:-3px;right:-3px;bottom:-3px;border:3px solid #fff;box-shadow:inset 0 0 0 4px #ff0000, inset 0 0 0 7px #fff;z-index:5;pointer-events:none;}
/* 푸터 로고는 <a> 가 인라인이라 박스(210x24)가 이미지(210x49)보다 작아 링이 로고 위에 얹혔다 */
.footlogo a{display:inline-block;line-height:0;padding:12px;}
/* 푸터 로고는 안쪽 링이라 링이 로고를 덮는다 — 패딩을 12px 로 늘려 링과 로고 사이를 띄우고
   짙은 남색 푸터 위라 빨강을 4→7px 로 굵혀 혼자서도 읽히게 한다(흰 2px 은 가장자리) */
.footlogo a:focus-visible{box-shadow:inset 0 0 0 7px #ff0000;}
/* 브레드크럼 홈 아이콘도 같은 문제 — a 가 inline 이라 박스(27x24)가 아이콘(27x29)보다 작았다 */
.subhome a{display:inline-block;line-height:0;vertical-align:middle;padding:4px;}
/* 조직도 남색 박스는 글자가 흰색인데 링 안쪽도 흰색이라 서로 붙어 구분이 안 된다
   (결과서 p41·p42 "개체와 초점의 색이 동일한(비슷한) 오류") — 링을 3px 밀어 빨강이 글자 쪽에 오게 한다
   ⚠️아래 잘림 규칙이 이 뒤에 와야 총장·진천캠퍼스 두 곳의 안쪽 링을 덮지 않는다 */
#txt [data-item="group"] strong a:focus-visible,
#txt [data-item="group"] span a:focus-visible,
.orgpcw strong a:focus-visible,
.bonbum strong a:focus-visible{outline-offset:3px;}
/* 조직도 최상단 두 링크는 overflow:hidden 컨테이너 경계에 붙어(여유 0~1px) 바깥 링 윗변이 잘린다
   라이브 실측: 조직도 링크 111개 중 잘리는 것은 이 둘뿐이고 글자 여백 12~13px 이라 안쪽 링이 글자를 안 덮는다 */
.orgtel a:focus-visible,
#txt [data-item="group"]>strong a:focus-visible{outline-width:3px;outline-offset:-3px;box-shadow:inset 0 0 0 7px #ff0000;}


/* 3차 메뉴는 li 에 테두리(활성 3px)가 있어 a 안쪽 링이 좌우로 3px 어긋나 보인다 — li 에 그린다
   ⚠️4차는 제외한다. a 배경이 흰색이고 li 를 꽉 채워 li 의 inset 링이 자식 배경에 덮여 안 보인다 */
.third-menu li:has(> a:focus-visible){outline:none;box-shadow:inset 0 0 0 4px #ff0000, inset 0 0 0 8px #fff;}
.third-menu li:has(> a:focus-visible) > a:focus-visible{outline:none;box-shadow:none;}

.logt button:focus-visible{outline-offset:0;}
/* 좌우 패딩이 0 이라 흰 링(전역 offset 0)이 흰 아이콘·LOGIN 글자에 바로 닿았다 — 좌우만 벌린다.
   세로는 위쪽 여유가 4.8px 뿐이라(위 주석) 손대지 않는다. LOGOUT·ADMIN 도 같은 구조라 함께 건다 */
.logt button, .logt .loginAfter a{padding-left:6px;padding-right:6px;}
/* 공지 탭 슬라이더(proSwiper) 의 pagination bullet(12px)은 안쪽 링(-4px)이 bullet 배경에 덮여 안 보인다.
   위 96번 그룹의 #tab1 [tabindex]:focus-visible 가 ID 라 특이도(1,2,0)로 -4px 를 강제 → 바깥 링으로 되돌린다.
   반드시 #containertab(ID) 으로 특이도(1,3,0)를 올려야 이긴다(.proSwiper 만이면 0,3,0 이라 짐 — 라이브 실측 확인).
   bullet 은 컨트롤 줄 세로 가운데라 바깥 링(+2px)을 줘도 컨테이너 경계에 거의 안 닿아 안 잘린다. */
#containertab .proSwiper .swiper-pagination-bullet:focus-visible{outline-offset:0;box-shadow:0 0 0 6px #ff0000;}
/* 사진이 깔린 카드형 슬라이드(우석PRIDE·우석SNS).
   ⚠️ 여기서는 outline 을 쓸 수 없다 — 조상의 overflow:hidden 때문에 링을 안쪽(offset 음수)에
      그려야 하는데, 그 자리는 자식(사진·텍스트 박스)의 배경이 나중에 덮어버려 화면에 안 보인다.
      box-shadow:inset 도 같은 이유로 자식 배경 아래에 깔린다. 계산값은 정상인데 안 보이는 함정.
   → 가상요소를 자식 위(z-index)에 얹어 링을 그린다. 빨강 테두리 + 안쪽 흰 선이라
      사진이 어떤 색이든 분리돼 보인다. 절대배치 자식이 없는 것을 확인하고 relative 를 준다. */
.hakswiper a:focus-visible,
.snsSwiper a:focus-visible{outline:none;box-shadow:none;position:relative;}
.hakswiper a:focus-visible::after,
.snsSwiper a:focus-visible::after{content:'';position:absolute;left:0;top:0;right:0;bottom:0;border:3px solid #fff;box-shadow:inset 0 0 0 4px #ff0000, inset 0 0 0 7px #fff;z-index:5;pointer-events:none;}
/* 로그인 팝업 탭은 바로 아래 입력칸이 DOM 상 뒤 형제라 나중에 그려져 링 하단 9px 을 덮는다
   (잘림이 아니라 덮임 — 잘라내는 조상 0개). static→relative 는 배치를 안 바꾸고 쌓임만 올린다 */
.login_tabs button:focus-visible{position:relative;z-index:5;}
/* 로그인 팝업 닫기는 흰 테두리 버튼이 파랑 헤더(#265DA8) 위에 있다 — 전역 링(흰 안쪽/빨강 바깥)은
   두 층 다 죽는다(빨강 vs 파랑 1.63 · 흰 링이 흰 버튼 테두리에 붙음). 층을 뒤집어
   바깥을 흰색(vs 파랑 6.53), 안쪽을 빨강(vs 흰 테두리 4.00)으로 각각 3:1 을 넘긴다.
   ⚠️outline-offset 으로 간격을 만들면 안 된다 — outline 이 box-shadow 위에 그려져
   층 순서가 도로 뒤집힌다. 간격도 그림자 층으로: 간격4(헤더색) → 빨강3 → 흰3 */
#userPopLayer .closeBtn:focus-visible{outline:none;box-shadow:0 0 0 4px #265DA8, 0 0 0 7px #ff0000, 0 0 0 10px #fff;}

/* form */
textarea::-webkit-input-placeholder,
input::-webkit-input-placeholder,
textarea::-moz-placeholder,
input::-moz-placeholder,
textarea:-ms-input-placeholder,
input:-ms-input-placeholder{color:#888;}

input[type="number"]::-webkit-inner-spin-button, input[type="number"]::-webkit-outer-spin-button{height:auto;}
select{-webkit-appearance:none;cursor:pointer;}
select::-ms-expand{display:none;}

input[type=button],
input[type=submit]{-webkit-appearance:none;-moz-appearance:none;appearance:none;-webkit-border-radius:0;border-radius:none;cursor:pointer;}

/* 접근성 1.4.11: 테두리가 입력칸 경계를 알리는 유일한 단서라 3:1 이상. #e5e5e5 는 1.26:1 이었다 */
input[type=file]{line-height:1;padding:6px 10px 7px;border:1px solid #8c8c8c;background:#fff;color:#4d4d4d;cursor:pointer;font-size:12px;}

input[type=text]:read-only,
input[type=password]:read-only,
input[type=tel]:read-only,
input[type=number]:read-only,
input[type=email]:read-only,
input[type=url]:read-only,
input[type=file]:read-only{border:1px solid #e1e2e2;color:#4d4d4d;text-indent:10px !important;}

input[readonly],
input[disabled]{border:1px solid #e1e2e2;color:#4d4d4d;text-indent:10px !important;}

input[type=checkbox]{vertical-align:middle;}

/* 접근성 1.4.11: #e1e2e2 는 1.30:1 이었다 */
textarea{width:100%;padding:5px 7px;font-size:13px;-webkit-appearance:none;-moz-appearance:none;appearance:none;-webkit-border-radius:0;border-radius:none;border:1px solid #8c8c8c;}

button{cursor:pointer;border:0;}

input:-webkit-autofill{-webkit-box-shadow:0 0 0 1000px white inset !important;}
input{-webkit-border-radius:0;/*-webkit-appearance:none;*/}
#skipNavigation {position: absolute; left: 0; top: 0; width: 100%; z-index: 10000;}
#skipNavigation a {display: block; position: absolute; left: 0; top: -10px; width: 100%; height: 1px; margin-bottom: -1px; background: #005baa; font-size: 0; text-align: center; font-weight: bold; color: #fff;}
#skipNavigation a:hover, #skipNavigation a:focus, #skipNavigation a:active {position: absolute; left: 0; top: 0; height: 20px; padding: 4px; font-size: 13px;}
#contents{width: 100%;}

/* 다국어 중문만 서체 변경 */
body.lang_zh{
	font-family: "SimSun", "Songti SC", "STSong", serif;
	/*중문 font-weight 깨지는 오류 방지*/
	-webkit-font-smoothing: antialiased;
	-moz-osx-font-smoothing: grayscale; 
	text-shadow: 0 0 1px rgba(0,0,0,0.01); 
}

/* mtree */
ul.mtree{margin-left:0;}
ul.mtree ul{margin-left:1em;}
ul.mtree>li{list-style:none;border-bottom:1px solid #2673b7;font-size:16px;background:#005baa;}
ul.mtree a{display:block;}
ul.mtree>li>a{/* line-height:40px;*/font-size:15px;box-sizing:border-box;color:rgba(255, 255, 255, 1);padding:14px 0 14px 25px !important;}
/*ul.mtree a{transition:height 300ms ease-out;}*/
ul.mtree.bubba ul{margin-left:0;}
