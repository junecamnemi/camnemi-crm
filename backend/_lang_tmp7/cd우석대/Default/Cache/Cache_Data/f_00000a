/* == a11y: 슬라이더 컨트롤 (2026-07-19, 추가형 — 기존 코드 무개조) ============ */
$(function(){
	/* 자동재생 정지/재생 토글 — 이름을 상태에 맞춰 바꾸고 aria-pressed 는 쓰지 않는다(재생 컨트롤 표준 패턴).
	   꼬리 단어만 갈아끼우므로 "자동재생"의 '재생'이 먼저 걸려 "자동정지 정지"가 되던 replace 버그는 없다. */
	function autoplayLabel(btn, verb){
		var $b = $(btn), base = $b.data('a11yBase');
		if(base === undefined){ base = ($b.attr('aria-label') || '').replace(/\s*(정지|시작)$/, ''); $b.data('a11yBase', base); }
		return base + ' ' + verb;
	}
	$(document).on('click', '.swiper-autoplay-toggle', function(){
		var sel = $(this).attr('data-swiper');
		var el = sel ? document.querySelector(sel) : $(this).closest('.swiper, .swiper-container')[0];
		var sw = el && el.swiper;
		if(!sw || !sw.autoplay) return;
		if(sw.autoplay.running){
			sw.autoplay.stop();
			$(this).addClass('is-paused').attr('aria-label', autoplayLabel(this, '시작'));
		} else {
			sw.autoplay.start();
			$(this).removeClass('is-paused').attr('aria-label', autoplayLabel(this, '정지'));
		}
	});
	/* SNS 슬라이더 이전/다음 (인스턴스는 el.swiper) */
	function snsActiveSwiper(){
		var el = $('.tab_content:visible .snsSwiper')[0] || $('.snsSwiper')[0];
		return el && el.swiper;
	}
	/* A11Y(6.1.1): SNS 이전/다음은 Swiper navigation 이 아니라 커스텀 버튼이라 Swiper 의 비활성 처리
	   (swiper-button-disabled + aria-disabled)를 못 받는다. 그대로 두면 첫/마지막 슬라이드에서도
	   활성처럼 보이고 초점을 받으면서 아무 동작도 하지 않는다 — 다른 슬라이더 3종과 동작이 어긋난다.
	   → 슬라이드 변경·탭 전환 때마다 aria-disabled 를 맞춘다(표시는 CSS 가 담당). */
	function syncSnsNav(){
		var sw = snsActiveSwiper();
		if(!sw) return;
		$('.sns-nav-prev').attr('aria-disabled', sw.isBeginning ? 'true' : 'false');
		$('.sns-nav-next').attr('aria-disabled', sw.isEnd ? 'true' : 'false');
	}
	$('.snsSwiper').each(function(){
		var sw = this.swiper;
		if(sw) sw.on('slideChange', syncSnsNav);
	});
	/* 탭을 바꾸면 조작 대상 스와이퍼가 바뀌므로 다시 맞춘다(fadeIn 뒤라 약간 늦춤) */
	$(document).on('click', '.sec07tab .tabs li, .sns_tab li', function(){ setTimeout(syncSnsNav, 150); });
	syncSnsNav();
	$(document).on('click', '.sns-nav-prev, .sns-nav-next', function(){
		if($(this).attr('aria-disabled') === 'true') return;   /* 끝에 도달한 버튼은 동작시키지 않는다 */
		/* 버튼이 sns_tab 아래(스와이퍼 밖)로 이동 — 활성 탭의 스와이퍼를 조작 */
		var el = $(this).closest('.snsSwiper')[0] || $('.tab_content:visible .snsSwiper')[0], sw = el && el.swiper;
		if(!sw) return;
		if($(this).hasClass('sns-nav-prev')) sw.slidePrev(); else sw.slideNext();
		syncSnsNav();
	});
	/* div 화살표 키보드 조작 보장 — 보이는(폭>0) 화살표만. 안 보이는 화살표에 tabindex를 주면 초점 유실됨 */
	$('.swiper-button-prev, .swiper-button-next').each(function(){
		if(this.offsetWidth > 0){
			$(this).attr({'role':'button','tabindex':'0'});
			$(this).attr('aria-label', $(this).hasClass('swiper-button-prev') ? '이전 슬라이드' : '다음 슬라이드');
		}
	});
	$(document).on('keydown', '.swiper-button-prev, .swiper-button-next', function(e){
		if(e.key === 'Enter' || e.key === ' '){ e.preventDefault(); $(this).trigger('click'); }
	});
	/* slick 구버전이 붙이는 잘못된 listbox/option role 제거 (axe: aria-*-field-name).
	   슬라이드는 캐러셀이지 목록상자가 아님 — role 제거가 정석. 재초기화 대비 이벤트도 바인딩 */
	function stripSlickRoles(){
		$('.slick-track[role="listbox"]').removeAttr('role');
		$('.slick-slide[role="option"]').removeAttr('role');
	}
	stripSlickRoles();
	$(document).on('init reInit breakpoint', '.slick-slider', function(){ setTimeout(stripSlickRoles, 0); });

	/* A11Y-HIDE */
	/* ⚠️ 2026-07-23 이후 이 블록은 평상시 아무 일도 하지 않는다 — 위에서 autoplay 를 옵션 레벨(autoplay:false)로
	   껐기 때문에 stop() 은 이미 멈춘 것을 다시 멈추고, 토글 버튼도 마크업에서 숨겨져 대상이 없다.
	   그래도 남겨두는 이유: 누군가 옵션만 autoplay:{delay:N} 으로 되돌리면 정지 버튼이 숨겨진 채
	   자동재생만 되살아난다. 이 블록이 그때 다시 전수 정지를 걸어주는 안전망이다.
	   (Swiper 는 params.autoplay 가 false 여도 create() 에서 swiper.autoplay 객체를 만들므로 호출 자체는 정상)
	   완전 원복 = 이 블록 삭제 + 위 autoplay 값 4곳 복구 + main_body.php 토글 주석 3쌍 해제, 셋을 함께.
	   (2026-08-28 .hakswiper 는 자동재생을 되살려 아래 배열에서 뺐다 — 정지 버튼도 함께 노출) */
	/* querySelector(단수)였을 때 .proSwiper 는 탭마다 있어 첫 탭만 꺼지고 나머지 5개가 계속 돌았다 → All 로 전수 정지 */
	['.proSwiper', '.medswiper', '.baswiper', '.nowswiper'].forEach(function(sel){
		document.querySelectorAll(sel).forEach(function(el){
			if (el.swiper && el.swiper.autoplay) el.swiper.autoplay.stop();
		});
	});
	/* 정지시켰으면 토글 버튼 표시도 정지 상태로 맞춘다 — 안 맞추면 아이콘은 "정지"인데 실제는 멈춰 있고
	   눌렀을 때 이름과 반대로 재생이 시작된다. 이 블록을 통째로 지우면(원복) 버튼 상태도 원래대로 돌아간다.
	   .pop-toggle 은 제외 — 위 전수 정지 대상이 아니고, 팝업 Swiper 초기화보다 먼저 돌면 오판한다. */
	$('.swiper-autoplay-toggle').not('.pop-toggle').each(function(){
		var sel = $(this).attr('data-swiper');
		var el = sel ? document.querySelector(sel) : $(this).closest('.swiper, .swiper-container')[0];
		var sw = el && el.swiper;
		if (sw && sw.autoplay && !sw.autoplay.running) $(this).addClass('is-paused').attr('aria-label', autoplayLabel(this, '시작'));
	});

	/* 접근성(6.1.1 키보드 사용): 슬라이드가 전부 보여 넘길 것이 없으면(isLocked) 이전/다음은 아무 동작도
	   안 하면서 초점만 받는다. Swiper 5 의 navigation 모듈은 init·toEdge·fromEdge 에만 update() 를 걸어
	   두고 lock/unlock 이벤트는 듣지 않아, 초기화 뒤 isLocked 가 바뀌어도 swiper-button-lock 이 안 붙는다
	   (scrollbar 는 updateSize() 마다 갱신돼 lock 이 걸리므로 스크롤바만 숨겨지던 상태였다).
	   → init 직후와 resize 마다 navigation.update() 를 직접 불러 lock 클래스를 반영한다.
	   watchOverflow 가 꺼진 슬라이더에는 lock 이 붙지 않으므로(조건이 watchOverflow && isLocked) 무해하다. */
	['.proSwiper', '.medswiper', '.baswiper', '.nowswiper', '.hakswiper'].forEach(function(sel){
		document.querySelectorAll(sel).forEach(function(el){
			var sw = el.swiper;
			/* watchOverflow 가 켜진 슬라이더만 다룬다 — 꺼진 쪽은 isLocked 가 undefined 라 lock 을 지우기만 하는데,
			   버튼을 공유하는 구조가 있으면 남의 lock 까지 벗겨낸다(위 snsSwiper 사례). */
			if (!sw || !sw.params.watchOverflow || !sw.navigation) return;
			var syncLock = function(){
				var lock = !!sw.isLocked;
				[sw.navigation.$prevEl, sw.navigation.$nextEl].forEach(function($e){
					if ($e && $e.length) $e[lock ? 'addClass' : 'removeClass']('swiper-button-lock');
				});
			};
			syncLock();
			sw.on('resize', syncLock);
		});
	});

	/* 접근성(6.1.2 초점 이동 · 6.4.1 키보드 사용): 슬라이드 안 링크에 Tab 초점이 들어갔는데
	   그 슬라이드가 화면에 안 보이면 초점이 시야에서 사라진다.
	   → "안 보이면 탭에서 뺀다"가 아니라 "초점이 가면 보이는 자리로 옮긴다"로 처리한다.
	     앞의 방식은 초점 유실은 막지만 그 슬라이드 내용에 키보드로 영영 도달할 수 없게 된다.

	   ⚠️ .swiper-slide-visible 만 믿으면 안 된다 — 그건 "슬라이더 컨테이너 기준" 이다.
	      hakswiper 는 컨테이너(1400px)가 x:830~2230 으로 뷰포트(1920) 밖까지 나가 있어,
	      4번째 슬라이드는 visible 클래스가 붙어 있는데도 실제 화면에서는 잘려 있었다.
	      그래서 뷰포트와 잘라내는 조상 전부의 가시 구간 교집합으로 판정한다. */
	(function(){
		var SEL = ['.proSwiper', '.medswiper', '.baswiper', '.nowswiper', '.hakswiper', '.snsSwiper'];

		/* 이전 방식이 남겨둔 tabindex="-1" 를 걷어낸다(캐시된 옛 스크립트·재실행 대비) */
		function clearOldMarkers(root){
			$(root).find('[data-a11y-slidetab="1"]').removeAttr('tabindex').removeAttr('data-a11y-slidetab');
		}

		/* 뷰포트만 보면 안 된다 — overflow 로 잘라내는 조상 안에 들어와야 실제로 보인다.
		   (2404폭에서 슬라이드가 tab_content 에 잘렸는데 뷰포트 기준으론 "보임"이라 한 박자 늦었다) */
		function fullyOnScreen(el){
			var r = el.getBoundingClientRect();
			var L = 0, R = (window.innerWidth || document.documentElement.clientWidth);
			var n = el.parentElement;
			while (n && n !== document.body) {
				var ox = window.getComputedStyle(n).overflowX;
				if (ox === 'hidden' || ox === 'clip' || ox === 'auto' || ox === 'scroll') {
					var nr = n.getBoundingClientRect();
					if (nr.left > L) L = nr.left;
					if (nr.right < R) R = nr.right;
				}
				n = n.parentElement;
			}
			return r.left >= L - 1 && r.right <= R + 1;   /* 1px 은 반올림 오차 여유 */
		}

		/* overflow:hidden 인 조상은 스크롤바가 없어 사용자가 되돌릴 수 없는데, 브라우저는 초점을
		   보이게 하려고 그런 조상도 가로로 밀어버린다. 밀렸으면 즉시 제자리로 돌린다.
		   (레이아웃이 음수 오프셋으로 배치된 구간에서 제목·버튼이 화면 밖으로 사라지는 것 방지) */
		function resetHiddenScroll(el){
			var n = el.parentElement;
			while (n && n !== document.body) {
				var ox = window.getComputedStyle(n).overflowX;
				if ((ox === 'hidden' || ox === 'clip') && n.scrollLeft !== 0) n.scrollLeft = 0;
				n = n.parentElement;
			}
		}

		function bindFocusFollow(sw, el){
			el.addEventListener('focusin', function(e){
				var slide = e.target.closest ? e.target.closest('.swiper-slide') : null;
				if (!slide) return;
				var idx = Array.prototype.indexOf.call(slide.parentElement.children, slide);
				if (idx < 0) return;
				/* ⚠️ 순서 주의 — 되돌린 뒤에 판정해야 한다.
				   브라우저는 focusin 이 오기 전에 이미 숨은 조상을 밀어 슬라이드를 보이게 해 둔다.
				   그 상태에서 먼저 판정하면 "화면 안"으로 나와 조기 return 하고, 그 다음 되돌리기가
				   브라우저가 민 것을 취소해 슬라이드가 다시 화면 밖으로 나간다(slideTo 도 못 함). */
				resetHiddenScroll(slide);
				if (fullyOnScreen(slide)) return;
				/* 초점 간 슬라이드를 보이는 자리로 — 끝단이면 Swiper 가 알아서 최대치까지만 민다.
				   speed 0 = 즉시. 300ms 면 초점 간 슬라이드가 그 사이 화면 밖이라 한 박자 늦어 보인다 */
				if (typeof sw.slideTo === 'function') sw.slideTo(idx, 0);
				/* ⚠️ 여기서 scrollIntoView 를 쓰면 안 된다 — overflow:hidden 인 조상도 스크립트로는
				   스크롤되기 때문에 섹션 전체가 옆으로 밀려버리고, 스크롤바가 없어 되돌아오지도 않는다.
				   (hakswiper 에서 #sec05 가 310px 밀려 제목·조작버튼이 화면 밖으로 나간 사고) */
				resetHiddenScroll(slide);
				/* 브라우저 기본 스크롤이 우리 다음에 일어나는 경우까지 잡는다 */
				if (window.requestAnimationFrame) window.requestAnimationFrame(function(){ resetHiddenScroll(slide); });
				setTimeout(function(){ resetHiddenScroll(slide); }, 350);
			});
		}

		/* 같은 클래스의 슬라이더가 여럿이다(.proSwiper 6 · .snsSwiper 2 — 탭 패널마다 하나).
		   querySelector 는 첫 하나만 잡아, 탭을 바꾸면 그 패널 슬라이더엔 핸들러가 없었다 */
		SEL.forEach(function(sel){
			var els = document.querySelectorAll(sel);
			if (!els.length) return;
			Array.prototype.forEach.call(els, function(el){
				clearOldMarkers(el);
				if (!el.swiper) return;
				bindFocusFollow(el.swiper, el);
			});
		});
	})();
});
