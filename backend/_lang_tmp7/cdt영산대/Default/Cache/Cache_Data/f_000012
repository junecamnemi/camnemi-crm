/* 탭메뉴 */
.c-tab01 {position:relative;margin-bottom:50px;line-height:1.3;width:100%;padding:0;box-sizing:border-box;}
.c-tab01:before {display:block;content:'';position:absolute;top:10px;left:0;width:100%;height: calc(100% - 20px);background:#f2f2f2;z-index:-1;}
.c-tab01 ul {display:flex;font-size:0;width:100%;background:none;}
.c-tab01 ul li {display:inline-block;width:50%;border-bottom:none;margin-bottom:-1px;vertical-align:top}
.c-tab01 ul li a {position:relative;display:block;width:100%;text-align:center;box-sizing:border-box;transition:all .5s ease}

.c-tab01 ul li a:before {content:'';position:absolute;left:0;top:50%;width:1px;height:19px;margin-top:-10px;background:#d8d8d8;}
.c-tab01 ul li:first-child a:before {display:none;}
.c-tab01 ul li a > span:first-child {display:block;font-size:17px;color:#333;padding:0;white-space:nowrap;text-overflow:ellipsis;overflow:hidden;position:relative;}
.c-tab01 ul li.over a:after,
.c-tab01 ul li a:hover:after {height:90px;}
.c-tab01 ul li a[target="_blank"] span:after {content:"";display:inline-block;position:absolute;width:10px;height:10px;background:url('/resources/_Img/Common/ico_nw.gif') no-repeat 0 0;margin:7px 0 0 10px;vertical-align:middle}
.c-tab01 ul li.over a[target="_blank"] span:after {background-position:-10px 0px}

@media all and (min-width:1000px) {
	.c-tab01 ul li {height:90px;}
	.c-tab01 ul li a {height:100%;display:flex;align-items:center;text-align:center;justify-content:center;}
	.c-tab01 ul li a > span:first-child {display:inline;font-size:17px;color:#333;padding:0;white-space:initial;text-overflow:initial;overflow:hidden;position:relative;z-index:2;}
	.c-tab01 ul li.over a,
	.c-tab01 ul li a:hover {background:#263658;border-radius:30px 0 30px 0;box-shadow:5px 5px 5px rgba(0, 0, 0, 0.2);-webkit-box-shadow:5px 5px 5px rgba(0, 0, 0, 0.2);-moz-box-shadow:5px 5px 5px rgba(0, 0, 0, 0.2);}
	.c-tab01 ul li.over a span,
	.c-tab01 ul li a:hover span {color:#fff;}
	.c-tab01 ul li.over a:before,
	.c-tab01 ul li a:hover:before {display:none;}
}
@media all and (max-width:999px) {
	.c-tab01:before {display:none;}
	.c-tab01 {background:#f2f2f2;}
	.c-tab01 ul {display:flex;flex-wrap:wrap;font-size:0;width:100%;background:#fff;overflow:hidden;}
	.c-tab01 ul li {display:inline-block;border-bottom:1px solid #ccc;margin-bottom:-1px;width:33.33%;vertical-align:top}
	.c-tab01 ul li a {position:relative;display:block;width:100%;text-align:center;box-sizing:border-box;transition:all .5s ease;border-top-width:0}
	.c-tab01 ul li a:before {content:'';position:absolute;left:0;top:50%;width:1px;height:19px;margin-top:-10px;background:#d8d8d8;}
	.c-tab01 ul li:first-child a:before,
	.c-tab01 ul li:nth-child(5n+1) a:before {display:none;}
	.c-tab01 ul li a:after {content:"";display:block;width:50px;height:0;position:absolute;bottom:-1px;left:50%;margin-left:-25px;background:#0d5db2;transition:all .5s ease}
	.c-tab01 ul li a span {display:inline-block;font-size:15px;color:#333;padding:10px;white-space:initial;text-overflow:initial;overflow:hidden}
	.c-tab01 ul li.over a:after,
	.c-tab01 ul li a:hover:after {height:3px;}
	.c-tab01 ul li.over a span,
	.c-tab01 ul li a:hover span {color:#0d5db2;}

	.c-tab01 ul li:nth-child(5n+1) a:before {display:block;}
	.c-tab01 ul li:nth-child(3n+1) a:before {display:none;}
}
