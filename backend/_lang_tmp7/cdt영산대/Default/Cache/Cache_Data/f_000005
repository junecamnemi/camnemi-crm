/* 게시판 글내용 */
/*상단 출력 정보*/
.board-view-head {position:relative;border-top:2px solid #112b49;border-bottom:0;text-align:left;}
.board-view-head .board-view-title {position:relative;width:100%;background:#fff;border-bottom:1px solid #ccc;padding:25px 350px 25px 40px;box-sizing:border-box;}
.board-view-head .vtitle {color:#222;font-weight:500;font-size:1.059em;width:100%;word-break:break-all;box-sizing:border-box;margin-top:0;}
.board-view-head .vtitle .state {position:absolute;left:250px;top:10px;text-align:center;font-size:14px;color:#fff;padding:5px 20px;background:#0a60bc;border:1px solid #0a60bc}
.board-view-head .vtitle .state.end {color:#0a60bc;background:#fff;border:1px solid #0a60bc}
.board-view-head .vtitle-winfo {position:absolute;top:28px;right:40px;font-size:16px;color:#555;}
.board-view-head .vtitle-winfo span {background:url(/resources/_Img/Board/default/vbar.gif) no-repeat 0 50%;padding-left:10px;margin-left:8px;}
.board-view-head .vtitle-winfo span:first-child {background:0;margin:0;padding:0;}
.board-view-head .vtitle-winfo span em {font-style:normal;}
.board-view-head .vtitle-winfo .hit {/*background:0;position:absolute;top:35px;right:30px*/}
.board-view-head .vtitle-winfo .date {color:rgba(0,0,0,0.5);font-family:'Lato', sans-serif;}
