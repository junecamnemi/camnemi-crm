.pds .pds-list .stitle {text-align:left;font-size:20px;color:#222;font-weight:500;overflow:hidden;text-overflow:ellipsis;/*white-space:nowrap; line-height:35px;*/line-height: 24px !important;display: ruby-text;}/* 대학 인권 센터 서식자료실 2줄 설정 */
.pds .pds-list .stitle * {vertical-align:middle;overflow: hidden;text-overflow: ellipsis;display: -webkit-box;-webkit-line-clamp: 2;-webkit-box-orient: vertical; /* display: inline; */}
.pds .pds-list .stitle .cate {display:inline-block;font-size:14px;color:#fff;background:#ff7746;border-radius:17.5px;line-height:35px;padding:0 11px;}
.pds .pds-list .stitle .new {  }
.pds .pds-list .writer {display:none;}

.pds .pds-list .date {position:relative;display:block;padding-left:26px;font-size:16px;color:#000000;opacity:0.9;font-family:'Lato', sans-serif;padding-top:0;margin-top:11px;}
.pds .pds-list .date:before {display:block;content:'';position:absolute;top:0;bottom:0;left:0;margin:auto 0;width:16px;height:16px;background:url(/resources/_Img/Board/default/board_spr.png) no-repeat -22px 0;filter:grayscale(100%) brightness(0.68) contrast(5.5)}

.pds .pds-list .file {position:absolute;top:50%;right:30px;margin-top:-22.5px;}
.pds .pds-list .file .btn-pds-file {position:relative;display:block;width:45px;height:45px;border:1px solid #CCCCCC;background:#fff;box-sizing:border-box;transition:all .3s ease }
.pds .pds-list .file .btn-pds-file:before {display:block;content:'';position:absolute;top:0;bottom:0;left:0;right:0;margin:auto;width:14px;height:14px;background:url(/resources/_Img/Board/default/board_spr.png) no-repeat -72px 0;transition:all .3s ease;filter:grayscale(100%) brightness(0.68) contrast(5.5)}
.pds .pds-list .file .btn-pds-file:hover {border-color:#f86518;background:#f86518;}
.pds .pds-list .file .btn-pds-file:hover:before {background-position:-48px 0;}

.pds .pds-files-down {position:absolute;top:calc(100% + 16px);right:0;width:460px;height:auto;text-align:center;font-size:0;background:#fff;box-shadow:0 0 40px rgba(0,0,0,0.1);overflow:visible;z-index:3001;}
.pds .pds-files-down-blind, .pds .pds-files-down.blind {width:0;height:0;overflow:hidden;position:absolute;display:none;}
.pds .pds-files-down .inwr {position:relative;display:block;vertical-align:middle;width:100%;text-align:left;box-sizing:border-box;padding:10px 45px 20px 30px;z-index:1;}
.pds .pds-files-down .inwr .tit,
.pds .pds-files-down .inwr .stit {height:0;}
