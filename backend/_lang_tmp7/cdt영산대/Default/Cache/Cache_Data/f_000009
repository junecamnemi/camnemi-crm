/* 대학소개 > 시설안내 신청*/
.fac-box {font-size:0}
.fac-box li {display:inline-block;margin-right:2.357%;width:31.761%;box-sizing:border-box;vertical-align:top}
.fac-box li .pic-box {position:relative}
.fac-box li .pic-box:before   {position:absolute;content:"";bottom:0;transform:translateY(50%);right:25px;width:70px;height:70px;border-radius:40% 45% 40% 50%;animation:freeTrial 3s infinite alternate ease-in-out;box-shadow:0 12px 30px rgba(205,126,57,0.4);-webkit-box-shadow:0 12px 30px rgba(205,126,57,0.4);-moz-box-shadow:0 12px 30px rgba(205,126,57,0.4);z-index:10;background:#ff7746 url(/resources/homepage/kor/_Img/content/futsal_spr.png) no-repeat 0 0}
.fac-box li.gress .pic-box:before {background-color:#5ba081;background-position:-74px 0}
.fac-box li.design .pic-box:before {background-color:#568dbe;background-position:-148px 0}
.fac-box li img {width:100%}
.fac-box li:last-child {margin-right:0}
.fac-box li .txt-box {padding:40px 25px;position:relative}
.fac-box li .txt-box .fac-tit {font-size:24px;font-weight:700;color:#222}
.fac-box li .txt-box .fac-txt {font-size:17px;margin:25px 0}
@media all and (max-width:999px){
	.fac-box li .txt-box {padding:20px 0}
	.fac-box li .txt-box .fac-tit {font-size:22px}
	.fac-box li .txt-box .fac-txt {font-size:16px;margin:15px 0}
	.fac-box li .pic-box:before {height:49px;width:49px;background-size:234px auto}
	.fac-box li.futsal .pic-box:before {background-position:0 0}
	.fac-box li.gress .pic-box:before {background-position:-52px 0}
	.fac-box li.design .pic-box:before {background-position:-104px 0}
}
@media all and (max-width:799px){
	.fac-box li .txt-box .fac-tit {font-size:20px}
	.fac-box li .txt-box .fac-txt {font-size:15px}
}
@media all and (max-width:699px){
	.fac-box li {width:100%;margin-right:0;margin-bottom:30px}
	.fac-box li .pic-box:before {left:20px}
	.fac-box li .txt-box {margin-top:20px}
}