@charset "utf-8";

/* 2015-10-05 CSS CENTUMSOFT */

#doc-wrap {position:relative;min-width:1400px;max-width:1920px;overflow:hidden;margin:0 auto}
.div-cont {position:relative;max-width:1400px;margin:0 auto;box-sizing:border-box;}

@media all and (max-width:1440px){
	#doc-wrap {min-width:320px}
	.div-cont {padding:0 20px;}
}
@media all and (max-width:680px){
}
@media all and (max-width:420px){
}

/* 스킵네비게이션 */
#skipNavi {height:0}
#skipNavi .skipLink {position:absolute;top:-1000px;left:-1000px;overflow:hidden;z-index:5000}
#skipNavi .skipLink:focus, #skipNavi .skipLink:active {top:0;left:0;padding:10px 20px;background:#1e64ba;color:#fff}

/* 레이아웃 */
#header-wrap {position:relative;height:130px;margin:0 auto}
#mcontainer-wrap {position:relative;width:100%}
#container {position:relative;max-width:1400px;margin:48px auto 0 auto}
#container:after {content:'';clear:both;display:block}

@media all and (min-width:1000px) {
	#header-wrap.over:before {display:block;content:'';position:fixed;top:130px;left:0;width:100%;height: calc(100% - 140px);background:rgba(0,0,0,0.5);z-index:11;}
	.headerFixed #header-wrap.over:before {top:90px;height: calc(100% - 90px);}

	.headerFixed #header-wrap {position:fixed;left:0;top:0;width:100%;z-index:3001;background:#fff;margin:-41px 0 0;}
	.headerFixed #header-wrap:after {content:"";display:block;position:absolute;width:100%;height:1px;background:#ddd;left:0;top:100%;z-index:500}
	.headerFixed #container-wrap {padding:115px 0 0}
	.headerFixed #smart-quick-Navi .role-head {height:75px;margin:40px 0 0;}
	.headerFixed #smart-quick-Navi .role-head .trigger .p1 {display:none}
	.headerFixed #smart-quick-Navi .role-head .trigger .p2 {padding:0 0 25px;}
}

/* svisual */
#svisual-wrap {position:relative;/*max-width:1740px;*/*max-width:100%;margin:0;width:100%;height:330px;z-index:10}
#svisual-wrap #visImgWrap {width:100%;position:relative;height:100%;z-index:1}
#svisual-wrap #visImgWrap #visImg {position:relative;height:100%}
#svisual-wrap #visImgWrap #visImg .site-util {display:block;max-width:1400px;margin:0 auto;box-sizing:border-box;position:relative;z-index:2;}
#svisual-wrap #visImgWrap #visImg .site-util .txtBox {display:block;position:absolute;left:2%;top:70px;}
#svisual-wrap #visImgWrap #visImg .site-util .txtBox > div {box-sizing:border-box;position:relative;line-height:1.2;color:#fff;text-shadow:0 0 7px rgba(0, 0, 0, .4)}
#svisual-wrap #visImgWrap #visImg .site-util .txtBox .txt1 {display:block;font-family:'DWImpactamin', sans-serif;letter-spacing:-.06em;color:#fff;font-weight:400;font-size:45px;opacity:0;transform:translateY(30px);transition:all .4s ease .2s}
#svisual-wrap #visImgWrap #visImg .site-util .txtBox .txt1:before {display:block;content:'';width:57px;height:27px;background:url(/resources/homepage/kor/_Img/Layout/slogan_logo.png) no-repeat 0 0;margin-bottom:12px;}
#svisual-wrap #visImgWrap #visImg .site-util .txtBox .txt2 {display:inline-block;font-weight:300;letter-spacing:-.04em;color:#fff;font-size:18px;line-height:1.3;margin:26px 0 0;opacity:0;transform:translateY(30px);transition:all .4s ease .4s}

#svisual-wrap #visImgWrap #visImg .site-util .lnkBox {display:block;position:absolute;right:0;top:110px;}
#svisual-wrap #visImgWrap #visImg .site-util .lnkBox a {display:block;box-sizing:border-box;position:relative;color:#fff;line-height:1;}
#svisual-wrap #visImgWrap #visImg .site-util .lnkBox a span {display:block;box-sizing:border-box;position:relative;padding:0 70px 0 0;line-height:55px;font-size:18px;font-weight:500;letter-spacing:-.05em;opacity:0;transform:translateX(-30px);transition:all .4s ease .8s}
#svisual-wrap #visImgWrap #visImg .site-util .lnkBox a span:before {content:"";display:block;position:absolute;right:0;top:0;width:53px;height:53px;background:none;border:1px solid #b9b9b9;border-radius:50%;opacity:0;transform:translateX(-30px);transition:all .3s ease;}
#svisual-wrap #visImgWrap #visImg .site-util .lnkBox a span:after {content:"";display:block;position:absolute;right:18px;top:21px;width:19px;height:12px;background:url(/resources/homepage/kor/_Img/Layout/layout_spr.png) no-repeat -87px -58px;opacity:0;transform:translateX(-30px);transition:all .3s ease;}
#svisual-wrap #visImgWrap #visImg .site-util .lnkBox a:focus span:before,
#svisual-wrap #visImgWrap #visImg .site-util .lnkBox a:hover span:before {background:#fff;border-color:#fff;}
#svisual-wrap #visImgWrap #visImg .site-util .lnkBox a:focus span:after,
#svisual-wrap #visImgWrap #visImg .site-util .lnkBox a:hover span:after {background-position:-131px -58px;}

#svisual-wrap #visImgWrap #visImg .imgBox {display:block;position:relative;height:100%;overflow:hidden;width:2000px;}
#svisual-wrap #visImgWrap #visImg .imgBox img {display:block;position:absolute;width:2000px;height:auto;top:0;left:0;z-index:1;transform:scale(1.2);transition:transform 3s ease}
.loaded #svisual-wrap #visImgWrap #visImg .site-util .txtBox .txt1 {opacity:1;transform:translateY(0)}
.loaded #svisual-wrap #visImgWrap #visImg .site-util .txtBox .txt2 {opacity:.8;transform:translateY(0)}
.loaded #svisual-wrap #visImgWrap #visImg .site-util .lnkBox a span {opacity:1;transform:translateX(0);}
.loaded #svisual-wrap #visImgWrap #visImg .site-util .lnkBox a span:after {opacity:1;transform:translateX(0);}
.loaded #svisual-wrap #visImgWrap #visImg .site-util .lnkBox a span:before {opacity:1;transform:translateX(0);}


.loaded #svisual-wrap #visImgWrap #visImg .imgBox img {transform:scale(1)}

@media all and (max-width:999px) {
	#svisual-wrap {height:330px;/*margin-left:20px;width: calc(100% - 20px);*/}
	#svisual-wrap #visImgWrap #visImg .imgBox img {left:-20%;margin-left:0;}
	#svisual-wrap #visImgWrap #visImg .site-util .txtBox {left:20px}
}
@media all and (max-width:768px) {
	#svisual-wrap {height:210px;}
	#svisual-wrap #visImgWrap #visImg .imgBox img {width:1170px;left:0;margin-left:0;}
	#svisual-wrap #visImgWrap #visImg .site-util .txtBox {top:40px}
	#svisual-wrap #visImgWrap #visImg .site-util .txtBox .txt1 {font-size:30px;opacity:1;transform:translateY(0);}
	#svisual-wrap #visImgWrap #visImg .site-util .txtBox .txt1:before {width:41px;height:19px;background-size:100% 100%;margin-bottom:10px;}
	#svisual-wrap #visImgWrap #visImg .site-util .txtBox .txt2 {font-size:14px;margin:10px 0 0;opacity:2;transform:translateY(0);}

	#svisual-wrap #visImgWrap #visImg .site-util .lnkBox {display:none;}
}

/* contents */
@media only screen and (min-width:1400px) {
	#contents {width:100%;min-height:600px;word-break:keep-all;word-wrap:break-word}
}
#contents .cont-top {position:relative;margin-bottom:43px}
#contents .cont-top .cont-tit {font-size:40px;color:#222;font-weight:700;letter-spacing:-0.06em;text-align:center}

/* cont-navi */
#cont-navi {display:block;position:absolute;width:100%;left:0;bottom:0;height:60px;background:#f87141;z-index:12}
#cont-navi:before {display:block;content:'';position:absolute;top:0;left:0;width:1830px;height:100%;background:#f87141;}
#cont-navi .div-cont {position:relative;max-width:1400px;margin:0 auto;height:100%}
#cont-navi .div-cont:after {content:"";display:block;clear:both}
#cont-navi .home {display:block;float:left;position:relative;z-index:1;width:44px;height:100%}
#cont-navi .home:before {content:"";display:block;position:absolute;top:0;left:0;bottom:0;margin:auto 0;z-index:2;width:17px;height:14px;background:url(/resources/homepage/kor/_Img/Layout/layout_spr.png) no-repeat 0 -58px;transition:all .3s ease;}
#cont-navi .home:after {content:"";display:block;position:absolute;top:0;right:2px;bottom:0;margin:auto 0;z-index:1;width:7px;height:7px;opacity:.5;border-bottom:2px solid #fff;border-right:2px solid #fff;transform:rotate(-45deg);transition:all .3s ease;}
#cont-navi dl {float:left;position:relative;z-index:5;/*min-width:250px;max-width:350px;*/width:auto;height:100%}
#cont-navi dt {display:block;height:100%}
#cont-navi dt a {display:block;position:relative;height:100%;padding:0 50px 0 20px;font-size:0}
#cont-navi dt a:before {content:"";display:block;position:absolute;top:0;right:24px;bottom:0;margin:auto 0;z-index:2;width:17px;height:17px;background:url(/resources/homepage/kor/_Img/Layout/layout_spr.png) no-repeat -32px -58px;transition:all .3s ease;}
#cont-navi dt a:after {content:"";display:block;position:absolute;top:0;right:2px;bottom:0;margin:auto 0;z-index:1;width:7px;height:7px;opacity:.5;border-bottom:2px solid #fff;border-right:2px solid #fff;transform:rotate(-45deg);transition:all .3s ease;}
#cont-navi dt a .txt {display:inline-block;position:relative;font-size:16px;line-height:60px;color:#fff;padding:0;vertical-align:middle;transition:all .3s ease}
#cont-navi dt a:focus:before,
#cont-navi dt a:hover:before {background-position:-56px -58px;}
#cont-navi dl.is-last dt a:after {display:none;}
#cont-navi dl.is-last dt a:before {background-position:-56px -58px;}


#cont-navi .sub-list {position:absolute;top:100%;left:0;background:#fff;width:200px;border:1px solid #f87141;border-top:0;display:none;}
#cont-navi .sub-list ul {display:block;margin:8px 19px 9px;}
#cont-navi .sub-list .mn_a1 {position:relative;display:block;font-size:15px;color:#555555;padding:10px 0 11px 0;}
#cont-navi .sub-list .mn_a1 span {display:inline-block;}
#cont-navi .sub-list .mn_a1[target='_blank']:after {display:inline-block;content:"";width:10px;height:10px;vertical-align:middle;margin:0 0 1px 10px;background:url(/resources/homepage/kor/_Img/Layout/layout_spr.png) no-repeat -256px -106px;}
#cont-navi .sub-list .mn_a1[target='_blank']:hover:after,
#cont-navi .sub-list li.isOver .mn_a1[target='_blank']:after {background-position:-271px -106px;}
#cont-navi .sub-list li.isOver a span {font-weight:500;color:#f15922;text-decoration:underline;}
#cont-navi .sub-list li:hover span {color:#f15922}

#cont-navi .cont-ctrl-btns {position:absolute;right:0;top:7px;height:46px;font-size:0}
#cont-navi .cont-ctrl-btns:after {content:"";display:block;clear:both}
#cont-navi .cont-ctrl-btns .unit {display:block;float:left;position:relative;height:100%;width:46px;}
#cont-navi .cont-ctrl-btns .unit > button {position:relative;width:100%;height:100%;border:0;border-radius:50%;background:none;transition:all .3s ease;}
#cont-navi .cont-ctrl-btns .unit > button:before {content:"";display:block;position:absolute;top:0;right:0;bottom:0;left:0;margin:auto;background:url(/resources/homepage/kor/_Img/Layout/layout_spr.png) no-repeat;transition:all .3s ease;z-index:2}

#cont-navi .cont-ctrl-btns .unit-sns {float:right;}
#cont-navi .cont-ctrl-btns .unit .btn-share:before {width:24px;height:22px;background-position:-209px 0;}
#cont-navi .cont-ctrl-btns .unit-print {margin-right:5px;}
#cont-navi .cont-ctrl-btns .unit .btn-print:before {width:26px;height:26px;background-position:-163px 0;}
#cont-navi .cont-ctrl-btns .unit > button:hover,
#cont-navi .cont-ctrl-btns .unit > button.is-open {background:rgba(0,0,0,0.3);}

#cont-navi .cont-ctrl-btns .sns-list {display:none;position:absolute;top:0;right:100%;z-index:100;width:auto;font-size:0;white-space:nowrap;box-sizing:border-box;}
#cont-navi .cont-ctrl-btns .sns-list li {display:inline-block;box-sizing:border-box;position:relative;margin-right:5px;}
#cont-navi .cont-ctrl-btns .sns-list button {display:block;box-sizing:border-box;border:0;position:relative;background:#fff;border-radius:50%;width:46px;height:46px;font-size:0;overflow:hidden; }
#cont-navi .cont-ctrl-btns .sns-list button:before {content:"";display:block;position:absolute;transition:all .3s ease;width:46px;height:46px;background:url(/resources/homepage/kor/_Img/Layout/layout_spr.png) no-repeat;top:0;right:0;bottom:0;left:0;margin:auto}
#cont-navi .cont-ctrl-btns .sns-list .btn-fb:before {background-position:-253px 0px}
#cont-navi .cont-ctrl-btns .sns-list .btn-tw:before {background-position:-304px 0px}
#cont-navi .cont-ctrl-btns .sns-list .btn-insta:before {background-position:-407px 0px}
#cont-navi .cont-ctrl-btns .sns-list .btn-nb:before {background-position:-355px 0px}

@media all and (max-width:1499px) {
#cont-navi .div-cont {box-sizing:border-box;padding:0 20px;}
}
@media all and (max-width:768px) {
	#cont-navi {height:45px;/*z-index:initial;*/}
	#cont-navi .div-cont {box-sizing:border-box;padding:0 5px;}
	#cont-navi dt a .txt {line-height:45px;}
	#cont-navi .home {display:none;}
	#cont-navi dt a{;padding:0 40px 0 5px;}
	#cont-navi dt a:before{right:15px;}

	#cont-navi .cont-ctrl-btns {/*transform:scale(0.7);top:1px;right:-3px;z-index:14;*/display:none}
}



#contents #cont {padding:0 0 70px 0;font-size:17px;color:#555;letter-spacing:-0.04em;line-height:26px;word-break:keep-all;word-wrap:break-word;min-height:400px}
#contents #cont:after {clear:both;content:"";display:block}
@media all and (max-width:999px){
	#contents {width:auto;max-width:100%;float:none}
	#contents #cont {font-size:16px; padding-bottom:40px;}
	#header-wrap {padding-left:0;height:auto}
}
@media all and (max-width:768px){
	#container {margin-top:0;z-index:1}
	#contents .cont-top {padding:20px 0;margin-bottom:0;border:0}
	#contents .cont-top .cont-tit {font-size:26px;position:relative}
}
@media all and (max-width:599px){
	#contents #cont {padding-bottom:30px;font-size:15px;line-height:24px}
}























