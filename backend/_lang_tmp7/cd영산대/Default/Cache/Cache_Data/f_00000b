/* 진주교대 사용자서비스 Navi */
#smart-quick-Navi {display:block;position:absolute;width:100px;right:0;top:0;z-index:3001}/* Footer보다 z-index 위에 */
#smart-quick-Navi.close {height:116px}
#smart-quick-Navi.open {height:100%}
#smart-quick-Navi .role-head {display:block;height:116px;position:relative;z-index:1}
#smart-quick-Navi .role-head .trigger {display:block;width:100%;height:100%;border:0;box-sizing:border-box;position:relative;color:#fff;background:#513d3b;overflow:hidden;transition:padding .3s ease}
#smart-quick-Navi .role-head .trigger:before {content:"";display:block;position:absolute;width:45px;height:89px;z-index:1;left:0;top:0;background:url(/resources/homepage/kor/_Img/Layout/layout_spr.png) no-repeat -360px 0px}
#smart-quick-Navi .role-head .trigger .p1 {display:block;position:relative;font-family:"minion-pro";font-weight:400;font-size:16px;opacity:.6;line-height:1.2;z-index:2;margin:0 0 3px;transition:all .3s ease}
#smart-quick-Navi .role-head .trigger .p2 {display:block;position:relative;box-sizing:border-box;position:relative;font-weight:500;font-size:16px;line-height:18px;letter-spacing:-.05em;;padding:0 0 31px;z-index:2;transition:padding .3s ease}
#smart-quick-Navi .role-head .trigger .p2:after {content:"";display:block;position:absolute;width:22px;height:22px;background:url(/resources/homepage/kor/_Img/Layout/layout_spr.png) no-repeat -415px 0px;left:50%;bottom:0;margin:0 0 0 -11px;transition:all .3s ease}
#smart-quick-Navi .role-head .trigger .p2 span {display:block}
#smart-quick-Navi .role-head .trigger:focus .p1,
#smart-quick-Navi .role-head .trigger:hover .p1 {opacity:1}
#smart-quick-Navi .role-head .trigger:focus .p2:after,
#smart-quick-Navi .role-head .trigger:hover .p2:after {transform:rotate(90deg)}
#smart-quick-Navi .role-head .trigger.over .p1 {opacity:1}
#smart-quick-Navi .role-head .trigger.over .p2:after {transform:rotate(45deg)}
#smart-quick-Navi .role-body {display:block;position:absolute;width:100%;left:0;top:0;height:100%;box-sizing:content-box;padding:116px 0 0}
#smart-quick-Navi .role-body.over {}
#smart-quick-Navi .role-body .inBox {display:none;width:100%;height:100%;background:#6c5f5e}
#smart-quick-Navi .role-body .inBox.fixed {position:fixed;right:0;top:0;width:100px;height:100%;padding:116px 0 0}
#smart-quick-Navi .role-body ul {display:block}
#smart-quick-Navi .role-body ul li {display:block;box-sizing:border-box;border-bottom:1px solid rgba(255, 255, 255, .1)}
#smart-quick-Navi .role-body ul li button {display:block;position:relative;width:100%;box-sizing:border-box;border:0;background:transparent;line-height:1;text-align:center;padding:76px 0 27px}
#smart-quick-Navi .role-body ul li button:before,
#smart-quick-Navi .role-body ul li button:after {content:"";display:block;position:absolute;top:0;right:0;bottom:0;left:0;transition:all .3s ease}
#smart-quick-Navi .role-body ul li button:before {width:40px;height:40px;background:url(/resources/homepage/kor/_Img/Layout/layout_spr.png) no-repeat;margin:26px auto auto auto;opacity:.8;z-index:1}
#smart-quick-Navi .role-body ul li button:after {width:100%;height:100%;background:rgba(0, 0, 0, .2);z-index:0;opacity:0}
#smart-quick-Navi .role-body ul li button.n01:before {background-position:-447px 0px}
#smart-quick-Navi .role-body ul li button.n02:before {background-position:-497px 0px}
#smart-quick-Navi .role-body ul li button.n03:before {background-position:-547px 0px}
#smart-quick-Navi .role-body ul li button.n04:before {background-position:-597px 0px}
#smart-quick-Navi .role-body ul li button span {display:inline-block;position:relative;color:#fff;opacity:.8;line-height:1;font-size:15px;opacity:.8;transition:all .3s ease;z-index:2}
#smart-quick-Navi .role-body ul li button:focus:before,
#smart-quick-Navi .role-body ul li button:hover:before,
#smart-quick-Navi .role-body ul li button:focus span,
#smart-quick-Navi .role-body ul li button:hover span {opacity:1;text-decoration:underline}
#smart-quick-Navi .role-body ul li button:focus:after,
#smart-quick-Navi .role-body ul li button:hover:after {opacity:1}
#smart-quick-Navi .role-body .btn-closer {display:block;position:relative;width:50px;height:50px;margin:0 auto;border:0;background:transparent}
#smart-quick-Navi .role-body .btn-closer:after {content:"";display:block;position:absolute;width:22px;height:22px;background:url(/resources/homepage/kor/_Img/Layout/layout_spr.png) no-repeat -415px 0px;top:0;right:0;bottom:0;left:0;margin:auto;transform:rotate(45deg);transition:all .3s ease}
#smart-quick-Navi .role-body .btn-closer:focus:after,
#smart-quick-Navi .role-body .btn-closer:hover:after {transform:rotate(-45deg)}
@media all and (max-width:1660px) {
	#smart-quick-Navi {display:none}
}

