/*-----기본-----*/
html{font-size:20px;}
body{font-size:1rem}
.tablet{display:none;}
.mob{display:none;}
#wrap{position:relative; line-height:1.5; overflow:hidden; font-size: .9rem;}
#wrap img { border:none; }
#wrap i{vertical-align:inherit;}


/*헤더*/
#header{background: #f7f8f9;position:relative;z-index:999;}
#header h1{}
#header h1 a{display: block;}
#header .header_inner{position:relative; width:1550px; margin:0 auto; height:4.5rem;display:flex;align-items: center;justify-content:space-between; }

@media (max-width:1030px){
	html{font-size:16px;}
    body{font-size:1rem}
	#wrap{font-size:1rem;}
	.tablet{display:block;}
}

@media (max-width:767px){
	html,body,#wrap{height:auto;}
	html{font-size:15px;}
    body{font-size:1rem; position:relative;}
	.web{display:none;}
	.mob{display:block;}
}

/*----- header 상단 -----*/
/* #header{position:fixed; top:0; left:0; right:0; z-index:30;} */
/* 헤더 상단 */
#header.open h1{z-index: 9999;}
#header .area_top{ z-index:30; background: linear-gradient(90deg, #024EA0 0%, #1A2F6E 100%);}
.fixed_header #header .area_top{display:none;}
#header .area_top > .inr{display:flex; justify-content:space-between; height:40px; margin:0 45px;}
#header .area_top .util_l{height:100%;}
#header .area_top .util_l .lst{display:flex; align-items: center;  height:100%; color: #fff;}
#header .area_top .util_l .lst li {display:flex; align-items: center;}
#header .area_top .util_l .lst li.center_area {position: relative;}
#header .area_top .util_l .lst>li:before{content:''; display:block; width:1px; height:14px;  background:rgba(187,187,187,.2);}

#header .area_top .util_l .lst > li > a{display:flex; justify-content:center; align-items:center; position:relative; height:100%; padding: 0 15px; font-weight:500; font-size:15px; text-align:center; color: #fff;}
#header .area_top .util_l .lst > li:nth-child(2) > a { color: rgba(255,255,255,.5) !important; }
#header .area_top .util_r{height:100%;}
#header .area_top .util_r .lst{display:flex; height:100%;align-items: center;}
#header .area_top .util_r .lst li{position:relative;padding:0 0.5rem;}
#header .area_top .util_r .lst li a {color: #FFF; font-size: 0.7rem; font-weight: 400; line-height: 0.7rem; letter-spacing: -0.0035rem;}

#header .area_top .util_r .lst li:after{content:'';position:absolute;width:1px;height:0.6rem;width:1px;background:rgba(255,255,255,0.2);right:0;top:0.5rem;}
#header .area_top .util_r .lst li:last-child{padding-right:0;}
#header .area_top .util_r .lst li:last-child:after {display:none;}
#header .center_area .open_select{display:flex; justify-content:center; align-items:center; position:relative; height:100%; padding: 0 15px; font-weight:500; font-size:15px; text-align:center; color: #fff; font-family: 'Pretendard'}

.fp-viewing-news #header .center_area .open_select:after,
.fp-viewing-banner #header  .center_area .open_select:after,
#header.open  .center_area .open_select:after{background-position:0 -40px;}
#header .center_area.on .open_select:after{transform: translateY(-50%) scaleY(-1);}
#header .center_area .box_select{visibility:hidden; opacity:0; position:absolute; top:130%; left:10%; z-index:100; padding:0.5rem; border-radius:8px; background:#eaeaea; transition:all .2s cubic-bezier(0.25, 0.46, 0.45, 0.94);}
#header .center_area.on .box_select{display:block; visibility:visible; opacity:1;}
#header .center_area .box_select ul li{border-top:1px solid rgba(255,255,255,.2);}
#header .center_area .box_select ul li:first-child{border-top:1px solid rgba(255, 255, 255,2);}
#header .center_area .box_select > ul > li a{display:block; padding:5px 0; font-size:14px; text-align:center;}
#header .center_area .box_select ul li a[target="_blank"]:after{content:''; position:relative; top:auto; right:auto; bottom:auto; width:13px; height:13px; margin:0 0 0 5px; border:0; background-position:-31px -123px; vertical-align:baseline; transform:none;}
#header .center_area .open_select:after{content:'';position:absolute;width:0.9rem;height:0.9rem;background:url(/images/default/content/select-bottom.svg)no-repeat center center;background-size:cover;top: 50%;transform:translateY(-50%);right:-0.1rem;}
#header .center_area .box_select > ul > li a:hover{color:#00387A;font-weight:700;}

#header .header-right {display:flex; align-items: center; gap: 0.85rem; }
#header .header-right a.order-btn {border-radius: 0.4rem;background:#007AFF;width:5.55rem;height:1.6rem;display:flex;justify-content: center;align-items: center;color: #FFF; font-size: 0.75rem; font-weight: 600; line-height: 0.8rem; letter-spacing: -0.00375rem;margin-right:0.5rem;}

#header .lang-wrap {position:relative;}

#header .select_btn{width:4.5rem;height:2rem;border-radius:0.4rem;display:flex;gap:0.5rem;justify-content: center;align-items: center;color: #333; font-family: 'Oswald'; font-size: 0.75rem;

font-weight: 500; line-height: 0.8rem; letter-spacing: -0.00375rem;border-radius: 2.5rem;
border: 1px solid #333;}
#header .option_list {position:absolute;width:100%;background:#fff;border-radius:0.4rem;padding:0.5rem 0;top:2rem;display:none;}
#header .option_list li{text-align:center;}
#header .option_list li a {font-size: 0.75rem; }

/*-----네비게이션-----*/
#header .header_inner #nav {display: flex; flex-direction: row; justify-content: center; align-items: center;}
#header .header_inner #nav{}
#header .header_inner #nav ul {clear:both;  position:relative; box-sizing:border-box;height:100%;}
#header .header_inner #nav ul li { display:inline-block;width: auto; float:none; vertical-align:top;position:relative;}
#header .header_inner #nav ul li {position:relative; }
#header .header_inner #nav ul li a{color: #222;
font-size: 0.8rem; font-weight: 400; letter-spacing: -0.004rem;}



#header .header_inner #nav ul li ul {z-index: 10;display:none; position: absolute; width:9.5rem;  left:50%; margin-left:-4.75rem; top:0; padding:5rem 0 .5rem; box-sizing:border-box; text-align:center; background:#fff;  box-shadow: 0 4px 15px 0 rgba(0, 0, 0, 0.15); border-radius:1rem; height:auto;   /*display: none;*/	animation-name: slide_down;	animation-duration:0.5s;    animation-duration: linear; animation-direction: alternate; animation-fill-mode: forwards;border-radius:1rem;top:0.3rem;}



#header .header_inner #nav ul li ul li {display:block;margin:0; margin-bottom:13px; line-height:1.5;}
#header .header_inner #nav ul li ul li a:after{content:'';display:block;position:absolute;width:100%;height:1px;background:#fff;left:0;bottom:0;opacity:0;}

#header .header_inner #nav ul li ul li a:hover:after{opacity:1;}
#header .header_inner #nav ul li ul li a:hover{color:#054D9F;font-weight:700;text-decoration-line: underline;
text-decoration-style: solid;
text-decoration-skip-ink: auto;
text-decoration-thickness: auto;
text-underline-offset: auto;
text-underline-position: from-font; }
#header .header_inner #nav ul li.active > div > a{}
#header .header_inner #nav ul li.active ul li:after{display:none;}

#header .header_inner #nav > ul > li > div{position:relative;overflow:hidden;padding:0 1rem;z-index:11;line-height:4.5rem;}
#header .header_inner #nav > ul > li > div > a{color: #222; font-size: 0.95rem; font-weight: 600; line-height: 0.95rem; letter-spacing: -0.00475rem;}





/*-----사이트맵 버튼-----*/
#header .btn-gnb-menu{height:4.5rem; cursor:pointer; z-index:9999;text-align:center; -webkit-transition: all 0.25s; transition: all 0.25s;}
#header .btnAll {position:relative; display:block; margin:0 auto; top:50%;  transform:translateY(-50%);outline: none; z-index:9999;}
#header .btnAll span {display: inline-block;width: 100%;height: 2px;background-color: #444;-webkit-transition: all 0.25s;transition: all 0.25s; }
#header .btn-gnb-menu button{width:1.95rem;height:1.6rem;display:flex; flex-direction:column;justify-content: space-between}
#header.open .btn-gnb-menu span:nth-child(1) {
	transform: translateY(0.7rem) rotate(45deg);
}
#header.open .btn-gnb-menu span:nth-child(2) {
	opacity: 0;
}
#header.open .btn-gnb-menu span:nth-child(3) {
	opacity: 0;
}
#header.open .btn-gnb-menu span:nth-child(4) {
	transform: translateY(-0.7rem) rotate(-45deg);
}

@keyframes slide_down {
  from {
    transform: translateX(0px) translateY(-30px);
	opacity:0;
  }
  to {
    transform: translateX(0px) translateY(0px);
	opacity:1;
  }
}



/*사이트맵*/
#header #navi{position:fixed; top:0; width:100%; height:100%; padding-top:0; overflow:hidden;  z-index:20;overflow-y:scroll;transform: scale(0);left:0;}
#header .navi-bg{    display: block;width: 46px;height: 46px;background: rgba(255, 255, 255, 0.9) ;border-radius: 50%;position: absolute;right: 4%;top: 46px;transform: translate(-50%, -50%) scale(0);transition: all 0.8s ease-in-out;z-index:11;}
#header #navi .site-img{transform: scale(1);position:absolute;right:0;bottom:0;}

#header.open .navi-bg{transform: translate(-50%, -50%) scale(150);backdrop-filter: blur(0.05px);}

#header.open #navi{transform: scale(1);
	transition: all 0s 0.8s; }
#header #navi .mobile_top{height:100%;position:relative;}
#header #navi .site-bg{position:absolute;z-index:1;width:0;margin:0 auto;height:100%;}

#header #navi  .mbtop{width:0;transition-duration: 0.5s;display:flex;height:100%;}
#header #navi  .mbtop li a{color:rgba(255,255,255,0.7);font-size:0.9rem;}


#header #navi{
  -ms-overflow-style: none; /* 인터넷 익스플로러 */
  scrollbar-width: none; /* 파이어폭스 */
}

#header.open #navi .site-bg.open .bg {width:30%;transition: all 0.8s cubic-bezier(.16,1,.64,1);}
#header.open #navi .mbtop{width:100%;transition-duration: 0.5s;}

#header #navi  .mbtop li { line-height: 100%; }

#header #navi  .mbtop > li { opacity: 0;transition-duration: 0.5s;width:calc(100% / 5);text-align:center; position: relative; background-color: transparent; overflow: hidden; padding-top: 10rem; display: flex; align-items: center; flex-direction: column; }
#header #navi  .mbtop > li a {position:relative;z-index:1;}
#header #navi  .mbtop > li:hover{background: linear-gradient(180deg, #024EA0 0%, #1A2F6E 100%);}
/* 배경 전용 레이어 */
#header #navi .mbtop > li::before {
    content: "";
    position: absolute;
    left: 0; top: 0;
    width: 100%; height: 100%;
    background: #00387A url(/images/default/main/site-bg.png) no-repeat bottom right;
    opacity: 0;
    transition: opacity .35s ease-in-out; /* 부드럽게 */
    z-index: 1; /* 텍스트 위로 올라오지 않게 */
}

/* hover 시 서서히 나타남 */
#header #navi .mbtop > li:hover::before {
    opacity: 1;
}
#header #navi  .mbtop > li > ul {margin-top:2.5rem; max-width: 9.1rem; width: 100%;}
#header #navi  .mbtop > li > ul > li > a {color:#2D3748;font-size:0.9rem; font-weight: 500; position:relative;line-height:1; letter-spacing: -0.0045rem;}
#header #navi  .mbtop > li > ul > li > a:hover{color:#fff;}
#header #navi  .mbtop > li > ul > li > a:before{content:'';position:absolute;bottom:0;left:0;width:0;background:#fff;height:2px;transition-duration: 0.5s;}
#header #navi  .mbtop > li > ul > li > a:hover:before{width:100%;transition-duration: 0.5s;}



#header #navi  .mbtop > li > ul > li:not(:last-child){margin-bottom:2.25rem;}
#header #navi  .mbtop > li > ul > li > ul {display:flex; margin-top: 1rem; flex-direction: column; gap: 0.5rem;}
#header #navi  .mbtop > li > ul > li > ul a { color: #717d96; font-size: 0.8rem; font-weight: 400; line-height: 1; letter-spacing: -0.004rem; }
#header #navi  .mbtop > li > ul > li > ul a::before { content: '- ' }
#header #navi  .mbtop > li:hover > ul > li > ul a { color: #fff; }

#header.open #navi  .mbtop > li  {opacity: 1;transition-duration: 0.5s;    animation-delay: .4s;}


#header #navi  .mbtop > li > a{font-size:1.4rem;font-weight:700;line-height:1;color:#2D3748; display: inline-flex; justify-content: center; width: 100%; }

#header #navi  .mbtop > li:hover > a {color:#ffff;}
#header #navi  .mbtop > li:hover > ul > li > a{color:#ffff;}


#header #navi  .mbtop .depth1-div{margin-top:0.75rem;}
#header #navi  .mbtop .depth1-div > ul {display:flex;}
#header #navi  .mbtop .depth1-div > ul > li:not(:last-child){margin-right:7rem;}
#header #navi  .mbtop .depth1-div > ul > li > a{font-size:0.9rem;color:rgba(255,255,255,0.7);font-weight:600;margin-top:0.75rem;}
#header #navi  .mbtop .depth1-div > ul > li .depth2 > ul {margin-top:0.75rem;}
#header #navi  .mbtop .depth1-div > ul > li .depth2 > ul > li > a{font-size:15px;color:rgba(255,255,255,0.4);position:relative;padding-left:0.5rem;display:inline-block;}
#header #navi  .mbtop .depth1-div > ul > li .depth2 > ul > li > a:before{content:'';display:block;position:absolute;width:5px;height:1px;background:rgba(255,255,255,0.4);top:0.5rem;left:0;}
#header #navi  .mbtop .depth1-div > ul > li .depth2 > ul > li > a:after{content:'';display:block;width:100%;height:1px;background:#fff;left:0;bottom:0;opacity:0;}

#header #navi  .mbtop .depth1-div > ul > li:hover > a {color:#fff;}
#header #navi  .mbtop .depth1-div > ul > li .depth2 > ul > li > a:hover:after{opacity:1;}
#header #navi  .mbtop .depth1-div > ul > li .depth2 > ul > li > a:hover{color:#fff;}
#header #navi  .mbtop .depth1-div > ul > li .depth2 > ul > li > a:hover:before{background:#fff;}

.mbtop a.has-external { display: inline-flex; align-items: center; gap: 0.5rem; }
#header #navi .mbtop a.has-external::after { content: ""; width: 0.9rem; height: 0.9rem; background: url("/images/default/content/icon-external.svg") no-repeat center / contain; flex-shrink: 0; }

#header.open h1{}
#header.open .btn-gnb-menu span{background-color:#444;}
#header.open .header_inner .header-right a.mall-btn{z-index:111;background:inherit;border:1px solid #fff;color:#fff;}
#header.open .select_btn{z-index:111;color:#fff;}

@media (min-width: 2000px) {
	#menuAll .mobile_top{justify-content: center;}
	#menuAll .mobile_top .mbtop:after{width:calc(100% - 13rem);}
}


@media (max-width:1550px){
	#header .header_inner{width:100%;padding:0 1rem;}
	#header{width:100%;margin-left:0;left:0;}
	#header .area_top > .inr{margin:0 1rem;}
}

