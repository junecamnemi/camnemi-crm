/* 공통*/
.boardListTitle {margin-bottom:0.75rem; font-size:0.8rem; font-weight:normal; color:#898989; display:flex; justify-content: space-between; align-items: flex-end;}
.boardListTitle strong{color:#333;}
.boardListRightTitle {text-align:right; }
.boardListRightTitle form.categoryForm { display:inline; margin:0; padding:0; }
.boardListRightTitle form.categoryForm fieldset { display:inline; margin:0; padding:0; border:none; }
.boardListRightTitle form.categoryForm fieldset legend { display:none; }
.boardListRightTitle form.categoryForm select{height:1.75rem; line-height:1.75rem;}
#sepration:has(+ #container [class^="boardListContainer"]) .sub-visual-img .sep_img { background-position: center 87% !important; }
#sepration:has(+ #container [class^="boardGalleryContainer"]) .sub-visual-img .sep_img { background-position: center 87% !important; } 
/* 카테고리 탭으로 */
.category {margin-bottom:2.5rem;}
.category ul{display:flex;gap:0 0.4rem;}
.category ul li a {padding: 0.75rem 1.25rem; border-radius: 2.5rem; background: #DFE8F0; color: #717D96; font-size: 0.8rem; font-weight: 600; line-height: 0.8rem; letter-spacing: -0.004rem; display: flex;}
.category ul li.on a {background: #054D9F; color: #fff !important;}
.category ul li a:hover{color:#054D9F}

/* 검색 */
.boardSearch {padding:1.95rem;text-align:center;  background-color: #F7F8F9; border-radius: 1rem; display: flex; align-items: center; justify-content: center; margin-bottom: 2.5rem;}
.boardSearch form { margin:0; padding:0;width:100%; }
.boardSearch form fieldset {display: flex; align-items: center; margin:0; gap: 0.5rem; }
.boardSearch select{flex-shrink:0; border:1px solid #ddd; line-height:1; height:2.75rem;color:#464646; vertical-align:top; background:#fff url("/images/default/content/sel-icon.svg") no-repeat right+1rem center; max-width: 12.5rem; width: 100%; border-radius: 0.5rem; padding: 0 1rem; font-size: 0.8rem; color: #717d96;}
.boardSearch select:focus {border: 2px solid #2D3748;}
.boardSearch input[type="text"] { border:1px solid #ddd; height:2.75rem; margin:0; vertical-align:top;width:calc(100% - 12.5rem - 1rem - 4.85rem); padding: 0.95rem 1rem; font-size: 0.8rem; color: #717d96; border-radius: 0.5rem;}
.boardSearch input[type="text"]:hover,
.boardSearch input[type="text"]:focus-visible { border: 1px solid #2d3748; }
.boardSearch input[type="text"]:focus { border: 2px solid #2d3748; }


.boardSearch input[name="btn_submit"] { background:#41464e; border:1px solid #41464e; }
.boardSearch .searchSubmit {display: flex; justify-content: center; flex-shrink:0; cursor:pointer; overflow:hidden; position:relative; height:2.75rem;  box-sizing:border-box; background:#41464e; border:1px solid #25282d; color:#fff !important; text-align:center; vertical-align:middle; transition:all 0.4s ease-out 0.1s; -webkit-backface-visibility:hidden; -moz-backface-visibility:hidden; -webkit-transform:translate3d(0, 0, 0); -moz-transform:translate3d(0, 0, 0); border-radius: 0.5rem; padding: 0 1rem; gap: 1rem;}

.boardSearch .searchSubmit img {width:18px;}
.boardSearch a.shadeButton {flex-shrink:0; margin-left:5px; position:relative; font-size:0; display:block; width:2.25rem; height:100%; background:#92999e; color:#fff;}
.boardSearch a.shadeButton:before{content: "\e9d2"; display : block; position : absolute; left : 50%; top:50%;  -ms-transform: translate(-50%, -50%); transform: translate(-50%, -50%); font-size:1rem; font-family: 'xeicon';}

.manageButton { margin-top:1rem; font-size:.7rem;}


/* Total: Page: n/n */
