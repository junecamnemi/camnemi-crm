  /* IE10+ */
  background: radial-gradient(ellipse at center, #fff 0%, #ddd 100%);
  /* W3C */
  filter: progid:DXImageTransform.Microsoft.gradient(startColorstr='@rfrom', endColorstr='@rto', GradientType=1);
  /* IE6-9 fallback on horizontal gradient */
}
