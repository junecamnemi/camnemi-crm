@charset "UTF-8";
@import url("/_res/anyang/_share/css/font.css"); 

/* common */
body{font-family:'Noto Sans KR',sans-serif;font-weight:200;font-size:1.8rem;color:#333;-webkit-text-size-adjust:none;-moz-text-size-adjust:none;-ms-text-size-adjust:none;line-height:1.4}

html{font-size:10px;}
.inner{max-width:157.6rem;width:100%;margin:0 auto;padding-left:8.8rem;padding-right:8.8rem;box-sizing:border-box}
*{box-sizing:border-box;word-break:keep-all;word-wrap:break-word;}

a{color:inherit}
h1,h2,h3,h4,h5,h6,strong{font-weight:normal}
em{font-style:normal;}

input::placeholder{color:inherit}
input::-webkit-input-placeholder{color:inherit}
input:-ms-input-placeholder{color:inherit}
select::-ms-expand {display: none;}

button, input[type=submit]{border:0;}

img{width:100%}

.sub-visual-wrap,
.sub-nav-wrap{background:#fff url(/_res/anyang/main/img/bg_header.jpg) repeat-y left;background-size:50%}
#container{/*max-width:191.6rem;*/width:100%;margin:0 auto;}
.content{/*padding-top:6rem;*/padding-bottom:15rem;padding-left:8.8rem;padding-right:8.8rem;}

body{letter-spacing:-.1rem}

/* color */
:root{
	--w-col:#fff;
	--y-col:#ffbd33;
	--b-col:#26409a;
	--bl-col:#000;
	--gry-col:#555;
	--all-transi:all 0.4s ease 0s;
}

.pc{display:block}
.mo{display:none}

/* 새창 */
.bl-link span{padding-right:2rem;background-image:url(/_res/anyang/_share/img/btn-export-box1.png);background-repeat:no-repeat;background-position:top 50% right .1rem;background-size:1.2rem;}
.sub-mn > li:hover > .bl-link span{background-image:url(/_res/anyang/_share/img/btn-export-box2.png);}

/* guide */
.guide{padding: 20px; height: 100%; min-height: 100%; overflow: auto; background: #f0f0f0;}
.guide>h1{border-bottom: 1px dashed #999; padding-bottom: 20px; margin-bottom: 20px}
.View{padding: 15px; background: #fff; border: 1px solid #ddd;}
.guide_group>h2{margin: 20px 0; padding: 20px 0;}

.box{margin-top:3rem;padding:2rem 0 2rem;color:#999;border-top:1px dotted #ddd}
.box:nth-child(1){margin:0;padding-top:0;border:0}


/*Font Guide*/
.visual-tit{font-weight: 700; font-size: 5.2rem; color: #fff;}
.visual-txt{font-weight: 500; font-size: 2.4rem; color: #fff;}
.title div{padding:6rem 0;font-size:5rem;line-height:1.3;text-align:center;font-weight:300;color:#000;/*background:url(/_res/anyang/enter/img/bg_title.png) repeat-x 0 bottom;background-size:auto .6rem*/}

.tit01{margin:6.5rem 0 3rem; font-weight: 500; font-size: 3.4rem; color: #000;line-height:1.3}
.tit01:nth-child(1){margin-top:0}
.tit01::before{display: block; content:""; width: 3.7rem; height: .5rem; background: url(/_res/anyang/enter/img/ico-dot-tit.png) no-repeat; background-size:contain; padding-bottom: 1rem;}
.tit02{margin:3.5rem 0 3rem;font-size: 2.4rem; font-weight: 400; color:#26409a;}
/*.tit02:before{display:inline-block; content:""; width: 6px; height: 6px;  border-radius: 50%; vertical-align: middle;  background: #ffbd33; margin-right: 1rem;}*/
.tit01 + .tit02 {margin-top:0}
.tit03{margin:3.5rem 0 3rem;font-size: 2.4rem; font-weight: 500; color:#1ca29a;}
.tit04{margin:4rem 0 3rem;font-size:2.4rem;color:#000;font-weight:400}

.text-info{margin:3rem 0;font-weight: 200; font-size: 1.8rem; line-height:1.7; color: #333;}
.line{border: 1px solid #dddedf;}
.list-box + .gray-bg{margin-top: 4rem;}
.gray-bg > .tit02:first-of-type,
.gray-bg > .text-info:first-of-type{margin-top: 0;}
.gray-bg > .text-info:last-of-type{margin-bottom: 0;}

/*img-box*/
.img-box{display: flex; align-items:stretch;margin:5rem 0}
.img-box li{flex:1;padding:0 1rem}
.img-box li:first-child{padding-left:0;}
.img-box li:last-child{padding-right:0}
.img-box li img{max-width: 100%;}

.des{margin-top:.5rem;padding-left:2.4rem;color:#26409a}
.des:before{display:inline-block;content:'※';width:2rem;margin-left:-2.4rem}

/*Button Guide*/
.btn{display:inline-flex; align-items: center; justify-content: center;line-height:1.2; font-weight: 400; font-size: 1.8rem; border: 0; cursor: pointer;min-width: 16rem; height: 5rem; padding: 1.6rem 1.4rem;margin:.5rem 1rem}

.more-btn{display:inline-flex; align-items: center; justify-content: center; min-width:20rem; height:4.8rem; padding: 1rem 2rem; background: #fafafa; border: 1px solid #e4e4e4; color: #111; border-radius: 2.4rem; font-size: 1.8rem; cursor: pointer;}

.blue{background: #26409a; color: #fff;}
.gray{background: #dadee7; color: #000;}
.black{background: #000; color: #fff;}
.green{background: #26999a; color: #fff;}
.b-blue{border: 1px solid #26409a; color: #26409a; background: transparent;}
.b-white{border: 1px solid #fff; color: #fff; background: transparent;}
.b-black{border: 1px solid #333; color: #333; background: transparent;}
.orange{color: #ed6c0e;}

.ico-export1{display: inline-block; width: 1.2rem; height: 1.2rem; margin-left: 2rem;font-size:0; background: url(/_res/anyang/_share/img/board/btn-export-box1.png) no-repeat; background-size: 100%; vertical-align: middle;}
.ico-export2{display: inline-block;width: 1.2rem; height: 1.2rem; margin-left: 2rem;font-size:0; background: url(/_res/anyang/_share/img/board/btn-export-box2.png) no-repeat; background-size: 100%;vertical-align: middle;}
.ico-export3{display: inline-block;width: 1.2rem; height: 1.2rem; margin-left: 2rem;font-size:0; background: url(/_res/anyang/_share/img/board/bg-rule-link.png) no-repeat; background-size: 100%;vertical-align: middle;}
.ico-down1{display: inline-block;width: 1.4rem; height: 1.1rem; margin-left: 2rem; font-size:0;background: url(/_res/anyang/_share/img/board/btn-down-box1.png) no-repeat; background-size: 100%;vertical-align: middle;}
.ico-down2{display: inline-block;width: 1.4rem; height: 1.1rem; margin-left: 2rem;font-size:0; background: url(/_res/anyang/_share/img/board/btn-down-box2.png) no-repeat; background-size: 100%;vertical-align: middle;}
.ico-plus{display: inline-block;width: 2.8rem; height: 2.8rem; margin-left: 1.7rem;font-size:0; background: url(/_res/anyang/_share/img/board/ico-plus.png) no-repeat; background-size: 100%; vertical-align: middle;}
.ico-link-hp{display: inline-block; width: 1.7rem; height: 1.5rem; margin-left: 2rem;font-size:0; background-image:url(/_res/anyang/enter/img/ico-link-hp.png);background-position:right;background-repeat:no-repeat;background-size: 100%;vertical-align: middle;}
.ico-link-hp-b{display: inline-block; width: 1.7rem; height: 1.5rem; margin-left: 2rem;font-size:0; background-image:url(/_res/anyang/enter/img/ico-link-hp-b.png);background-position:right;background-repeat:no-repeat;background-size: 100%;vertical-align: middle;}
.ico-link-hp-blue{display: inline-block; width: 1.7rem; height: 1.5rem; margin-left: 2rem;font-size:0; background-image:url(/_res/anyang/enter/img/ico-link-hp-blue.png);background-position:right;background-repeat:no-repeat;background-size: 100%;vertical-align: middle;}

.btn-con-more{display:inline-block;margin-top:1.5rem;padding:3% 8rem 3% 2rem;border:.1rem solid #074755;background:#fff url(/_res/anyang/main/img/bg_infobox.gif) no-repeat right;background-size:6rem}

/*교수소개*/
.profile-wrap{border-top: 2px solid #26409a; margin-top: 4.7rem;}
.profile-box1{padding: 4rem 4rem; display: flex;}
.profile-box1 .profile-img{width: 15rem; height: 18rem; background: #000;}
.profile-con1{margin-left: 7rem; width: calc(100% - 22rem);}
.profile-con1 .name{font-size: 2.4rem;}
.profile-con1 .name strong{font-size: 2.8rem; font-weight: 700; padding-right: 1.2rem;}
.profile-con1 .profile-info{margin: 2.5rem 0;}
.profile-con1 .profile-info li{font-size: 1.8rem; line-height: 1.8; vertical-align: middle;}
.profile-con1 .profile-info li:before{display: inline-block; content: ""; background: #93a0cd; width: 4px; height: 4px; border-radius: 50%; vertical-align: middle;}
.profile-con1 .profile-info li strong{display: inline-block; min-width: 8rem; margin: 0 3rem 0 1rem; font-weight: 700;}

.profile-box2{background: #f1f1f1; padding: 4rem 6rem;}
.profile-con2{background: #fff; border-radius: 1rem; box-shadow:3px 3px 3px 1px rgba(0, 0, 0, .2); margin: 1.8rem 0 5rem 0; padding: 3rem 4.5rem;}
.profile-con2 li{font-size: 1.8rem; line-height: 2; font-weight: 500;}

/*본문 레이아웃*/
.layout-txt-bg{background: #f6f4f4; padding: 4rem;}
.gray-bg{background: #f7f7f7; padding: 3.6rem 4rem;}
.layout-txt01{display: flex; padding-bottom: 4rem; border-bottom: 1px solid #e7e7e7;}
.layout-txt01 .main-img{width: 38rem; height: 22.4rem; background: #000;}
.layout-txt01 .text-info{width: calc(100% - 38rem); padding: 2rem 0 0 3rem;}

.layout-txt02{display: flex; padding: 4rem 0; border-bottom: 1px solid #e7e7e7;}
.layout-txt02 .main-img{min-width: 13.6rem; height: 14rem; border-radius: 50%; background: #000;}
.layout-txt02 .text-info{width: calc(100% - 13.6rem); padding: 2rem 0 0 3rem;}

.layout-txt03{display: flex; flex-wrap: wrap; padding: 4rem; border-bottom: 1px solid #e7e7e7;}
.layout-txt03 li{width: calc((100% - 9rem) / 4); margin-right: 3rem;}
.layout-txt03 li:nth-child(4n){margin-right: 0;}
.layout-txt03 li:nth-child(n+5){margin-top: 3rem;}
.layout-txt03 li .main-img{width:100%; height: 21rem; background: #000;}
.layout-txt03 li .text-info{text-align: center; padding-top: 3rem;}

.layout-txt04{padding: 4rem 0; border-bottom: 1px solid #e7e7e7;}
.layout-txt04 .layout-txt-bg{width: 100%; height: 18.3rem; overflow: auto;}

.layout-txt05{padding: 4rem 0; border-bottom: 1px solid #e7e7e7;}
.layout-txt05 .tit01{padding-bottom: 2rem; }
.layout-txt05 .text-info-wrap{border: 1px solid #d2d2d2;}
.layout-txt05 .text-info{padding: 4rem; position: relative;}
.layout-txt05 .text-info:after{display: block; content:""; position: absolute; bottom: 0; left: 4rem; width: calc(100% - 8rem); border-bottom: 1px dashed #333;}
.layout-txt05 .text-info:last-child:after{border-bottom: 0;}

.layout-txt06 .tit01{padding-bottom: 4rem; }
.layout-txt06 .text-info-wrap{display: flex; flex-wrap: wrap; }
.layout-txt06 .text-info-wrap .text-info{margin-right: 3rem;}
.layout-txt06 .text-info-wrap .text-info li{line-height: 1.7;}
.layout-txt06 .text-info-wrap .text-info li:before{display: inline-block; content: ""; width: 3px; height: 3px; border-radius: 50%; background: #333; vertical-align: middle; margin-right: .9rem;}

.layout-txt07{padding: 4rem 0; display: flex; flex-wrap: wrap; }
.layout-txt07 .text-info{width: calc((100% - 7rem) / 2); margin-right: 7rem;}
.layout-txt07 .text-info:last-child{margin-right: 0;}

.layout-txt08{display: flex; flex-wrap: wrap;}
.layout-txt08 .text-info{width: calc((100% - 6rem) / 3); margin-right: 3rem;}
.layout-txt08 .text-info:last-child{margin-right: 0;}

.layout-txt09{padding: 4rem 0;}

.layout-txt10{padding: 4rem 0;}
.list-box > li{position:relative;margin-top:1rem;padding-left:1rem; color: #000;line-height:1.6}
.list-box > li:first-child{margin-top:0}
.list-box > li:before{position:absolute;left:0;top:1.3rem; content:""; width:5px; height:2px;background: #444;}
.list-box > li > ul{margin:1rem 0 1.8rem;}
.list-box > li > ul > li{position:relative;color: #555;padding-left:.8rem;line-height:1.6}
.list-box > li > ul > li:before{position:absolute;left:0;top:-.2rem; content:"·";}

/*layout-table*/
.layout-table{padding: 4rem 0;}
.layout-table .tit01{padding-bottom: 1.8rem;}
.board-table{width: 100%;margin-bottom:5rem; border-top: 2px solid #000; border-bottom: 1px solid #44505e; border-collapse: collapse;}
.board-table th{background: #f7f8f8; padding: 1.8rem; border: 1px solid #dddedf;text-align:center;font-weight:400}
.board-table td{text-align: center; vertical-align: middle; padding: 1.8rem; border: 1px solid #dddedf;}
.board-table th:first-child,
.board-table td:first-child{border-left:0;}
.board-table th:last-child,
.board-table td:last-child{border-right:0;}

.board-table1{width: 100%;margin-bottom:1rem; border-top: 2px solid #000; border-bottom: 1px solid #44505e; border-collapse: collapse;}
.board-table1 th{background: #f7f8f8; padding: 1.8rem; border: 1px solid #dddedf;text-align:center;font-weight:400}
.board-table1 td{ vertical-align: middle; padding: 1rem; border: 1px solid #dddedf;}
.board-table1 th:first-child,
.board-table1 td:first-child{border-left:0;}
.board-table1 th:last-child,
.board-table1 td:last-child{border-right:0;}

.list-tit > .board-table{width: calc(100% + 1rem);margin:2rem 0 1.8rem -1rem;}

/*layout-tab*/
.tab-list{display: flex; flex-wrap: wrap; width: 100%;margin-bottom:5rem;padding: 0.5rem;border: 1px solid #93a0cd; border-radius: 0.6rem;}
.tab-list li{width:calc(100% / 6)}
.tab-list li a{position:relative;display:flex;align-items:center;justify-content:center;height: 4.8rem;text-align: center; color: #26409a; font-size: 1.8rem;transition:all 0.4s ease 0s;}
.tab-list li a:after{position:absolute; right:0; top:50%; display:inline-block; content:""; border-right: 1px solid #e2e8ff; height: 2.4rem; transform: translateY(-50%);}
.tab-list li:nth-child(6n) a:after{display:none}
.tab-list li a.active{background: #26409a; border-radius: 0.4rem; color: #eef0f6;}
.tab-list li a.active:after{border-right:0;}

label[for="tab_select"]{position: absolute; left: -999999999px; top: -999999999px; width: 0; height: 0; visibility: hidden; font-size: 0;}
.tab-sel{display: block; width: 100%;margin-bottom:4rem; font-weight: 400; font-size: 2.4rem; padding: 1.5rem 6rem 1.5rem 3rem; box-sizing: border-box; border-radius: 1rem; color: #fff; cursor: pointer; background: #26409a url(/_res/anyang/_share/img/board/btn_tab_on.png) no-repeat top 50% right 3rem; background-size: 2.7rem 1.5rem; -webkit-appearance: none; -moz-appearance: none; appearance: none; outline: none; text-overflow: ellipsis;}

.design-input{padding:60px 0;border:1px solid #ddd;border-radius:10px;text-align:center}

.tab-con{display:none}
.tab-con.active{display:block;}

/* flex */
.flex{display:flex;}
.jc-sb{justify-content:space-between}
.ai-c{align-items:center}

/* btn */
.btn-r{display:flex;justify-content:flex-end}

.btn-m{min-height:4.4rem;padding:0 2rem;border-radius:.4rem;font-size:1.8rem;cursor:pointer}
.btn-m{margin:0 .7rem;}
.btn-m:first-of-type{margin-left:0}
.btn-m:last-of-type{margin-right:0}

.y-color{color:#fff;background-color:#ffbd33}
.b-color{color:#fff;background-color:#26409a}

/* btn ico */

.pdf{padding-right:5rem;background-image:url(/_res/anyang/enter/img/ico_pdf.png);background-position:right;background-repeat:no-repeat;background-size:3.5rem}
.docu{padding-right:5rem;background-image:url(/_res/anyang/enter/img/ico_docu.png);background-position:right;background-repeat:no-repeat;background-size:3.7rem}
.zoom{padding-right:5rem;background-image:url(/_res/anyang/enter/img/ico_zoom.png);background-position:right;background-repeat:no-repeat;background-size:3.7rem}

.new-link{padding-right:2rem;background-image:url(/_res/anyang/enter/img/ico-link.jpg);background-position:right;background-repeat:no-repeat;background-size:1.2rem}
.new-link:hover{text-decoration:underline}


/* text guide */
.txt-l{text-align:left !important}
.txt-c{text-align:center !important}

.c-point{color:#26409a}

/* step */
.step-wrap{display:flex;justify-content:start;align-items:stretch;flex-wrap:wrap;margin-bottom:6.5rem}
.step-list{position:relative;padding:2.5rem 3.5rem;border:1px solid #999;margin-top:3rem;}
.step-list:after{position:absolute;right:-2rem;top:50%;width:2.1rem;height:3.9rem;content:'';background-image:url(/_res/anyang/enter/img/bg_step_first.jpg);background-size:2.1rem;background-repeat:no-repeat;transform:translateY(-50%)}
.step-tit{}
.step-tit span{color:#a6a6a6;font-size:1.6rem}
.step-tit strong{display:block;padding:.6rem 0;color:#26409a;font-size:2rem;font-weight:500}
.step-list:last-child{border:2px solid #26409a;}
.step-list:last-child:after{display:none}
.step-list:last-child .step-tit strong{color:#26409a;}
.step-list header + *{margin-top:2rem;padding-top:1.7rem;border-top:1px solid #dfe5f3}

.step04 .step-list{width:calc((100% - 10rem) / 4); margin-right: 3.3rem;}
.step04 .step-list:nth-child(-n + 4){margin-top:0}
.step04 .step-list:nth-child(4n){margin-right: 0;}

/* process-step */
.process-wrap{display:flex;justify-content:start;align-items:stretch;flex-wrap:wrap;margin-bottom:1rem}
.process-list{position:relative;padding:2.5rem 2rem;border:1px solid #dbdbdb;margin-top:3rem;}
.process-list:after{position:absolute;right: -4rem; top:50%;width:2.8rem;height:2.6rem;content:'';background-image:url(/_res/anyang/_share/img/ico-process-arrow-l.png);background-size:2.8rem;background-repeat:no-repeat;transform:translateY(-50%)}
.process-list em{display: block; color:#a9b2da;font-size:1.8rem; font-weight: 400;}
.process-list strong{display: inline-block;padding: 1.5rem 0 .6rem 0;color:#26409a;font-size:1.8rem;font-weight:400;}
.process-list strong a{display: inline-block;}
.process-list:last-child{background: #f5f7ff;}
.process-list:last-child em{color: #26409a;}
.process-list:last-child:after{display:none}
.process-list:last-child .step-tit strong{color:#26409a;}
.process-list span{vertical-align: middle; margin-left: 1rem;}

.step03 .process-list{width:calc((100% - 15rem) / 3); margin-right: 5rem;}
.step03 .process-list:nth-child(-n + 3){margin-top:0}
.step03 .process-list:nth-child(3n){margin-right: 0;}

.step04 .process-list{width:calc((100% - 15rem) / 4); margin-right: 5rem;}
.step04 .process-list:nth-child(-n + 4){margin-top:0}
.step04 .process-list:nth-child(4n){margin-right: 0;}

.step05 .process-list{width:calc((100% - 20rem) / 5); margin-right: 5rem;}
.step05 .process-list:nth-child(-n + 5){margin-top:0}
.step05 .process-list:nth-child(5n){margin-right: 0;}

.step06 .process-list{width:calc((100% - 20rem) / 6); margin-right: 4rem;}
.step06 .process-list:nth-child(-n + 6){margin-top:0}
.step06 .process-list:nth-child(6n){margin-right: 0;}

/* tab */
.tab-sel2{display: block; width: 100%;margin-bottom:4rem; font-weight: 400; font-size: 2.4rem; padding: 1.5rem 3rem; box-sizing: border-box; border-radius: 1rem; color: #fff; cursor: pointer; background: #26409a url(/_res/anyang/_share/img/board/btn_tab_on.png) no-repeat top 50% right 3rem; background-size: 2.7rem 1.5rem; -webkit-appearance: none; -moz-appearance: none; appearance: none; outline: none;}

/* list type */
.dot-list li{padding-left:1rem;line-height:1.6;}
.dot-list li:before{display:inline-block;width:1rem;height:2rem;margin:-.9rem 0 0 -1rem;content:'•';font-size:1.4rem;color:#bbb;vertical-align:middle}

.num-list li{padding-left:1rem;line-height:2;}

.num-list2>li{margin-left:2rem;line-height:2;list-style:decimal}

/* space */
.w70{min-width:auto!important;width:7rem !important}

.mt-0{margin-top:0 !important}
.mt-20{margin-top:2rem!important}
.mt-30{margin-top:3rem!important}

.mb-0{margin-bottom:0 !important}
.mb-10{margin-bottom:1rem!important}
.mb-30{margin-bottom:3rem!important}

.mr-0{margin-right:0 !important}

@media screen and (max-width: 1400px){
	html{font-size:9px;transition:all 0.4s ease 0s}
}

@media screen and (max-width: 1200px){
	/*html{font-size:8px}*/
}

@media screen and (max-width: 1024px){
	.inner{padding-left:2rem;padding-right:2rem}
}

@media screen and (max-width: 768px){
	.pc{display:none}
	.mo{display:block}
		
	.content{padding-left:2rem;padding-right:2rem}
	
	/*html{font-size:7px}*/
	.title div{padding:3rem 0;font-size:3rem;}
	.tit01{font-size:2.4rem}
	.tit02,.tit03{font-size:2.2rem}
	
	/* step */
	.step-wrap .step-list{width:calc((100% - 3rem) / 2);margin-top:3rem !important; margin-right:2.2rem}
	.step-wrap .step-list:nth-child(-n + 2){margin-top:0 !important}
	.step-wrap .step-list:nth-child(2n){margin-right:0 !important}
	.step04 .step-list.odd-last{width: calc(100% - .8rem); margin-right: 0;}
	
	/* process-step */
	.process-wrap .process-list{width: 100%; margin-top:6rem !important; margin-right: 0; text-align: center;}
	.process-wrap .process-list:nth-child(1){margin-top:0 !important;}
	.process-list:after{position:absolute;top: auto; right: auto; left: 50%; bottom: -4.7rem; width:3rem;height:3.4rem;content:'';background-image:url(/_res/anyang/_share/img/ico-process-arrow-b.png);background-size:2.8rem;background-repeat:no-repeat;transform:translateX(-50%);}

	.t-mobile colgroup{display:none}
	.t-mobile tr{display:table;width:100%;}
	.t-mobile th,
	.t-mobile td{display:block;width:100%;border-left:0;border-right:0}
	.t-mobile .btn{width:100%;margin-left:0;margin-right:0;}
	
